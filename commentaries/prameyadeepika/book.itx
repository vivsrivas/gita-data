
%%% ##label=<segment001_pd01>##

\centerline{shrIjayatIrthamunivirachitayA}
\centerline{\Largedvng prameyadIpikayA sahitam}
\ \ \ guNagaNanilayaM patiM ramAyA jagadaghadahanaM cha vAsavIsUnum  |
\ \ \ munikulatilakaM cha pUrNabodhaM gurumapi paramaM guruM cha me vande  || 1||

\ \ \ AnandatIrthabhagavatpAdAchAryavinirmitam  |
\ \ \ vyAkhyAsye bhagavadgItAbhAshhyaM tatkaruNAbalAt  || 2||

prAripsitavighnavighAtAdiprayojanaM samuchitavishishhTeshhTadevatAgurupraNAmaM
granthArambhapratij~nAM chAdau nibadhnAti bhagavAn bhAshhyakAraH \dash \" devam\"
iti |

atra \" deva\" shabdo \" devatA\" shabdaparyAyaH pratipAdyamAha |  sannidhAnAchcha
bhagavadgItAyA, iti labhyate |  tenedAnIM nArAyaNasya praNAme samuchitatAmAchashhTe |
aj~nAnapAratantryAdibhiH sarvadoshhaiH, visheshheNa, sarvadA, sarvAtmanA varjitam |
\" parito deshataH kAlato guNatashcha pUrNam\" iti vaishishhTyamAchashhTe |

paramavaishhNavasya bhagavato bhAshhyakArasya vishhNurishhTadevatA iti prasiddhameva |
yadvA bhagavadgItApratipAdyatvaM nArAyaNasya na pareshhAmiva jIvatvanirvisheshhatvAdirUpeNa |
kiM nAma\?  \" sarvadoshhavarjitatayA pUrNatayA cha\", iti padadvayena AkhyAti |

\" An\" vyAsAn \dash \" a A aM aH purANarshhiH vyAsaH shAkhAsahasrakR^it\" 
(padma pu\. 6\.71\.273) ityakArasya tannAmasu pAThAt\footnote{\normaldvng \" a A aM aH purANarshhiH vyAsaH shAkhAsahasrakR^it | \ mahAbhAratanirmAtA kavIndro bAdarAyaNaH || \ kR^ishhNadvaipAyanaH sarvapurushhArthaukabodhakaH | \ vedAntakartA brahmaiva vyaJNjakaH puruvaMshakR^it\" || \ iti vAsudevasahasranAmni vyAsanAmAsu pAThAd, ityarthaH \ \dash veNupallI shrInivAsAchAryavirachitA bhAvadIpikA |} |  bahuvachanaM cha 
gauravAdeva |  \" gItA\" iti bhagavadgItaiva abhipreyate, \" mukhyAmukhyayoH mukhye 
kAryasampratyaya\", iti nyAyAt |  \" yadyapi bahvarthA gItA, shaktashchAhaM tadvachane, 
tathA.api shrotR^INAM mandAM matimapexyAlpamevochyata\", iti bhAvenoktam \dash 
\" leshata\" iti |  itthambhUtalaxaNArthatR^itIyAntAt tasiH |  \" \" artha\" shabdena 
sarvArthagrahaNaprasaktau sarveshhAM cha bhAshhye.adarshanAt vandhyeyaM pratij~nA\", iti 
mandAshaN^kAnirAsAya idamuditam |

\" nanvastu namaskAragrathanaM shishhyashixArtham |  pratij~nA tu kimarthaM granthe
niveshanIyA\?\" |  uchyate \dash \" bahubhirvyAkhyAtR^ibhiH bhagavadgItAyA vyAkhyAtatvAt
vyarthamidaM bhAshhyam\", ityAshaN^kAnirasanaM prayojanamasya |  anyaiH
svapaxanixiptadR^ishhTibhiH svAbhiprAyo bhagavadgItArthatvena AropyoktaH |
\" ahaM tu gItArthameva vaxyAmi\" iti sUchanAt |  na chAtra yatibhaN^go
doshhaH, tasya kAvyavishhayattvAt |  shAstre tu \" ya upAdhirlagati sAdhye
sambandhavisheshhaNe\" ityAdyabhiyuktavAkye darshanAd \dash iti |

\" nanu cha prAdhAnyena vyAkhyeyatA prAmANye adhikArivishhayaprayojanAbhisambandhe
durgamArthatve cha sati sambhavati |  tat kathaM bhagavadgItAyAH prAmANyAdikam\?
sati vA tasmin tathAvidhagranthAntaraparihAreNAsyA eva vyAkhyAne ko hetuH\"
ityAshaN^kya \" mahAbhAratAntargatatvAd bhagavadgItAyAH tasya prAmANyAdisiddhau
tasyA api tat setsyati\" ityAshayavAn mahAbhAratasya prAmANyAdikaM sAdhayituM 
Aha \dash
%%% ##endlabel##

%%% ##label=<segment002_pd01>##

{\Largedvng pra\.dI\. || } kimanayA kuTilikayA gItAyA eva pR^ithakprAmANyAdikaM sAdhyatAm\?  maivam |  
mahAvAkyaprAmANyAdyanabhidhAne avAntaravAkyaprAmANyAderasambhAvanAgrastatvena 
sAdhayitumashakyatvAt |  yathoktam \dash \" sambhAvitaH pratij~nAyA arthassAdhyeta 
hetunA\"\footnote{\normaldvng \" sambhAvitaH pratij~nAyA arthaH sAdhyeta hetunA |  na tasya hetubhistrANaM \ utpatanneva yo mR^itaH\" \dash vishhNutattvavinirNaya\-TIkA |} iti |  nashhTashabdo.adarshanavAchI, \" Nasha adarshane\" iti 
smaraNAt |  \" dharmo\" nivR^ittilaxaNaH |  j~nAnashabdena j~neyaM paratattvaM 
vAsudevAkhyamaparaM cha prakR^ityAdikaM laxyate |  laxaNAyAshcha prayojanaM, \" yathA 
dharmo j~nAtvA utpAdanIyaH na tathedaM kintu j~nAnaparamparaiva tadvishhayA.anushhTheyA\" 
iti j~nApanam |  

\" loka\" iti sajjano vivaxitaH \dash \" nashhTe.adarshanaM gate dharmaj~nAne yasya
tasmin loke vishhaye kR^ipALubhiH\" |  yadyapi \" spR^ihigR^ihi\" (ashhTA\. 3\.2\.158)
ityAdinA kR^ipeH\" Aluch\" pratyayo na vihitaH |  tathA.api vyAkaraNAntarabalAd
avagantavyaH |  kaLashavAchI vA\" ALu\" shabdaH \dash \" kR^ipApUrNakalashaiH\" ityarthaH |  
\" moxasAdhanayoH dharmaj~nAnayoradarshanAt saMsAre klishyamAnAn sajjanAnavalokya 
utpannakR^ipaiH\" iti yAvat |  anyapadArthAnAM devAnAM \" brahmarudrendrAdibhiH\" 
iti yadvisheshhaNaM \" tatprasiddhaprabhAvAnAmapi bhagavaditareshhAmashakyamidaM kAryam\" 
iti j~nApanArtham |

j~nAnapadena dharmo.apyupalaxyate |  samakaxyatvanirAsAya svashabdenAgrahaNam |  
etachcha pUrveNottareNa cha sambaddhyate, \" j~nAnapradarshanAyArthito\", \" j~nAnapradarshanAyAvatatAra\" 
iti |  \" bhagavAn samagraj~nAnaishvaryavairAgyAdiguNasampanno nArAyaNo vyAsarUpeNa 
avatatAra\", ityarthaH | 
%%% ##endlabel##

%%% ##label=<segment003_pd01>##

{\Largedvng pra\.dI\. || } \" tataH kiM prakR^ita\?\" ityata Aha \dash \" tatashcha\" iti | 
yasmAt dharmaj~nAnapradarshanArthamavatIrNaH, tasmAdeva |  avatArAnantarameva vA |  
\" vijAtIyavyApAravyavadhAnamantareNa\", iti yAvat |  dharmaj~nAnapradarshanAya 
\" mahAbhAratasaMhitAm\", mahAbhAratAkhyaM shAstraM, \" achIklR^ipat\", 
samarthitavAn |  \" vyAsa\" iti sambandhaH |  

\" dharmAdij~nAnamapurushhArthaM kathaM shAstraprayojanamabhipretavAn\?\" ityata uktaM 
\dash \" dharmaj~nAnalaxaNayA dvArA sajjanAnAM moxo bhaved ityabhiprAyeNa\" iti |
atra \" j~nAna\" shabdo mukhyArtha eva |  \" etadgranthanirmANe bhagavataH kiM
prayojanam\?\" ityata uktam \dash \" kR^ipALuH\" iti |  \" saMsAre svAbhAvike
moxArthaM prayatnaH kAkIyakArshhNyApanayanArthaprayatnatulya\", ityata uktam,
\" ishhTAnishhTaprAptiparihArasAdhanAdarshanAt saMsAre klishyamAnAnAm\" iti |
moxasya purushhArthatAsamarthanArthaM vAdivipratipatteH tatsvarUpanirdhAraNArthaM cha 
\" ishhTa\" ityAdyuktam |  Atyantiketi chopaskartavyam |  sAdhanaM cha dharmaj~nAnarUpam |

\" nanu vedAnAmuddhR^itattvAt tata eva dharmAdipratipattisambhavAt kiM bhAratanirmANena\?\"
ityata uktam \dash \" sarvavedArtha\" iti |  \" anena vedAdhikAriNAM traivarNikAnAM
puMsAM vedArthaj~nAnopAyo bhAratam\", iti sUchayati |  \" kiJNcha vedAnadhikAriNAM
vedatulyatvAchcha tannirmANaM yuktam\?\" ityAshayavAn Aha \dash \" veda\" iti |
tadanena paramAptimUlatvAt mahAbhAratasya prAmANyam |  dharmaH paramaparaM cha
tattvaM vishhayaH |  tajj~nAnaM avAntaraM prayojanam |  moxaH paramam |
\" sajjanAshchAdhikAriNa\" ityuktaM bhavati |  \" nashhTadharma\" ityAdinA bahusho 
vishhayaprayojanAbhidhAnena tayorananyalabhyatvaM sUchitam |  \" yadabhAvAtsatAM
saMsAre klesho yadarthaM devatAnAM prArthanaM yadarthashcha bhagavato.avatAraH,
tadbhAratanirmANenaiva paryavasitam\", iti |

etenaitadapi pratyuktam \dash yadAha bhAskaraH, \" shAstraprayojanAbhidhAne prastute 
avatAraprayojanAbhidhAnamasaN^gatam\", iti |  saN^karaH kR^ishhNAvatArapuraskAreNa
gItAyAH saN^gatimAha |  \" tadatikrameNa vyAsAvatArapuraskAre ko hetuH\?\" iti
chet, \" kR^ishhNasya balakAryatvena j~nAnopadeshasya prAsaN^gikatvam |  vyAsasya
j~nAnakAryatvena prAdhAnyam\" iti |

\" vedAdisaMvAdenApi bhAratasya prAmANyanishchaya\" ityAshayenAha \dash \" sarva\" 
iti |  \" naitAvatA vedAdisamaM bhAratam, kintu tadanuktArthasyApi pratipAdanena
tato.adhikam\" iti bhAvenAha \dash \" tad\" iti |  \" tarhi nirmUlatvena
aprAmANyaM prasajyata\" ityata uktam \dash \" Ishvara\" iti |  \" j~nAnadR^ishhTaH\"
j~nAnavishhayIkR^itaH |  sarvaj~natvasya \" jhaD\" iti sphuraNArthaM \" svena\" 
ityanuktvA \" Ishvara\" ityuktam |  \" Ishvaraj~nAnasya kutaH prAmANyam\" 
ityata uktam \dash \" kevala\" iti |  indriyAdyanapexam |  anena 
\" satsvapyanyeshhu grantheshhu kimetadvyAkhyAnena\" iti parihR^itam |

\" nanu \" nashhTadharma\" ityAdinA \" mandAn prati idaM nirmitam\" iti sUchitam |  
te cha vedaikadeshArthamapi j~nAtumashaktAH |  tatkathaM sarvavedAdyuktAnuktArthavato.asya
praNayanam\?\" |  maivam \dash brahmAdInAmapyatrAdhikArAt |  yathoktam,

\ \ \ \" vedottamaM tachcha vidhAtR^ishaN^karapradhAnakaistanmukhataH suraiH shrutam\"

iti |  \" kathametadubhayam\" ityata Aha \dash \" sarva\" iti | \" rUpa\" shabdo
abhidheyArthaH |  \" svaM rUpaM shabdasya\" (ashhTA\. 1\.1\.68) ityatra 
\" rUpa\" shabdena prasaktasya bAhyArthasya vyAvR^ittaye \" svam\" ityuktatvAt |  
sa cha vyAghAtaparihArArthaH |

sAmAnyena dvyarthaM bhAratam |  tatraiko.arthaH sarvaprANinAmavagAhyaH |  
aparassarvaprANinAmanavagAhyaH |  kintu keshhAJNchideva iti na kashchiddoshha iti |  
anavagAhyarUpatAyAM hetumAha \dash \" paroxa\" iti |  \" paroxo\" atyantagUDhaH |

\" nanu dharmAdyanekavishhayasya kathamekavAkyatA\" ityata Aha \dash \" kevala\" iti |
kevalaM ekameva bhagavatsvarUpaM paraM mukhyapratipAdyaM yasyAssA tathoktA |
\" dharmAdikaM tu tAdarthyena amukhyapratipAdyam\", iti bhAvaH |

\" bhagavatsvarUpapratipAdanaM na saN^kIrNatayA |  api tu nishhkR^ishhTatayA\" iti 
j~nApanAya \" svarUpa\" ityuktam |
%%% ##endlabel##

%%% ##label=<segment004_pd01>##

{\Largedvng pra\.dI\. || }  \" kuta etatpratipattavyam\?\" ityata Aha \dash \" tachcha\" iti |
yadetat \" nashhTadharma\" ityAdinoktaM, tat \" lokeshA\" ityAdyAgamachatushhTayena 
uktaM cha |  na kevalaM asmAbhiruchyate |  

\" upasargasya ghaJNyamanushhye bahuLam\" (ashhTA\. 6\.3\.122) ityato \" adhIkAra\"
iti dIrghaH |  \" striyAdikam\" iti chhAndasa iyaN^ |  \" vyAso bhUtvA cha\"
vyAso bhUtvaiva |  vilambamakR^itvA |  \" abhUtvA mUlarUpeNa cha\" iti vA |
\" tena\" vyAsarUpeNa \" anyAvatArarUpaishcha\" |   \" param\" atishayena
uttamam |  \" ko.asau paJNchamo veda\?\" ityata Aha \dash \" bhAratam\" iti |  
paJNchamavedAkhyaH \" shAstrapuN^gavaH\" |  iti \" sambhinnaH\" prabhinnaH |
athavA, iti \" shAstrapuN^gavaH\" |  \" sa cha \" sambhinna\" ekArthatayA saN^gata
ityanekeshhvapi grantheshhvekavachanam\", iti yojyam |

atra paJNcharAtraM nArAyaNAvatAreNa kR^itam |  mUlarAmAyaNaM hayagrIvarUpeNa |
AdibhAgavataM mUlarUpeNa |  \" brahmA\" bR^ihaspatirapi |  \" kR^itsnam\" iti
sheshhaH |  \" sarvo.api\" jano \" jAnati\" jAnAti |  \" bahvartham\" iti
\" pravadanti\" |  \" bhArataM chApi\" iti pUrvoktena samuchchayaH |

\" dasha avarA yeshhu te tathA\", \" te.arthAH yasya\" iti vigrahaH |

yAjakAderAkR^itigaNatvAt \" vishhNubodhakam\" iti samAsaH |  karaNArthaghaJNantena vA
samAsaH |  pashchAdalpAdyarthe kaH |  \" uttamam\" ityuktasyaiva vivaraNaM \" vedAdapyuttamam\"
iti |  eshhu vAkyeshhu yathAsambhavaM pUrvoktArtho.avagantavyaH |

\" yadi vidyAd\" ityAdibhAratavAkyaparyAlochanayA choktaM, \" tadavasIyata\" iti
sambandhaH |  \" chatvArashcha te vedAshcha\" iti visheshheNasamAsa evAyaM,
na dviguH |  aN^gAni chopanishhadashcha \" aN^gopanishhadam\" iti samAhAradvandvaH |
tena \" dvandvAchchudashhahAntAtsamAhAre\" (ashhTA\. 5\.4\.106) iti samAsAnto.akAraH |  
tato bahuvrIhiH |  

\" prachalishhyati\", prachAlayishhyati iti |

\" bhAravattvAd\" ityanena \" matvarthe tapratyaya\" ityuktaM bhavati |
bhArataprAmANyamaN^gIkR^itya itaradanaN^gIkurvANaM prati idamuktam |  yuktyanusandhAnena
vinA.abhipretArtho na pratIyate |  ataH \" tatparyAlochanayA\" ityuktam |
anusandhAnaprakAraM cha leshena darshayishhyati |  R^ishhINAM vaishampAyanAdInAM
sampradAyAchchhishhyebhyaH pradAnAchchaitadavasIyate |  na hi prAmANyAdirahitaM
R^ishhayaH shishhyANAM shreyase vyAkuryuriti yujyate\?

\" ko hyanya\" ityAdipurANalaxaNagranthAntaragatavAkyArthAnyathAnupapattyaitad
avasIyate |  \" granthAntara\" iti visheshhaNasya prayojanaM svayameva vaxyati |
vAkyasyoktArthe sAmarthyAbhAvAd \" anyathAnupapattyA\" ityuktam |  tachcha
pradarshayishhyate \dash nAradasyAdhyayanavyAkhyAnAdiliN^gaishchoktArtho.avasIyate |
\" R^ishhisampradAyAd ityanenaiva gatam\" iti chenna |  R^ishhINAM
gR^ihasthatvena parArtho.anyavishhayo.api vyavahAraH kathaJNchit sambhAvyetApi |
\" nAradasya tu paramahaMsasya svArtho vyApAro.anyavishhayo na sambhavati\" iti
j~nApanArthatvAt |  ata eva \" sampradAyAd\" iti \" adhyayana\", iti choktam |

\" tadvAkyaparyAlochanayA\", ityuktam |  \" kIdR^ishI sA paryAlochanA\" ityato 
leshena darshayati \dash \" katham\" iti |
%%% ##endlabel##

%%% ##label=<segment005_pd01>##

{\Largedvng pra\.dI\. || } \" mahattvAd\" iti vAkye \" bhArata\" shabdaM niruchya tajj~nAnAt 
sarvapApaxayo.abhidhIyate, na tu bhAratasyottamattvaM sAxAt |  tathA.api 
paryAlochanayA gamyata eva |  yathA hi nArAyaNAdibhagavannAmaniruktij~nAnAd 
bhavan pApaxayo.abhidheyasya sarvottamatva eva, tathA ayamapi |  anyathA 
bhAratasya sarvashAstrottamatvAbhAve |  kathaM tachchhabdaniruktij~nAnamAtreNa sarvapApaxayaH 
syAt\?  \" shabdAntaraniruktij~nAnena\" tadabhAvAd, iti |

\" syAdetadanumAnaM, yadi hetUkR^ito.arthaH pramitaH syAt |  na chaivam |
ayathArthaprashaMsAyA api darshanena vachanasyAnyathAsiddheH\" ityata Aha \dash 
\" prasiddhashcha\" iti |  dhiyAM tAvat prAmANyaM svataH, bAdhakAdaprAmANyam |  
na cheha tadasti |  arthavAdAnAM chAbAdhite svArthe prAmANyamastyeva |  \" ato, 
hetUkR^ito yo.artho \" bhArata\" shabdaniruktaj~nAnena sarvapApaxayaH sa prasiddhaH 
pramita eva\", iti |

\" sarvapApaxaye tadaiva muktiH syAd\", iti chet tarhi \" sarva\" shabdArtha eva 
saN^kochyatAM, na tu sarvo vAkyArthaH\?  evamanyAnyapi bhAratavAkyAni paryAlochanIyAni |  
tathA hi |  \" yadi vidyAd\" iti vAkye yadyapi bhArataM noktam |  tathA.api 
uttaratra \" itihAsa\" shabdena gR^ihItatvAt \" purANa\" padaM tadupalaxaNaM, 
iti j~nAyate |  na hyanuktasyopapAdanaM yuktam |  tatashcha bhAratasya vedArthaj~nAnopAyatA
anena siddhyati |  achetanatvaparyAlochanAyAM \" bibheti\" ityetat bibhetIva 
svArthamantardhApayatIti j~neyam |

yadyapi \" manvAdi\" ityetadApAtato na prakR^itaM kamapyarthaM pratyAyayati |
tathA.api bhagavatpAdairanyatrodAhR^itasya etadvyAkhyAnarUpavAkyasyAnusandhAne
bhAratasya bhagavatparatvAdi gamayati |  tulAropaNaM bhAravattvaM cha pratinidhidvAreNa
upapAdanIyam |  \" yadiha\" ityasya stutitvopapattaye tadevAnyatra iti vyAkhyAne
sarvavedAdyarthopabR^iMhitatvAdikaM siddhyati |

\" virATa\" ityetatpUrvottaravAkyAnusandhAne bhAratasya kalpatarurUpatAM
pratipAdayat bhAratasya sarvapurushhArthahetutAM gamayati \dash iti |

\" ko hyanyaH iti purANavAkyAnyathAnupapattyA\" ityuktam |  \" kIdR^ishI
sA.anyathAnupapattiH\" ityata Aha \dash
%%% ##endlabel##

%%% ##label=<segment006_pd01>##

{\Largedvng pra\.dI\. || } \" anyathA\" iti cha vartate |  \" anyasya\" iti vyatyayena 
tR^itIyArthe shhashhThI |  yadvA \" kartum\" iti kR^idyoge kartari\footnote{\normaldvng \" kartR^ikarmaNoH kR^iti\" \dash ashhTA\. 2\.3\.65} |  \" na lokAvyaya\" 
(ashhTA\. 2\.3\.69) iti pratishhedhashcha \" naJNA nirdishhTamanityam\" ityato.anityaH |  
ata eva tosunkasunoH yoge shhashhThI dR^ishyate, \" sUryasyodetoH\", \" krUrasya visR^ipa\" 
iti |  \" ko hyanya\" iti vAkye tAvadbhAratasya nArAyaNAdanyena 
kartumashakyatvamuchyate |  tatkathamanyathA kevaleshvaraj~nAnadR^ishhTArthayuktatvAbhAve 
yujyate\?  tathAvidhAnAmanyaiH kartumashakyatvasya adarshanAd, iti |

\" nanvanyaiH kartumashakyavamiti heturasiddhaH |  \" ko hyanyaH\" iti vAkyasya 
avidyamAnArthastutitvopapattiH\", ityata Aha \dash \" granthAntara\" iti |  
\" avidyamAna\" ityataH paraM \" artha\" shabdo adhyAhAryaH |  \" idaM vAkyam\" 
iti sheshhaH |  yadvA \" stutiH\" guNotkarshhaH |  \" atrochyata\" iti sheshhaH |  
nAtrArthashabdAdhyAhAraH |  anena prAguktasya \" granthAntara\" iti visheshhaNasya 
prayojanamuktam |  iyaM cha sambhAvanAyuktiH |  nishchayayuktistu \" cha\" shabdasUchItA 
bAdhakarahitatvAdiH |  

\" nanu bhavedetadyadyatra bhAratasyAnyena kartumashakyatvalaxaNA stutiruchyeta |
na chaivam |  \" kR^ishhNadvaipAyanaM vyAsaM viddhi nArAyaNaM param\" iti
bhAratasya karturvyAsasya nArAyaNatvalaxaNAyAH stuterupakramAt |  uttaratra
tasyaivArthasyopapAdanAt\" ityata Aha \dash \" na cha\" iti |  \" karturevAtra
stutiruchyata\" iti cha na vAchyam |  kintu bhAratasyApi |  \" katham\", iti 
chet\?  atra hyanumAnena vyAsasya nArAyaNatvaM sAdhyate |  tatra \" kR^ishhNadvaipAyanam\"
iti pUrvArdhaH pratij~nArUpaH |  \" ko hyanya\" iti uttarArdho vyatirekavyApteH
pratipAdakaH |  anukto hetuH vyAptivachanasAmarthyAdUhyaH |  tatra na tAvat
granthakR^ittvaM hetuH |  \" kutaH\?\" ityata Aha \dash \" itaratrApi\" iti |
granthakR^ittvasya nArAyaNAditaratrApi sAmyAdanaikAntyaprasaN^gAt |  nApi bhAratakR^ittvam |
\" kutaH\?\" ityata Aha \dash \" itaratrApi\" iti |  granthavyaktivisheshhakR^ittvena
nArAyaNatvasAdhanasyetaratra kALidAsAdAvapi sAmyAdatiprasaN^gAt |  tasmAt 
nArAyaNAdanyena kartumashakyasya kAryasya kartR^itvameva hetuH |  na chAsAvasiddhaH |  
bhAratasya tathAtvAdityUhyam |  vyAptivAkyaM cha tadabhiprAyaM mantavyam |  tathA cha 
kathamatra bhAratasya stutirnAvagamyate\?  shrutyA.anavagame.apyarthAdavagamAditi |

\" astvevaMvidhaM bhAratam |  vyAchikhyAsitAyAstu gItAyAH kimAyAtam\?\",
ityata Aha \dash
%%% ##endlabel##

%%% ##label=<segment007_pd01>##

{\Largedvng pra\.dI\. || } tatraivaMvidhapramANyAdyupete bhArate |  \" gItAmupanibabandha\" 
vyAsaH |

\" kimiyaM gItAyAH prAmANyAdeH sambhAvanA, uta nishchayayuktiH\?  na dvitIyaH |
tathAtve, kaLiN^gopadeshAderapi tatprasaN^gAt |  \" anuvAdo asau\" iti chet\?
ayamapi tathaiva |  Adye, nishchAyakaM vAchyam\" ityata uktam \dash \" vAsudeva\" iti |
\" saMvAdaM rUpayati\", iti \" saMvAdarUpA\" |  

\" tathA.api bhArataikadeshAntaraparihAreNa asyA gItAyA vyAkhyAne ko hetuH\?\" ityata 
Aha \dash \" sarva\" iti |  \" sarvabhAratArthasya saN^graho yasyAm\", iti gamakatvAd
vyadhikaraNabahuvrIhiH |  \" etad vyAkhyAne sarvamapi bhArataM vyAkhyAtaprAyaM bhavati\"
iti bhAvaH |  \" naitAvatA bhAratasamA gItA, kintu tato.adhikA cha\", ityAshayena 
Aha \dash \" bhArata\" iti |  \" kuta etad\", ityata Aha \dash
%%% ##endlabel##

%%% ##label=<segment008_pd01>##

{\Largedvng pra\.dI\. || } sarvashAstreshhu varam |  \" tadevamAptimUlatvAdinA prAmANyAt, 
dharmAdipratipAdanena savishhayatvAt, moxArthatvena saprayojanatvAt, sadadhikAritvAt, 
durgamArthatvAchcha, vyAkhyeyA gItA\", iti sthitam |

tatra j~nAnameva kevalaM moxasAdhanam |  dharmastu j~nAnAt prAganushhThito.antaHkaraNashuddhyAdidvArA
j~nAnaM janayan moxasAdhanam |  j~nAnottarastu muktAvAnandodrekaheturityevaM
vishhayaprayojanayoH sambandho.abhihitaH |

kechittu \" j~nAnottarakAlaM dharmAdyanushhThAnameva nAsti\" iti bruvate |  anye 
tu \" j~nAnakarmasamuchchayasAdhyatvAt moxasya tatpratipAdanAya gItArambho na
dharmAdipratipAdanArtham |  tadarthAnAM manvAdidharmashAstrANAM sanakAdiyogashAstrANAM
cha pratikAlaM vidyamAnatvAd\", ityAchaxate |  tadubhayaM nirAkartumAha \dash
%%% ##endlabel##

%%% ##label=<segment009_pd01>##
{\Largedvng pra\.dI\. || } sa gItokto dharmo brahmaNaH svarUpaj~nAne suparyApto 
j~nAnAtprAganushhThitaH |  \" brahmaNaH padavedane\" jAte.anushhThitastu \" suparyAptaH\" 
suparyAptamuktihetuH, ityanugItopakrame bhagavataivoktam |  udAharishhyante chAtra 
spashhTArthAni vAkyAni |  na cha gItAyAM tathAvidhamekamapi vAkyaM dR^ishyate |  

tathA cha vaxyate |  manvAdishAstrANAM vidyamAnatvena dharmAderapratipAdyatve 
samuchchayo.api na pratipAdyaH \dash shrutyAdipratipAdyatvAbhyupagamAt |  \" tatra
na sphuTaM pratipAdanam\", iti chet\?  samaM yathoktaM, vedArthAj~nAnAchcha, iti |  
tasmAt, \" yatkiJNchidetad\" ityuktameva vishhayAdikam \dash iti |
%%% ##endlabel##

%%% ##label=<segment010_pd01>##
\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM prathamo.adhyAyaH ||}
%%% ##endlabel##

{\Largedvng pra\.dI\. ||} \" tatra\", gItAyAm |  \" kaishchana shlokairidamuchyata\" iti sheShaH |  
\" nanvatra na dharmo, nApi tattvaM pratipAdyate |  tatkuto.asya gItAyAmanupraveshaH\?\"
maivam |  bhagavato.arjunabodhane prasaktiM darshayato.asya granthasya tAdarthyAt
tatra praveshopapatteH |  bAndhavAdiviShayo mohaH \dash \" mamaite, ahameteShAM,
ete cha mannimittaM naN^xyanti, kathametairvinA.ahaM bhaveyam\?, pApaM cha me
bhaviShyati, jayashcha sandigdha\", ityAdirUpo mithyApratyayo \" bAndhavAdimohaH\" |
teShu sneho vA |  sa jAlamiva, tena \" saMvR^itam\" |  tata eva \" viShIdantam\" |
viShAdo nAma mohanimittakAt shokAt yanmanodaurbalyaM yasmin sati
sarvavyApAroparamo bhavati |

\" nanvidAnImeva kuto.arjunasya mohassamutpatitaH\? \" na hyete bAndhavAdaya\"
ityAdikaM prAk nAj~nAsIt |  yena yuddhAya mahAntamudyogamakArShId\?\"
ityata uktam \dash \" senayoH\" iti |  mahApakArasmaraNenAnuvartamAno.api
kopo mR^idumanasAM bAndhavAdimR^itikAle nivartate |  snehashchotpadyate |  \" tato moha,
iti prasiddhameva\", iti bhAvaH |  

\" arjunasya j~nAnitvAt mohajAlasaMvR^itatvAdikamIShadeva\", iti mantavyam |
%%% ##endlabel##

%%% ##label=<segment002_pd02>##

{\Largedvng pra\.dI\. ||} \" praj~nAvAdAn\" ityetat \" praj~nAvatAM buddhimatAM vAdAn 
vachanAni\" (shaM\.bhA\. 2\.11) iti kashchidvyAkhyAtavAn |  tadasat |  
\" na hi \" dR^iShTvemaM svajanaM kR^iShNa\" ityAdyarjunavAkyeShu kashchid 
buddhimadvAdo vidyate |  na hi buddhimanto nArAyaNadviTtadanubandhinigrahaM 
adharmaM vadanti |  na cha dharmAdharmaviShayatvamAtreNa buddhimadvAdo bhavati |  
bauddhopadeshAderapi tattvaprasaN^gAd\" \dash ityAshayena anyathA vyAchaShTe, 
\" praj~nAvAdAn\" iti |  svasyA eva manIShAyA utthitAni, na tu 
shAstrAchAryopadeshaprAptAni |

\" kathametallabhyate\?\"  uchyate |  \" praj~nAyA vAdAH\" \" praj~nAvAdAH\" |
kAryakAraNabhAve ShaShThI |  \" na hi sa vAdo.asti yaH praj~nApUrvo na bhavati\", 
iti sAmarthyAt \" sva\" iti labhyate |  sAvadhAraNaM chaitat, \" abbhaxa\"
iti yathA |  anyathA punarvaiyarthyAd, iti |

\" kathamashochyA\", \" ityata Aha\" iti sheShaH |  \" gatAsUn\" ityataH 
paramitishabdaH |  \" AsannavinAshAH kathamashochyA\?\" ityarthaH |

\" nanu prAgashochyatvAnuvAdena \" anvashocha\" ityevoktam |  na tvashochyatvam |
tatkathamevamAxepaH\?\"  maivam |  na hi yathAshrutaivAtra vAkyavR^ittiH |
\" asiddhasyAnuvAdaH, siddhasya bodhanam\" ityApatteH |  kintu yAneva 
\" anvashochaH\" tvaM te\" ashochyAH\" |  tasmAt tAn prati na shokaH kAryaH |  
\" tvaM yAMshcha bhAShase, te \" praj~nAvAdAH\", ato na bhAShaNIyA\", iti |  tathA 
cha \" ashochyAH kuto.avagantavyA\?\" iti prashno vA.a.axepo vA yujyata eva || 11||
%%% ##endlabel##

%%% ##label=<segment003_pd02>##

{\Largedvng pra\.dI\. ||} \" kim\" iti \" kasmAt kAraNAt\?\" |  \" paNDitAH api
agatAsUniva gatAsUnAsannavinAshAn nAnushochanti\", iti sheShaH |  
\" atranityatvAd\" ityuttaram |  \" kuto nityatvamityata Aha\" iti vAkyaM 
chAdhyAhAryam |  \" natvevAham\" ityataH paramitishabdashcha |  arjunaM 
nimittIkR^itya prAptalokopakArArthaM hi bhagavatopadeshaH kriyate |  tatra 
ye bhagavataH kR^iShNasyeshvaratvaM nityatvaM cha na jAnanti tAn prati 
yathAshrutaiva yojanA |  dR^iShTAntastUttaratra bhaviShyati |  \" ye tu 
tajj~nAtvA jIvanityatAmeva na jAnanti tAn pratyanyathA yojyam\", ityAha 
\dash \" Ishvara\" iti | 
%%% ##endlabel##

%%% ##label=<segment004_pd02>##

{\Largedvng pra\.dI\. ||} \" aprastutatvAd\", anAshaN^kitatvAt |  \" dR^iShTAntatvenAha\"
\" jIvanityatAyAM sAdhyAyAmIshvaram\", iti sheShaH |  ata eva \" kR^iShNa\" 
ityanuktve, \" Ishvara\" ityuktam |

\" nanvIshvaranityatvaM kutassiddham\?  pUrvArdhe vAkyatrayasadbhAvAt, kathaJNchit 
yojanAsambhave.api uttarArdhasyaikavAkyatvAt kathaM yojanA\?\" ityata Aha \dash 
\" yathA\" iti |  \" vedAntA\" upaniShadaH |  \" siddhasyArthasya sAdhyatvena 
nirdesho doShAyeti sAmarthyAt yathaivaMshabdAdhyAhAreNa vAkyabhedena cha yojyam\",
iti bhAvaH |

\" nanu vedAntairIshvaranityatvaM jAnantaH, tatraivoktaM jIvanityatvaM kathaM na
jAnanti\?\"  uchyate \dash \" nityo nityAnAm\" (shve\.u\. 6\.13, ka\.u\. 2\.2\.13)
ityAdau nirdhAraNasAmarthyAt jIvAnAM nityatvamIshvarasya cha paramanityatvamavagamya
mandAH pratipadyante \dash \" nityatvaM hi vinAshAbhAvaH |  na chAbhAvaH tAratamyavAn |
ata Ishvara eva nityo, jIveShu tUpachAra\", iti |  tAn prati anumAnena
jIvanityatvamIshvaradR^iShTAntena sAdhyate |  tatra \" natvevAhaM jAtu nAsam\"
iti dR^iShTAntena anAditvaM sAdhanamanuvadati |  \" na tvam\" ityAdinA tasya
paxadharmatAmAha |  \" na chaiva\" ityAdinA dR^iShTAnte, paxe cha, sAdhyAbhidhAnaM,
iti |

atra bhagavatA jIvAnAM parasparaM IshvarAchcha bhede pratipAdite.api \" bahuvachanaM
sharIrApexayA natvAtmApexayA\" (shaM\.bhA\. 2\.12) iti vadato bhaviShyattyuttaram |

%%% ##endlabel##

%%% ##label=<segment005_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu chAtra kiM paridR^ishyamAnadehapaxIkAreNa 
anumIyate, kiM vA tadatiriktadehipaxIkAreNa\?  nA.adyaH |  dehotpattivinAshayoH, 
pratyaxasiddhatvena hetoH svarUpAsiddhatvAt,  kAlAtyayApadiShTatvAchcha\" 
iti sphuTatvAt noktam |  dvitIye doShamAha \dash \" dehina\" iti |
\" dehinaH\", dehavataH dehAtiriktasya Atmano \" bhAve\" sadbhAve |
etat nityatvAnumAnam |  \" bhavati\", sambhavati |  dehapaxoktadoShAbhAvAt |
\" kintu taddehAtiriktAtmasattvamevAsiddham |  pramANAbhAvAt |  tatashcha
AshrayAsiddhiriti |  astu vA dehAtiriktAtmasattvam |  tathA.api nAnumAnaM
sambhavati\", ityAha \dash \" dehina\" iti |  \" dehinaH\" ityekavachanaM tantram |  
\" tatpUrvottaradeheShu eka evAyaM AtmA\" ityasyArthasya bhAva etadanumAnaM 
sambhavati |  svarUpAsiddhyAdyabhAvAt |  \" kiM nAma\?  tatpUrvottaradeheShu
AtmaikatvamevAsiddham |  pramANAbhAvAt |  tathA cha dehotpattAvutpattimataH
tadvinAshe cha nAshavataH kathamanAditvena nityatvaM sAdhyata\?\" iti |  ubhayasyApi
parihAradarshanAdevaM yojyam |  arthadvayAnuguNyAyaiva bahuvachane prakR^ite.api
ekavachanam |  tathA \" bhAva\" iti pulliN^ge prakR^ite.api \" tadeva\" iti
sAmAnyagrahaNAya napuMsakanirdeshaH |  \" na ityAha\", iti sheShaH |  \" dehino.asmin\"
ityataH paraM \" iti\" shabdashcha |  AxepadvayaparihArAya pAdatrayaM vyAkhyAti 
\dash \" yathA\" iti |  
%%% ##endlabel##

%%% ##label=<segment006_pd02>##

{\Largedvng pra\.dI\. ||} atra \" dehI tadIxitA siddhaH\" iti dehAtiriktA.atmasAdhanam |
\" tad\" iti kaumArAdiparAmarshaH |  yAjakAditvAt samAsaH\footnote{\normaldvng \" yAjakA.adibhishcha\" \dash aShTA\. 2\.2\.9} |  dvitIyAntasya
tR^innantena vA samAsaH |  \" asti tAvat kaumArAdiviShayamIxaNam |  na cha
IxaNaM IxitAraM vinA sambhavati |  sa cha vaxyamANAt parisheShapramANAt dehI
dehAtiriktaH siddha\" iti |  atra kaumArAdigrahaNaM atantram |  j~nAnamAtreNa
j~nAtR^isiddheH |  \" deha\" shabdashcha indriyAdisahita sharIravR^ittiH |  shloke cha, 
\" kaumAraM yauvanaM jarA\" iti viShayeNa viShayIxaNamupalaxyate |  tat 
\" dehino dehAtiriktasya\" ityuktaM bhavati |  \" yathA\" ityAdisamastavAkyaM 
shloke cha pAdatrayaM dehabhede.api AtmaikatvasAdhanam |  \" kaumArAdimat
sharIrabheda\" ityarthaH |  \" dehI eka eva\" ityarthaH |

\" tadIxitA\", iti \" yo.ahaM kumArasharIravAnabhUvaM, sa idAnIM yuvasharIravAn
varta, ityAdipratyabhij~nAta\", ityarthaH |  \" dehAntaraprAptAvapi\", iti
\" anekadehaprAptAvapi\" ityarthaH |  \" eka eva dehI siddha\" iti vartate |

\" IxitR^itvAd\" iti \" pratyagrajAtasya shishorAhArAdyabhilASheNa
pUrvadehAnusandhAnasiddheH\" ityAshayaH |  
%%% ##endlabel##

%%% ##label=<segment007_pd02>##

{\Largedvng pra\.dI\. ||} evamAtmano dehAtirekaM dehabhede.apyekatvaM cha 
prasAdhya \" dhIrastatra na muhyati\" ityuchyate |  tasya
vaiyarthyamityAshaN^kya \" ye.asmin viShaye.anye.api mohahetavaH te dhIreNa
svayaM nirAkAryA\" ityevaM arthatvAt \" na vaiyarthyam\" ityAshayavAn
tatpradarshanArthaM uttaraM prakaraNaM Arabhate |  \" tatrexaNena kathaM 
dehAtiriktA.atmasiddhiH\?  IxitA hi tena siddhyati |  sa cha sharIraprANajATharAnalendriyamanoviShayasannidhAvIxaNadarshanAt, teShu
anyatamaH kiM na syAd\?\" ityataH sharIrasya tAvadIxaNaM niShedhati \dash
\" nahi\" iti |  atrApi \" kaumArAdi\" ityatantram |  \" sharIrasyAnubhavo 
na sambhavati\" iti pratij~nA |  \" jaDasya\", \" sharIrasya\" iti hetudvayam |
\" mR^itasya adarshanAd\" iti dR^iShTAntoktiH |  \" jaDatvaM cha bhautikatvaM
vivaxitam\" iti na sAdhyAvishiShTatA |

aprayojakatvAbhiprAyeNa shaN^kate \dash \" mR^itasya\" iti |  \" jIvachCharIra\-
mR^itasharIrayorbhautikatve sharIratve cha samAne.api mA bhUt mR^itasharIrasyexaNam |
prANAdiivAyUnAM jATharAnalasyendriyANAM chApagamAt |  jIvatastu prANAdisannidhAnAd
bhaviShyati |  ko virodhaH\?  mA hi bhUdekadharmopapannAnAM avAntarakAraNavaichitryAt
vaichitryAbhAvaH |  na kevalamidamAshaN^kyate, kintu \" ahaM manuShyaH\"
ityAdyanubhavAdetad dehasya IxitR^itvaM \" siddham\" pramitaM cha\", ityarthaH |  
dUShayati \dash \" na\" iti |  na prANAdisannidhAnaM sharIrasyexitR^itve prayojakaM 
vAchyam |  suptimUrchChayoH sharIre prANAdyapagamalaxaNavisheSharahite 
satyeva j~nAnAdInAM dharmANAM adarshanAt |  j~nAnagrahaNaM upalaxaNam |  
\" sukhaduHkhechChAdveShaprayatnairapyAtmA sAdhyA\", iti sUchayituM \" Adi\"
padam |  \" mR^itAdau j~nAnAdyabhAvashcha tatkAryAdarshanAt siddha\" iti
darshayituM \" j~nAnAdivisheSha\" ityuktam |  \" j~nAnAdInAM visheShaH
kAryam\" iti |  etena saN^ghAtachaitanyapaxaH, prANAdichaitanyapaxashcha
parAkR^ito veditavyaH |

%%% ##endlabel##

%%% ##label=<segment008_pd02>##

{\Largedvng pra\.dI\. ||} manasa IxitR^itvamatideshena nirAchaShTe \dash \" samashcha\"
iti |  manoviShaya IxitR^itvAbhimAnashcha pUrveNa samaH |  suptyAdau satyapi
manasi j~nAnAdarshanAt |  \" evaM tarhi AtmA.api j~nAtA na syAd\?\" iti chenna |
tadA tasya manasA sannikarShAbhAvAt |  \" manaso.api tathA.astu\" iti chet,
siddhastAvadAtmA |  manaso j~nAtR^itve doShAntaramAha \dash \" kAShThAdi\" iti |
mano na j~nAtR^i, j~nAnakaraNatvAt |  yadyasyAM kriyAyAM karaNaM na tattatra kartR^i, 
yathA pAke kAShThAni | ChidAyAM kuThAro vA |  na chAsiddho hetuH |  \" manasA 
jAnAmi\" iti anubhavAt | etenAtmasannikarSheNa \" mano j~nAtR^i\" iti 
nirastam |  \" nanu \" janyaj~nAnaM manoniShTham\" iti siddhAntaH |  tat 
kathametat\?\" maivam \dash manoniShThasyApi j~nAnasya na manaH kartR^i, 
kintvAtmaiva |  yathA.avayavavikledalaxaNasya pAkasya na taNDulAH 
kartAraH, kintu devadatta \dash iti |

etenendriyachaitanyapaxo.api nirastaH |  \" chaxuShA pashyAmi\" ityAdau 
\" teShAmapi karaNatvapratiteH\" iti |  \" atItAdij~nAnadarshanAd 
viShayachaitanyapaxaH sphuTadUShaNa\" iti na nirAkR^itaH |  evaM parisheShapramANena 
dehAtirikta AtmA siddhaH |

\" tasya svabhAvAdevAhArAdyabhilAShopapatteH pratyabhij~nAnaM asiddham\" iti 
vadantaM prati Atmanityatve pramANAntaraM chAha \dash \" shruteshcha\" iti |
%%% ##endlabel##

%%% ##label=<segment009_pd02>##

{\Largedvng pra\.dI\. ||} \" asmAchCharIrabhedAdUrdhvaM utkramyAmuShmin svarge loke\" 
(ai\.A\. 2\.5) ityAdishruteshcha dehAtirikto nitya AtmA siddhaH |  
ata eva \" na svabhAvavAdAvakAsha\" iti | 

nanu, bauddhachArvAkAdIn prati dehAtiriktanityAtmasAdhanaM idam \dash na cha 
te shruteH prAmANyaM aN^gIkurvate |  tatkathaM shrutyudAharaNam\?  ityata Aha 
\dash \" prAmANyaM cha\" iti |  bauddhena tAvat pratyaxAnumAnayoH, chArvAkeNa 
cha pratyaxasya prAmANyaM aN^gIkR^itam |  \" tat kutaH\?\" iti vaktavyam |
\" bodhakatvena\" iti chet\? tarhi tadvat shruterapyaN^gIkriyatAm |

\" nanu vAkyatve same.api keShAJNchid bauddhAdivAkyAnAM aprAmANyadarshanAt, 
shruterapi tadAshaN^kyata\" ityata Aha \dash \" na cha\" iti |  \" buddhasyedam\", 
bauddham |  \" chArvAko bauddhamudAharati |  bauddhastvanyad\" iti draShTavyam |
\" aprAmANyaM shruteH shaN^kanIyam\" iti sheShaH |  \" tathA sati, indriyaliN^gayorapi 
kvachidaprAmANyadarshanAt sampratipannayorapi pratyaxAnumAnayoH tachChaN^kAprasaN^gAd\"
iti bhAvaH |  \" prasaktApi shaN^kA tatra nirdoShatvenApanIyata\" iti chet\? \" samaM
prakR^ite.api\" ityAha \dash \" apauruSheyatvAd\", iti |  \" apauruSheyatve.api 
doShitvaM kiM na syAd\?\" ityata Aha \dash \" na hi\", iti |  
sAmAnyoktitvAt \" apauruSheye\" iti napuMsakoktiH | anyathA shruteH 
prakR^itatvAt strIliN^gaM syAt\? 

shabde hyabodhakatvAdayo doShAH |  te cha vaktR^ipuruShAshritAj~nAnAdimUlAH | 
\" yasya tu vaktA puruSha eva nAsti, tatra kathaM vaktR^ipuruShAshrita aj~nAnAdayo 
doShamUlatvena kalpayituM shakyAH, vyAhateH\" iti | atrAj~nAnAdInAM
pauruSheyatvoktirupachArAt |  \" puruSha\" shabdAt tatkR^itavAkyAdiShveva |
DhaJNaH smaraNAt | 

\" nanu shruterapauruSheyatvameva nAsti, vAkyatvAt, laukikavAkyavat\", iti 
chet, kimevaM vadataH \" kimapi vAkyaM apauruSheyaM nAsti\" iti matam, 
uta \" kiJNchidasti\" iti | 

Adye, doShamAha \dash \" vinA cha\" iti |
%%% ##endlabel##

%%% ##label=<segment010_pd02>##

{\Largedvng pra\.dI\. ||} kasyachidvAkyasya apauruSheyatvAbhAve dharmAdharmayoranishchayaH 
prasajyeta\?  nishchAyakAbhAvAt |  na cha \" tathA.astu\" iti vaktuM shakyam |
\" tatsadbhAvasya sarvaiH samayibhirnishchitatvAd\" iti | 

\" nanu pratyaxaikapramANavAdI yaH chArvAko dharmAdharmau nAN^gIkurute tasya nedaM 
aniShTam\" |  

\" kimapyapauruSheyavAkyamanaN^gIkR^itya vedApauruSheyatvaM pratyAchaxANAn
sarvAn prati chAyaM prasaN^ga ityatastenApi dharmAdikaM aN^gIkAryairnaM prasaN^gaM 
vaxyAma\", iti Ashayena Aha \dash \" yashcha\" iti |
%%% ##endlabel##

%%% ##label=<segment011_pd02>##

{\Largedvng pra\.dI\. ||} \" tau\", dharmAdharmau |  \" iti prasajyeta\", iti sheShaH | 
\" dharmAdyanaN^gIkAre kutastachChAstrasya ashAstratvaprasaN^go yena asau shAstrI 
na syAd\?\", ityata Aha \dash \" aprayojakatvAt\", iti |  prayujyate 
pravartyate praNetA shrotA cha shAstre yAbhyAM te preyojake, viShayaprayojane |
avidyamAne prayojake yasya shAstrasya tat tathA |  ananyalabhyaM kamapi 
puruShArthaM adhikR^itya tatsAdhanaM tathAvidhamarthaM pratipAdayan vAkyasamUho hi 
shAstram |  anyathA.atiprasaN^gAt |  nachAtIndriyasya abhAve.anyattathAbhUtaM 
shakyanirUpaNam |  \" ataH shAstratvasiddhaye viShayAditvena dharmAdikaM 
kimapyaN^gIkAryam\" iti bhAvaH | 

shaN^kate \dash  \" mA.astu\" iti |
%%% ##endlabel##

%%% ##label=<segment012_pd02>##

{\Largedvng pra\.dI\. ||} \" mA\" ayaM, na \" mAN^\" |  \" astu\" iti avyayaM vA | 
\" dharma\" ityupalaxaNam |  \" anirUpyatvAt\", pramANAbhAvena pratipAdayituM
ashakyatvAt | 

idamuktaM bhavati \dash \" viShayaprayojane hi te bhavata ye pramANena pratipAdayituM 
shakyete |  vAN^mAtrasya shrotR^ibhiranAdaraNAt |  na cha dharmAdikaM pramANena 
pratipAdayituM shakyam, pratyaxAgocharatvAt, anumAnAdeshcha prAmANyAbhAvAt | 
ato na shAstraviShayatvAdinA dharmAdikaM aN^gIkartuM uchitam |  nachaitAvatA 
nirviShayatvAdi ApattiH |  yato dharmAdyabhAvo viShayo bhaviShyati |  
prayojanaM cha shrotR^INAM dharmAdyanuShThAnaprasaktakleshanivR^ittiH |  dharmAdisadbhAva
bhramoparuddhaviShayasukhAvAptishcha |  praNetushcha lokopakAraH |  upakartAraM
cha pratyupakurvanti lokA\", iti nirAkaroti \dash \" na\" iti |  evaM vadatA, 
dharmAdyabhAvo.api na shAstraviShayatvena shakyate vaktum | sarvAbhimatasya 
dharmAdeH pramANaM vinA vAN^mAtreNa niSheddhuM \" nAsti\" iti pratipAdayituM
ashakyatvAt |  \" ghaTAdyabhAva iva pratyaxeNaiva dharmAdyabhAvo nishcheShyata\" iti 
chet\?  syAdevaM yadyatra na kAchit vipratipattiH |  yatra tvastivAbhimAnaH, 
tatra pishAchAdAviva pratyaxAnupalambhaH sandehahetureva bhavati\footnote{\normaldvng \" asmin vaTe pishAcho.asti\" iti vArtAM shrutavato vaTasamIpaM gatasya, tatra \ pishAchAnupalabdhau satyAM nirNAyakAbhAve saMshayo bhavati |  \" kiM vidyamAna eva \ pishAcho.antardhAnashaktyA nopalabhyate, kiM vA avidyamAna eva\?\" iti | \ \dash shrITIkAkR^itpAdakR^itA pramANapaddhatiH |} iti |  
tadidamuktaM \" sarvAbhimatasya\" iti |  

punashshaN^kate \dash \" na cha\" iti |  \" mA bhUddharmAdyabhAvasya viShayatvam, 
tatsAdhakapramANAbhAvAt |  tathA.api dharmAderviShayatvAdikaM na ghaTate | 
aprAmANikasya pramityanupapattyA sAdhayitumashakyatvAd\" iti | 

nirAkaroti \dash \" na\" iti |  \" asti tAvaddharmAdiviShaye sarveShAM
AvipAlagopAlamastitvAbhimAnaH |  abhimAno j~nAnameva |  na cha tasya 
bAdhakaM kiJNchit |  dharmAdyabhAvapratipAdakapramANAbhAvasyoktatvAt |  ataH 
sarvAbhimatereva dharmAdau pramAtvAt, tatkaraNasya cha pramANatvAdasiddhaM
aprAmANikatvam\" iti bhAvaH |  \" kiM tat pramANam\?\", iti chet\?
dharmAdeH prAmANikatvasiddhau kimanaya vyarthachintayA |  na cha tatra 
pramANavisheSho ashakyanirUpaNaH |  Agamasya tatsahakAriNo.anumAnasya 
cha sattvAt |  ata eva na andhaparamparA.api | 

\" AgamAdeH prAmANyaM nAsti, ityuktam\" ityata Aha \dash \" anyathA\" iti |
%%% ##endlabel##

%%% ##label=<segment013_pd02>##

{\Largedvng pra\.dI\. ||} \" yadi Agamasya anumAnasya cha na prAMANyaM syAt, tadA sarvasya 
vAchA nirvartyasya vyavahArasya asiddhiH syAt\?  parapratyayanArtho hi vAgvyavahAraH |  
sa yadi na paraM pratyAyayet vyartho na kriyetaiva\" iti |  \" cha\" shabdaH
pramANasAmAnyasiddhyA tadvisheShasiddheH samuchchaye | 

\" bhavatu AgamAprAmANye vAchanikavyavahArAsiddhiH | anumAnAprAmANye tu katham\?\"
ityata Aha \dash \" na cha\" iti |  \" tvadIya vAkyaM mayA shrUyata\" iti j~nAtvA 
mAM prati tvayA vAgvyavahAraH kriyate, anyathA vA\?  dvitIye, niShphalo na 
kartavyaH syAt\?  nA.adyaH \dash \" parachittavR^ittInAM parasyApratyaxatvena \" mayA 
shrutam\" iti tava j~nAtumashakyatvAt, madIyaM pratyuttarameva tajj~nAnopAya 
ityevaM vaktavyam\" iti bhAvaH |  \" astvevam\" ityata Aha \dash 
\" anyathA vA\" iti |  \" vA\" shabdo.avadhAraNe |  \" pratyuttaraM hi liN^gatayA 
j~nApakam |  na cha tava mate anumAnaM pramANam |  ataH pratyuttaraM 
anyathaivAj~nApakameva syAd\?\" iti | 

\" nanu shabdaliN^gayoH prAmANyameva nAN^gIkriyate |   j~nApakatvamAtraM tu
aN^gIkriyata eva | ataH kathaM vAchikavyavahArAsiddhiH\?\" ityata Aha \dash 
\" bhrAntirvA\" iti |  j~nApakatvaM aN^gIkR^itya prAmANyAnaN^gIkAre shabdaliN^gAbhyAM 
jAyamAnaH pratyayastava mate bhrAntirvA syAt saMshayo vA\?  gatyantarAbhAvAt | 
na cha parasya bhrAntyAdyarthaM vachanaprayogaH |  nApi \" pratyuttareNa bhrAntaH sandigdho 
vA vAkyaM prayuN^kta\" iti yuktam |  ato \" vAchikavyavahArasiddhyarthaM 
AgamAnumAnaprAmANyamaN^gIkAryam\" iti | 

evaM chArvAkashAstrasya viShayaM nirAkR^itya prayojanamapi nirAkurvan 
shrotR^iprayojanaM tAvannirAchaShTe \dash  \" sarva\" iti |
%%% ##endlabel##

%%% ##label=<segment014_pd02>##

{\Largedvng pra\.dI\. ||} yathA shAstrasya sarveShAM shrotR^INAM sukhakAraNatvaM, tathA 
dharmAdyabhAvaj~nAne sarvamaryAdA.atikrame parasparahiMsAdinA sarvaduHkhakAraNatvaM 
cha syAt\?  tathA cha samavyayaphalaM niShprayojanameva\footnote{\normaldvng \" asatyAni durantAni samavyayaphalAni cha | \ ashakyAni cha vastUni nArabheta vichaxaNaH\"  ||} \dash iti |  idAnIM
shAstrapraNetR^iprayojanaM nirAkaroti \dash \" eko vA\" iti |  dharmAdij~nAnashUnyAH 
pashuprAyA nopakAriNamupakurvanti |  api tu sarve.apyakartumalam |  \" tadabhAve.api 
eko vA.anyathA apakArakaH syAd\?\", ityarthaH |  \" tadevaM dharmAdyanaN^gIkAre
shAstrasya viShayAdyabhAvenAshAstratvaprasaN^gAt sarvaiH dharmAdikamaN^gIkAryam\" iti | 

\" nanu svIkR^itaM dharmAdikam |  pauruSheyavAkyAt tannishchayaH syAd\?\" ityata 
Aha \dash  \" rachitatve cha\" iti |
%%% ##endlabel##

%%% ##label=<segment015_pd02>##

{\Largedvng pra\.dI\. ||}  \" tatashcha na dharmAdinishchaya\" iti bhAvaH | \" nirdoShatvena 
pramito.asau\" iti chet\?  tasya nirdoShatvaM kiM tadvAkyAt siddhaM, 
pramANAntareNa vA\?  na dvitIyaH |  tadabhAvAt |  AdyaM dUShayati 
\dash \" na cha\", iti |  \" atiprasaN^gAd\" iti bhAvaH | 

na cha pratyaxAdinA dharmAdisiddhiH |  ataH sarvaiH kimapyapauruSheyaM vAkyaM
aN^gIkAryam | aN^gIkR^itaM cha bauddhAdibhiH svasamayApauruSheyatvam, 
\" shauddhodaniprabhR^itayassampradAyapravartakAH\" ityuktatvAt |  \" tataH kim\?\" 
iti chet\?  \" vAkyatvahetoH tatrAnaikAntyam\" iti | 

\" astvevamanumAnasya anyatarAnaikAntyAt shruterapauruSheyatve bAdhakAbhAvaH | 
sAdhakaM tu kim\?\" iti chet\?  \" karturaprasiddhirapauruSheyatvaprasiddhishcha\"
iti brUmaH | 

\" evaM tarhi gUDhakartR^ikasya kR^itApauruSheyatvaprasiddhikasyApi
apauruSheyatvaprasaN^ga\" ityata Aha \dash \" na cha\" iti |
%%% ##endlabel##

%%% ##label=<segment016_pd02>##

{\Largedvng pra\.dI\. ||}  \" kenachit kR^itam\" iti sheShaH |  \" uktavAkyasamam\",
\" vedavad apauruSheyam\" ityarthaH |  \" anAdikAle\" yaH \" parigrahaH\" 
\" prAktanaM evaitad\" iti j~nAnaM tena viShayIkR^itatvAt shruteH |  \" itarasya 
tadabhAvAdapauruSheyatvaprasiddhireva tatra bhagna\" iti bhAvaH |  
apauruSheyatvasiddhau siddhamarthaM upasaMharati \dash \" ata\", iti |

evaM cha chaturthapAdopayuktaM prameyamuktvA tamidAnIM niveshayati \dash 
\" ata\" iti |
%%% ##endlabel##

%%% ##label=<segment017_pd02>##

{\Largedvng pra\.dI\. ||} yata evaM nairAtmyavAdibhirutprexitAH kutarkA atastaiH
\" kutarkaiH\" \" dhIraH\" dhImAn \" tatra\" dehAtiriktanityAtmasadbhAvaviShaye 
na mohamApadyate |  \" narake niyataM vAsaH\" (1\.44) ityAdyarjunavachanena 
tasya nityAtmapratipattisiddheH muhyatIti prathamapuruShaprayogaH  || 13|| 
%%% ##endlabel##

%%% ##label=<segment018_pd02>##

{\Largedvng pra\.dI\. ||}  \" anekArthA gItA\" iti darshayituM shlokadvayaM prakArAntareNa
vyAchaShTe \dash \" atha vA\", iti |  \" na jIvanAshamapexya shokaH kArya\" 
iti sheShaH |  nityatvAt jIvasya |  \" anena yojanA pUrvavadeva\" iti 
j~nApayati || 12|| 

\" nApi\" ityatrApi pUrvavat sheShaH |  atra pUrvayojanA na saN^gachChate | 
ato.anyathA pAdatrayaM vyAkhyAti \dash \" yathA\", iti |  jarAdiprAptau 
dehAntaraprAptAviti nimittasaptamyau | 

tatashchAyamarthaH \dash \" kaumArAdyavasthAvishiShTadehahAne tAvat nAsti shoka 
iti prasiddham | \" tat kasya hetoH\?\" iti vAchyam |  jarAdivishiShTa
dehAntaralAbhAt |  \" samAnalAbhena hAnirhi samAdhIyata\" iti chet\? tarhi 
maraNe.api shoko na kAryaH, dehAntaralAbhAdeva |  yadA tu jIrNalAbhena 
samIchInahAneH pratividhAnaM, tadA sutarAM samIchInalAbhena jIrNahAneH\" iti |
tatrAvasthAmAtrahAniH, atratu avasthAvato.apItyetadanupayuktaM vaiShamyam | 
\" niShkapradAnena paTagrahaNadarshanAd\" iti bhAvenoktaM \" dhIraH\" iti || 13|| 
%%% ##endlabel##

%%% ##label=<segment019_pd02>##

{\Largedvng pra\.dI\. ||} prakArAntareNa shokaM shaN^kate \dash \" tathA.api\" iti |  \" yadyapi
\" bAndhavAdInAM hAnirbhaviShyati\" iti dhiyA na shoko yuktaH, uktavidhayA
AtmahAnerabhAvAt, dehahAnAvapi pratinidhilAbhAt |  tathA.api, \" tanmaraNe 
mamaiva sukhahAnirduHkhAvAptishcha bhaviShyati\" iti dhiyA me shokaH samutpatitaH |
katham\?  taddarshanAbhAvAdinA\" |  \" tat\" iti bAndhavAdidehAdiparAmarshaH |
\" Adi\" padena vikR^itataddarshanaM cha gR^ihyate |  \" premAspadAnAM hi
darshanasparshanAlApAdikaM sukhahetuH |  teShu mR^iteShu taddarshanAdyabhAvAt
sukhahAniH |  tathA teShAM ChedabhedAdidarshanena duHkhAvAptishcha\" iti |
etanniShedhapUrvakaM shlokamavatArayati \dash \" na\" iti |  \" mIyante viShayA
ebhiriti mAtrA indriyANi (shaM\.bhA\. 2\.14) iti vyAkhyAnamasat, 
purANAdau \" mAtrA\" shabdasya viShaye rUDhatvAd\" ityAshayavAn vyAchaShTe,
\" mIyanta\" iti |

\" nanu gandharasarUpasparshashabdA viShayAH |  ato bhinnapadatve dvandvatve vA
sparshAnAM viShayAntargatAnAM punaruktirvyarthA\", ityata Aha \dash \" teShAm\" iti |
\" viShayANAm\" |  \" tathA.apyanupapattiH, viShayANAM sparshAbhAvAd\", ityata Aha 
\dash \" sambandhA\" iti |  \" evaM tarhi kiM ShaShThIsamAsaparigraheNa\?  bhinnapadatvAdAvapi
doShAbhAvAd\" ityato vAkyaM yojayati \dash \" ta eva\" iti |  \" tu\" shabdasyArtha
\" eva\" iti |  \" na hi viShayANAM sambandhAnAM cha pR^ithagetatkAryaM sambhavati\" 
iti bhAvaH |

\" nanu shItoShNashabdau viShayavisheShavachanau |  tat kathaM viShayasambandhA
viShayavisheShaM dadyuH\?  kathaM cha sAxAt sukhaduHkhe\?  kashcha pratisambandhI\?
kasmai dadati\?\" ityata Aha \dash \" deha\" iti |  \" deha\" shabdenAtra
indriyANi laxyante |  anena shItoShNashabdau sakalaviShayopalaxakau |  
\" viShayoktyA cha tatsAxAtkAro laxyata\" iti laxitalaxaNA iyam |  
\" anubhavadvAraiva sukhaduHkhadAnam |  pratisambandhI dehaH |  dAnaM chAtmana\" ityuktaM 
bhavati |   etena laukikI pratItirarjunena shaN^kitA.anUdyate |  \" tattadviShayANAM 
taistairindriyairye ye sannikarShAH taistaiH  tattadviShayasAxAtkAro bhavati |  
tatreShTaviShayasAxAtkArAt sukhaM bhavati |  aniShTaviShayasAxAtkArAt duHkhaM 
bhavati\" iti |

\" bhavedetadevaM, tataH kiM prakR^itashaN^kAyA\?\" ityataH \" tu\" shabdAt parayA 
kAkvA siddhamarthamAha \dash \" ha hi\" iti |  \" svataH\" viShayendriya 
sannikarShamAtreNa |  \" duHkhAdiH\" iti viShayasAxAtkAraH, \" sukhaduHkhe\" cha |

\" anena \" mAtrAsparshA\" eva kevalAH kiM shItoShNasukhaduHkhadAH\?  na hi |
kiM nAma abhimAnasahitA\?\" ityuktaM bhavati |  abhimAno nAmAtra 
viShayeShu shobhanAdhyAsanimitta snehaH, aritvAdibhramanimitto dveShashcha, 
sharIrendriyAntaHkaraNeShu mamatA.atishayahetuko.aviveka ityAdiH |  

\" viShayendriyasannikarShA eva j~nAnasya sukhaduHkhayooshcha kAraNaM kuto na syuH\?  
yenAbhimAno.apyadhikaH kAraNasAmagryAM niveshyata\?\" iti shaN^kApUrvakaM
uttarapAdaM vyAchaShTe \dash \" kuta\?\" iti |  \" nanu kathamidaM labhyate\?\" \" yata 
ityadhyAhArAd\" iti brUmaH |  prayojanAntarAbhAvAt, hetvarthagarbhatvena 
vA |  \" savisheShaNe hi vidhiniShedhau visheShaNamupasaN^krAmataH\" iti 
nyAyAt, shItoShNasukhaduHkhadatvavishiShTAnAM mAtrAsparshAnAM idaM visheShaNaM
bhavat, shItoShNasukhaduHkhadatvamupasaN^krAmati |  \" mAtrAsparshAnAM shItoShNa
sukhaduHkhadatvaM yat tasyAgamApAyitvAd\" ityarthaH |  \" anena kathamuktashaN^kAnirAsa\?\"
ityato.atiprasaN^gamukhena vyAchaShTe \dash \" yadi\" iti |  \" mAtrAsparshA yadi 
\" svataH\", svayamevAbhimAnamanapexya, \" AtmanaH\" \" shItoShNasukhaduHkhadAH\" 
\" syuH\", tarhi \" suptAvapi syuH\" |  na hi kAraNasAmagrI kAryaM vyabhicharati\?\" 
ityarthaH |  na cha vAchyam, \" suptau viShayendriyasambandhA eva na santi\" iti, 
sparshatvagindriyasambandhasyAvarjanIyatvAt |  ata eva shItoShNagrahaNaM kR^itam |  
etena indriyamanassannikarShAbhAvo.api pratyuktaH |  na chAtmamanassannikarShAbhAvaH |
manasaH kadApyAtmaviyogAbhAvasya vaxyamANatvAt |

atiprasaN^gasya viparyaye paryavasAnaM vadan sAxAdarthaM darshayati \dash \" ata\" 
iti |  \" ato \" matrAsparshA\", nAtmanaH \" svataH\" svayameva kevalAH
shItoShNasukhaduHkhadA bhavanti\" iti sambandhaH |  \" ata\" ityuktasyaiva
vivaraNaM, \" yataH\", \" tannimittA eva\" iti |  \" tad\" ityabhimAnaparAmarshaH |
\" tena nimittena sahitA eva shItoShNasukhaduHkhadA yata\" ityarthaH |  \" tatkuta\?\"
ityata uktam, \" mAtrA\" iti |  \" mAtrAsparshA, jAgratsvapnayorabhimAnavatoreva 
te tathAvidhA \" shItoShNasukhaduHkhadAH\" \" santi\", bhavanti |  nAnyadA
abhimAnarahite suptyAdAviti mAtrAsparshAnAM shItoShNasukhaduHkhadatvasyAbhimAna
anvayavyatirekAnuvidhAyitvAd\", ityarthaH |

\" nanvabhimAnahIne.api j~nAnotpattiH tR^iNAdau dR^ishyate\" |  satyam |
\" sukhaduHkhahetubhUtaM j~nAnamatrAdhikR^itamityadoSha\", iti |

%%% ##endlabel##

%%% ##label=<segment020_pd02>##

{\Largedvng pra\.dI\. ||} \" itashchAbhimAna evAtmana upaplava\", ityAha \dash \" Atmanashcha\" 
iti |  atra \" taiH\" iti j~nAnasukhaduHkhaparAmarshaH |  \" Atmano 
j~nAnAdibhiH sambandho nAsti, teShAM manovR^ittitvAt |  tathAchAnyagatadharmAH
kathamanyasya vikriyAhetavo, vinA.abhimAnAt\?  prasiddhaM cha \" svAbhimatagR^ihadAho
devadattaM duHkhIkaroti\", iti |  j~nAnAdibhirAtmanaH sambandhAbhAve kathamuktaM
\" shItoShNAdyanubhava Atmana\" ityAdi\?\" ityata uktam \dash \" viShaya\" iti |
manovR^ittirUpANi j~nAnAdIni viShayabhUtAni |  AtmA cha viShayI |  sAxichaitanyasya
tadviShayatvAt |  etameva sambandhamabhipretya \" Atmano j~nAnam\" ityAdivyavahAraH |
upalaxaNaM chaitat |  IshvarAdhinaM, svAmitvamapi grAhyam |  tAdAtmyasamavAyanirAse
tAtparyAt |

\" nanvabhimAnasahitAnAmeva mAtrAsparshAnAM j~nAnAdihetutvaM, na kevalAnAm,
ityupapAditametat |  tato \" anityA\" iti vyartham\" iti chenna |  
AgamApAyitvasyaiva anena vyAkhyAnAt |  \" vyAkhyAne.api kiM 
prayojanam\?\" ityata Aha \dash \" na cha\" iti |
%%% ##endlabel##

%%% ##label=<segment021_pd02>##

{\Largedvng pra\.dI\. ||} \" AgamApAyi\" shabdo dvayoH prayujyate |  yat pravAharUpeNa nityaM,
vyaktirUpeNAnityaM, yathA gaN^godakam |  tadekaM \" AgamApAyi\" ityuchyate |
\" yasya tu pravAho.api vichChidyate, yathA kiMshukakusumAnAM, tadaparam\", iti |
tatra \" AgamApAyi\" shabdAdubhayapratItau \" AgamApAyitve.api\" \" AgamApAyi\"
shabdArthatve.api yat pravAharUpeNa nityatvaM tadatra vivaxitaM nAsti, na bhavati |
mAtrAsparshAnAM shItoShNasukhaduHkhadatve tadasambhavAt |  prakR^itAnupayogAchcha |
kintu dvitIyameva |  \" suptyAdAvabhAvena sambhavAduktarItyA prakR^itopayogAd
ityetadanityA ityanenAha bhagavAn\", ityarthaH |  \" praLayo\" mUrchChA |
\" Adi\" padena asampraj~nAtasamAdhergrahaNam |  

\" nanvanityapadamapyanekArthameva\" |  satyam |  tathA.api punaH 
prayatnAdyAlochanAdetatsiddhiH |  etadapi visheShaNopasaN^krAntaM visheShaNam |  
\" AgAmivyAkhyAnamapexya bhAShyakR^itA ayamarthaH prAgupanyasta\" iti 
j~neyam |  uktamarthaM piNDIkR^ityopasaMharati \dash \" ata\" iti |
%%% ##endlabel##

%%% ##label=<segment022_pd02>##

{\Largedvng pra\.dI\. ||} uktaprakAreNa dehAdAvAtmano \" mamaivaitad\" ityAdibhrama eva |  
bhramasahitA eva \" mAtrAsparshA\" ityarthaH |  \" tataH kim\" ityataH
chaturthapAdaM vyAkhyAtumupodghAtamAha \dash \" ata\" iti |  \" tadvimuktasya\",
bhramavimuktasya |  \" bandhumaraNAdiduHkham\" yat prAk shaN^kitam |  \" na 
hi sAmagrIkAryamekadeshena bhavati\" iti bhAvaH |  \" tataH kim\?\" ityataH 
chaturthapAdaM vyAkhyAti \dash \" ata\" iti |  \" titixasva\", \" viphalIkuru\" 
iti bhAvaH |

\" nanu \" tAn\" iti mAtrAsparshAnAM parAmarsho yuktaH |  tat kathaM \" shItoShNAdIn\"
ityuktam\?\"  maivam |  shItoShNAdihetUnAM mAtrAsparshAnAmeva \" tach\" Chabdena
upalaxaNAt  || 14||
%%% ##endlabel##

%%% ##label=<segment023_pd02>##

{\Largedvng pra\.dI\. ||} ato mAtrAsparshAnAM viphalIkaraNataH bhavatprayojanamAha \dash 
\" ata\" iti |  \" duHkhAbhAvasya yuddhAkaraNenaiva sambhavAt, kiM tat kR^itvA
prasaktaduHkhAbhAvAyAbhimAnatyAgena\?  ityetadAshaN^kAparihArAya\", iti sheShaH |

pUrvashloke \" titixasva\" iti padaM \" sahasva\" (shaM\.bhA\. 2\.14) iti kaishchit 
vyAkhyAtam |  tadasat |  \" tadanuvAde.atra viphalIkaraNasyaiva pratIteH\"
iti bhAvenAdyapAdaM vyAkhyAti, \" yam\" iti |  \" na vyathayanti\", na 
chAlayanti |  \" na shItoShNasukhaduHkhalaxaNavaiShamyavantaM kurvanti\" ityarthaH |

\" strINAmapyevaMvidhAnAM maitreyIpramukhAnAmamR^itatvashravaNAt, \" puruSham\"
iti visheShaNamayuktam\" ityato.anyathA vyAchaShTe \dash \" puri\" iti |
sharIrasambandhinameva santam |  \" sharIradarshanavantam\" ityarthaH |
\" etadapi kimarthaM visheShaNam\?\" ityata Aha \dash \" sharIra\" iti |  suptyAdau
\" sarveShAM prAkR^itAnAmapyabhimAnAbhAvena vyathAbhAvAdamR^itatvaprasaktiH
ityAshaN^kAnivR^ittyartham\", ityarthaH |

\" nanu yasya dehAdAvabhimAno nAsti tasya duHkhaM sukhaM cha nAsti, ityuktam |  
tasya kathaM \" samaduHkhasukham\" \" dhIram\" iti visheShaNadvayam\? asya 
pUrvakaxyAgatatvAd\" ityAshaN^kya tadupAyapradarshanArthaM \" pUrvAvasthAnuvAdo.ayam\"
iti krameNa pR^ichChApUrvakamAshayamAha \dash \" katham\" iti |  yenAbhimAnatyAgena
\" mAtrAsparshA\" \" na vyathayanti\", sa \" katham\" |  \" kenopAyena
bhavati\?\" ityarthaH |  duHkhaM yathA.anupAdeyamapuruShArthatvAt, tathA vaiShayikaM
sukhamapyamR^itatvavirodhitvAdanupAdeyaM yasya, sa \" samaduHkhasukhaH\" |  evaM
bhAve cha kathaM sukhahetuShu shobhanAdhyAsalaxaNaH tadvirodhiShu dveShalaxaNo.abhimAnaH
syAd\?\", iti bhAvaH |  tat samaduHkhasukhatvameva |  \" katham\",
\" kenopAyena bhavati\?\" ityarthaH |  \" dhairyeNa\" iti \" sukhe duHkhe cha prApte
sati tatkAryayorutsekaviShAdayoH stambhakena prayatnena\", ityarthaH  || 15||
%%% ##endlabel##

%%% ##label=<segment024_pd02>##

{\Largedvng pra\.dI\. ||} \" natvevAham\" ityatra bhagavAn kR^iShNo.api yaM pratipaxe nixiptaH,
sa AxeptuM prasaktiM darshayati \dash \" nitya\" iti |  uktamanAditvena hetunA 
anumitam |  \" tataH kim\?\" ityata Aha \dash \" kim\" iti |  \" anAdishcha\" 
ityapi grAhyam |

\" Adye, dR^iShTAntAbhAvena vyAptigrahAsambhavaH, dvitIyastvaprAmANikatvAd
ashakyopanyAsa\" iti pUrvapaxyabhiprAyaH |  \" viditAbhiprAyaH siddhAntI 
kimR^ijAvanvaye sambhavati vakreNa vyatirekeNa\", iti manyamAno dvitIyaM 
paxamupAdatte, \" anyadapi\" iti |  uktAbhiprAyeNa pR^ichChati \dash \" tad\" 
iti |  \" iti shaN^kAyAm\" iti sheShaH |

durgamArthatvAt pUrvArdhaM vyAchaShTe \dash \" asata\" iti |  \" kAraNasya\" prakR^iteH |
\" abhAvaH\" prAgabhAvaH, pradhvaMsashcha |  \" kuta etad\?\" ityato bhAShyakAraH
tAvatpramANamAha \dash \" prakR^itiH\" iti |  \" puruShaH\" paramAtmA \" brahma\"
shabdoktaH |  anAditve.apyevamAgamo j~neyaH |

\" nanu, \" asataH, satashchAbhAvao na vidyata\" ityekenaiva vAkyena dvayorabhAvapratiShedhe
kartuM shakye, kimevaM pR^ithag pratiShedhena\?\" ityata Aha \dash \" pR^ithag\" iti |  
\" vidyata\" iti vAkyadvayagrahaNam |  \" asato.abhAvo na vidyate, satashchAbhAvo 
na vidyata\" iti dvayoH pR^ithagabhAvapratiShedha AdarArtha, iti yojyam |  
AdarashchAnumAnavyAptisadbhAve |  ata evAnekadR^iShTAntapradarshanam |

\" nanu \" sato brahmaNa\" (shaM\.bhA\. 2\.16) ityastu, \" sadeva somya\" (ChA\.u\. 6\.2\.1)
ityAdiprayogAt |  \" asataH kAraNasya\" iti tu katham\?\" ityata Aha \dash
\" asata\" iti |  \" asachChabdArthasya kAraNatvaM cha bhAgavate.abhihitam\" ityarthaH |
\" asataH\", \" asat\" shabdasya |  \" kAraNatvam\" \" kAraNArthatvam\" iti vA |  
\" sadasadrUpayA\", kAryakAraNarUpayA |  \" asataH\" iti shruteranekArthatvAd
atrodAharaNam |  \" kAraNasya\", \" avyakteshcha\", \" asat\" shabdArthatvam |
gatyarthasya sadeH kvibantasya karmaNi hi saditi rUpam, \" asadavyaktarUpatvAt
kAraNaM chApi shabditam\" iti vachanAt |  atrArthe bhagavatA pramANamuchyate \dash
\" ubhayorapi\" iti |

\" tadasat, anyadarshanasya anyAn pratyapratyAyakatvAd\" ityAshaN^kya,
\" darshanamUlakaH sampradAya upadeshaparamparArUpo laxaNayA.atra pramANatvenochyata\"
ityAha \dash \" sampradAyashcha\" iti |  \" cha\" shabdo bhAShyakArodita
pramANasamuchchaye |  \" Agamo granthanibaddhaM vAkyam, sampradAyastu upadesha
paramparAmAtram\" iti bhedaH |  etat prakR^itipuruShayoranAdinityatvam |

kechid \" api\" shabdasya bhinnakramatvamaN^gIkR^itya, tena sUchitaM pramANaM
prAgudAhR^itam, iti varNayanti |

\" nanu anto vinAshAdiH parichChedo.atra tattvadarshibhirdR^iShTa, ityuchyate |  tat kathaM
na virodha\?\" ityata Aha \dash \" anta\" iti |  \" nirNayaH\" anAdinityatva
avadhAraNam |  apavyAkhyAnaM tu anyatra nirAkR^itam  || 16||
%%% ##endlabel##

%%% ##label=<segment025_pd02>##

{\Largedvng pra\.dI\. ||} \" avinAshi tu\" iti shloke sarvagatasya nityatvaM uchyate |  \" tat
prakR^itAnupayuktam\" ityAshaN^kya pUrvArdhaM tAvat prakR^itopayogaM sUchayan vyAchaShTe 
\dash \" kiM bahunA\?\" iti |  \" vAkyAnAmupAsanArthatvAt sampradAyasya cha
mUlAnishchayAt prakR^itibrahmaNoshchasvarUpasyaivAsiddheH jIvAdanyasyAnAdinityasyAbhAvAt,
punaranumAnasya vyAptyasiddhiH\" ityAshaN^kya, \" kiM bahunA prakR^ityAdisvarUpasAdhanena\?
kiM cha \" idaM nityam\" iti bahunA pratyekamuktena\?  \" yaddeshato.anantaM tannityameva\" 
ityekasaN^grAhakasaN^gR^ihItaM vedAdikaM jIvAdanyadapyasti, tad vyAptigrahaNasthaLaM 
bhaviShyati, ityAha bhagavAn\" ityarthaH |

\" veda\" shabdena varNA gR^ihyante |  \" Adi\" padenAkAshAdayaH |  eteShAM cha 
pratyabhij~nA.adinA nityatvasiddhiH |

\" nanu kAlAvayavAH xaNAdayaH sarvagatA api na nityAH\" |  satyam \dash nahi 
atra vyAptiruchyate, kintu bahUktiparihArAyopalaxaNamAtram, iti |

\" tu\" shabdArtha \" eva\" iti |  \" tathA.apyuttarArdhaH punarukta\" ityata Aha \dash 
\" nApi\" iti |  pUrvaM svAbhAviko nAsho niShiddhaH |  \" avinAshi\" iti
tAchChIlikapratyayAt |  atra tu naimittikaH, \" kashchit kartuM nArhati\" iti
vachanAt |

\" prAgAnuktasya vedAderavyayatvasya kathamanuvAda\?\" ityata Aha \dash \" avyayashcha\"
iti |  \" vidhAnamevedaM kaimutyena shApAdinA vinAshasyAbhAvaM sAdhayitum\" iti
bhAvaH  || 17||
%%% ##endlabel##

%%% ##label=<segment026_pd02>##

{\Largedvng pra\.dI\. ||} \" dehAnAmantavattvaM prAguktaM kimarthamuchyata\?\" ityata Aha \dash
\" bhavatu\" iti |  \" AtmanityatvAnumAnasya pratipaxaM vaktuM svAbhipretasya
hetoH siddhAntinA.apyabhyupagatatvaM dR^iDhIkurvatA, pUrvapaxiNA \" dehasyApi 
kasyachit nityatvaM bhavatu kim\" iti pR^iShTe, netyAha\" ityarthaH |  
siddhArthatA parihArAya \" kasyachid\" ityuktam |

\" nanvatiprasaN^go.ayaM kasmAnna bhavati\?\"  \" kasyachid\" iti visheShaNa
vaiyarthyAt |  \" nityasya ityAtmanityatvaM punaH kasmAduchyata\?\" ityata
Aha \dash \" astu\" iti |  \" evaM dehAnityatvaM siddhAntino.api siddhaM kR^itvA,
tarhi pratibimbasya Atmana upAdherdehasya nAshAt nAsho.astu |  darpaNanAshAt
mukhapratibimbasyeveti pUrvapaxiNA pratipaxe.abhihite tatpratiShedhAya idamAha\"
ityarthaH |  anena, \" tathA.api AtmA nityaH\" iti vAkyavR^ittiH sUchitA |  
anuvAde prayojanAbhAvAt |

ye \" dehA\" anityA, na teShAmupAdhitvam |  \" yasya chopAdhitvaM, nAsau
anitya\" iti bhAvaH |  tadidamuktaM \" ime\" iti |  vyaktIkariShyate chaitat |

\" nanu \" sharIriNo\" \" dehAH\" iti vyarthaM, asharIrasya dehAbhAvAd\" ityata
Aha \dash \" sharIriNa\" iti |  \" nityasya dehA antavanta\" ityuchyamAne,
IshvaradehasyApi antavattvaM prasajyate |  tad vyAvR^ittyarthaM \" sharIriNaH\"
iti visheShaNam |  \" jantujanyusharIriNaH\" (amara\. 1\.4\.313) ityabhidhAnAt,
\" sharIra\" shabdasya jIve prasiddheH |  

\" tathA.api \" anAshinaH\" iti punaruktiH\" iti |  atra kechidetat parihArAya
\" vinAshinaH\" iti pAThAntaraM kurvanti (rA\.bhA\. 2\.18) |  tadasat |  \" antavanta\"
ityanena punaruktitAdavasthyAt |  kathaJNchit samAdhAne.api anyatrApi tat samam |
\" kimanyathApAThena ityAshayavAnAha\" \dash \" na cha\" iti |  upAdhinAshena
nAshAbhAve.api upAdhibimbasannidhinAshAnnimittAt pratibimbasyAtmano nAsho 
bhaviShyati |  na chAsiddhiH shaN^kyA |  \" parichChinnasyaiva pratibimbasambhavena sannidhi
nAshadhrauvyAd, iti punaH pratipaxite tatpratiShedhAyedam\" iti bhAvaH |

\" aprameyasya\" ityasambhavi visheShaNam, vyarthaM cha\" ityataH tannivartyAM
AshaN^kAM darshayitvA vyAchaShTe \dash \" kuta\" iti |  \" na hi pratipaxo vAN^mAtreNa
niSheddhuM shakyata\" iti bhAvaH |  \" aprameya\" ityanena pratipaxahetorasiddhimAchaShTe |
\" nAyamAtmA ghaTAdeH kasyachit pratibimbaH, kintu Ishvarasya |  sa chAprameyaH
sarvagata iti kathaM tasyopAdhisannidhinAsha\?\" iti |

\" nanu kathamidaM labhyate\?  \" atadbhAve sAmAnAdhikaraNyaM sArUpyaM gamayati\"
iti prasiddhameva |  na cha sarvagatasya pratibimbAsambhavaH |  tadadhInasArUpyasya
pratibimbatvAt\" |  tadidamuktaM \" sarUpatvAd\" iti |

\" nanu vaktavyaM sarvamuktvopasaMhAraH kriyate |  tatkimAtmanityatvaviShaye
sarvashaN^koddhAro jAto\?\"  \" yena \" tasmAdyudhyasva\" ityupasaMhriyata ityato
jAta\" ityAha \dash \" na hi\" iti |  \" upAdhibimbasannidhyanAshe sati 
pradarshake Adarshe upAdhau bimbe chAvinaShTe pratibimbanAsho na hi asti\?  
upapAditashchAtra trayasyAnAsha\" iti bhAvaH |

\" nanu vinAshinAM dehAnAM anupAdhitvAt ko.atropAdhiH\?\" ityata Aha \dash 
\" svayameva\" iti |  \" upAdhyupAdhimadbhAvo visheShabalena\" iti bhAvaH |  
\" loke.adR^iShTamidaM kathamaN^gIkAryam\?\" ityata Aha \dash \" chittvAd\" iti |  
\" jaDeShvayAvadvastubhAvitvAt, sarvatra bhedAbhedau |  chitsvarUpe tu 
yAvadvastubhAvitvAdabheda eva\" iti bhAvaH |

\" svasyaivopAdhitve, muktAvAtmanivR^ittiH syAt\?  upAdhinivR^ittilaxaNatvAt
mukteH\" ityata Aha \dash \" nityashcha\" iti |  \" dvividha upAdhirAtmanaH |
nityo.anityashcha |  tatra nityasyAvAsthAnamanyasya nivR^ittirmuktau\" iti |  \" kuta
etad\?\" ityata Aha \dash \" pratipattau\" iti |  \" prAptau satyAM yutastiShThati\"
iti sheShaH |  \" nanUpAdhyeti katham\?\"  kipratyayAntasya pulliN^gatAniyamAt |
\" tarhi iShudhirdvayoH katham\?\"  prayogadarshanAdapavAdaH |  yathA.aha
\" liN^gasheShavidhirvyApI visheShairyadyabAdhitaH\" iti |  samaM prakR^ite.api |

svaH, AtmA, rUpaM yasyAH, sA \" svarUpA\" |  chidrUpatvAt svarUpatvam,
svarUpatvAt nityatvam  || 18||
%%% ##endlabel##

%%% ##label=<segment027_pd02>##

{\Largedvng pra\.dI\. ||} \" ya enam, iti punarAtmanityatvaM kimityuchyata\?  ityato nAsya
nityatvapratipAdane tAtparyaM, kintu niShTaN^kitaM ched, Atmano nityatvaM tarhi
kA gatiH taddhananavyavahArasya\?\" ityAshaN^kya \" tasya bhrAntatvamanenochyata\"
ityAha \dash \" vyavahArastu\" iti |  vyavahAro.atra j~nAnam |  \" tathA.api \" nAyaM
hanti na hanyate\" iti punaruktireva\" iti chenna |  \" j~nAnAnAM prAmANyasya 
bAdhakaikApodyatvAt kuto bAdhakAdasya bhrAntatvam\?\" ityAshaN^kya, 
\" svapaxasAdhakAnAmeva uktahetUnAmetadbAdhane.api vyApArapradarshanArthatvAd 
asya\" ityAha \dash \" kuta\" iti |

\" nanvatra hananamekameva |  tat kathaM \" ubhau\" iti\?  kathaM cha \" nAyaM hanti
na hanyate\" iti\?  athaikasyA api kriyAyAH kArakabhedAdevamuktiH, tarhi 
karaNAdhikaraNoktirapi prasajyata\" iti |

uchyate \dash Atmano nityatvamiva asvAtantryamapi prAk pratipAditam |  
yathoktaM tAtparyanirNaye\footnote{\normaldvng \" ya enaM vetti hantAram\" svAtantryeNa |  anyathA \" mayA hatAMstvaM jahi\" (11\.34) \ ityAdivirodhaH |  chetanaM prati \" ya enam\" iti paramAtmano.api samam || 2\.19||} |  \" tatra hananavyavahAravat, svAtantryavyavahArasyApi
bhrAntatvamanenochyata\" iti \" ubhau\" ityAdyupapadyate |  ata eva bhAShyakAro
\" vyavahArastu\" iti sAmAnyenAha, na tu \" hananavyavahAra\" iti niShkR^itya |

\" nanu nityatve bimbanityatvAdayo hetava uktAH |  asvAtantrye tu na ko.api |  
tat kathaM \" uktahetubhya\" ityuktam\?\" iti chenna \dash pratibimbatvasyoktatvAt |

\" tasya kathamasvAtantryahetutvam\?\" ityata Aha \dash \" na hi\" iti |  \" kriyA\"
iti vadatA, \" hantAram\", \" hanti\" iti padadvayamupalaxaNArtham, iti
sUchitam |

\" nanu pratibimbasyApi loke kriyA dR^ishyate |  jIvasya cha kriyA.abhAve, \" kartA
shAstrArthavattvAt\" (bra\.sU\. 2\.3\.32) ityAdivirodha\" ityata Aha \dash \" sa hi\" iti |  
\" bimbakriyayA\", bimbAdhInakriyayA |  tathA cha \" pUrvaM svAtantryAbhAvApexayA
kriyApratiShedha\" iti j~nAtavyam |

\" nanu upAdhikriyayA.api pratibimbe kriyA bhavati |  tatkathamuchyate \" bimbakriyayaiva\"
iti\?\"  maivam |  svAtantryapratiShedhe tAtparyAt |  jIvasya pR^ithagupAdhyabhAvAchcha |

jIvasyeshvarAdhInakriyatve shrutiM chAha \dash \" dhyAyatIva\" iti |  \" Ishvaro jIvaM dhyAyati\"
ityarthaH |  \" iva\" shabdo.alpArthe  || 19||
%%% ##endlabel##

%%% ##label=<segment028_pd02>##

{\Largedvng pra\.dI\. ||} \" tathA.api \" na jAyate\" iti punaruktam\" ityAshaN^kya, \" nedaM
bhagavadvAkyaM, kintUktArthe sammatitvena mantravarNo.ayamudAhriyata\" ityAha
\dash \" atra\" iti |

\" nanu jIvaH svarUpeNa \" bhUtvA\", dehasambandhena \" bhavitA\" eva |  tat kathaM
uchyate, \" bhUtvA bhavitA\" na\?\" ityato anyathA vyAchaShTe \dash \" na cha\" iti |
\" jIvo na jAyate chet tarhi yatheshvaraj~nAnaM vR^iddhihrAsavarjitaM bhUtvaiva
kayAchidachintyashaktyA bhUtam\", iti \" vyavahArAvalambanaM tathA jIve.api
kiM jananavyavahArastannimitta\?\" iti pR^ichChAyAM, \" na\" ityanenochyata,
ityarthaH |

\" nanvIshvaraj~nAnasyoktaprakAraM \" bhUtvA\", bhavanaM kutaH siddham\? yena jIvasya
 tathAbhAvAsambhAvanAyodAhriyata\?\" ityata Aha \dash \" taddhi\" iti |
\" tah\" Ishvaraj~nAnasyoktaprakAraM \" bhUtvA\", bhavanaM shrutismR^itisiddhaM hi, iti 
sambandhaH |  \" tadaixata\" iti bhavanamuchyate |  \" devadatto.apashyad\" itivat |  
\" deshataH\" iti vR^iddhihrAsAdirAhityam |  \" nanu \" Ishvaravad\" ityeva 
kasmAnnoktam\?\" naivaM shaN^kyam |  lokadarshanasya adhikasya tatrotpAdAt |  
\" ajo nityaH\" iti punaruktamityAshaN^kya tannivartyAM AshaN^kAmuktvA.anyathA 
vyAchaShTe \dash \" kuta\" iti |  \" na jAyate mriyate\" ityetat \" kasmAtkAraNAd\?\" 
ityarthaH |  \" ajAdi\" ityanena \" ajo nityaH shAshvataH\" iti vyAkhyAtam |  
\" shAshvataH\" ityetat \" nityaH\" ityanena gatArtham, ityato anyathA 
vyAchaShTe \dash \" shAshvata\" iti |  tathA cha \" ajo nityaH\" ityAbhyAM
\" bimbotpattinAshanimittau \" shAshvataH\" ityanenopAdhibimbasannidhi
janananAshanimittau janmanAshau na sta\" ityuktaM bhavati |

\" tathA.api \" ajaH ityuktatvAt \" purANaH\" iti punaruktiH\" iti chet, na |
\" bhUtvA bhavitA vA\" na, ityuktam |  \" tatkutaH\?  kiM nimittashcha tarhi
jananavyavahAra\?\" ityAshaN^kya, \" dehAt dehAntaraprAptirasyAsti, ityanenochyata\"
ityAha \dash \" puram\" iti |  \" evamapi \" na hanyate\" iti punaruktiH\" iti chenna |
\" yadi \" purANaH\", \" tarhi upAdhibhUtadehanAshAt darpaNanAshAt pratibimbanAshavad
AtmanAshaH syAd\"  ityAshaN^kA.atra pUrvAbhiprAyeNa parihriyata\", iti bhAvenAha \dash
\" tathA.api\" iti |  purANatve.api  || 20||
%%% ##endlabel##

%%% ##label=<segment029_pd02>##

{\Largedvng pra\.dI\. ||} \" vedAvinAshinam, iti punarAtmano.avinAshitvAdikaM kimarthamuchyata\?\"
ityato.asya tAtparyamAha \dash \" ata\" iti |  \" uktaiH pramANaiH\" |  evaM
avinAshitvAdirUpam |  \" kaM ghAtayati hanti vA, ityevaM bhAvaM (na) karoti\" 
ityarthaH |  \" jIvasyAnityatvAdikaM manyamAno na jAnAti\" ityuktam |  \" idAnIM tu 
j~nAnI naivaM manyata ityuchyata\" iti |

\" avinAshinam\", \" nityam\" iti punaruktimAshaN^kya dvedhA.arthabhedamAha \dash
\" avinAshinam\" iti |  \" naimittikaH\" bimbanAshAdinimittakaH |  svAbhAvikaH
kAlakR^itaH |  \" doShayogarahitam\" ityanena \" mAtrAsparshAH\" (2\.14) ityatra
\" yaduktamAbhimAnikamevA.atmano duHkhAdikaM na tu svagatam\" tasyAnuvAdaHkriyate |

evaM vyAkhyAnaprakAramanyatrApyatidishati \dash \" iti sarvatra\" iti |  \" vivekaH\" 
shabdArthayoH |  \" avinAshinaM doShayogarahitam, iti kuto labhyata\?\" ityata 
Aha \dash \" doSha\" iti |  \" anekArthatvAd dhAtUnAm\" iti bhAvaH  || 21||
%%% ##endlabel##

%%% ##label=<segment030_pd02>##

{\Largedvng pra\.dI\. ||} \" dehAnAmapagamopagamayorapyeka evAyamAtmA, ityetat 
\" dehino.asmin\" (2\.13) ityatraiva sadR^iShTAntamuktam |  ato \" vAsAMsi\" 
iti vyartho.ayaM shloka\" ityata Aha \dash \" deha\" iti |  \" kaumArAdidehAnAM 
anatibhinnatvAt (atibhinnatvAbhAvAt) na tena dehAtmanorviveko 
vinAshitvAvinAshitvalaxaNaH spaShTamanubhavArUDho bhavati\" iti bhAvaH |  
\" dR^iShTAntaM pUrvoktAdvilaxaNam\" iti sheShaH |  \" dR^iShTAntam\" ityupalaxaNam |  
dArShTAntikasyApi kathitatvAt  || 22||
%%% ##endlabel##

%%% ##label=<segment031_pd02>##

{\Largedvng pra\.dI\. ||} \" naimittikanAshasya prAk nirastatvAt  kiM \" nainam\" iti shlokena\?\"
ityataH tannivartyAshaN^kApradarshanapUrvakaM tAtparyamAha \dash \" svata\" iti |  \" svataH\" 
kAlataH |  prAyaH bAhulyena |  shaN^kyamAnanimittavyAvR^ittyarthametadavyayam |
\" kenachit\" shAstrAdinA |  \" syAdvinAsha\?\" iti sheShaH |

\" asambhAvitashaN^kAyA na paryavasAnam\" ityato dR^iShTAntamAha \dash \" kakachChedavad\"
iti |  yathA daxasya prajApateH shirachChedo na svato jAto, nApi 
vIrabhadrasyAyudhena nimittena, kintu yaj~napashubhAvanAkhyena nimittavisheSheNa, tathA\" 
ityarthaH |  \" ityataH\" evaM shaN^kitatvAt |  vishiShyanta, iti visheShAH |  
vishiShTanimittAni vinAshasya  || 23||
%%% ##endlabel##

%%% ##label=<segment032_pd02>##

{\Largedvng pra\.dI\. ||} \" tarhi \" achChedyo.ayam\" ityAdi punaruktam\" ityata
Aha \dash \" vartamAna\" iti |  \" laTprayogeNa vartamAnasyaiva ChedAderniShedhAdidAnIM
dR^ishyamAnatvenAtmanaH prAgvinAshAbhAve.apyuttaratra shastrAdinA vinAshaH syAd\" 
iti shaN^kAyAM \" ChedAdiyogyataivAtmano nAsti\" iti pratipAdanAyaitaduditam |
\" arhe kR^ityatR^ichashcha\" iti kR^ityasya arhArthatvasmaraNAditi bhAvaH |
\" tarhi tenaivAlam |  kimAdyena shlokena\?\" ityata Aha \dash \" vartamAna\" 
iti |  \" pravR^itte shastrasampAte iti vachanAtprasaktau satyAmapi vartamAnasya
ChedAderadarshanAchChedAdyayogyatvamAtmano yuktam\" iti darshayati prathamashlokena |
\" evaM tarhi auttarAdharyaprasaN^ga\" iti chenna |  upoddhAtAbhiprAyeNa bhagavatokte
abhiprAyamajAnAnasya shaN^kAmanUdyAvatArasya kR^itatvAt |  svAbhiprAyeNa tUpoddhAtamuktvA
sAdhyamAhetyavatAraH kartavyaH |  \" nityaH sarvagataH ityAdikaM jIve.asambhAvitam\" 
ityAshaN^kya tannivartyAshaN^kApradarshanapUrvakaM vyAchaShTe \dash \" kuta\?\" iti |
vartamAnachChedAdyadarshanamAtmanaH ChedAdyayogyatAyAM kiM nishchayayuktiH\?
uta sambhAvanAyuktiH |  nAdyaH |  kadAchidadR^iShTasyApi pashchAddarshanAt |
dvitIye \" kuto.ayogyatAnishchaya\?\" iti shaN^kArthaH |  \" nityaH sarvagataH\" 
iti bhAvapradhAno nirdeshaH |  Ishvarasya tAvat ChedAdyayogyatvaM siddham |
nityasarvagatatvAdivisheShaNavatvAt |  nahyevambhUtasya ChedAdikaM sambhavati |
ataH \" tatpratibimbasyApi jIvasya tadayogyatvam\" iti bhAvaH |  mantravarNe
\" shAshvataH\" iti IshvaravisheShaNamuktam |  atra \" sthANuH\" iti |
tayorbhedamAha \dash \" shAshvata\" iti |  ekarUpatvamAtraM sAmAnyena\-
anyathAtvAbhAvaH |  tasya sAmAnyaprakaraNatvAt | \" sthANuH\" ityasya 
naimittikaniShedhaprakaraNatvAt |  asyArthabhedakathanasyottaratropayogaM 
vaxyAmaH |  \" nityaH\" itIshvaravisheShaNaM pratibhAti |  tadanyathA vyAchaShTe 
\dash \" nityatvam\" iti |  bhinnapadoktamapi vishiShTasya visheShaNaM 
visheShaNamupasaN^krAmati |  sannidhAnAchcha sarvagatatvamiti bhAvaH |  \" dvayaM 
pR^ithagIshvaravisheShaNaM kiM na syAd\?\" ityata Aha \dash \" anyathA\" iti |  
\" ajo nityaH\" iti nityatvamIshvarasya prAguktam |  \" aprameyasya\" iti 
sarvagatatvaM cha |  atastAbhyAM punarukterityarthaH |  asyApyuttaratropayogaH |

\" nanu jIvasyeshvarapratibimbatvamatra bahuvAramuktam |  ataH punaruktidoSha\" 
ityata Aha \dash \" aikya\" iti |  \" jIveshvaraikyaviShaye na punaruktirdoShaH |
kutaH\? aikyamAtrasya punaH punaruktAvapi pUrvapUrvAnuktAnAM tatratatropayuktAnAM
IshvaravisheShaNAnAmuttaratropAdAnAd\" iti |  aikyamatra gauNaM vivaxitam |
visheShaNabhedAdvishiShTabheda iti bhAvaH |  \" nanvetadapi nAsti |  \" shAshvataH\"
ityuktasyaiva sthANushabdena grahaNAd\" ityAshaN^kAnirAsAya \dash \" shAshvata
ityekarUpatvamAtram\" ityAdikaH prAchIno granthaH |  \" nanu pratibimbatvaM
tattatsAdhyasiddhaye hetutvenoktam |  nachaikasyaiva hetoranekasAdhyasiddhyarthaM punaH 
punarupanyAse doSho.asti |  tat kasya hetoH\? prameyabhedAt |  ataH kathamimaM
shAN^kA\?\" iti |  uchyate |  \" ekatroktamIshvarapratibimbatvamanyatrApi hetutvena
shiShyaireva j~nAyatAm |  kiM svayaM vachanena\?\" iti shaN^kiturabhiprAyaH |
\" IshvarapratibimbatvamAtrasya tattadvishiShTashaN^kAnirAsAsAmarthyAttattad
aupayikavisheShaNapradarshanArthaM svayamupAdAnam\" iti parihArAbhiprAyaH |
\" nanvIshvarasya nityasarvagatatvAdivisheShaNavattvAdastvachChedyatvAdikam |
jIvasya tu kutaH\? tathAvidheshvarapratibimbatvAditi chenna |  yo yasya 
pratibimbaH sa taddharmeti niyamAbhAvAd\" ityata Aha \dash \" yuktAshcha\" iti | 
%%% ##endlabel##

%%% ##label=<segment033_pd02>##

{\Largedvng pra\.dI\. ||} \" bimbadharmAH\" bimbasamAnadharmAH |  \" yo yatpratibimbaH
so.asti virodhe taddharmeti vyAptiratrAbhipretA\" iti bhAvaH |

%%% ##endlabel##

%%% ##label=<segment034_pd02>##

{\Largedvng pra\.dI\. ||} \" syAdidaM vyAkhyAnaM yadi jIvasyeshvarapratibimbatA syAt |  
saiva kutassiddhA\?\" ityata Aha \dash \" tattA cha\" iti | 

\" nanu jIvasyeshvarapratibimbatvAN^gIkAre \" aMsho nAnAvyapadeshAt\" 
(bra\.sU\. 2\.3\.43), \" mamaivAMshaH\" (15\.7) ityAdivAkyasiddhena tadaMshatvena virodhaH 
syAt |  pratibimbo hi bimbAdatyantAbhinna iti keShAJNchinmatam |  atyantabhinna
ityapareShAm |  aMshastu tadekadeshastena bhinnAbhinnaH |  yathA paTAMshastantuH
paTena |  tataH paxadvaye.api kathaM na virodha\?\" ityata Aha \dash \" na cha\" iti |
jIvasyeshvarapratibimbatvAN^gIkAre.api na tadaMshatvavirodhaH |  \" kuta\?\" ityata 
Aha \dash \" tasyaiva\" iti |  pratibimbatvasyaivAMshashabdapravR^ittinimittatvAt |  

ayaM bhAvaH |  atyantabhinnasya jIvasya yadIshvarAdhInatatsAdR^ishyopetatvaM
tatpratibimbatvamuchyate |  abhedamatasya nirAkariShyamANatvAt |  \" tadeva 
tadaMshatvamiti kuto virodha\?\" iti |  \" nanvaMshatvaM tadekadeshatvam |  
tatkathamuchyate pratibimbatvamevAMshatvam\?\" iti |  tatrAha \dash \" na cha\" 
iti |  \" aMshatA aMshashabdapravR^ittinimittam |  na kevalamekadeshatvaM
\" aMsha\" shabdapravR^ittinimittam |  api tu pratibimbatA.api\" iti bhAvaH |  
\" astu nAma anekArthatvaM \" aMsha\" shabdasya |  tathApi \" aMsho nAnA\" 
(bra\.sU\.2\.3\.43) ityAdau pratibimbatvamevAMshatvamityatra kiM pramANam\? 
tadekadeshatvaM kiM na syAd\" ityata Aha \dash \" pramANaM cha\" iti |  
jIvasyeshvarapratibimbatvaM tadaMshatvaM cha tAvaduchyate |  \" na cha parasparaviruddhaH 
shAstrArtho bhavituM yuktaH |  tatrAnekArthasyAMshashabdasya viruddhArthaM parityajyArthAntaraM 
gR^ihyata\" ityarthApattirevAtra pramANamiti bhAvaH |  

syAdetat, \" yathA pratibimbatvameva tattvamaMshashabdasyApi tadeva pravR^ittinimittamiti
vachanadvayavirodhashAntyarthaM kalpyate, tathaikadeshatvameva tattvaM pratibimbashabdasyApi
tadeva pravR^ittinimittamiti kuto na kalpyam\? vachanadvayavirodhasyaivamapi shAnteH\"
ityata Aha \dash \" na cha\" iti |  \" aMshasya\" aMshatvasyaikadeshatvasya |  
pratibimbatvaM pratibimbashabdapravR^ittinimittatvaM na kalpyam |  \" kuta\?\" ityata 
Aha \dash \" gAdhyAdiShu\" iti |  gAdhyAdiShvaMshashabdAbhidheyeShvaMshatvasya 
bAhurUpyadR^iShTeH |  itaratra pratibimbashabdAbhidheyeShu sUryakAdiShu pratibimbatvasya 
anekarUpatvAdR^iShTeH |  

idamuktaM bhavati |  \" indrAMsho gAdhI\" ityuchyate |  tatra visheSha evAMshashabdasya 
pravR^ittinimittam |  bhedAbhedAdeH pramANabAdhitatvAt |  paTAMshastanturityatraikadeshatvam |  
sUryAMshashchaxurityatrAtyantabhinnasya tadadhInasAdR^ishyam |  evaM \" aMsha\" shabdo
anekArthaH prayogeShu dR^ishyate |  tathAchoktaM \" dvirUpAvaMshakau tasya\" ityAdi |  
na chaivaM pratibimbashabdasyAnekaM pravR^ittinimittaM dR^ishyate |  tathA cha 
sAvakAshasyAMshashabdasya niravakAshena pratibimbashabdena bAdho yuktaH |  na tu
vaiparItyam \dash iti |

\" nanvIshvarasya sthANutvaM na yujyate |  \" tadaixata\" (ChA\.up\.6\.2\.3),
\" so.akAmayata\" (bR^i\.u\. 1\.2\.4, 1\.2\.6) ityAdikartR^itvavirodhAd\"
ityata Aha \dash \" sthANutve.api\" iti |  

%%% ##endlabel##

%%% ##label=<segment035_pd02>##

{\Largedvng pra\.dI\. ||} \" kuta\?\" iti chet kiM dvayoH parasparaparihAreNa
vR^ittidarshanAdvirodhashchodyate\? uta sahAdarshanAt\? nAdyaH kartR^itvarahitasya
kasyApyadarshanAt |  \" na dvitIya\" ityAha \dash \" ubhaya\" iti |  \" anyatra 
sahAdR^iShTaM sthANutvaM kartR^itvaM cha kuto bhagavati\?\" ityata Aha \dash \" achintya\" 
iti |

mAyAvAdI tu kartR^itvasthANutvayorekaM kartR^itvaM mAyAmayam |  sthANutvaM cha 
pAramArthikam |  kAlpanikapAramArthikayoshcha gagane nIlatvanIrupatvayoriva 
na virodha iti virodhasamAdhAnaM manyate |  tadasadityAha \dash \" na cha\" 
iti |  \" kuta\?\" ityata Aha \dash \" tvayi\" iti |  \" brahmaNi\", \" Ishvare\"  
iti sampUrNaishvarye |  na yogitvAt |  kintvIshvaratvAt |  kAryakAraNe 
sakalakAryotpAdanasAmarthyopete |  \" ityAdi\" iti kriyAvisheShaNam |  \" 
viruddhAnAmanyatra sahAnavasthitAnAM dharmANAM bhagavatyavirodhasya sahAvasthAnasyokteH | 
tathA cha bAdarAyaNIyaM matamavalambamAnasyaivaM virodhasamAdhAnamasAmpradAyikam\"
iti bhAvaH |
%%% ##endlabel##

%%% ##label=<segment036_pd02>##

{\Largedvng pra\.dI\. ||} \" itashcha tadayuktam\" ityAha \dash \" mahAtAtparyAchcha\" iti |  
sakalavedAnAM parameshvaraguNotkarShe mahAtAtparyam |  \" tatrexitR^itvAdInAM
mithyAtvakalpane tadvirodhassyAd\" ityarthaH |  \" samastavedAnAM bhagavadguNotkarShe
mahAtAtparyamityetadeva kuta\?\" iti chet |  uchyate \dash yasya hi shAstrasya
yatprayojanaM tadyajj~nAnAdbhavati sa tasya viShaya iti niyamaH |  anyathA viShayaprayojanayoH 
sambandho na syAt |  tathA cha tatra prexAvatAM pravR^ittirna bhavet |
\" vedasya cha moxaH prayojanam |  sa cha bhagavadguNotakarShaj~nAnAdeva bhavatIti 
tatraiva tasya mahAtAtparyaM yuktamiti pratipAdayiShyan, sarvavedAnAM moxaH
prayojanamityevAsiddham |  \" na svargAdeH phalAntaram\" iti kaishchidaN^gIkR^itatvAd\"
ityataH tattAvat sAdhayati \dash \" moxo hi\" iti |  vedo hi mahachChAstram |
\" vedashAstrAtparaM nAsti\" iti vachanAt |  tasya cha mahApuruShArthenaiva
prayojanaM bhavituM yuktam |  moxashcha mahApuruShArthaH |  ataH sa eva tasya prayojanaM
iti bhAvaH |  \" moxasya mahApuruShArthatvaM kuta\?\" ityata Aha \dash \" tatrApi\" 
iti |  puruShArtheShvapi |  atra eveti nirdhAraNeNa mahattvaM gamyate |  \" anteShu\" 
dharmamoxeShu |  \" madhyeShu\" arthakAmeShu |  antayorantaraM madhyam |  \" naitAvatA
dharmo moxasamaH |  xayiphalatvAd\" ityAha \dash \" puNya\" iti |  \" chitaH\" 
prAptaH |  \" astvevam |  tataH kim\?\" ityata Aha \dash \" sa cha\" iti |  
moxasya bhagavatprasAdasAdhyatvamanyasAdhyatvAbhAvashcheti dve prameye |  tatra 
yathAyogaM vAkyAnyetAni j~nAtavyAni |  yadi nirvyalIkaM ChadmanA vinA |  
\" sarvAtmanA\" sarvaprakAreNa |  shritapado bhagavAn yeShAM dayayet dayAM 
kuryAt |  tarhyeShAM \" shvasR^igALabhaxye dehe mamAham\" iti dhIrna bhavati |  te 
devamAyAM devamahimAnaM vidanti |  atitaranti cha saMsAramityarthaH |  \" R^ite\" 
satye, yadyasmAt, \" Isha\" iti sambuddhiH |  \" atastavAN^ghreshChAyAmAshrayema\" 
iti sambandhaH |  j~nAnaM prasAdasAdhanamityanupadaM vaxyate |  ataH \" tamevaM\" 
ityAdyudAharaNam |  \" tato.api kim\?\" ityata Aha \dash \" sa cha\" iti |  
viShNuprasAdashcha |  loke satpuruShaprasAdo guNotkarShaj~nAnasAdhyaH prasiddhaH |
taddR^iShTAntenAnumAnAdityarthaH |  \" nanvIshvarasyAnumAnAviShayatvAtkathaM tatra
lokaprasiddhamaN^gIkAryam |  anyathA.aj~nAnAdikamaN^gIkAryaM syAd\" ityata Aha 
\dash \" loka\" iti |  anyathA mImAMsArambhAnupapattiriti bhAvaH | 

%%% ##endlabel##

%%% ##label=<segment037_pd02>##

{\Largedvng pra\.dI\. ||} \" nanvindraprasAdakAmaH \" ahalyAyai jAra\" iti tannindAmeva 
karoti |  tato bhagnavyAptikamidamanumAnam\" ityata Aha \dash \" ahalyA\" 
iti |  ahalyAjAratvAdipratipAdakaM vAkyamapyutkarShameva vakti |  katham\? 
\" doShakR^ito.api te yastatphalaM bahutaro lepaH sa nAsIdityasyArthasyAnena
vyaJNjanAd\" ityarthaH |  kuta etat\? atyantAlaukikakalpanAdevaM kalpanasya 
jyAyastvAt |  \" tatphalaM bahutaro lepa ityetat kuta\?\" ityata Aha \dash 
\" bahunaraka\" iti |  asau paranArIdharShaNadoShaH |  \" hi\" iti 
sakaladharmashAstraprasiddhiM dyotayati |  \" sa lepastasya nAsidityetatkuta\?
ityata Aha \dash \" tasya\" iti |  \" ahalyAdharShaNena tasyendrasya lomA.api 
na xIyata\" ityarthaH |
%%% ##endlabel##

%%% ##label=<segment038_pd02>##

{\Largedvng pra\.dI\. ||} \" bhagavatprasAdastadguNotkarShaj~nAnasAdhya ityetanna kevalaM
anumAnAtsiddham |  kiM tarhi bhagavadvachanAchcha\" ityAha \dash \" yo mAm\" iti |
atra \" sa sarvavit\" ityAdistutyA prasAdo gamyate |  tadevaM bhagavadguNotkarShe
mahAtAtparyaM sarvAgamAnAmiti pramitam |

%%% ##endlabel##

%%% ##label=<segment039_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu brahmarudrAdInAM sarvotkR^iShTatvaprasiddheH viShNoH 
sarvotkarSha eva nAsti |  kutastatra sarvAgamAnAM mahAtAtparyam\?\" iti chenna |  
tatprasiddherbhrAntitvAt |  \" tatkuta\?\" ityata Aha \dash \" satyam\" iti | 
\" satyam\" vaxyamANam |  tasya leshasyeti sarvatra sambandhaH |  \" nanu 
purANavirodhAllaukikI pratItirastu bhrAntiH |  purANeShvevAnyeShAM sarvotkarSho
bhagavadaikyaM chochyate |  tatkatham\? na hi purANasya purANaM bAdhakam |  sAmyAd\"
ityata Aha \dash \" anya\" iti |  anyotkarShaM aikyaM cha purANeShu pratItamapi
mahAbhArataviruddham |  ato na grAhyamityarthaH |  atraikyaM prasaN^gAduktam |
\" mahAbhAratasya purANabAdhakatvaM kuta\?\" ityata uktaM\dash \" tathaiva\" iti |  
\" ityAdinA\" granthAntareNa, \" siddhaH\" pramita utkarShaH sarvashAstrottamatvaM
yasya tat tathoktam |  \" kathaM mahAbhArataviruddham\?\" ityata Aha \dash \" tatra
hi\" iti |  \" tatra\" mahAbhArate |  ityAdivAkyeShu vakti bhagavAnvyAsaH |
\" ito.api mahAbhAratasya purANabAdhakatvaM yuktam\" ityuktaM \dash \" sAdhAraNa\" 
iti |  \" kassarvotkR^iShTa\?\" iti sAdhAraNaprashnarUpe.avasare viShNuprashaMsAM
anupakramya svarUpakathanAvasara iti yAvat |  \" purANe.apyevamevAnyotkarShAdyuktau
sAmyameva\" ityata Aha \dash \" anyatra\" iti |  \" anyatra\" purANe |
yatkiJNchiduktAvapyanyotkarShAdyuktAvapi |  asAdhAraNa evAvasare tatstutiprasaN^ge |
\" taduktam\" iti sheShaH |  \" asAdhAraNAvasaroktamapi rudrAderutkR^iShTatvAdi
kuto durbalam\? ityata Aha \dash \" taddhi\" iti |  \" tat\" stutiprastAvoktaM
sarvotkR^iShTatvam |  vedAdAvagnyAderapyasti |  tasyApi grAhyatvaM 
syAdityarthaH |  

%%% ##endlabel##

%%% ##label=<segment040_pd02>##

{\Largedvng pra\.dI\. ||} \" itashcha na purANoktaM rudrAderutkR^iShTatvaM grAhyam\" ityAha 
\dash \" tadgrantha\" iti |  \" tadgranthaH\" shaivapurANam |  \" tatkatham\?\" 
ityata Aha \dash \" tathA hi\" iti |  tadgranthetyuktapradarshanAya shaiva 
ityuktam |  \" N^yApoH saJNj~nAchChandasorbahulam\" iti \" jAhnavi\" iti hrasvaH |  
tatraiva skAnda eva shivAnmuktiM niShidhya |  \" itashcha na purANoktaM 
shivAderutkR^iShTatvaM grAhyam\" ityAha \dash \" sama\" iti |  samaM 
shaivavaiShNavapaxayoH |  \" nAhaM na cha shivo.anye cha\" ityAdi tadvachanam |
%%% ##endlabel##

%%% ##label=<segment041_pd02>##

{\Largedvng pra\.dI\. ||} \" astu laukikI pratItirbhrAntiH |  purANaM cha vipralambhamUlaM
vyAmohanArtham |  tathA.api \" vishvAdhiko rudraH\" ityAdivedavirodha\" 
ityata Aha \dash \" vedashcha\" iti |  saN^kuchitAdyartho vyAkhyAtavyaH | \" kuta\?\" 
ityata Aha \dash \" yadi\" iti |  itihAsAdyananurudhya yathAshrutavedavyAkhyAne
aniShTamAha \dash \" anirNayAchcha\" iti |  \" na kevalaM \" vishvAdhiko rudraH\" 
ityAdivedo viShNossarvotkarShasyAvirodhI |  kintu pratyuta tatra vede.asmadiShTasya
viShNossarvotkarShasya siddhirapi\" ityAha \dash \" tatrApi\" iti |  \" kuta\?\" 
ityata Aha \dash \" nAma\" iti |  \" viShNornAmabhirvaisheShyAdvishiShTatvAt |
rudrAdisarvanAmavattvAd\" ityarthaH |  \" mahAtAtparyAchcha\" ityAdinoktamarthaM
upasaMharati \dash \" ata\" iti |  \" aprAmANikatvAtpramANaviruddhatvAchcha\"
ityarthaH |
%%% ##endlabel##

%%% ##label=<segment042_pd02>##

{\Largedvng pra\.dI\. ||} \" astvevam |  tathApIxItR^itvAderna mAyAmayatve tadvirodhaH |  guNotkarShasya
sattve hi sa syAt |  na cha vedatAtparyaviShayatvamAtreNa satyatA |  moxApexayeshvaraM
prasAdayitumuktasya rAjAdyutkarShasyevAsattvasambhavAt |  saMvAdAbhAvena sattvanishchayAyogAd\" 
ityata Aha \dash \" tathA api\" iti |  phalApexayeshvaraM prasAdayituM pratipAditatve.api
svataH prAmANyAt saMvAdamanapexya j~nAnagrAhakeNaiva prAmANyasya nishchitatvAt |  na hi 
prAmANyanishchaye viShayAsattvashaN^kA sambhavati |  \" evaM sati bauddhAdyAgamaviShayasyApi 
sattvaM syAd\" iti chenna |  prasaktasyApi tatprAmANyagrahaNasya balavadvirodhenApoditatvAt |
\" na cha tathA prakR^ite.api\" ityAha \dash \" avirodhAd\" iti |  \" nanvanyatra 
puruShe sarvotkarShasyAdarshanAt taddR^iShTAnteneshvare.api tadabhAvasya sAdhayituM 
shakyatvAdanumAnavirodho.asti\" ityata Aha \dash \" na cha\" iti |  \" kAlAtItaM
anumAnam\" iti bhAvaH |  pramANaviruddhasyApyanumAnatve.atiprasaN^gaM sUchayati 
\dash \" dharma\" iti |  dharmairvaichitryaM \" dharmavaichitryam\" |  \" evamanumAne.arthAnAM 
dharmavaichitryaM na syAd\" iti bhAvaH |  yadvA.anena granthenAsambhAvanAvirodhaM 
parihartuM sambhAvanAM darshayati |  \" bhavedevaM yadi svata eva prAmANyagrahaH syAt |  
tadanaN^gIkAre kimuttaram\?\" ityata Aha \dash \" svata\" iti |  saMvAdAdhInaH 
prAmANyagraha ityaN^gIkAre tu prAmANyanishchayAya saMvAdakamAnoktau tasyAdoShatvaM 
prAmANyamanyasaMvAdena sAdhayedityanavasthAlaxaNo.atiprasaN^ga ityarthaH |
%%% ##endlabel##

%%% ##label=<segment043_pd02>##

{\Largedvng pra\.dI\. ||} \" ito.api na vedatAtparyagocharasya bhagavadguNotkarShasyAsattvaM
shaN^kanIyam\" ityata Aha \dash \" ananya\" iti |  \" prayojanAnapexayA cha\" 
ityarthaH |  \" tarhi tatparatvameva na siddhyet |  prayojanaparyAlochanayA hi
tatprAksAdhitam\" ityata Aha \dash \" siddham\" iti |  \" katham?\" ityata 
Aha \dash \" nArAyaNa\" iti |  prayojanApexayA bhagavadguNotkarShaparatvapaxe
prayojanena tatsAdhanaM kR^itam |  prayojanAnapexApaxe tu Agamaireva tatsiddham |
paxadvayaM cha \" sarve vedAstu devArthAH\" ityAdi vaxyamANapramANasiddham |
\" ekasyaiva vAkyasya prayojanasApexatvamanapexatvaM cha viruddham\" ityata 
Aha \dash \" na cha\" iti |  \" pratipattR^ibhedAd\" iti bhAvaH |  \" nanu
jaDasya vedasya etAn pratyevaM pratipAdayiShyAmyetAn pratyevam iti kathaM 
chetanavatpravR^ittiH\?\" ityata Aha \dash \" Ishvara\" iti |  \" anAdirveda
ityuktam |  tatra kathamIshvarasya niyamanam\?\" ityata Aha \dash \" anAdau
cha\" iti |  anAdipadArthaviShaye |  \" niyAmakatvamanyatrAdR^iShTaM kathaM
Ishvarasya\?\" ityata Aha \dash \" prayojakatvaM tu\" iti |  anAderniyAmakatvaM
tvIshvarasyAchintyashaktyA yuktam |  \" ananyApexayA cha\" ityAdinoktaM 
upasaMharati \dash \" ata\" iti |  \" tathA cha paxadvaye.api mahAtAtparyavirodhAnna
IshvarasyexitR^itvAdikaM mAyAmayam\" iti bhAvaH | 
%%% ##endlabel##

%%% ##label=<segment044_pd02>##

{\Largedvng pra\.dI\. ||} aprAmANikaM cha tanmAyAmayatvam |  tathA hi |  \" kiM
sthANutvexitR^itvAnyathA.anupapattyaitat kalpyata uta pramANAntarAt\? nAdyaH |
anyathaivopapatteruktatvAd\" ityAha \dash \" tachcha\" iti |  sthANorapi
IxitR^itvam |  \" ananyApexA\" svatantrA |  na dvitIyaH |  tadadarshanAditi
bhAvenopasaMharati \dash \" ata\" iti | 
%%% ##endlabel##

%%% ##label=<segment045_pd02>##

{\Largedvng pra\.dI\. ||} \" prakR^itamanusaran achalaH ityetatpadaM yadanyaiH 
parispandarahita\" (shAM\.bhA\.2\.24, rA\.bhA\.2\.24) iti vyAkhyAtaM |  \" tadasat\"
iti bhAvenAha \dash \" achalatvaM tu\" iti |  \" ityAdivadvyAkhyeyam\" iti 
sheShaH |  satyaj~nAnAnandasvarUpaM brahmAbhyupagachChatA yathaitAni vAkyAni vyAkhyAyante 
laukikasattAdirahitaM iti tathA achalaH ityetadapi laukikakriyApratiShedhaparaM vyAkhyeyaM |
sarvathA parispandAbhAvArthatve \" apraharSham\" ityAderapi sarvathA.anAnandatvAdikaM
arthaH syAt |  avisheShAditi bhAvaH |  \" nanu viShamo.ayamupanyAsaH \" vij~nAnaM
AnandaM brahma\", \" satyaM j~nAnam\" ityAdibhirAnandarUpatvAdeH pramitatvena
tathA vyAkhyAnopapatteriti chet samaM prakR^ite.api\" ityAha \dash \" kriyA\" 
iti |  \" kutaH kriyAdR^iShTiH\?\" ityata Aha \dash \" tapa\" iti |  \" tapa\" 
Alochanam |  \" vij~nAnamAnandam\" ityAdIni niravakAshAni |  kriyAvAkyAni
sAvakAshAni |  \" sarvasya brahmadharmasya mAyAmayatvAt |  ataH punarvaiShamyam\"
ityata Aha \dash \" atashcha\" iti |   ata eva mahAtAtparyavirodhAdeva |  \" itashcha
neshvaradharmANAM mAyAmayatvam\" ityAha \dash \" aishvaryAd\" iti |  sambodhanAd
Ishvarasya |  arsha Adyajanto.ayaM shabda ityevakAreNa vyavachChinatti |  niyAmakAbhAvena
ashrutapratyayakalpanA.ayogAt |  \" evaM sambodhane tatsvarUpatvamevaishvaryAdInAM 
syAt, natvamAyAmayatvam\" ityata Aha \dash \" svarUpatvAd\" iti |  
anantatvasvAbhAvikatvAdivachanAchcha neshvarashaktyAdInAM mAyAmayatvam |  mAyAmayasya 
anantatvAdyanupapatterityAha \dash \" vij~nAna\" iti || 24||
%%% ##endlabel##

%%% ##label=<segment046_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu, bhagavAn j~nAnibhirdR^ishyate, chintyate cha |  tat kathamuchyate,
\" avyakto.ayamachintyo.ayam\" iti\?\"  tatrAha \dash \" ata eva\" iti |
achintyashaktitvAdeva |  yathoktam, \" ato.anantena tathAhi liN^gam\" (bra\.sU\. 3\.2\.27)
iti  || 25||
%%% ##endlabel##

%%% ##label=<segment047_pd02>##

\" nanu, sarvashaN^koddhAreNAtmanityatvaM pratipAdya, \" tasmAdevam\" (2\.25)
ityupasaMhR^itam |  tat kiM \" atha cha\" iti punaruchyate\?\" ityato
aN^gIkR^itya \" AtmanityatvaM prakArAntareNa shokashaN^keyam\" ityAshayavAn
Aha \dash \" astvevam\" iti |  \" yuddhe cha mR^itirniyatA |  janimR^itinimittaM 
cha duHkhaM madIyAnAM bhaviShyati, iti me shoka\", iti shaN^kAsheShaH |  anena 
pUrvArdho.api vyAkhyAtaH |  ata eva \" dehasaMyogaviyogAtmakajanimR^itI\" 
ityuktam |  anyathA, \" dehasaMyogaviyogau\" ityeva vA, \" janimR^itI\", ityeva 
vA brUyAt |  \" sta eva\" ityanena \" nityashabdo.avadhAraNArtha\" ityuktam |

\" astvevamAtmano nityatvam\" iti vadatA, \" Atmano.anityatvamabhyupagamya
idamuchyate\" (shaM\.bhA\. 2\.26) iti mAyAvAdino.apavyAkhyAnaM nirastaM bhavati,
\" dhruvaM janma mR^itasya cha\" (2\.27) ityuttaravAkyavirodhAt |  \" avyaktAdIni\" 
(2\.28) ityanenApi virodhAt  || 26||
%%% ##endlabel##

%%% ##label=<segment048_pd02>##

{\Largedvng pra\.dI\. ||} anenaivAbhiprAyeNaitadekavAkyatayottaraM shlokadvayaM krameNAvatArayati,
\" kuta\" iti |  shaN^kAmanUdya, \" tathA.api tvaM na shochitumarhasi\" ityuktam |
\" tatra ko hetuH\?\" ityarthaH  || 27||
%%% ##endlabel##

%%% ##label=<segment049_pd02>##

{\Largedvng pra\.dI\. ||}  spaShTanaM cha janmamaraNasvarUpanirUpaNena  || 28||
%%% ##endlabel##

%%% ##label=<segment050_pd02>##

{\Largedvng pra\.dI\. ||} \" Ashcharyavat, iti shlokasya na prakR^itasaN^gatirdR^ishyate |
taduttarashlokashcha punarukta\", ityata Aha \dash \" dehayoga\" iti |  dvandvaikavadbhAvo.ayam |
\" sarvathA\" iti bimbanAshAbhAvAdibhiH sarvaiH prakAraiH |  \" ityupasaMhartum\"
uttareNa shlokena |  \" IshvarasarUpatve.api kathamanAsha\?\" ityAshaN^kA
parihArahetutvAd \" upasaMhartum\" ityuktam |  \" aprameyasya\" (2\.18)
ityAdinA prAguktatvAt \" punaH\" iti |  \" enaM yaH kashchit pashyati sa 
Ashcharyavad\" ityuktvA, chaturthapAdena tadupapAdanaM kriyate |  taM vyAchaShTe,
\" durlabhatvena\" iti |  \" durlabhatvaM \" Ashcharya\" shabdapravR^ittau nimittam\"
ityarthaH |  \" tat katham\?\" ityata Aha \dash \" taddhi\" iti |  \" Ashcharyamanitye\"
ityAdismR^itiM \" hi\" shabdena sUchayati |  \" sarveShAmAtmadraShTR^itvAt, kathaM 
\" AtmadraShTA durlabho.api yenAshcharya\" ityuchyate\?\" ityata Aha \dash \" durlabho.api\" 
iti |  \" IshvarasarUpatvAdinA AtmadraShTA durlabha\" iti bhAvaH |  anena 
\" Ashcharya eva \" Ashcharyavad\" ityuchyata\" ityuktaM bhavati |  \" yat 
pratibimbasya jIvasya draShTA.api durlabhaH, kiM tatsAmarthyaM varNanIyam\?\"
iti IshvarasAmarthyapradarshanam |  

\" dehayogaviyogasya\" ityAdinA \" dehI nityam\" iti shloko vyAkhyAtaH |

\" svadharmam\" ityAdayaH shlokA atirohitArthatvAnna vyAkhyAtAH |  
evamuttaratrApi || 29\-30||
%%% ##endlabel##

%%% ##label=<segment051_pd02>##

{\Largedvng pra\.dI\. ||} pUrvaprakAraNopasaMhArapUrvakaM tatsaN^gatatvenottaraprakaraNArambha\-
pratij~nArthaM eShA te.abhihitA ityuktam |  tatra \" sAN^khyayogashabdau kApila\-
pAtAJNjalavachanau\" iti pratItinirAsAya vyAchaShTe \dash \" sAN^khyam\" iti | 
\" pratItArthAveva kiM na syAtAm\?\" ityata Aha \dash \" netarau\" iti |  
\" itarau\" shAstralaxaNau |  \" kutrachid\" Agame |  etau tUpAdeyau |
\" buddhyA yuktaH\" ityAdivachanAt |  \" ato na tAvatra vivaxitau\" iti
vAkyasheShaH |  \" prakR^itipuruShavivekAdestaduktasyopAdeyatvAt kathametad\?\"
ityata uktaM \dash \" sAmastyena\" iti |  \" ekadeshasyopAdeyatayA tadupAdeyatve
saugatAderapi tatprasaN^ga\" iti bhAvaH |  \" ito.api na yogaH pAtaJNjalaM shAstram\"
ityAha \dash \" karma\" iti |  asminneva yoge \" karmayogo vishiShyate\" 
ityAdiprayogAchcha |  \" na hi shAstre karmayogashabdo.asti\" iti |  na kevalaM
upAdeyatvAbhAvAnnetarAviha vivaxitau |  kiM tu\" ityata Aha \dash \" ninditatvAchcha\" 
iti |  \" kathaM ninditatvam\?\" ityata Aha \dash \" bhinna\" iti |  

\ \ \ \" sAN^khyaM yogaH pAshupataH vedAraNyakameva cha |
\ \ \ j~nAnAnyetAni bhinnAni nAtra kArya vichAraNA\" ||

\dash (mahA\.123\.37\.59 \ast) iti sAN^khyAdInAM bhinnamatatvamuktvA

\ \ \ \" paJNcharAtrasya kR^itsnasya vaktA nArAyaNaH svayam |
\ \ \ j~nAneShveteShu rAjendra sarveShvetadvishiShyate\" ||

\dash (mahA\.123\.37\.63 \ast) iti paJNcharAtrastutyA |  \" viruddhAnAM ekastutiraparanindAM
gamayatIti prasiddhameva\" iti bhAvaH |  \" evaM tarhi vedAraNyakasyApi nindA
syAd\" ityata Aha \dash \" vedAnAM tu\" iti |  ekArthatvAt paJNcharAtreNa |
\" j~nAnAnyetAni bhinnAni iti pArthakyokteH kathamekArthatvam\?\" ityata 
Aha \dash \" pArthakyaM tu\" iti |  yuktamityanena teShAmeva prakR^itatvAd
ityabhipraiti |  \" tathAchAdyavAkye vedAraNyakapadena paJNcharAtramuttaravAkye cha 
paJNcharAtrapadena vedAraNyakamupalaxyata\" iti bhAvaH |  \" vedapaJNcharatrayoH
ekArthatvaM kuta\?\" iti chet |  udAhR^itamoxadharmavAkyArthAnyathAnupapattyA
tAvat |  aparaM cha pramANamAha \dash \" tatraiva\" iti |  moxadharma eva |

\ \ \ \" ye hi te yatayaH khyAtAH saptachitrashikhaNDinaH |
\ \ \ tairekamatibhirbhUtvA yatproktaM shAstramuttamam |
\ \ \ vedaishchaturbhiH samitaM kR^itaM merau mahAgirau\" ||

\dash (mahA\.123\.22\.26 \ast) ityAdinA chitrashikhaNDishAstrasya vedaikyokteshcha |
\" asaN^gatametad\" ityata Aha \dash \" paJNcharAtra\" iti |  \" paJNcharAtra\-
mUlakasya\" ityarthaH |  etachcha vaikhAnasasaMhitopakrama eva prasiddham |
etadvyAkhyAnaM \" j~nAnayogena sAN^khyAnAm\", \" sAN^khyayogau pR^ithagbAlAH\" 
ityAdAvapyatidishati \dash \" evameva\" iti |  \" shabda\" iti jAtyabhiprAyaM\-
ekavachanam |  \" ito.apyatra sAN^khyayogashabdau j~nAnopAyavAchinau\" ityAha
\dash \" yukteshcha\" iti |  tAmeva yuktiM darshayati \dash \" j~nAnaM hi\" iti | 
atroktavaxyamANayorarthayoH sAN^khyayogashabdau prayuktau |  uktavaxyamANArthau cha 
j~nAnopAyAveveti tadarthAvetau yuktAviti \dash \" jaivaM j~nAnam\" iti |  jIvasya
tattvamityarthaH |  yadyapIshvaratvaM choktam |  tathApi tAdarthyenetyadoShaH |  \" nanu
buddhirj~nAnaM, tadutpAdyata eva |  na tvabhihitam |  nApi shrAvyate |  tatkathamuchyate
\" sAN^khye buddhirabhihitA yoge tvimAM shR^iNu\" iti\?\" |  tatrAha \dash \" budhyata\" 
iti |  \" vAg\" iti sheShaH |  \" nanu sAN^khyaM na vAcho.adhikaraNam |  
tat kathaM saptamI\?  kimarthaM cha prasiddhavAkChabdaparityAgenAprasiddhabuddhishabdopAdAnam\?\" 
ityata Aha \dash \" sAN^khya\" iti |  sAN^khyaM chAsau viShayashcha |  anena 
viShayasaptamIyamityAha |  nAvishadaM vAN^mAtramuktam |  \" kintu tava bodho yathotpadyate 
tathetyaprasiddhapadopAdAnaprayojanam\" ityuktaM bhavati || 39||
%%% ##endlabel##

%%% ##label=<segment052_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu \" vyavasAyAtmikA\" iti shloke na pratij~nAto \" yoga\" uchyate |
nApi \" buddhyA yukta\" ityAdivat prashaMsA |  tat kiM artho.ayam\?\" ityata 
Aha \dash \" yoga\" iti |  \" j~nAnopAyaviShayAmimAM vaxyamANAM vAchaM shR^iNu |
shrutvA tatra niShThAM kuru, ityuktam\" ityarthaH |  shravaNamAtrasya vidhinA
vinA.api sambhavAt |  

\" bahvyo buddhyaH j~nAnopAyaviShayA vAchaH parasparaviruddhAH santi |  katham\? 
matabhedAt |  ekaM matamavalambamAnAH kiJNchijj~nAnasAdhanamAchaxate |  aparaM
matamAshritAH tatpratiShedhenAnyadAhuH |  tatra cha \" idameva tattvaM, nedam\", iti
vinigamakaM nAsti |  tattasmAt kathamekatra tvadIyAyAmeva vAchi niShThAM vishvAsaM 
karomi\?  nanu sarvANyapi matAni vyavasAyAtmakAnyeva |  svesve.arthe sarveShAM
sandehAbhAvAt |  ataH kathamuchyate \" vyavasAyAtmikA eka, avyavasAyinAM 
buddhaya\" iti\?\"

tatrAha \dash \" samyag\" iti |  \" yuktiH\" iti pramANasAmAnyamuchyate |  \" pramANena
nirNItatvamevAtra vyavasAyashabdArtho, na nishchayamAtram\", ityarthaH |  \" prAmANikameva 
mataM grAhyam |  tatra cha na kAchit vipratipattiH |  yatastavaikatra niShThA.abhAvaH |  
aprAmANikeShu vidyamAnA.api vipratipattiH kiM kariShyati\?\" iti bhAvaH  || 40\-41||
%%% ##endlabel##

%%% ##label=<segment053_pd02>##

{\Largedvng pra\.dI\. ||} \" yAmimAm\" iti shlokatrayasya prakR^itopayogAdarshanAt saN^gatiM
Aha \dash \" syuH\" iti |  na tu vaidikAnyavyavasAyAtmakAni |  \" tataH 
kiM prakR^ita\?\" ityata uktaM \dash \" te.api\" iti |  vyavasAyAtmakaM mataM 
vaidikamavalambamAnA api kechit vaidikAnyapi sarvANyeva karmANi 
svargAdiphalAnyAhuH |  \" bhavAmstu kAmyArthAnyeva karmANi svargAdiphalAni | 
niShkAmAnIshvarArpaNabuddhyA.anuShThitAni tu j~nAnArthAnItyabhipraiti |  tathAcha 
tvadvachane niShThA.anupapattistadavasthA\" iti bhAvaH |  Aha |  \" teShAM 
vaidikAbhAsatApradarshanAya nindAm\" iti sheShaH |  bhogaishvaryagaterapi 
prakR^itatvAt \" tayA\" iti tatparAmarshabhrAntiM vArayati \dash \" yAm\" 
iti |  \" anyathA yachChabdaH sAkAN^xo.ananvitaH syAd\" iti bhAvaH |
\" vAchaH puShpitatvaM katham\?\" ityata Aha \dash \" moxa\" iti |  atyalpatvena
upamA |  \" vedavAdaratAH ityetat kathaM nindAvachanam\?\" ityata Aha \dash \" veda\" 
iti |  \" kathametadasmAt padAllabhyate\? kathaM chaiShA.api nindA\?\" ityata Aha 
\dash \" vedaiH\" iti |  \" vAda\" shabdo.atrApAtataH pratipAdane vartate |  vaxyate 
chAtrAbhidhAnam |  ApAtataH pratipAdyaM cha karmAdi |  sAvadhAraNaM cha 
tat |  \" abbhaxo vAyubhaxa iti yathA\" ityarthaH |  \" sAvadhAraNatvaM kuta\?\" 
iti chet \" uttarapadabalAd\" iti tAni paThati \dash \" nAnyad\" iti | 
\" ApAtataH pratItArthAdanyasya sadbhAve bhavedeShA nindA |  ko.asau kutashcha\?\" 
ityata Aha \dash \" paroxa\" iti |  kvachit prakaTavachanAt \" iva\" ityuktam |
ata eva \" prAyaH\" ityAha |  \" devA\" vedAbhimAninaH tatprakArasUchanArthaM
\" mAM vidhatte\" ityAdyudAhR^itam |  vadanti vedAH |  \" gati\" shabdasya
avagatirapyarthaH pratIyate |  ata Aha \dash \" bhoga\" iti |  \" anyathA.asadanuvAdatva\-
prasaN^gAd\" iti bhAvaH |  \" eShA.api kathaM nindA\?\" ityata Aha \dash \" tatprApti\" 
iti |  \" moxaM vedaphalaM na manyanta\" ityarthaH |  \" tayA.apahR^ita\" 
(shAM\.bhA\. 2\.44) ityAderapratItinirAsAyArthamAha \dash \" teshhAm\" iti |  \" teShAM
buddhiH manovR^ittiH vyavasAyAtmikA samyagyuktinirNayAtmikA na bhavati |  tata eveshvare
samyaksamAdhAnArthaM na vidhIyata\" ityarthaH |  \" samyagyuktinirNayAtmakatvAbhAve
kutaH samAdhyabhAva\?\" ityata Aha \dash \" samyag\" iti |  anena samAdhishabdArtho.api
vivR^ito bhavati |  \" kimIshvare manassamAdhAnena\?  yena tadabhAvo nindA syAd\" 
ityata Aha \dash \" taddhi\" iti |   \" moxAbhAvashcha mahAnindA\" iti vaxyati |
\" samyaN^nirNItArthAnAM ityuktaM na kevalamAnubhAvikam |  kintu purANe.apyuktam\" 
ityAha \dash \" uktaM cha\" iti |  \" varIyasIH\" varIyasyaH |  \" supAM suluk\" 
(aShTA\. 7\.1\.39) ityAdinA jasaH pUrvasavarNaH |  \" vAcho\" vedavAchaH |
svapne niruktyA svapnapratItArthadR^iShTAntena |  \" heyAnumitam\" heyatvenAnumitam |
idameva hi samyaN^nirNItArthatvaM yat heyopAdeyavivekena heyahAnaM upAdeyopAdAnaM
cha |  taddhi moxasAdhanamityetachChrutyAdiprasiddhameva || 42\-44||
%%% ##endlabel##

%%% ##label=<segment054_pd02>##

{\Largedvng pra\.dI\. ||} \" yathaiShA chatushshlokI na pratij~nAtaM yogamAha, tathA traiguNya
ityetadapi\" (shAM\.bhA\.2\.45) iti pratItinirAsAyAha \dash \" tAm\" iti | 
pratij~nAtAm |  \" Adi\" grahaNenAShThaparisamApteriti sUchayati |  saptamopakrame
punaH pratij~nAnAt |  \" tarhi pratij~nAnantarameva kuto nAvochad\" iti 
mandAshaN^kAnirAsAyoktam \dash \" itarad\" iti |  svoktau niShThA.abhAve 
kAraNamevamapodyedAnIM pratij~nAtamAha |  anyathA \" tatpratibandhenAsyAvasarAbhAvAd\" 
iti bhAvaH |  athavA vaxyamANAnAM vAkyAnAM dvedhA vR^ittimanenAchaShTe \dash \" kaishchit 
vAkyaiH itaradyogaviruddhamapodya kaishchidyogamAha\" iti |  yadvA \" bahUni me 
vyatItAni\" (4\.5) ityAdi prAsaN^gikaM vihAyAnyadyogaviShayaM j~nAtavyam |  tathA cha 
vaxyati \" sAdhanaM prAdhAnyenoktam\" iti |  \" vedAH traiguNyaviShayAH tvaM tu
nistraiguNyo bhava\" ityanena \" vedaparityAgo vidhIyata\" ityanyathApratItinirAsAya 
vyAchaShTe \dash \" vedAnAm\" iti |  \" triguNasambandhi\" ityanena
\" tasyedam\" ityarthe taddhito.ayaM ShyaJN |  \" vichitrA hi taddhitagatiH iti 
vachanAd\" iti sUchayati |  sambandhi kAryam |  \" pratItitaH\" ApAta\-
pratItitaH |  arthaH pratipAdyaM prayojanaM cha |  \" vedAnAM paroxArthatvaM kuta\?\"
ityata Aha \dash \" paroxa\" iti |  \" yata evaM bhrAntirataH prAptisadbhAvAt 
prasaktAM bhrAntiM mA kArShIH |  kathametadanena labhyata\" ityata Aha \dash \" vAda\" 
iti |  \" vedavAdaratAH\" ityatrApyetadevAbhidhAnam |  \" pratIta evArtho.astu\" 
ityata Aha \dash \" na tu\" iti |  paxaH paramasiddhAntaH |  \" uttAnArtho vedo
niShidhyata eva yogaviruddhatvAd\" ityataH \" paxaH\" ityuktam |  \" kuta\?\" 
ityata Aha \dash \" veda\" iti |  \" dharmamUlam\" dharmaj~napteH kAraNam |
\" tadvidAm\" vedavidAM manvAdInAm |  \" smR^itiH\" granthaH |  \" shIlam\" 
manogatiH |  \" AchAro\" dharmabuddhyA.anuShThAnam |  \" Atmano\" manaso
ruchirvikalpaviShaye |  \" praNihito\" vihitaH |  \" tadviparyayaH\" pratiShiddhaH |
\" vivaxitayogavirodhe hi vedasiddhAnto niShedhyaH syAt |  na chaivam |  
pratyuta tadanuguNa eva\" iti bhAvaH |  dharmashabdo.atra nivR^ittidharmaparaH || 45||
%%% ##endlabel##

%%% ##label=<segment055_pd02>##

{\Largedvng pra\.dI\. ||} \" yogopadeshaprasaN^ge j~nAnaphalakathanasya ka upayoga\?\" ityata 
Aha \dash \" tathApi\" iti |  \" yAmimAm\" ityatra kAmyakarmiNAM nindA kR^itA |
\" nistraiguNyo bhava\" iti cha tattyAgo vihitaH |  \" tatra praShTavyaM kinnimittaM
etad\?\" iti |  \" nanUktaM kAmyakarmiNAM samAdhyabhAvena j~nAnAbhAvAt moxo na
bhavati\" iti |  atredamuchyate |  yadyapi j~nAnaphalaM kAmyakarmiNAM na bhavati |  
tathApi tannindAdi nopapadyate |  yataH \" kAmyakarmiNAM phalaM svargAdikaM 
j~nAninAM na bhavati\" iti \" j~nAnakarmamArgayoH sAmyameveti yogAnuShThAnaniyamAxepe 
satyAha\" ityarthaH |  kechidasya shlokasya karmamAtratyAge tAtparyamAhuH 
(shAM\.bhA\.2\.46) |  apare tu \" yatkarmasamucchitaM j~nAnaM moxasAdhanaM 
tatkarmapara eva vedabhAgo.adhigantavyaH |  na tu samastavedAbhyAsenAyuH
samApanIyamityatra\" (rA\.bhA\.2\.46) |  tannirAsAya vyAchaShTe \dash \" yathA\" iti | 
sAmarthyAt yathaivaMshabdayoradhyAhAraH |  \" yAvAn\" \" tAvAn\" ityetayoH
AvR^ittishcha |  \" sarveShu vedeShu\" iti |  \" taduktakAmyakarmiNAm\" ityarthaH |
\" brAhmaNasya iti na xatriyAdivyAvR^ittiH shaN^kyA\" iti bhAvenAha \dash \" brahma\" 
iti |  varNaviparyayo niruktatvAt |  \" evaM tarhi brAhmaNashabdo muktavAchI syAt |  
na cha muktasya phalamasti\" ityata Aha \dash \" aparoxa\" iti |  tadupapAdayati 
\dash \" sa hi\" iti |  \" tarhi \" vijAnataH\" iti punaruktiH\" iti chenna |  
tasya paroxaj~nAnivAchitvAt |  \" ubhayagrahaNamanupapannam\" ityata Aha \dash 
\" vijAnata\" iti |  tasyAparoxaj~nAnasya paroxaj~nAnaphalatvam |  etachcha 
svarUpakathanam |  \" yadyapi j~nAninaH karmiNashchAnyonyaphalAbhAvaH |  tathA.api j~nAninaH
phalaM mahAsamudrodakamiva mahat |  karmiphalaM tu kUpodakamivAtyantAlpam |  ataH
kutastayoH sAmyam\? tathAchAlpAsthiraphalakarmanindayA mahAnantaphalaj~nAnasAdhane
yoge preraNaM yuktameva\" iti bhAvaH |  apavyAkhyAnaM tUktavaxyamANanyAyanirastam || 46||
%%% ##endlabel##

%%% ##label=<segment056_pd02>##

{\Largedvng pra\.dI\. ||} \" j~nAninAM karmAbhAvamuktvA idAnImaj~nAninaH karma chochyata\" 	
(shAM\.bhA\.2\.47) ityanyathAvyAkhyAnanirAsAyAha \dash \" kAmAtmanAm\" iti | 
\" eShAm\" karmiNAm |  \" sakAmatayA karma kurvatAM yA nindA kR^itA \" yAmimAm\" 
ityAdinA sA na yuktA\" ityarthaH |  \" kutaH\?\" \" svargakAmo yajeta\" ityAdau
yajanavat svargakAmasyApi vihitatvAt |  na hi vihitaM kurvatAM nindyatvam |  
tathAtve yajanasyApi nindyatvaprasaN^gAditi vadan vishiShTavidhitvaM manyate pUrvapaxI |
\" te ityetadarjunamAtraviShayam\" (shAM\.bhA\.2\.47) ityanyathApratItinirAsAya
Aha \dash \" ta\" iti |  \" sarvavarNAshramopalaxaNamarthaH prayojanamasya\" iti
tathoktam |  \" vaktaryAyatte shabdaprayoge vAchakameva prayujyatAm |  kiM laxaNayA\?\" 
ityata Aha \dash \" tava\" iti |  phalakAmaH kartavyo yasyAsau tathoktaH |  tasya
bhAvaH tattA |  \" phalakAmasya kartavyatA tava kartuH\" iti vA |  kR^ito.api phalakAmo
na j~nAnino.atyantabAdhakaH |  tatpratibandhanIyasya j~nAnasyAptatvAt |  moxasya cha 
niyatatvAt |  tathA.api moxavilambahetutvAttasyApi na kartavyaH |  \" kimvanyeShAM
aj~nAninAmiti pradarshanAyopalaxakapadaprayoga\" iti bhAvaH |  \" nanu 
\" karmaNyevAdhikAro mA phaleShu\" iti dvayamuktam |  tatkathaM na 
phalakAmakartavyatetyekasyaiva grahaNam\?\" |

uchyate \dash phalakAmakartavyatAniShedhasyaivAtra prAdhAnyAt |  \" karmaNyadhikAraH\" 
iti hi tadartho.anuvAdaH |  \" tathA.api na phalakAmAdhikAra iti vaktavyam\" |  maivam |  
adhikArabhAvAbhAvayoH kartavyatvAkartavyatvasamarthanArthamuktatvena 
sAdhyasyaivopAdAnAt |  tathA cha vaxyati |  \" te ityupalaxaNArtham\" ityuktasya 
vyAvartyamAha \dash \" na tu\" iti |  keShAJNchit \" phalakAmakartavyatA.asti, 
kevalaM te nAsti\" ityarthastu netyarthaH |  \" kAmAn yaH kAmayate\" (mu\.u\. 3\.2\.2) 
ityAdau sarveShAM niShedhAditi bhAvaH |  \" nanvarjunasya j~nAnitve syAdidam |  
tadeva kuta\?\" ityata Aha \dash \" sa hi\" iti |  \" hi\" shabdasUchitAM 
pramANaprasiddhimeva darshayati \dash \" narAMsha\" iti |  \" kathaM tarhi 
yajj~nAtvA na punarmohaM ityarjunasya moha uchyate\? kathaM cha prashnakaraNam\?\" 
ityata Aha \dash \" mohAdistu\" iti |  \" balavatA prArabdhakarmAdinA 
j~nAnasyAbhibhavAnmohaH, visheShaj~nAnAdyarthaH prashna\" iti bhAvaH |  
\" nanvindrAdInAmeva kuto j~nAnitvam\?\" ityata Aha \dash \" yadi\" iti |  
sattvaM hi j~nAnakAraNam |  \" sattvAt saJNjAyate j~nAnam\" iti vachanAt |
devAshcha shuddhasattvAH |  ataH kAraNasadbhAvAdyuktaM teShAM j~nAnam |  anyathA na
kasyApi syAt |  itashchendrAdayo j~nAnina ityAha \dash \" upadesha\" iti | 
\" etaduhaivendro vishvAmitrAya provAcha\" ityAdirupadeshaH |  \" Adi\" padena
prajApatau brahmacharyam |  arjunasya j~nAnitve pramANAntaramAha \dash \" pArtha\" 
iti |  j~nAniShu gaNanAt |  etenApavyAkhyAnamapi nirastam |
%%% ##endlabel##

%%% ##label=<segment057_pd02>##

{\Largedvng pra\.dI\. ||} \" nanvatra mA phaleShu iti phalaviShayo niShedhaH kR^itaH |  tatkathaM
uktaM phalakAmeti\?\" tatrAha \dash \" kAma\" iti |  \" phala\" shabdena
tadviShayakaM kAmamupalaxya tadviShayo niShedho.atra kriyate |  na phalaviShaya
ityarthaH |  \" kuto laxaNAshrayaNam\?\" ityata Aha \dash \" phalAni hi\" iti |  
\" yatra hi puruShasya kartumakartuM vA svAtantryaM tatraiva niShedho nAnyatra |
prasakterabhAvAt |  na cha phaleShu svAtantryamasti | ato mukhye bAdhakAt
laxaNAshrayaNam\" ityarthaH |  \" kathamasvAtantryam\?\" ityataH karaNe
tAvadAha \dash \" na hi\" iti |  akaraNe.api tadAha \dash \" bhavanti cha\" 
iti |  \" cha\" avadhAraNe |  avirodhe brahmadarshanAditadvirodhyabhAve |
tadanena \" te\" iti \" phaleShu\" iti cha padadvayaM vyAkhyAtam |
%%% ##endlabel##

%%% ##label=<segment058_pd02>##

{\Largedvng pra\.dI\. ||} \" syAdetat |  \" svargakAmo yajeta\" ityAdau svargAdikAmanA\-
vishiShTaM yajanAdikaM karma kartavyatayochyate |  ato na kAmAtmanAM nindochitA\" 
iti shaN^kAyAM \" kimetat karmaNyevAdhikAraH\?\" ityasaN^gatamuchyate |  \" yashcha
karmavat kAmanAyA api kAryatAM manyate, kutastasya phalakAmanAyAmadhikArabhAvaH 
siddhaH\? \" phaleShu\" iti lAxaNikapadaprayoge cha kiM nimittam\?\" ityAshaN^kya 
pUrvArdhaM vyAchaShTe \dash \" ata\" iti |  \" ata\" ityasya vaxyamANena \" bhUtvA\" 
ityataH pareNa \" ityarthaH\" ityanenAnvayaH |  \" ata uktanyAyena padadvayasya
lAxaNikatve satItyarthaH shlokArdhasya sampadyata\" iti sheShaH |  tatra tAvat
\" karmaNyevAdhikAraH sarvavarNAshramiNAM, na phalakAmanAyAm\" ityukte.arthadvaye
hetudvayamAha \dash \" karmAkaraNa eva\" iti |  \" kurvanneveha karmANi\" 
(IshA\.u\.2) ityuktvA \" evaM tvayi nAnyatheto.asti na karma lipyate nare\" 
(IshA\.u\.2) ityuktatvAt karmAkaraNa eva pratyavAyo.aniShTaprAptIShTAprAptilaxaNaH |
natvakAmanayA pratyavAyaH |  pramANAbhAvAt |  \" nanu kAmAbhAve tatphalAnavApteH
kathaM pratyavAyAbhAva\?\" ityata uktaM \dash \" phalAprAptau\" iti |  \" kAmya\-
phalAprAptAvapi na pratyavAya\" ityetadupapAdanAyoktaM \dash \" j~nAnAdinA vA\" 
iti |  \" vA\" shabdaM upamAyAm |  yathA j~nAnAdinA sAdhanena moxaM gachChataH
svargAdyalAbho na khedahetuH |  mahAphalalAbhe.alpahAnerakiJNchitkaratvAt |
tathA.akAmanayA phalAprAptAvapi na khedaH |  niShkAmena karmaNA mahAphalasya j~nAnAdeH
lAbhAditi bhAvaH |  \" tataH kim\?\" ityata uktasya hetudvayasya gItoktaM
sAdhyadvayamAha \dash \" ata\" iti |  \" na tu phalakAmanAyAm\" iti cha 
vaktavyam |  \" yata evaM karmAkaraNe pratyavAyo.ataH karmaNyevAdhikAraH |  yataH
kAmAkaraNe na pratyavAyo.ato na kAme.adhikAra\" ityarthaH |  \" tataH kiM prakR^ita\?\" 
ityataH paramasAdhyadvayamAha \dash \" ata\" iti |  yataH karmaNyevAdhikAro.atastadeva
kAryam |  vidhiviShaya ityarthaH |  yataH kAme nAdhikAro.ataH kAmena phalaprAptiH
phalaprAptaye kAma iti yAvat na kAryaH |  tatra dR^iShTAnto j~nAnAdiniShedhena \" vA\" 
iti |  atrApi \" vA\" shabda upamAyAm |  \" yathA prexAvatA j~nAnAdikaM parityajya
phalaprAptirna kriyate tathA\" ityarthaH |  pUrvokta evAbhiprAyaH |  \" yadi karmaiva
vidhiviShaya na kAmaH tarhi \" svargakAmo yajeta\" ityAdivAkyAnAM kiM tAtparyam\?\" 
ityata Aha \dash \" kAmavachanAnAM tu\" iti |  anAdiviShayavAsanAvAsitAntaHkaraNA
na sahasA j~nAnasAdhane karmaNi pravartayituM shakyante |  atasteShAM karmaNyabhiruchi\-
jananArthaM \" svargakAmaH\" ityAdiphalashrutiH pravR^ittA |  karmaNi pravR^ittAnstu
shanaiH \" kAmaM tyAjayiShyAmi\" ityabhiprAyavatI |  \" yathA phalena pralobhya bAlAnAM
bhaiShajyarochanaM kriyate tathA\" ityarthaH |  \" astvevaM tAtparyaM, yojanA tu katham\?\" 
ityata Aha \dash \" ata eva\" iti |  yata evaM nyAyena karmaNa eva kAryatvaM 
na kAmasyeti prAptamataH \" kAmI yajeta\" ityeva shruterarthaH |  \" kAmAnuvAdena\" 
yajanaM vidhIyata\" iti yAvat |  \" eva\" shabdavyAvartyamAha \dash \" na tu\" 
iti |  \" kAmavishiShTayajanavidhAnaM tu na\" ityarthaH |  etaduktaM bhavati |
vishiShTavidhAnashaN^kAyAM \" nedaM vishiShTavidhAnaM kintu kAmAnuvAdena yajanasyaiva\" 
iti paramasAdhyamatrAdhyAhAryam |  \" tatkuta\?\" ityapexAyAM \" karmaNa eva 
kAryatvAt kAmasya tadabhAvAd\" iti hetuvachanaM chopaskartavyam |  \" tadapi
kuta\?\" ityapexAyAM \" karmaNyevAdhikAro na phalakAma\" iti gItoktayoH 
hetvorupasthAnam |  \" etadapi kuta\?\" ityapexAyAM karmakAmAkaraNayoH 
pratyavAyabhAvAbhAvayoH hetvoradhyAhAraH |  etadupapAdanAya 
lAxaNikaphalashabdopAdAnamiti |  bhAskarastvAha \dash 
\" nityanaimittikAnyeva karmANi mumuxuNA niShkAmatayA kartavyAni |  na tu 
jyotiShTomAdIni kAmAdhikAre vihitAni |  teShAM niShkAmatayA karaNe pramANAbhAvAt |
ato.asadidaM vyAkhyAnam\" iti |  tatrA.aha \dash \" niShkAmam\" iti |  yaj~nAdikameva
prakramya tasya niShkAmatayA.anuShThAnavachanAdyuktamidaM vyAkhyAnam |  \" etAnyapi
tu karmANi saN^gaM tyaktvA\" (18\.6) ityAdivaxyamANavachanebhyashcha |  na chaitAni
nityanaimittikaviShayANi |  tatra kAmaprasaktyabhAvena tatpratiShedhAnupapatteH |  kiM
cha nityanaimittikAtiriktasya jyotirnAmakasya yaj~nasya phalakAmanayA vinA vidhAnAchcha |
jyotiShTomasyaivAyaM guNavidhAnAyAnuvAda iti tu na sammatam |  \" Adi\" padena
\" vishvajitA yajeta\" ityAdergrahaNam |  \" tatrApi svargakAmapadAdhyAhAro 
nirNIta\" iti chet, \" satyam |  kAminAM tu tathA  |  svavachanenAnuktau tu 
kAraNamihoktam\" iti |  

\" nanu pUrvArdhenaiva shaN^kAyA nirastatvAt kimuttarArdhena\?\" ityataH krameNa
pAdadvayopayogamAha \dash \" ata\" iti |  phalakAmasyAkartavyatvAt |  
\" karmaphalahetutvamaprasaktaM kimiti niShidhyata\?\" ityata Aha \dash \" karmaphalam\" 
iti |  \" shAkapArthivAdivat tatkR^itipadalopo.atra\" iti bhAvaH |  \" tarhi\" 
iti |  \" yadi phalaM nA.akAN^xyam\" ityarthaH |  \" na karomi svayaM klesharUpatvAd\" 
iti bhAvaH |  akarmashabdasya niShiddhe.api pravR^itteH saN^gashabdasya chAnekArthatvAt
prakR^itopayuktatayA vyAchaShTe \dash \" karma\" iti |  \" sopapattikamAxipte 
kathamidamuttaram\?\" ityato bhagavadabhiprAyamAha \dash \" anya\" iti |  \" prasAda\"
shabdena bhaktij~nAnAdikamupalaxyate |  evaM tarhi \" bhagavatprasAdAdi ichChayA 
karma kartavyamityuktaM syAt |  na cha tadyuktam |  kAmasya ninditatvAt |
anyathA svargAdikAmanAyA apyaniShiddhatvaprasaN^gAt |  ato nedaM bhagavadabhiprAya\-
varNanaM yuktam\" ityata Aha \dash \" ichChA cha\" iti |  \" te tava paritoShaNAya
sakalaM karma vR^iNImaha\" iti mahadAchAreNa bhagavatparitoShaNasya kartavyatAvagamAt |
\" nanvakartavyatAyAmapi kAmanindAvachanaM pramANamastItyuktam\" ityata Aha \dash 
\" anindanAd visheShata\" iti |  \" yathA mahadAchAro visheShaviShayo na tathA 
kAmanindAvachanam |  kintu sAmAnyaviShayameva |  ato mahadAchAreNa bAdhyata\" 
iti bhAvaH |  \" tarhi tadvatsvargAdikAmanA.api kAryA\" iti yaduktaM tatrA.aha 
\dash \" visheShata\" iti |  \" cha\" shabdena pramANAbhAvaM samuchchinoti |  
astvAchAro visheShaviShayaH |  kAmanindAvachanaM cha sAmAnyaviShayam |  
\" tathA.api kuto bAdhyabAdhakabhAva\?\" ityata Aha \dash \" sAmAnyam\" iti |  
sAmAnyavisheShashabdau tadviShayapramANaparau |  \" cha\" shabdAdavirodhe sati |  
uktaM pramANamupasaMharan pramANAntarANyapyatrA.aha \dash \" ata\" iti |  
\" ekAtmatAm\" sAyujyam |  \" asyaiva visheSho.ayaM bhaktimanvichChanta\" iti |  
\" nanu \" brahmajij~nAsA\" shabdo na j~nAnechChAparaH |  kintu vichArasyopalaxakaH\" |  
satyam |  tathA.api tatpUrvako vichAro laxyate |  anyathA sambandhAbhAvAt | 
lokasiddhanyAyAllokasiddhavyAptikAnumAnAt || 47||
%%% ##endlabel##

%%% ##label=<segment059_pd02>##

{\Largedvng pra\.dI\. ||} \" karmaNyeva\" (2\.47) ityanena \" yogasthaH\" ityasya 
gatArthatAparihArArthamAha, \" pUrva\" iti |  

niShkAmatAdivishiShTAni karmANyeva \" yogaH\" |  ato \" yogasthaH\" ityanenaiva 
labdhaM punaH \" kuru karmANi\" iti kimarthamuchyata\?\" ityata Aha \dash \" yogastha\"
iti |  \" j~nAnopAyamanutiShThan\", ityarthaH |  \" karmasambandhaM tyaktvA, karmANi 
kuru, ityetad vyAhatam\" ityata Aha \dash \" saN^gam\" iti |  \" Ishvaro me 
prasIdatu, iti abhisandhimapi tyaktvA\" iti vyAkhyAnaM pUrvameva nirastam |  
\" tata eva\" iti parAmarshasaukaryAya \" tyaktvA\" ityanuvAdaH kR^itaH |

\" saN^gaM tyaktvA\", \" siddhyasiddhyoH samo bhUtvA\" iti dvayamuktvA,
\" samatvaM yoga uchyate\" ityekasyaiva grahaNamayuktam |  tathA sati,
saN^gatyAgasya ayogatvaprasaN^gAd, ityata Aha \dash \" tata eva\" iti |
\" saN^gatyAgAdeva etayoH kAryakAraNabhAvAt, kArye gR^ihIte kAraNamarthAd
gR^ihItameva\", iti bhAvaH |

\" nanu samatvayogayorbhedaH kena shaN^kito, yena \" samatvaM yoga uchyate\"
iti tayoraikyamuchyate\?\" ityata Aha \dash \" sa eva cha\" iti |  \" yogasthaH\"
ityukte \" ko yoga\?\" ityapexAyAM bhagavatA \" saN^gaM tyaktvA\", \" siddhyasiddhyoH
samo bhUtvA\" iti yogo vyAkhyAtaH |  \" mandAstu pR^ithageva te visheShaNe
kalpayiShyanti, iti tadanujighR^ixayA, idamuditam\" iti bhAvaH |  \" sa eva 
yat samatvam\" iti sheShaH |  yogaikadeshe \" yoga\" shabdaH  || 48||
%%% ##endlabel##

%%% ##label=<segment060_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu yogopadeshamupakramya karmaNo buddhiyogAdavaratvaM kimarthamuchyate\?\"
ityata Aha \dash \" itashcha\" iti |  \" yujyasva\" prayatasva |  \" yAvAnarthaH\"
iti karmaphalasya j~nAnaphalApexayA.alpatvAt \" yogAya yujyasva\" ityuktam |
atra tu tatraiva hetvantaramuchyate |  \" buddhiyogAd\" iti ShaShThIsamAsapratIti
nirAsAya Aha \dash \" buddhiyogAd\" iti |  \" laxaNa\" shabdaH svarUpArthaH |
\" puruShArthasambandhinA karmaNA saha nirdeshe tathAbhUtasya j~nAnasyaiva grahaNaM
yuktam\" iti bhAvaH |  upAyAt puruShArthasya |  \" dUra\" shabdo viprakarShavAchI |
\" tasyAtra kathamanvaya\?\" ityata Aha \dash \" dUreNa\" iti |  \" uktaM j~nAnAt
karmaNo.atIvAvaratvamidAnImupapAdanIyam |  tadvihAya kimidaM tR^itIyapAdenochyata 
ityataH sAdhyanirdesho.ayam\" iti sUchayan vyAchaShTe \dash \" ata\" iti |  j~nAne 
sthitiM tadupAyayogAnuShThAnalaxaNAm |  \" phalahetUnAM kR^ipaNatvavarNanamanupayuktam\"
ityata Aha \dash \" phalam\" iti || 49||
%%% ##endlabel##

%%% ##label=<segment061_pd02>##

{\Largedvng pra\.dI\. ||} \" buddhiyuktaH prexAvAn kAmyaM sukR^itaM duShkR^itaM cha jahyAd\"
iti yogasvarUpanirUpaNaparatAM nirAkartumAha \dash \" j~nAna\" iti |  \" kathaM
karmaNo j~nAnAdatIvAvaratvam\?\" ityataH \" kAmyakarmiNaH kR^ipaNA dInAH, \" imaM
lokaM hInataraM vA vishanti\" ityukteH\" ityuktam |  tathA.api \" kathaM dUreNAvaram\?\" 
ityapexAyAM \" karmaphalAdvilaxaNaM j~nAnaphalamAha\" ityarthaH |  pratItArthe
anupapattiM tUttaratra darshayiShyati |  atra duShkR^itavatsukR^itasyApi sarvAtmanA hAnaM
pratIyate |  tatsaN^kochena vyAchaShTe \dash \" sukR^itamapi\" iti |  \" apriyaM
sukR^itaM kIdR^isham\?\" ityata Aha \dash \" mAnuShyAdi\" iti |  vyAvartyamAha 
\dash \" na\" iti |  bR^ihat prAN^ mukteH j~nAnAdiguNavivR^idvilaxaNaM, tadanantaraM
chA.anandavR^iddhirUpaM phalaM yasya tad \" bR^ihatphalam\" |  \" tathAbhUtaM sukR^itameva
nAsti, kAraNAbhAvAd\" ityata Aha \dash \" upAsanA\" iti |  \" Adi\" padena
nivR^ittaM karma |  \" kutaH saN^kocha\?\" ityata Aha \dash \" na hAsya\" iti |  
\" yajate\" dadAti |  \" tapyate\" anena |  atrApi \" aviditvA\" iti 
visheShaNAjj~nAninaH sukR^itAxayaH pratIyate |  uttaratra vA.asyA shruterupayogaH | 
\" nanu \" nAstyakR^itaH kR^itena\" ityAdishravaNAt satpratipaxA etAH shrutaya\" 
ityata Aha \dash \" ata\" iti |  \" visheShashruterbalavattvAd\" iti bhAvaH |
\" shrutiH\" shravaNam |  \" xIyante chAsya karmANi iti j~nAnino.api karmaxayaH
pratIyata\" iti chenna |  niravakAshashrutivirodhenAsya duShkR^itaviShayatvAt |
\" tadA vidvAn puNyapApe vidhUya iti j~nAnino.apyubhayaxayashrutirasti\" ityata 
Aha \dash \" ubhaya\" iti |  uktaiva yuktiH |  yuktiviruddhaM cha j~nAninaH 
sarvasukR^itahAnam |  tathAhi |  upAsanAdijanitaM sukR^itaM j~nAninaH kimiShTaM
utAniShTam\? Adye kiM tattadichChayA xIyata uta j~nAnasvabhAvAt\? AdyaM 
dUShayati \dash \" na hi\" iti |  \" yena j~nAnI tatxayamichChed\" iti sheShaH |  
dvitIyaM nirAkaroti \dash \" na cha\" iti |  \" j~nAnasyApuruShArthatA\-
prasaN^gAd\" iti bhAvaH |  nAntyaH |  aniShTatve kAraNAbhAvAt |  \" niShphala\-
tvAdaniShTam\" ityata Aha \dash \" iShTAshcha\" iti |  \" kechid\" ityalaukikAH |
muktau alaukikA viShayA iShTA bhavanti |  \" tatprAptiH sukR^itaphalam\" iti 
bhAvaH |  \" mukto viShayAnichChatItyetat kuta\?\" ityata Aha \dash \" sa yadi\" 
iti |  \" yashaH\" yashasvI |  brAhmaNAnAM sakAshAt |  mukto yadyatkAmayate 
tattatkarmA.asmAt paramAtmanaH sR^ijate |  \" iShTaviShayaprAptiH sukR^itaphalam\" 
ityetadapi anayA shrutyochyate |  \" upAsanAdikameva j~nAnI na karoti |  
kR^itena vA sukR^itaM na jAyata\" ityetadapyanayA nirAkR^itam |  

\" nanu muktaH kimarthaM viShayAnichChet\? na tAvat sukhArtham |  j~nAnenA.avaraNa\-
rUpAvidyAnivR^ittAvAtmasvarUpasukhasya vyaktatvAt |  pR^ithak sukhasyAnaN^gIkArAt |
nApi duHkhanivR^ittyartham |  avidyAnivR^ittyaiva tatsiddheH\" iti |  maivam |  
nAvidyaivA.atmasvarUpAvaraNam |  kintvIshvarechChA.api |  tathA cha vaxyati |  tathA 
cha j~nAnenAvidyAyAM nivR^ittAyAmasheShAniShTanivR^ittirbhavati |  svarUpasukhaM cha 
bahutaraM vyajyate |  na tu sarvam |  j~nAnottaramanuShThitena nivR^ittakarmaNA prasannaH 
parameshvaro muktau viShayAnutpAdya tadbhogena j~nAnAnabhivyaktamapi svarUpasukhaM
vyaktIkaroti |  atra cha bhAShyakR^itaiva tatratatra pramANAnyuktAni |  
anenaivAbhiprAyeNa shrutyAdiShu mukterj~nAnamAtrasAdhyatvaM j~nAnakarmasamuchchayasAdhyatvaM 
chochyate |

\" nanu j~nAnamAtrasAdhyaM yatsvarUpasukhaM tadeva bahutaramasti |  ataH karmasAdhya\-
viShayabhogavyaN^gyasukhAN^gIkAraH kimartham\?\" ityata Aha \dash \" bahutve.api\" 
iti |  \" karmasukhe aN^gIkR^ita\" iti sheShaH |  \" sharIrendriyarahitasya 
muktasya kathaM viShayAnubhave shaktiH\?\" ityata Aha \dash \" anubhava\" iti |  
taduktaM \" brAhmeNa jaiminiH\" (bra\.sU\.4\.4\.5) iti |  kiM cha \" kAmarUpyanusaJNcharan\" 
ityAdilIlAvigrahagrahaNashruteshcha muktasya viShayAnubhavo yujyata ityAha \dash 
\" shruteshcha\" iti |  \" nanu yadetadudAhR^itAsu shrutiShu viShayechChAdikaM shrUyate tachcharama
sharIrapAtAt pUrvakAlInaM kiM na syAd\?\" ityata Aha \dash \" na cha\" iti |  
\" asmAchCharIrAt samutthAya sa tatra paryeti\", \" asmAllokAt pretya\",
\" etamAnandamayamAtmAnam\" ityAdyuttaratra shravaNAt |  \" ityAdi\" iti 
kriyAvisheShaNam |
%%% ##endlabel##

%%% ##label=<segment062_pd02>##

{\Largedvng pra\.dI\. ||} advaitavAdinastvAhuH \dash \" brahmaikameva tattvam |  tadeva
upAdhibhedabhinnaM jIvabhAvaM pratipadyate |  gaganamiva ghaTAdyupAdhibhinnaM 
ghaTAkAshAditvam |  tatra yasya jIvasya j~nAnamutpannaM sa brahmaNaikIbhavati |  
ghaTanAshe ghaTAkAsha iva mahAkAsheneti |  tatraike jIvabrahmabhedasyopAdheshcha
mithyAtvaM manyante |  anye cha satyatvam |  yadA cha sa j~nAnI brahmaNaikIbhUtaH 
tadA sakalasya kriyAkArakaphalalaxaNasya bhedasya pravilayAt kuto viShayabhogaH 
yadarthaM sukR^itasyAvasthAnam\?\" iti |

taddUShayati \dash \" na cha\" iti |  \" eva\" shabdena bhedAbhedau nirAkaroti |

\ \ \ \" paramAtmAnamAsAdya tadbhUtA yatayo.amalAH |
\ \ \ amR^itatvAya kalpante na nivartanti chAbhibhoH\" ||

\dash (mahA\.12\.90\.75) iti bhIShmeNa \" tasmin bhUtAH tadbhUtAH\" ityabhiprAyeNokte
\" muktAstadbrahmaiva bhUtAH\" ityarthAntaramAshaN^kya yudhiShThireNa \" AjanmamaraNaM 
vA te smarantyuta navA.anagha\" (mahA\.12\.90\.76) iti vikalpya pR^iShTaM yadi
j~nAnino muktau brahmaNaikIbhavanti tadaivaM vAchyam |  \" kiM te saMsAre.anubhUtaM
duHkhaM smarantyuta na\?\" iti |  Adyasya dUShaNamuktam \dash

\ \ \ \" moxe doSha mahAneSha prApya siddhiM gatAnR^iShIn |
\ \ \ yadi tatraiva vij~nAne vartante yatayaH pare\" ||

\dash (mahA\.12\.90\.78) iti |  pUrvaM siddhiM gatAn R^iShIn prApya pare.api yatayo
yadi tatra muktau vij~nAne vij~nAnena, prAganubhUtaduHkhasya smaraNena yuktA vartante,
tarhi moxe mahAneSha prasiddho doShaH |  doShaM cha bhAShyakAra eva sphuTIkariShyati |
dvitIyo.api dUShitaH \dash \" magnasya hi\" iti |  \" pUrvAnubhUtasmaraNAbhAve
pare.aj~nAne magnasya chetanasya duHkhataraM duHkhAtishayo na bhavet kiM, bhavedeva\"
iti |  \" tadevaM moxadharme.asya paxasya ninditatvAnna j~nAnI brahmaNaikIbhUta\"
ityarthaH |  \" nanu pUrvapaxasthena yudhiShThireNa ninditatve.api kathaM bhIShmeNa
AchAryeNoktamasatsyAt\? parihAre taduktadoShasyoddhArasambhavAd\" ityata Aha 
\dash \" parihAra\" iti |  \" na mayaitaduktam |  kintu tvamanyathA gR^ihItvA
dUShitavAnasi\" ityAshayena parihAre bhIShmeNa \" paramAtmanaH pR^ithaktvena muktAnAM
bhogAbhidhAnAchcha na j~nAnI brahmaNaikIbhUta\" ityarthaH |  tathA hi bhIShmavachanaM \dash

\ \ \ \" tathA.api tattvaM paramaM shR^iNu samyaN^ mayeritam |
\ \ \ indriyANi cha buddhyante svadehaM dehino nR^ipa |
\ \ \ karaNAnyAtmanastAni sUxmaH pashyati taistu saH\" ||

\dash (mahA\.12\.90\.81) iti |  \" yadyapIdaM durbodhaM tathA.api svaH svarUpabhUto 
dehaH yasya taM svadehaM paramAtmAnaM muktAn anyAn dehino viShayAMshcha 
muktasyendriyANi buddhyante |  kiM tAni kartR^INi\? na\" ityAha \" karaNAni\" 
iti |  \" kastarhi pUrvArdhasyArthaM\?\" ityata Aha \dash \" sUxmaH\" iti |  
\" itashcha na j~nAnino brahmaikyam\" ityAha \dash \" shukAdInAm\" iti | 

\" anena vAkyatrayeNa muktAnAM brahmabhede krameNa pratyaxAnumAnAgamA upanyastAH |  tatra
pratyaxaM na bAdhakam |  shukAdayo.api yadyapi j~nAninaH |  tathApIdAnImavinaShTopAdhitvAt
tannimittabhedavattayA dR^ishyante |  prArabdhakarmaxayAdupAdhinAshe brahmaiva saMvR^ittA na
pR^ithagdR^ishyanta\" ityata Aha \dash \" upAdhi\" iti |  \" jIvAstAvadbrahmaNaH
pratibimbA\" iti samarthitam |  tatra yadi tadIyasyopAdhernAsho.aN^gIkriyate tadA 
teShAM nAshaH prasajyate |  darpaNAdyupAdhinAshe mukhAdipratibimbanAshadarshanAdityarthaH |
\" yachchoktaM shukAdayo.avinaShTopAdhitvAdbrahmaNaH pR^ithagdR^ishyanta\" iti |  \" tadapyasad\" 
ityAha \dash \" na cha\" iti |  vastuta ekIbhUtasyopAdhinA.api pR^ithagj~nAne na 
mAnaM pashyAmaH |  gaganAdidR^iShTAntasyAsammatatvAt |  satyopAdhibhedamatasya 
chedaM dUShaNam |

\" kiJNchaupAdhika eva jIvabrahmaNorbhedo vAstavaM tvaikyam\" iti vadan praShTavyaH 
\dash \" kiM brahma nirduHkhaM svarUpamevAnusandhatte na jIvagataM duHkham |  tattu
jIva evAnusandhatta iti paxaH |  uta tadapi\?\" iti |  AdyaM dUShayati \dash 
\" na chaikIbhUtasya\" iti |  \" hastapAdAdyupAdhibhede.api bhokturekatvadarshanAd\" 
iti bhAvaH |  dvitIyaM nirAkaroti \dash \" Asam\" iti |  laN^atra sarvakAlopa\-
laxaNArthaH |  \" jIvarUpeNa duHkhyAsaM svarUpeNa tu neti vyavasthayA.anusandhAnAnna
virodha\" ityata Aha \dash \" anena\" iti |  \" iti cha na yuktam\" iti sheShaH |  
\" kuta\?\" ityata Aha \dash \" bheda\" iti |  \" upAdherabhedakatvasyoktatvAd\" 
iti bhAvaH |

apare tu \" brahmaNaikyamApannasya muktasya pUrvaduHkhAnusmaraNamasti na vA\? |  na 
iti paxe \" magnasya hi\" ityukto doShaH |  Adye kimasau pR^ithak smaratyuta 
brahmAtmaka eva\? prathamasya dUShaNam \dash \" na chaikIbhUtasya\" iti |  dvitIyasya 
\" Asam\" ityAdi\" iti vyAchaxate |  anena \" moxe doSho mahAneShaH\" 
ityukto doShaH pradarshito bhavati | 
%%% ##endlabel##

%%% ##label=<segment063_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu upAdhinAshe nAshAchcha pratibimbasya iti yaduktaM 
tadasat |  bhede hi bimbapratibimbayoretatsyAt |  na chaivam |  kintu 
bimbameva pratibimbam |  tadevedamiti pratyabhij~nAnAt |

\ \ \ \" nexetodyantamAdityaM nAstaM yantaM kadAchana |
\ \ \ noparaktaM na vAristhaM na madhyaM nabhaso gatam\" ||

\dash (manu smR^iti 4\.37) 
iti smR^itAvudyadAdAviva vAristhapratibimbe.apyAdityashabdaprayogAt |  bhedastu 
darpaNAdyupAdhikR^itaH |  tathAchopAdhinAshe bheda eva nashyati |  pratibimbasya kuto
nAshaH\? evaM jIvasyApi\" ityAshaN^kya pratyabhij~nAnaM tAvadasiddhamityAha \dash \" na
cha\" iti |  \" na pashyAmo\" na pratyabhijAnImaH |  \" pratyuta pratyakparAgbhAvAdinA
tayorbhedameva pashyAma\" iti chArthaH |  yachchoktaM \" jIvabrahmaNorbimbapratibimbayoraupAdhiko
bheda iti tannAsmAkamaniShTam |  kintu parasyaiva |  jIvopAdhinAshe pramANAbhAvena
nityatvAt |  tannimittasyApi bhedasya muktau sthiteH\" ityAshayavAnAha \dash \" upAdhi\" 
iti |  \" na pashyAmaH\" ityanuvartate |  \" na kevalamupAdhinAshe pramANAbhAvaH |
kintu tannAshAN^gIkAre bAdhakaJNchAsti\" ityAha \dash \" magnasya\" iti |  upAdhyabhAve
smaraNAdivilopAt |  \" na kevalametAvat |  upAdhinityatve pramANaM chAsti\" 
ityAha \dash \" yAvad\" iti |  \" astu tarhyudAhR^itaM smR^itivAkyaM bimba\-
pratimbayoraikye pramANam\" ityata Aha \dash \" ata\" iti |  pratyaxeNa bhedasya
pratIyamAnatvAt |  \" pratIyamAnamapi\" ityanena \" pratyabhij~nAyAmiva vachanasvarUpe
na vivAdo.asti\" ityAha |  \" vAristhamiti cha vachanaM na parasya mukhyaM sambhavati |
anaupachArikaiH sahapAThe.api bAdhakavashAdaupachArikatvaM \" brahmaj~nAnena vA muktiH\" 
ityAdau dR^iShTam\" iti |  
%%% ##endlabel##

%%% ##label=<segment064_pd02>##

{\Largedvng pra\.dI\. ||} \" evaM shukAdInAmityuktaM pratyaxamupapAditam |  adhunA.astAM
tAvadupapAdanasApexaM pratyaxam |  tannirapexaM chAsti\" ityAha \dash \" dR^iShTAshcha\" 
iti |  te nivR^ittasakalakarmANo muktAH |  etachcha moxadharme spaShTamuktam |  
prAN^ mukteshvarabhede smR^itirudAhR^itA |  shrutiM chodAharati \dash \" pratishAkhashcha\" 
iti |  \" nanu bheda ivAbhede.api \" pare.avyaye sarva ekIbhavanti\" ityAdivAkyAni
santi |  tatkathaM nirNaya\?\" ityataH sAmAnyanyAyaM tAvadAha \dash \" virodhe tu\" 
iti |  \" balavadvirodhena durbalaM bAdhyata\" iti bhAvaH |  \" tataH kIM prakR^ita\?\" 
ityata Aha \dash \" yuktayashcha\" iti |  atra bhedapaxe |  upalaxaNametat |  
pratyaxAnukUlyaM cha bhedavAkyAnAM prAbalyAya grAhyam |  \" tarhi \" ekI bhavanti\" 
ityasya kA gatiH\?\" ityata Aha \dash \" ata\" iti |  ubhayatra ekIbhAvashabdena
tadvAdivAkyaM gR^ihyate |  \" sthAnaikyaviShayamaikyavAkyam\" ityarthaH |  \" iyaM cha
rUDhalaxaNA\" iti \" na prayojanamanveShaNIyam\" iti dR^IShTAntoktiH |  na 
kevalamiyaM gatirnyAyaprAptA |  kintu shrautI chetyAha \dash \" uktaM cha\" iti | 
udake.apyaikyAdasammato dR^iShTAnto ityata Aha \dash \" tatrApi\" iti |  
\" nAstyeva samudre vR^iddhiranupalambhAd\" ityata Aha \dash \" asti cha\" iti |  
\" samudre.api vR^iddhiH\" iti sheShaH |  anupalambhasyAsiddhimAha \dash \" dvari\" 
iti |  nadInAM dvAri |  \" dR^ishyate cha\" iti sheShaH |  \" anyatra kuto na
dR^ishyate\?\" ityata Aha \dash \" mahattvAd\" iti |  samudrodakasya mahattvAt |
na kevalaM vR^iddhiliN^gakAdanumAnAdudake bhedasiddhiH |  \" kiM tarhi pratyaxAdapi\?\" 
ityAha \dash \" tA eva\" iti |  \" yA indrakamaNDalorAdAya svakamaNDalUdake 
xiptAstA evApastasyendrasya dadau vasiShTha\" iti mahAkaurmavachanAt samarthAnAM 
vasiShThAdInAM jalabhedadarshanAchcha |  \" bhedAdarshane vibhajya kathaM dadyAt\?\" 
iti |  \" itashcha muktabhedavAkyameva prabalam |  abhedaniShedhAtmakatvAd\" ityAha
\dash \" naiva\" iti |  \" kaivalyam\" sarvottamattvam |  ito.api bhedapaxo
balavAniti vaktumAha \dash \" savichArashcha\" iti |  pUrvottarapaxabalAbalachintA
\" vichAraH\" |  \" nirNayo\" jIveshabhedAvadhAraNam |  \" bahavaH puruShA
brahman ityAdinA\" iti sheShaH |  \" na hi bhinnayormuktAvabhedaH sambhavati\"
iti bhAvaH |  \" tataH kim\?\" ityata Aha \dash \" balavAMshcha\" iti |  
\" nirNayashcha\" iti sambandhaH |  vAkyamAtrAdekIbhavantItyAdeH |  \" kathaM
tarhi \" yatra\" ityAdi bhUmalaxaNamuchyata\?\" ityata Aha \dash \" ata\" iti |  
savichAranirNayavirodhAdeva vidyAmAnasyApyanyasya bhagavadadhInasattAdivAchi |
itashchaivamityAha \dash \" anyathA\" iti |  \" yadyanyadeva na syAt, tarhi
kathamIshvarasya sarveshvaratvasArvaj~nAdikaM shrutyAdisiddhaM syAt\? mAyAmayameva
tachChrutyAdAvuchyata\" ityata Aha \dash \" na cha\" iti |  bAdhakAntaramAha
\dash \" anyathA\" iti |  yadi bhUmA.advitIyaH syAt tarhi kathaM tajj~nAnAn
muktasya \" sa ekadhA\" ityAdi bhedenAvasthAnaM shrutirbrUyAt |  \" na 
tadbhUmaj~nAnaphalam |  kintu saguNavidyopAsanaphalam\" ityata uktaM \dash 
\" tatraiva\" iti |  bhUmaprakaraNa eva |  
%%% ##endlabel##

%%% ##label=<segment065_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu nAradena ye shvetadvIpe bhagavato bhinnA dR^iShTAste muktA eva
na bhavanti |  sasharIratvAt |  sasharIrANAmapi muktatvAN^gIkAre \" na ha vai 
sasharIrasya sataH priyApriyarapahatirasti\" (ChA\.u\. 8\.12\.1) ityAdishrutivirodha\" 
ityata Aha \dash \" na cha\" iti |  \" kuto na\?\" ityata Aha \dash \" vailaxaNyAd\" 
iti |  \" kiM tadasmadAdisharIrebhyasteShAM vailaxaNyam\?\" ityata Aha \dash 
\" abhautikAni\" iti |  \" ajaDAni\" ityarthaH |  \" tarhi kimAtmakAni\?\" 
ityata Aha \dash \" nitya\" iti |  \" vikAritvAdvinAshassyAd\" ityata uktaM \dash 
\" IshvarashaktyA\" iti |  \" kuta etad\?\" ityata Aha \dash \" tathA cha\" iti |  
nityopAdhireva ShoDashI kalA |  etaduktaM bhavati \dash \" yachChrutau sasharIrasya 
duHkhAnapahativachanaM tatkarmAdhInajaDasharIrAbhiprAyam |  shvetadvIpe nAradena 
dR^iShTAni tu sharIrANi chinmayAni |  jaDAnyapi na karmAdhInAni |  ato na duHkhakAraNAni |  
tathA cha na teShAM sasharIrANAmapi muktatve shrutivirodha\" iti |  \" yadi muktAH
sasharIrastarhi kathaM teShu \" asharIraM vA va santaM na priyApriye spR^ishataH\" 
(ChA\.\u\. 8\.12\.1) iti sharIrAbhAvavachanam\?\" ityata Aha \dash \" vadanti cha\" 
iti |  laukikAdvailaxaNye sati |  \" tadvadatrApi\" iti sheShaH |  itashchAsharIratva\-
uktiryuktetyAha \dash \" nirukti\" iti |  \" niruktilabhyArthasya tatrAbhAvad\"
ityarthaH |  \" kA.asau niruktiH\" ityataH prakriyAsampAdanagauravaparihArAya
shrutimeva tatparAM darshayati \dash \" tathA hi\" iti |  \" ashAri shIrNamabhavat |
iti hetoH tachCharIrashabdamabhavad\" ityarthaH |  \" kathaM niruktilabhyo.arthaH
teShu nAsti\?\" ityata Aha \dash \" na hi\" iti |  \" evaM tarhi kathaM teShu
\" sharIraM jAyate teShAm\" iti sharIrashabdaprayoga\?\" ityata Aha \dash 
\" sAmyAd\" iti |  \" asmadAdisharIraiH karacharaNAdimattvasAmyAdgauNa\" 
ityarthaH |  \" kuto.ayamasharIrashabdasyAbhiprAyaH\?  sarvathA vigraharAhityameva
kiM na syAd\?\" ityata Aha \dash \" prayogAchcha\" iti |  \" nAradAdibhiH
dR^iShTadeheShveva mukteShu etadvAkyadvaye dehAbhAvaprayogAnyathAnupapattyA.ayamarthaH
siddho na kevalaM sambhAvanAmAtreNa\" iti chArthaH |  \" ityAdi\" iti 
kriyAvisheShaNaM \" prayogAt\" ityanena sambaddhyate |
%%% ##endlabel##

%%% ##label=<segment066_pd02>##

{\Largedvng pra\.dI\. ||} \" santu nAradena dR^iShTAH shvetadvIpavAsino muktAH |  tathA.api
nAsmAkaM pratyaxavirodhaH |  yata eShA shvetadvIpaprAptirUpA nirguNamukteranyA 
gauNI muktiH |  nirguNAyAmeva tu muktau vayamaikyaM brUma\" ityata Aha \dash \" na 
cha\" iti |  \" shvetadvIpaprAptivyatiriktamuktiniShedhAdiyameva muktiH\" ityarthaH |
\" nanu shishupAlAdayaH shvetadvIpagamanena vinA.atraiva bhagavantaM pravishya muchyante |
tatkathametad\?\" ityata Aha \dash \" ye tu\" iti |  \" te na tadA muchyanta\" 
iti sheShaH |  \" tarhi kadA\?\" ityata Aha \dash \" te.api\" iti |  \" tato
muchyanta\" iti sheShaH |  \" nanu \" kechidatraiva muchyante\" ityAdyuktvA
\" mahAj~nAnA gachChanti xIrasAgaram\" iti mahAyogyatAvatAmeva shvetadvIpagamanokteH,
kathamayaM niyama\?\" ityata Aha \dash \" yogyatvaM cha\" iti |  \" atra nivAsa\" 
iti sheShaH |  asti sarveShAM shvetadvIpaprAptiH |  mahAj~nAnatvalaxaNaM yogyatvaM
tvatra nivAse vivaxitamityarthaH |  \" nanvidaM vAkyaM shvetadvIpaprAptiM vinA
saguNamuktiH nAstItyetatparam |  nirguNamuktistvanyA.asti\" ityata Aha \dash 
\" yudhiShThira\" iti |  \" sAyujyaM tAvatprasiddham |  saiva nirguNamuktiH |
tatrAtmano brahmaNaikatvam\" ityata Aha \dash \" sAyujyaM cha\" iti |  \" yathA
grahasya puruShAntaraM pravishya bhogaH, tathA muktasyeshvaraM pravishya bhoga eva
sAyujyam |  natvaikyam\" ityarthaH |  kuta etat\? \" sAyujyashabdasAmarthyAd
AgamavAkyAchcha\" ityAha \dash \" tadukteshcha\" iti |  uttamAyAM muktau 
sAyujyalaxaNAyAm |  \" IshvaraM pravishya\" iti sheShaH |  \" IshvarAnandAdivyudAsAya
bAhyAn\" iti |  bAhyeShvapi vibhAgo vachanAntarAdavaseyaH |  \" sukR^itamapyapriyam\" 
ityAdinoktamarthamupasaMharati \dash \" ata\" iti | 
%%% ##endlabel##

%%% ##label=<segment067_pd02>##

{\Largedvng pra\.dI\. ||} \" yathA sukR^itatyAge saN^kochastathA.aniShTatyAge.apyasti kim\?\" 
iti jij~nAsAyAmAha \dash \" so.astyeva\" iti |  \" prAchuryAbhiprAyANyetAni vAkyAni
kiM na syuH\?\" ityata Aha \dash \" visheSha\" iti |  \" saN^karShaNAdayaH samaShTi\-
jIvAH tAvanmuktAH |  teShAM cha balalaxmaNAdirUpeShu duHkhaM dR^ishyate |  tadeva
visheShapramANam\" ityata Aha \dash \" yeShAntu\" iti |  \" na sAyujyaM prAptAH\" 
na muktA ityarthaH |  sAyujyayogyAnAM tadabhAve muktyabhAvAt |  \" teShAM muktatvokteH
tarhi kA gatiH\?\" ityata Aha \dash \" sAmIpyAdi\" iti |  \" muktatvoktau bIjam\"
iti sheShaH |  \" kutaste na muktA\?\" ityata Aha \dash \" ata\" iti |  duHkha\-
darshanAttaddhetubhUtaprArabdhakarmabhAvAnna te muktAH |  \" kadA tarhi te muchyanta\?\" 
ityata Aha \dash \" tadbhuktvA\" iti |  atrAgamasammatiM chAha \dash \" tachcha\" 
iti |  \" so.astyeva\" ityAdyuktamupasaMharati \dash \" ata\" iti |  \" tatkiM\-
aniShTanivR^ittimAtraM muktiH\?\" ityato.anumAnAgamAbhyAM \" paramasukhaM cha\" 
ityAha \dash \" parabrahmatvam\" iti |  muktatvam |  \" brahmAdibhiH\" 
duHkhahInairapi |  \" moxe saktisstutyarthametad\" ityato na brahmaNa ekAntitvavirodhaH |  
samAsAntavidheranityatvAt \" vAN^mano.agocharam\" ityuktam |  \" mahad\" ityetat 
\" sukham\" ityanena sambadhyate |  \" brahmAdipadAdapyadhikatamam\" iti |  
brahmaNo brahmapadAdapyadhikaM sheShasya sheShapadAdapyadhikamityAdi j~neyam |  evaM 
j~nAnaphalapradarshanaparatvena pUrvArdho vyAkhyAtaH |  \" uktavidhayA 
yogasvarUpanirUpaNaparaH kiM na syAd\?\" ityato \" asmadukte.arthe 
tR^itIyapAdasaN^gateH anyathA tadasaN^gateH\" ityabhipretya taM paThati \dash 
\" ata\" iti |  \" na dUrasthahetuparAmarsho.ayam\" iti j~nApayituM
\" tasmAd\" iti paThitavye \" ataH\" ityuktam |  \" j~nAnasya mahAphalatvAt
\" yogAya yujyasva\" iti kathaM hetuhetumadbhAva\?\" ityataH \" yogAya\" 
ityetadvyAchaShTe \dash \" j~nAna\" iti |  \" nanu \" samatvaM yoga uchyate\"
iti yogo vyAkhyAtaH |  \" yogaH karmasu kaushalam\" ityAdi \" kim\" iti 
punarvyAkhyAyata\?\" ityataH \" stutiriyaM yogasya kriyata\" iti bhAvenAha
\dash \" taddhi\" iti |  \" tat yoga\" iti sheShaH || 50||
%%% ##endlabel##

%%% ##label=<segment068_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu \" karmajam\" iti shlokaH pUrvoktAnna vishiShyata\", ityata
Aha \dash \" tadupAyam\" iti |  \" tasya j~nAnasyopAyaM yogaM, tajj~nAnamupAyo 
yasya taM moxaM chAha vivR^iNoti\" ityarthaH |

vyavahitatvAdanvayamAha \dash \" karmajam\" iti |  \" aprAptasya phalasya kathaM
tyAga\?\" ityato vyAchaShTe \dash \" akAmanayA\" iti |  prakR^ityAdibhya 
upasaN^khyAnAt tR^itIyA |

\" etat prAguktam\" ityataH prakArAntareNa vyAchaShTe \dash \" IshvarAya\" iti |
\" buddhiyuktAH\", \" manIShiNaH\" iti paunaruktyaparihArAyAha \dash \" buddhiyuktA\" 
iti |

\" samyagj~nAninaH\" shAstrajanitatattvaj~nAninaH |  anena \" manIShiNaH\" iti
\" aparoxaj~nAnina\" iti sUchitam |  prashaMsAyAM matvarthIyasya vidhAnAt |

\" nanvidamekaM vAkyaM kathaM vAkyArthadvayasya vivaraNam\?  moxasvarUpavivaraNe.api
yogo na samyagvivR^itaH |  aN^ginaH karmaNa eva anabhidhAnAt |  aN^gAnAM cha 
saN^kalpatyAgAdInAm\", ityata Aha \dash \" sayoga\" iti |  samastAN^gasaN^grahAya 
yogagrahaNam |  tajj~nAnam |  \" yadyapi yojanAvashAdidamekaM vAkyam |  
tathApyarthavashAd dve veditavye |  yogashcha \" karmajaM phalaM tyaktvA\" 
ityanena samagro laxita\", iti bhAvaH || 51||
%%% ##endlabel##

%%% ##label=<segment069_pd02>##

{\Largedvng pra\.dI\. ||} \" yadA te iti shloke yogasambandhi na kimapyuchyata\?\" ityataH
tatsaN^gatimAha \dash \" kiyad\" iti |  evaM phalakAmanAdivarjitAnIshvarArAdhana\-
rUpANi |  \" ityAkAN^xAyAmAha\" ityarthaH |

\" nanviyamAkAN^xaivAnupapannA |  yogo hi j~nAnasAdhanatayopadiShTaH |  sAdhanaM cha 
sAdhyaprAptiparyantamanuShTheyamiti prasiddhameva |  niyatapUrvaxaNavR^itti kAraNamiti
tallaxaNam\" |  uchyate \dash \" yogo hi na sAxAjj~nAnasAdhanam |  kintu shravaNAdi\-
kameva |  pramiteH pramANaphalatvAt |  yogastvadR^iShTadvArA satvashuddhimutpAdya
shravaNAdInAmupakaroti |  upakArasya cha dvayI gatirdR^iShTA |  ato yuktaiveyamAkAN^xA\"
iti |  \" tathApi jij~nAsuneti vaktavyam\" |  satyam |  \" moxasAdhanaj~nAnArthinA\"
ityetAvato.arthasya grahaNAya \" mumuxuNA\" ityuktam |

\" nirvedaM vairAgyam\" (shAM\.bhA\.2\.52) ityanyathApratItinirAsAyAha \dash 
\" nirvedam\" iti |  \" nanu niShpUrvo vidirvairAgye rUDhaH |  tatkuto lAbhArthatA\?\" 
ityata Aha \dash \" prayogAd\" iti |  \" asyAmapi shrutau vairAgyArthatA kiM 
na syAd\?\" ityata Aha \dash \" na hi\" iti |  \" kuto nopapadyata\?\" ityata 
Aha \dash \" tathA sati\" iti |  \" jugupsAvirAmapramAdArthAnAmupasaN^khyAnam iti 
kAtyAyanavachanAtpANDityasya virAmArthadhAtuyogenApAdAnatvaprAptAvapAdAne cha 
paJNchamI syAnna dvitIya\" ityarthaH |  idamatrAbhipretam |  nirupasargaH sattArthasyaiva
viderarthaM bAdhitvA taM vairAgyArthaM vyavasthApayati |  \" nirvidyata\" iti kartari
prayogadarshanAt |  lAbhArthasya viderarthaM tu vishinaShTyeva |  kevalaM nirvidanti
nirvidanta iti vairAgye tatprayogadarshanAditi |  athavA.astu sarvatra nirodhAtvartha\-
bAdhakatvam |  \" visheShakatvamapi kvachit kiM na syAt\?\" \" vyAdadAti\" 
ityAdAvubhayadarshanAditi |  \" na kevalaM gItAyAM prayogAllAbhArthatA |  kintu 
vairAgyArthAnupapatteshcha\" ityAha \dash \" na cha\" iti |  anena \" antaHkaraNasya 
mohakalilAtikramo nAma j~nAnaprAptiH\" iti sUchitaM bhavati |  \" Adi\" padena 
tadupayuktaM gR^ihyate |  \" kuto na bhavati\?\" ityata Aha \dash \" AtmA\" iti |  
bhaktiM shravaNAdilaxaNAM \" kasya vA bR^ihatImetAmAtmArAmaH samabhyasat\" 
ityasyottaratvAt |  \" anuShThAnAchcha shravaNAdeH\" iti sheShaH |

\" nanu shukAdInAM shravaNAdyanuShThAne.api phalaM nAsti |  tatphalasya j~nAnasya
prAptatvAt |  phalAbhAvAnusandhAnamevAtra vairAgyashabdenAbhipretam |  yathA.aha
mAyAvAdI \dash \" tadA shrotavyaM cha shrutaM cha niShphalaM pratipadyata ityabhiprAyaH\" 
iti |  anuShThAnaM tu lokasaN^grahArthaM saMskArAdvA\?\" ityata Aha \dash \" na
cha\" iti |  \" kuto na\?\" ityata Aha \dash \" tasyaiva\" iti |  \" tasyaiva\" 
shravaNAdereva |  sthAnyAdeshoktivyatyayena dvandve.alpAchtarasya paranipAtena cha
\" AnmahataH samAnAdhikaraNajAtIyayoH\" ityasya vidheranityatvaj~nApanAt,
\" mahattvAdvikurvANAt\" ityAdiprayogadarshanAchcha mahatsukhatvAditi yuktam |
\" tathA.api shravaNAdikameva kathaM sukham\?\" \" uttaraxaNa eva mahAsukhodayAt
aikyopachAra\" ityadoShaH |  \" tiShThatu, tAvatkAlAntarabhAviphalam\" iti
\" eva\" shabdaH |  \" nanvasmadAdIdAnAM shravaNottaraxaNe sukhaM notpadyata\" 
ityata Aha \dash \" teShAm\" iti |  \" rasikAnAm\" ityarthaH |  \" na hi
pitR^ijIvanAdivArtAshravaNenAnyeShAmiva putrasyApi na sukhenotpattavyam\" iti |  
\" astu sambhAvanA |  nishchayastu kuta\?\" ityata Aha \dash \" yA\" iti |  
bhavato bhavajjanAnAM cha svamahimanyAvirbhUtasvarUpe |  \" AbrahmaNi\" 
alpamukte.api |  \" na kevalaM tAtkAlikaM sukhaM tatphalam |  kintu 
muktAvAnandavR^iddhishcha\" ityAha \dash \" teShAmapi\" iti |  j~nAninAmapi |
%%% ##endlabel##

%%% ##label=<segment070_pd02>##

{\Largedvng pra\.dI\. ||} \" j~nAnottarasyApyanuShThAnasya yadi phalaM syAt tarhyanuShThAnasya
ekavidhyaniyamAsambhavAt svargavadapavarge.api tAratamyaM prasajyeta |  na cha tadyuktam |
aprAmANikatvAtpramANaviruddhatvAchcha\" ityato \" nedamaniShTam\" iti bhAvena
Aha \dash \" tAratamya\" iti |  \" pramANavirodhAbhAvAchcha\" iti chArthaH |  \" kutaH
pramANAnmuktatAratamyAdhigatiH\?\" ityato.arthApattiM tAvadAha \dash \" tathA hi\" 
iti |  \" yadi muktAnAM tAratamyaM na syAt tadA muktimapyanichChatAmekAntinAM
moxamAtraM phalam |  taM moxamichChatAM supratIkAdInAM sa moxo bhavatItyaN^gIkAryaM
syAt |  tathA cha \" nAtyantikam\" iti moxamanichChatAM stutiH kathamupapannA
syAt\? nimittAbhAvAt |  ataH stutyanyathA.anupapattyechChatAM mukteranichChatAM
muktiradhiketi gamyata\" ityarthaH |  \" Atyantikam\" muktihetum |  \" ekAtmatA\"
sAyujyam |  ekatvamapi tadeva |  \" AgamAchcha tAratamyAdhigatiH\" ityAha \dash 
\" vachanAchcha\" iti |  \" AvirbhUtasvarUpiNAm\" iti karmadhArayAdatishayArtha
iniH |  anena jIvanmuktAvaishvaryatAratamyenArthApatteranyathopapattiH parihR^itA |
\" liN^gabhedena\", \" bhinnaliN^gAnAm\" ityAdyukteH |  \" paramaM sAmyamupaiti
ityAdivachanaviruddhaM muktatAratamyam\" ityata Aha \dash \" sAmya\" iti |  
\" prAchuryam\" pUrNatvam |  \" kuta etat\?\" \" uktapramANavirodhAt
visheShavachanAchcha\" ityAha \dash \" tathA cha\" iti |  \" yadyapi parAnando.alambuddhi\-
gocharatvamAtreNa samastathApi\" ityanvayaH |  \" na cha j~nAninAm\" ityAdinoktamarthaM
upasaMharati \dash \" ata\" iti | 

\" astu tarhi bhagavanmahimAdivyatiriktashrutAdau vairAgyamatra vivaxitam\" ityata 
Aha \dash \" na cha\" iti |  \" nirvedashabdasya vairAgyaikArthakatve nishchite 
tadbalAchChrotavyAdishabdasyArthasaN^kochaH kriyetApi |  itaratra, nitarAM lAbhe tasya 
shrautaprayoge vidyamAne tu nirmUlaM saN^kochakalpanam\" ityarthaH |  \" nanu
lAbhArthatAyAmapyasachChAstrAdivyudAsAya saN^kochaH kArya eva\" ityata Aha \dash 
\" mahadbhiH\" iti |  \" ayogyatayaiva tannirAsaH prakaraNAdvA\" iti bhAvaH || 52||
%%% ##endlabel##

%%% ##label=<segment071_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu uttarashloke.api yogAnuShThAnAvadhirevochyate |  ata punaruktidoShaH\"
ityata Aha \dash \" tadeva\" iti |  \" kiM tanmohakalilaM, kIdR^ishaM cha
tadatitaraNam\? ityAkAN^xAyAM puMsAM adhamamadhyamottamAvasthAdipradarshanena
pUrvashlokoktameva yogAnuShThAnAvadhimanena spaShTaM karoti\", ityarthaH |

\" nanu atra \" shrutivipratipannA\" iti shravaNAd, ito vairAgyamuchyate |
yathA.aha bhAskaraH, \" vastvantarashravaNAd viraktA\" iti |  tataH pUrvatrApi
vairAgyaM arthaH syAt\?  \" nishchalA\", \" achalA\", iti punaruktishcha |
yogAvApteruttarA cheyamavasthA |  tat kathamuchyate \" tadA yogamavApsyasi\" 
iti\?\" iti shaN^kAyAM shlokaM vyAchaShTe \dash \" pUrvam\" iti |  pUrvAvasthAta
uttarAvasthAyAH sAmarthyalabdhaM vailaxaNyaM darshayitumuktam \dash \" vedArtha\" iti |  

chalanaprasaktiM darshayati \dash \" viparItavAgbhiH\" iti |  \" asachChAstraiH\"
ityarthaH |  anena paroxaj~nAnakAShThA darshitA |  paroxatattvanishchayAnuvR^itti
vyudAsAya uktam \dash \" brahma\" iti |  atrApi chalanaprasaktimAha \dash \" bherI\"
iti |  \" tatkatham\?\" ityata Aha \dash \" parama\" iti |  etenAparoxaj~nAnakAShThA
darshitA |  upAyena siddhaH prAptaphalaH |  \" yogashabdena tatphalamupalaxyata\"
iti bhAvaH |  \" shlokadvaye.api etadavasthAprAptiH yogAnuShThAnAvadhiH\", iti
tAtparyam  || 53||
%%% ##endlabel##

%%% ##label=<segment072_pd02>##

{\Largedvng pra\.dI\. ||} \" j~nAnini prakR^ite labdhAvasaro.arjunaH pR^ichChati\" iti saN^gateH
sphuTatvAttAmanuktvA praj~nAshabdasya buddhimAtrArthatvapratItinirAsAya sthitapraj~na\-
shabdArthamAha \dash \" sthitA\" iti |  \" pratiShThAm\" prAptA |  \" j~nAnam\" 
aparoxam |  \" kiM prabhASheta\" ityataH \" kA bhAShA\" ityasyArthAntaraM Aha 
\dash \" bhAShyata\" iti |  \" j~nAnIti vyavahriyata\" ityarthaH |  bhAShAshabdasya 
strIliN^gatvAd \" anayA\" ityuktam |  \" vyavahArakAraNAnAmanekatvAt
\" kasyAyaM prashna\?\" iti na j~nAyate\" |  ata Aha \dash \" laxaNam\" iti |  
sAsnAdimattvaM laxaNaM dR^iShTvA hi gauriti vyavahriyate |  

\" j~nAnimAtravyudAsAya \" samAdhisthasya\" iti visheShaNamiti pratIyate |  \" samAdhiM
kurvata\" iti |  yathAha shaN^karaH \" labdhasamAdhipraj~nasya laxaNabubhutsayA.arjuna
uvAcha\" (shAM\.bhA\.2\.54) iti |  tadasad\" iti bhAvenAha \dash \" uktam\" iti |
j~nAnisAmAnyalaxaNavishaya evAyaM prashnaH |  \" kimarthaM tarhi samAdhisthasya 
ityuktam\?\" iti chet \" samAdhAvachalA buddhiH ityanenoktaM j~nAnisAmAnya\-
laxaNamanenAnuvadati\" iti brUmaH |  na hIdaM na laxaNam |  j~nAnimAtraniShTha\-
dharmatvAt |  \" kimartho.anuvAda\?\" iti chet \" tajj~nAtaM mayA iti 
j~nApanArtham\" iti vadAmaH |  \" etajj~nApane.api kiM prayojanam\" iti 
chet \" laxaNAntaraM pR^ichChAmi\" iti j~nApayitum |  \" anyathA siddha\-
prashno.ayamityupexyaH prasajyeta\" iti bhAvaH |  \" laxaNAntaraprashnasya chedaM 
prayojanam |  ayAvallaxyabhAvitvAnna tatsamyagvyavahAropayogi |  
yAvallaxyabhAvi tu sArvatrikavyavahAropayogi j~nAsyAmi\" iti |  \" ata 
eva prasiddhalaxaNapadaparityAgenAprasiddhabhAShApadopAdAnam\" iti |

\" kashcha ashcha Ishashcha keshAH brahmaviShNumaheshvarAH |  te yasyAvayavabhUtAH sa 
keshavaH paramAtmochyata\" iti bhAskaro niruktavAn \" etachChrutvA keshavasya\" 
(11\.35) ityatra |  tadasaditi bhAvenAha \dash \" kam\" iti |  \" kuta iyaM
niruktiH\?\" ityata Aha \dash \" tathA hi\" iti |  

\ \ \ \" ko brahmeti samAkhyAta Isho.ahaM sarvadehiShu |
\ \ \ AvAM tavAN^ge sambhUtau tataH keshavanAmavAn\" ||

\dash (harivaMsha 3\.88\.48 \ast) iti harivaMshavachanam |  \" vachanAntarAchcheyameva 
niruktiH svIkAryA\" ityAha \dash \" hiraNyagarbha\" iti |  \" ata\" iti labhyate |
tenaivashabdasya anvayaH |  hiraNyagarbha eva natvanyaH prajApatiH |  shaN^kara eva 
natvanyaH samartha iti vA |  \" anena keshayoH karmaNorupapadayorantarNItaNyarthAt 
\" vR^itu vartane\" ityasmAddhAtoH \" Do.anyatrApi dR^ishyate\" iti \" Da\" pratyaya 
ityuktaM bhavati |  \" AserakarmakatvAtkathaM karmaprashna\?\" ityata Aha \dash 
\" kim\" iti |  adhyAhR^itapratiyoganimittA dvitIyA |  \" na karmaNi\" 
ityarthaH |

prashnakaraNAdarjunasyAj~natvaM pratItam |  tannivArayati \dash \" na cha\" iti | 
\" tallaxaNAdikaM j~nAnilaxaNaM, tatpravR^ittyanupapattisamAdhAnaM cha |  prashnasya
anyathopapatteH\" iti bhAvaH |  \" kuta\?\" ityata Aha \dash \" jAnanti\" iti |  
samAsAnto vidhiranityaH |  ataH \" pUrvarAjAnaH\" iti sAdhu |  devarShayashcha
tathaiva jAnantyeva |  \" dharmAn\" ityupalaxaNam |  vArtAyai gurorAtmanAM cha
khyAtyai |  lokasya guhyArthavittaye cha |  \" eteShAM prashnakaraNaM lokAnAM kathaM
guhyArthavittaye bhavati\?\" ityato vyatirekamukhenopapAdayati \dash \" na ta\" 
iti |  \" ChandasyubhayathA\" ityato \" alpabuddhInAm\" iti nAmi dIrghatva\-
abhAvaH |  \" guhyAste.arthAH purANAdiShu prashnottaranibandhanena vinoktimAtreNa
alpabuddhinAM vyaktaM na prakAshante |  na cha prashnAkaraNe tadupanibandhanaM sambhavati\" 
ityarthaH |  etena \" mohAdistvabhibhavAdeH\" (bhA\.2\.47) ityetatprapaJNchitaM 
bhavati || 54||
%%% ##endlabel##

%%% ##label=<segment073_pd02>##

{\Largedvng pra\.dI\. ||} laxaNaprashnasyaivottaraM pratIyate |  na tu \" sthitadhIH\" 
ityAderityatastaduttarasthAnaM darshayannanantaraprakaraNArthaM darshayati \dash \" gamanAd\" 
iti |  \" abhisandhiH\" prayojanoddeshaH |  IShadabhisandhisUchanAya \" ati\" shabdaH |
\" pravR^ittimAtramihAbhipretam |  na bhAShaNAdikameva\" iti j~nApanAya \" bhAShaNAdi\" 
iti noktam |  \" vyavahArAya laxaNaprashno ghaTate |  pravR^ittyuddheshyaprashnastu vyartha
eva |  na cha shakyaH prativaktum |  anekeShAM pravR^ittyuddheshyasyaikarUpasyAbhAvAd\"
ityabhiprAyeNa bhagavatopexito.asAviti kiM na syAt\? kiM taduttarasthAnapradarshanena\? 
anyathA.alpamapyuddheshyaM vaktavyam\" ityata Aha \dash \" evam\" iti |  \" evaM
bherItADanAdAvapyachaletyuktaprakAreNa paramAnandatR^iptashchet kimarthaM pravR^ittiM
karoti\? na kuryAt |  karoti cha |  tasmAduktamasad\" ityuktAxepa evAtrAbhipretaH |
\" prashnastu mukhata eva |  ato nopexAmarhati\" iti bhAvaH |  etachchArjunasya
prexAvattvAdgamyate |  \" evaM chet gamanAdipravR^ittiH ityuktaH parihAro na pUrNaH |
pravR^ittikAraNAnukteH\" ityata Aha \dash \" prArabdha\" iti |  \" IShat tirohitaM 
brahma yasyAsau\" tathoktaH |  \" pariharati dvitIyaM prashnaM yA nishA ityAdau\" 
iti sheShaH |

\" nanu sarvakAmaprahANirj~nAnilaxaNatvenochyate |  tatkathamalpAbhisandhyaN^gIkAra\?\" 
ityata Aha \dash \" prAya\" iti |  \" kutassarvashabdasaN^kocha\" ityata Aha \dash 
\" shukAdInAm\" iti |  \" viruddhakAmasya\" iti sheShaH |  tachcha pravR^ittiliN^gena 
AgamAchcha j~nAtavyam |  anukUlakAmastu sarvathA.astyeva |  \" ato.api
saN^kocha\" ityAha \dash \" tvatpAda\" iti |  \" tAm\" bhaktim |  upalaxaNaM
etat |  prAyeNa viruddhakAmatyAgo j~nAnilaxaNaM chedindrAdInAM j~nAnitvaM na syAt |
bahutaraviruddhakAmadarshanAt |  \" tathAbhUtA api chejj~nAninastarhi devadattAdayo.api
kiM na syuH\?\" ityata Aha \dash \" yadA tu\" iti |  \" Agraho\" viruddha\-
kAmAbhiniveshaH |  etatpramANena sthApayati \dash \" tachcha\" iti |  \" AdhikArikAH\" 
iti puruShavisheShasaJNj~nA |  \" prajApAshcha tathA devAH\" ityAdivachanAt |
devadattAdipratibandIM mochayati \dash \" ata eva\" iti |  etadAgamoktAdeva |
\" Adi\" padena viruddhakrodhAdigrahaNam |  anena \" kAmashabdaH krodhAdInAM
apyupalaxaNArtha\" iti sUchitaM bhavati |
%%% ##endlabel##

%%% ##label=<segment074_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu samAdhiM kurvato j~nAnino laxaNametaditi vyAkriyatAm |  tathA
sati prashnavAkyasthaM samAdhisthasya iti padaM samaJNjasaM syAt |  sarvashabdashcha
asaN^kuchitArthaH syAt |  indrAdiviShayAxepAprasaktishcha\" ityata Aha \dash \" na
cha\" iti |  \" samAdhiM kurvatassnehaniShedho.anuguNa eva\" ityata Aha \dash \" na
hi\" iti |  nAtra snehaniShedhamAtramuchyate |  kintu \" tattatprApya shubhAshubham\" 
iti shubhAshubhArthaprAptipUrvakam |  na cha tatprAptissamAdhiM kurvato j~nAnino.asti |
\" kuta\?\" ityata uktaM \dash \" asaMpraj~nAta\" iti |  asampraj~nAtaH samAdhiH yasyAsau 
tathoktaH |  bAhyArthAnusandhAnaM yatra nAsti so.asampraj~nAtasamAdhiH |  itaraH
sampraj~nAtasamAdhiriti yogashAstre prasiddhaH |  tathA cha laxaNamasambhavi prasajyeta |
sAvakAshebhyo bahubhyo niravakAshasyaikasyaiva balavattvamiti bhAvaH |  \" evaM tarhi 
sampraj~nAtasamAdhisthasyaitallaxaNamastu |  tatroktadoShAbhAvAd\" ityata Aha 
\dash \" sampraj~nAte tu\" iti |  yadyapi sampraj~nAtasamAdhau shubhAshubhapratIti\-
sambhavenAsambhavitvaM nAma laxaNavirodho nAsti |  tathApi kAmAdihAnaM 
samAdhistha eva puMsIti niyamo nAsti |  asamAdhisthe.api j~nAnini 
vidyamAnatvAt |  tathA chAtivyAptiH syAdityarthaH |  \" asamAdhisthe.api j~nAnini 
kAmAdyabhAvaH kuta\?\" ityata Aha \dash \" kAmAdaya\" iti |  tadarthaM \" sarvathA\" 
iti visheShaNapraxepe.api puruShavisheShe.ativyAptiparihAro durghaTa eva |  na cha 
asmanmate.apyavyAptidoShaH |  asampraj~nAtasamAdhisthavyatiriktaviShayatvAt |  
sambhavatastu tadviShayatvAditi |

\" kAmAnAM manogatatvAvyabhichArAdvyarthaM visheShaNam\" ityato \" nedaM 
visheShaNam |  kintu sarvakAmatyAgasyAsambhavitvamAshaN^kya tadupapAdanAya
yuktiriyamuktA\" ityAha \dash \" manogatA hi\" iti |  \" tatraiva\" manasyeva |
\" kAmaj~nAnayorvirodhaH kuta\?\" ityata Aha \dash \" virodhashcha\" iti |  \" raso 
rAga\" (bhA\.2\.56) iti vaxyati |  \" nanu sarvakAmaprahANamasmadAdiShu 
na dR^iShTam |  taddR^iShTAntena j~nAniShvapi tadabhAvAnumAnAdasambhavitvaM laxaNasya\" 
ityata Aha \dash \" na cha\" iti |  \" kutaH\?\" udAhR^ita pramANavirodhAt |  
\" pramANaviruddhArthAnumAne cha paNDitamUrkhAdivaichitryApalApaprasaN^gAd\" ityAha 
\dash \" puruSha\" iti |  \" Atmani\", \" AtmanA\"  iti padadvayena \" jIva
evochyata\" (shAM\.bhA\.2\.55) iti kashchit |  tR^itIyAntena \" mana\" 
(rA\.bhA\. 2\.55)\footnote{\normaldvng aparaH AtmanA manasA AtmaikAvalambaneneti rAmAnuja 
ityarthaH \dash shrIsumatIndratIrthIya bhAvaratnakoshe} ityaparaH |  \" tadubhayamasad\" iti bhAvenAha
\dash \" AtmanA\" iti |  \" sthitassan\" iti sheShoktiH |  vAkyArthaM vadan 
svavyAkhyAnopapattau paravyAkhyAnAnupapattau cha yuktimAha \dash \" AtmAkhya\" 
iti |  \" tasmin sthitasya\" tadekAgrachittasya |  \" atra tyaktaviShayasyApi 
tuShTiruchyate |  sA cha paramAtmaparigrahe sambhavati |  nAnyathA\" ityarthaH |  
\" kuta\?\" ityata Aha \dash \" viShayAMstu\" iti |  \" tataH kim\?\" ityata 
Aha \dash \" ata\" iti || 55||  
%%% ##endlabel##

%%% ##label=<segment075_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu laxaNasyAnenaivoktatvAtkiM \" duHkheShu\" ityAdinA\?\" 
ityata Aha \dash \" tadeva\" iti |  \" uktaM laxaNameva |  spaShTanaM cha kAmashabdopalaxita\-
doShAntaratyAgakathanAdinA\" iti j~neyam |

\" nanu kAmatyAgAdIni j~nAnasAdhanatayochyanta \" amAnitvam\" ityAdau |  tato
j~nAnilaxaNasya jij~nAsAvativyAptiH\" ityata Aha \dash \" etAnyeva\" iti |  upa 
samIpe AyAH phalalAbho yeShAM tAnyupAyAni sAdhanAni |  satyametat |  
\" tathApi jij~nAsau prayatnasAdhyAni j~nAnini tu svabhAvasiddhAnIti na doSha\" 
iti bhAvaH |  atra pramANamAha \dash \" tachcha\" iti |  samuchchayavAdI tvAha 
\dash \" yAnIha sthitapraj~nalaxaNAnyuchyante tAnyevApavargasAdhanAni\" 
iti |  tadvA.anena dUShayati \dash \" j~nAnasAdhanAnyeva nApavargasAdhanAni\" |  
yathoktaM \" kAmakAreNa chaike\" iti |  AnandavR^iddhyarthatA tvaN^gIkR^itaiva |  
\" yoge tvimAM shR^iNu ityuktvA kathaM yogAdanyaduchyata\?\" ityato \" vedamuditam\" 
iti |  \" vigataspR^ihapadenaiva \" vItarAgaH\" ityetadgatArtham\" ityata 
Aha \dash \" shobhana\" iti |  ashobhaneShu viShayeShu shobhanatvabhrAntiH |  
\" raso rAgo raktirityetaiH kAma uchyate |  tathA shobhanAdhyAsa 
uchyata\" ityarthaH || 56||

%%% ##endlabel##

%%% ##label=<segment076_pd02>##

{\Largedvng pra\.dI\. ||} \" vItakrodha (2\.56) ityuktatvAt \" na dveShTi\" iti
punaruktiH\" ityata Aha \dash \" sarvatra\" iti |  \" sakAraNakaM 
dveShavarjanaM atrochyate\", ityarthaH  || 57\-58||
%%% ##endlabel##

%%% ##label=<segment077_pd02>##

{\Largedvng pra\.dI\. ||} \" viShayA vinivartanta ityAdishlokatrayAnte.api \" tasya praj~nA
pratiShThitA\" ityuktatvAdidamapi laxaNavivaraNam\" iti bhrAntissyAt |  tannirAkarANarthaM
Aha \dash \" na cha\" iti |  etallaxaNaM yasmAdbhavati tad \" etallaxaNam\" |
\" ayatnataH\" alpayatnataH |  \" anudarA kanyA\" iti yathA |  \" yadyevaMlaxaNaM
j~nAnaM tarhi sarvo.api janaH kasmAnna tatsAdhayati\? kAmAdyupadravaparihArArthaM kiM 
dandahyamAnashirA iva bambhramIti\?  ato nAstyevedaM j~nAniShu laxaNamityAshaN^kApari\-
hArArtham\" iti sheShaH |  tribhirityanuvartate |  \" j~nAnasyAlpaprayatnAsAdhyatvaM
atra na pratIyata\" ityAshaN^kya \" upoddhAtaprakriyayendriyajayasya tAvanmahAprayatna\-
sAdhyatvamAdyena shlokenochyata\" iti bhAvena taM vyAchaShTe \dash \" nirAhAratvena\" 
iti |  tena \" rasavarjam\" ityetadantasya vAkyasyArtha uktaH |  \" eva\" shabdena
\" rasavarjam\" ityetadvyAchaShTe |  tathA hi |  nirAhArasya dehinaH tena nirAhAratvena
iti yAvat |  \" viShayA\" rUpAdayaH |  tadbhogasamarthAnIndriyANyanenopalaxyante |
tAni vinivartante |  \" rasavarjam\" raso rAgaH taM varjayitvA |  viShayAbhilAShaH
chaitasiko nirAhAratvena na vinivartata iti |  asyaivArthAntaramAha \dash \" itara\" 
iti |  AkAN^xAshabdena bhogashaktayopi laxyante |  \" rasavarjam\" ityasyArtho
\" rasAkAN^xAdiH\" iti |  tatashcheyaM yojanA |  nirAhAratvena rasAditare viShayAH
tadbhogashaktayaH tadAkAN^xAshcheti yAvat |  \" vinivartante\" rasaM varjayitvA |
manaso rasaviShayAkAN^xA rasanendriyasya tadbhogashaktishcha na nivartata iti |  
\" raso.api\" ityasyArthamAha \dash \" sa tu\" iti |  Adye.arthe \" sa rasaH
sarvaviShayaviShayako rAgaH\" |  dvitIye \" sa rasastadbhogashaktistadAkAN^xA 
cha\" |  uktamarthaM shlokArUDhaM karoti \dash \" ityAha\" iti |  dvitIyArthe
pramANamAha \dash \" indriyANi\" iti |  \" jayanti\" bhogashaktixayeNa, rAgaxayeNa 
cha |  \" asau\" rasanA tu |  \" rasye\" viShaye |  prakAradvayena cha vardhate |  
AdyamarthamupapAdayati \dash \" rasashabdasya\" iti |  \" uktaM yuktam\" ityubhayatra 
sheShaH |  \" rasa\" shabdasya rAgavAchitvaM tUktAbhidhAnAdavagantavyam |  achetane 
chetanavadupachArAt \" rasaH paraM dR^iShTvA nivartate\" iti yuktam |

ayamarthasaN^grahaH |  yadA bAhyendriyANi viShayaissannikR^iShyante tadA taddvArA
manastatra pravartate |  pravR^itte cha manasi rAgo bhavati, tata AtmanaH xobha 
ityeSha indriyANAmavijayaH |  yo hi yaM vyAkulaM karoti sa tena vijita 
ityuchyate |  \" yadA tu bAhyendriyANi viShayasannidhAne.api na taissannikR^iShyante, 
sannikR^iShTAnyapi na manastadAbhimukhyenAharanti |  AhR^ite.api manasi na 
viShayarAgo jAyate tadA nAtmanaH xobho bhavati\" ityeSha indriyajayaH |  
so.ayaM saN^graheNa dvedhA |  bAhyendriyANAM shaktixayAnmanaso rAgaxayAchcha |  
etaddvayaM cha puruShabhedenoktaprakAradvayena nirAhAratvabrahmasAxAtkArAbhyAM 
bhavatItyevamindriyajayasya mahAprayatnasAdhyatvamiti || 59||
%%% ##endlabel##

%%% ##label=<segment078_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu yatnaj~nAnAbhyAmindriyajayamuktvA \" yatato hyapi\" iti
tadviruddhaM kathamuchyata\?\" iti chenna |  indriyajayArthaM kiM nirAhAratvalaxaNena
mahAprayatnena |  \" pratyAhArAdinA sAdhAraNaprayatnena tatsambhavAt |  tathA kiM 
aparoxaj~nAnena |  nityAnityavivekaj~nAnenApi tadupapatteH\" ityAshaN^kya \" tanniShedho
atra kriyata\" ityAshayavAnvyAchaShTe \dash \" aparoxa\" iti |  j~nAnasya prAdhAnya\-
sUchanAya vipashchito.api ityetatpashchAduktamapi \" aparoxa\" ityAdau vyAkhyAtam |
\" yatato.api\" ityasyArthaH \" sAdhAraNa\" iti |  \" haranti viShayasannikR^iShTAni
tadabhimukhaM kR^itvA tadrAgIkurvanti\" ityarthaH |  \" puruShasya iti vyartham | 
strINAmapyevambhAvAd\" ityata Aha \dash \" puruShasya\" iti |  etachchokta
upapAdanArtham |  \" pramAthIni\" ityasya prayojanaM vaktumAha \dash \" ka\" iti |  
\" etAvatA.a.atmanastadavijayaH katham\?\" ityAshayaH |  \" manohR^itavanti
puruShasya xobhaNashIlAnIti na tena jitAni\" iti bhAvaH |  \" puruShasya\" 
ityanena ubhayatrAsyAnvayaM darshayati || 60||
%%% ##endlabel##

%%% ##label=<segment079_pd02>##

{\Largedvng pra\.dI\. ||} \" upoddhAtasya sAdhye vaktavye \" tAni sarvANi\" iti kimuchyata\?\" 
ityato \" antarApatitAM shaN^kAM nivartayitumetad\" iti bhAvenAha \dash \" tarhi\" iti |  
\" yadi sAdhAraNayatnavivekaj~nAnAbhyAM na jIyanta\" ityarthaH |  \" ashakyAnyeva
jetum\" iti sheShaH |  \" nirAhArasya dehAvasthAnAsambhavAdbrahmAparoxaj~nAnasya\-
chendriyajayasAdhyatayA.abhipretatvenetaretarAshrayaprasaN^gAd\" iti bhAvaH |  \" tathA 
cha tajjayasya j~nAnasAdhanatvaM yadvivaxitaM tanna sambhavati\" iti shaN^kAsheShaH |
\" indriyasaMyamo.ashakya eveti shaN^kAyAM \" tAni sarvANi saMyamyAsIta\" iti
kimetaduchyata\?\" ityata Aha \dash \" bahuyatnavata\" iti |  \" yatnaM bahum\" iti 
sheShaH |  \" yadyapi tajjaye na paroktaM sAdhanamasmaduktaM cha shakyam |  tathApi
tatpratinidhinA mahatA prayatnena jayyAni\" ityarthaH |  etadapyupoddhAtatvenaivoktaM
iti j~nAtavyam |  \" yukta\" iti naitadyujiro rUpam |  \" yena pratisambandhya\-
AkAN^xAyAM tadanuktirdoShaH syAt |  kintu samAdhyarthasya yujeH\" iti bhAvenAha 
\dash \" yukta\" iti |  \" matparaH\" ityuttaratra \" shravaNAnmayI\" ityuktam |  
\" matparaH ityadvaitaj~nAnamanyairvyAkhyAtam |  tannAxarAnusArI\" ityAshayavAn
vyAchaShTe \dash \" ahameva\" iti |  \" bhagavAneva sarvasmAdutkR^iShTa iti j~nAtvA
tasminneva nirantaraM manaso yojanamindriyajaye paraM sAdhanam\" iti bhAvaH |
nirAhAratvAdikaM tu vastugatipradarshanArthamevoktamiti mantavyam |  yadarthamayaM
upoddhAtoktastatpradarshanaparatayottarArdhatAtparyamAha \dash \" phalam\" iti | 
\" yadyevaM tataH kim\?\" ityAkAN^xAyAM \" indriyajayasya j~nAnaM phalamAha\" 
ityarthaH |  \" yata evaM j~nAnaM mahAyAsasAdhyendriyajayaphalamata evAyAsabhIrurjano
na tatsAdhayati |  na tu j~nAnasyoktalaxaNatvAbhAvAd\" iti shlokatrayatAtparyArthaH || 61||
%%% ##endlabel##

%%% ##label=<segment080_pd02>##

{\Largedvng pra\.dI\. ||} \" dhyAyata ityAdinA prakR^itAnupayuktaM kimetaduchyata\?\" ityata 
Aha \dash \" rAgAd\" iti |  rAgAdidoShasya kAraNaM \" rAgAdidoShakAraNam\" | 
tathA rAgAdidoShaH kAraNaM yasya tad \" rAgAdidoShakAraNam\" |  parihArAya
rAgAdidoShasya |  idamuktaM bhavati \dash \" matparo yukta AsIta\" itIndriyajayasya
paramasAdhanamuktam |  \" rAgAdidoShaparihAro.apyaparaM sAdhanam\" iti vaxyati |
\" tatra sa eva kathaM syAd\?\" ityAkAN^xAyAM \" upoddhAtaprakriyayedamuchyata\" 
iti |  \" sammoho mUrchChA.atra na saN^gachChata\" ityato.anyathA vyAchaShTe \dash
\" sammoha\" iti |  \" akAryechChA\" adharmechChA |  \" kuta\?\" ityata Aha 
\dash \" tathA hi\" iti |  \" saMshabdastu tasyaiva visheShaka\" iti bhAvaH |
\" adR^iShTarUpAdharmaviShayaM taddhetuShu pApakarmasu cha niyataM kAmanaM mohasaMj~nitam\"
ityarthaH |  spaShTaM chAtra pramANamAha \dash \" tathA cha\" iti |  yatkiJNchidviShayasya
smR^itivibhramasya prakR^itAnupayogAtsamyagvyAchaShTe \dash \" smR^iti\" iti | 
\" vibhramo\" anavasthAnam |  nAsha iti yAvat |  \" chetanasya kathaM buddhinAsha\?\" 
ityata Aha \dash \" buddhi\" iti |  \" smR^itivibhrama evAyam\" ityataH
\" sarvAtmanA\" ityuktam |  \" nitya Atmetyuktam |  tatkathaM vinashyati\?\"
ityata Aha \dash \" vinashyati\" iti |  ukte.arthe pramANamAha \dash \" tathA hi\" 
iti |  tadA doShAdR^iShTeH |  etaduktaM bhavati \dash \" rAgadveShayoH paramparayA
narakAdyanarthaprAptiH kAryamiti j~nAnena tatparijihIrShAyAM viShayadhyAnaM 
paramparayA tatkAraNamiti j~nAnena tadakaraNAttayoranutpAdo bhavati\" 
iti || 62\-63|| 
%%% ##endlabel##

%%% ##label=<segment081_pd02>##

{\Largedvng pra\.dI\. || } \" rAgadveSha\" iti shlokadvayasya tAtparyamAha \dash \" indriya\" 
iti |  indriyajayashcha tatphalaM cha \" indriyajayaphalam\" |  indriyajayasya
phalaM \" indriyajayaphalam\" |  \" astvevaM rAgadveShaparihAraH |  tataH kim\?\" 
ityAkAN^xAyAM rAgadveShaparihArasyendriyajayAkhyaM phalamAha |  \" indriyajayena 
kiM bhavati\? \" vashe hi yasyendriyANi\" iti j~nAnaM bhavatItyuktam\" iti chet
satyam |  \" tatkiM sAxAdindriyajayaphalamuta vyavahitam\?\" ityAkAN^xAyAM
\" indriyajayasya phalaM j~nAnaM yathA syAttathA.a.aha\" ityarthaH |  \" rAga\-
dveShaparihAravadviShayacharaNasyApIndriyajayasAdhanatvamuchyata\" (shAM\.bhA\.2\.64)
ityanyathApratItinirAsAyAha \dash \" viShayAn\" iti |  \" nirAhAratvamindriyajaye
kAraNam |  tachchAshakyam |  ataH kathamindriyajaya\?\" ityAshaN^kya \" deha\-
dhAraNamAtropayuktaviShayAnubhavo na doShAyeti tadabhyupagamamAtramanena kriyata\"   
iti bhAvaH |  \" indriyajayavAchakaM padamatra na shrUyata\" ityatastadvyAchaShTe
\dash \" vidheya\" iti |  \" sa vidheyAtmA\" iti sheShaH |  \" kimanenApi\?\" 
ityata Aha \dash \" jita\" iti |  anenapAdatrayeNa rAgadveShaparihArasyendriya\-
jayAkhyaM phalamuktam |  yadyapyanuvAdo.ayaM pratIyate |  \" tathApyaprAptatvAd\-
anyathAvAkyavR^ittiH |  tathA hi |  ya uktavidhayA tyaktarAgadveShaH |  sa rAgadveSha\-
viyuktaistAbhyAmaprayuktaiH kevalaM sharIradhAraNArthaM viShayAn charati |  sa 
vidheyAtmA bhavati |  tata eva bAhyendriyANyapi tasya vashyAni bhavanti\" iti |
ata eva krameNa vAkyadvayasya pR^ithak tAtparyaM noktam |  dvitIyAkAN^xasya
uttaratvena \" indriyajayasya j~nAnaM vyavahitaphalam\" iti darshayituM
sAxAtphalamuktaM \" vidheyAtmA prasAdamadhigachChati\" iti |  tatra prasAdo
\" nAmAtmadharma\" iti pratIyate |  tannivR^ittyarthamAha \dash \" prasAdam\" iti |  
\" prasannachetasaH iti vaxyamANatvAd\" iti bhAvaH || 64||
%%% ##endlabel##

%%% ##label=<segment082_pd02>##

{\Largedvng pra\.dI\. ||} \" prasAde sati kiM na syAd\?\" ityata uktaM \dash \" prasAda\" iti | 
tadAxipati \dash \" katham\" iti |  \" tarati shokamAtmavit\" ityAdivirodhAt
iti bhAvaH |  \" kiM cha prasAde sati j~nAnaM bhavatIti vA vyavadhAnAntare vA
vaktavyam |  tannoktam |  sarvaduHkhahAnistvavaktavyaivoktA\" iti chAxepasheShaH |
etatparihAratvenottarArdhaM vyAkhyAti \dash \" prasanna\" iti |  etena \" prasAdasya
phaladvayamuchyata\" ityapi pratItirnirastA bhavati |  prasAde sati brahmAparoxaj~nAnaM
bhavati |  tachcha vyavadhAneneti bhaviShyati |  tato bhavantI sarvaduHkhahAniH 
prasAdaphalatayokteti na vaktavyAnuktiH |  nApyavaktavyoktiH |  \" buddhiyuktaH 
(2\.50) iti shloke sukR^itaduShkR^itahAnaM j~nAnaphalamuktam\" (shAM\.bhA\.2\.50) |  
tadayuktam |  apuruShArthatvAdityAshaN^kAM parihartuM prasaN^gAdidamuktamiti |  \" nanu 
yasyAnAyAsena abhilaShitaviShayopanatistasya mano.avyAkulaM prasannamityuchyate |  
tataH kathaM prasAdasyendriyajayaphalatvaM j~nAnaphalakatvaM chochyata\?\" ityata Aha 
\dash \" prasAdo nAma\" iti |  \" atra vivixitA\" iti sheShaH |  svato.api 
prayatnaM vinA.api |  viShayAgatirviShayAn pratyapravR^ittiH || 65||
%%% ##endlabel##

%%% ##label=<segment083_pd02>##

{\Largedvng pra\.dI\. ||} \" vaktavyasyoktatvAt \" nAsti buddhiH\" ityAdikaM kimartham\?\" 
ityata Aha \dash \" prasAda\" iti |  shravaNamananAbhyAM upakR^itena dhyAnenaiva
brahmAparoxaj~nAnasiddheH kimanena prasAdena |  \" yadarthamindriyajayo.apexita
ityAshaN^kya\" iti sheShaH |  \" nanvatra prasAdAbhAva idaM syAditi nochyate |  
ataH kathametaduktam\?\" ityataH prakaraNaprAptamadhyAharati \dash \" na hi\" 
iti |  \" nanu prasAdarahitA anumimata\" ityata Aha \dash \" chitta\" iti |  
ekAgratetyarthaH |  \" evamadhyAhAre sati \" nAsti buddhiH\" ityetatsambadhyata\" 
iti bhAvenAha \dash \" ayuktasya cha\" iti |  \" j~nAnamAtraM prakR^itAnupayuktamayuktaM 
cha\" ityata Aha \dash \" samyag\" iti |  \" brahmAparoxaj~nAnam\" ityarthaH |
\" etAvatA prasAdAbhAve doSha uktaH |  tatkimarthaM \" na chAyuktasya\" ityetad\?\" 
ityata Aha \dash \" tadeva\" iti |  \" dhyAnenaiva j~nAnotpAdAtkathaM nAsti
buddhirayuktasyetyAshaN^kyA\" iti sheShaH |  \" bhAvanA\" dhyAnam |  ata eva na
chAbhAvayato j~nAnam |  na chAj~nAninaH shAntiriti yojyam |  \" nanu shAntiH
prasAdaH |  tasya j~nAnasAdhanatvenoktatvAt kathaM j~nAnottaratvamuchyata\?\" 
ityata Aha \dash \" shAntiH\" iti |  etachcha na kevalaM muktau sarvaduHkhahAniH |  
kintu saMsAribhiralabhyaM paramasukhaM cheti j~nApayituM prasaN^gAduktam |  etadevAvexya 
bhAShyakR^itA \" brahmAdipadAt\" (bhA\.2\.50) ityAdyuktam || 66||
%%% ##endlabel##

%%% ##label=<segment084_pd02>##

{\Largedvng pra\.dI\. ||} \" ekenaiva shlokena prameyasya mudritatvAt \" shlokAbhyAm\" 
iti kimarthamuktam\?\" ityata Aha \dash \" katham\" iti |  kR^itashravaNamananasya
dhyAnopapatteriti bhAvaH |  \" na bhavatItyAshaN^kyA\" iti sheShaH |  \" anuvidhAnam\" 
sadR^ishabhavanam |  \" tadatrAsaN^gatam |  kartA chAtra jIva iti pratIyata\" ityata 
Aha \dash \" anuvidhIyata\" iti |  vipUrvo dadhAtiH karotItyarthe vartate |
kartA chAtreshvara evetyarthaH |  atrAnuH pR^iShThabhAvitvArtho na laxaNAdyArtha iti
karmapravachanIyo na bhavati |  nanviti sampratipattiruktA |  \" sA kuta\?\" 
ityata Aha \dash \" buddhiH\" iti |  grahaNashaktiH \" praj~nA\" |  \" tadgrahaNaM
atrAyuktam\" ityata Aha \dash \" praj~nAm\" iti |  paroxanishchayam |  
\" yasya praj~nAnaM notpannaM yasya yuktyabhAvaH kiM kariShyati\? vidyamAnasya hi
haraNam\" ityata Aha \dash \" utpatsyad\" iti |  \" tarhyutpannaparoxaj~nAnasya
yuktyabhAvo.akiJNchitkara\" ityata Aha \dash \" utpannasyApi\" iti |  \" chitta\-
nirodharahitashravaNamanane api na dhyAnopayoginI tattvanishchayavedArthaniyamau
kuruta\" iti bhAvaH || 67||
%%% ##endlabel##

%%% ##label=<segment085_pd02>##

{\Largedvng pra\.dI\. ||} \" atra paramaM prameyaM j~nAnilaxaNaM prakR^itam |  tasyAsambhavaparihArAya
j~nAnasya mahAprayatnasAdhyendriyanigrahasAdhyatvaM cha |  tatra kasya ayamupasaMhAra
iti na j~nAyate\" |  ata Aha \dash \" tasmAd\" iti |  \" j~nAnI j~nAyata\" iti 
sheShaH |  \" yata evaM nigR^ihItendriyasyaiva prasAdaH, prasAdavata eva yuktiryuktaM, 
ata eva shravaNamananAbhyAM tattvaj~nAnaM, tattvaj~nAnavata eva aparoxaj~nAnasAdhanaM
dhyAnaM, nAnyathA tasmAd\", ityarthaH  || 68||
%%% ##endlabel##

%%% ##label=<segment086_pd02>##

{\Largedvng pra\.dI\. ||} \" j~nAninaH sarvakarmaparityAgapratipAdanArtho yA nishA ityayaM
shloka\" (shAM\.bhA\.2\.69) iti kashchit |  tanna |  tatpratipAdakAxarAshravaNAt |
\" pramANavirodhAchcha\" ityAshayena tatpratipAdyamAha \dash \" uktam\" iti | 
chatuHshlokyA vixipyoktam |  \" nanvatroktaM kimapi na pratIyata\" ityata 
Aha \dash \" yA\" iti |  parameshvarasvarUpasya nishAsAmyamupapAdayati \dash 
\" yasyAm\" iti |  viShayatvamadhikaraNatvaM chAvivaxitvA kArakatvamAtravivaxayA
sAmyamidamuktam |  \" saMyamI\" ityasyAxarArtha \dash \" indriya\" iti | 
prakaraNalabhyo.artho \" j~nAni\" iti |  uttarArdhArthamAha \dash \" yasyAm\" iti |  
atrApi pUrvavatsAmyam |  \" yadi na kiJNchitpashyati kathaM tarhi tasya
gamanAdipravR^ittiH\?\" ityata Aha \dash \" mattAdivad\" iti |  \" kuta 
etad\?\" ityata Aha \dash \" taduktam\" iti |  \" muneH\" ityuktatvAt
\" chaturthAshramiNa eva j~nAnam\" iti vyAkhyAnamasaditi bhAvenAha \dash 
\" manana\" iti |  yAj~navalkyAdInAmayatInAmapi j~nAnashravaNAditi bhAvaH |  
\" mananasya prAN^nivR^ittatvAt \" pashyato muneH\" iti katham\?\" ityata Aha \dash 
\" pashyata\" iti |  darshanasAdhanatvena mananamihoktam |  na tu 
tatsamakAlInatayetyarthaH |  etachcha prAN^mananAdeH spaShTaM darshanasAdhanatvAnukteH 
prasaN^gAdihoktam |

\" nanu \" sthitadhIH kiM prabhASheta\" (2\.54) ityAderuttaramayaM shloka iti 
prAguktam |  tatkathamidAnIM laxaNaparatayA vyAkhyAtaH\?\" |  \" anyaparAdapi 
tallAbha ityAshayena\" iti brUmaH |  anyathA \" kiM prabhASheta\" ityAderuttaraM
AhetyatraivAvaxyat |  \" kiM tatra sthAnapradarshanAdinA\?\" iti || 69||
%%% ##endlabel##

%%% ##label=<segment087_pd02>##

{\Largedvng pra\.dI\. ||} \" pR^iShTasya samastasya uttaramuktam |  tatkiM \" ApUryamANam\"
ityanena\?\" ityata Aha \dash \" tena\" iti |  kriyamANetyupaskartavyam |
nityasApexatvAdasAmarthyAbhAvaH |  bAhyAnusandhAnarahitasya yujyetApi 
kathaJNchid gamanAdikam |  viShayAnubhavastu dR^ishyamAnaH kathaM syAt\?  \" tasya 
niyatasAdhana sAdhyasyAnusandhAnena vinA.anudayAd ityAshaN^kAparihArArtham\" 
iti sheShaH |  \" tadvatkAmA yaM pravishanti\" iti saN^xepeNoktam |  

tadvivR^iNoti \dash \" ya\" iti |  \" kAma\" shabdasyArtho \" viShayaiH\" iti |
anyathA, \" vihAya kAmAn\" ityuttaravirodhAt |  \" achalapratiShTham\"
ityasyaiva vyAkhyAnaM \" notsekam\" ityAdi |  \" kuta eSho.artha\?\"
ityataH \" samudradR^iShTAntopAdAnasAmarthyAd\" iti bhAvenAha \" na hi\"
iti |  

\" sa shAntimApnoti\" ityasya arthamAha \dash \" sa\" iti |  j~nAniprashaMsArthametat |
taddR^iShTvA kechit \" j~nAnina eva muktirityanenAha\" ityAhuH |  tadasat,
gatArthatvAt || 70||
%%% ##endlabel##

%%% ##label=<segment088_pd02>##

{\Largedvng pra\.dI\. ||} \" vihAya ityanenAyamevArtha uchyate |  ataH punaruktiH\" ityata
Aha \dash \" etadeva\" iti |  \" yadyatra \" kAmA\" ichChAvisheShAstarhi \" nispR^ihaH\" 
iti punaruktiH |  yadi \" kAmyanta\" iti viShayAstadA \" charatiH\" yadi
bhaxaNArthaH tadA vyAghAtaH |  atha gatyarthastadA vyartha\" ityato vyAchaShTe
\dash \" kAmAn\" iti |  \" nirmamo nirahaN^kAraH\" ityetad \" asambhava\"
parihArAya vyAchaShTe \dash \" bhaxayAmi\" iti |  \" kartR^itvAbhimAna eva 
\" ahaN^kAraH\" |  svAmitvAbhimAna eva mamatA |  na tu \" aham\"
pratyayAdimAtram\" iti bhAvaH |  \" sa hi pumAn ityanena anvayasamAptiM 
vadatA, \" j~nAnina eva muktiH\" ityeSho.artho nAtra pratipAdyata\" iti 
darshitam |  strIvyAvR^ittyabhAvashcha  || 71||
%%% ##endlabel##

%%% ##label=<segment089_pd02>##

{\Largedvng pra\.dI\. ||} \" j~nAnI stUyata \" eShA\" ityanena\" ityasat |  prathamavAkye
tadadarshanAditi bhAvenAha \dash \" upasaMharati\" iti |  \" prakaraNaM 
samApayati\" ityarthaH |  \" brahmadharmabhUta\" iti pratItinirAsAyAha \dash 
\" brAhmI\" iti |  sthitirnoktA |  \" tatkathamevamuchyata\?\" ityata Aha \dash 
\" laxaNam\" iti |  brahmaviShayaj~nAnavato laxaNamuktamityarthaH |  \" kiM 
prabhASheta\?\" ityAdiprashnaparihArasyArthAduktatvAdanupasaMhAraH |

\" antakAle charame vayasyapi yaH parivrajyAsyAM sthitau tiShThati so.api brahmApnoti |  
kimu brahmacharyAdeva pravrajya\?\" iti vyAkhyAnamasat |  aprakR^itatvAdityAshayavAn 
vyAchaShTe \dash \" antakAle.api\" iti |  j~nAnino brahmaprAptiruktA |  \" sA kiM
taddehapAtAnantaramevotAnyathetyapexAyAmidamuchyate \? kuto.asyArthasya 
bhagavadabhipretatvam\?\" ityata Aha \dash \" yaM yam\" iti | 

\" nanu j~nAnameva moxasAdhanam |  kAraNapauShkalye cha kAryaM bhavatyeva |  ataH
kathaM j~nAninaH sharIrAntaraprAptiH\?\" ityata Aha \dash \" j~nAninAmapi\" iti | 
\" prArabdhakarma sAmagryAH pratibandhakam |  tadevAntakAle brahmAnusandhAnaM 
pratibadhnAti\" iti bhAvaH |  \" nanu j~nAnAdeva sarvaM karma xINam\" ityata
Aha \dash \" bhogena\" iti |  \" astu prArabdhakarmaNAM bhogAdeva xayaH |  sa 
cha j~nAnaM yachCharIre jAtaM tatraivAbhUt |  ataH kathaM sharIrAntarArambha\?\"
ityata Aha \dash \" santi hi\" iti |  \" tAni kathamekenaiva sharIreNa
bhujyeran\?\" iti sheShaH |  \" saptajanmani\" iti dviguH |  itashchaitadevaM
ityAha \dash \" dR^iShTeshcha\" iti |  \" bahu\" ityanekopalaxaNam |  \" kathaM 
j~nAninAM bahusharIraprAptirdR^ishyata\?\" ityata Aha \dash \" tathA hi\" 
iti |  \" nanu j~nAnino.api yadi sharIrAntaraprAptistarhi garbhavAsAdi\-
duHkhairviluptashaktikaM j~nAnaM cha moxAya paryAptaM syAd\" ityata Aha \dash 
\" nishchita\" iti |  \" tasya\" j~nAninaH |  tAvadeva chiram |  tAvAneva 
vilambaH |  yAvanna vimoxye vimoxyate |  prArabdhena karmaNA |  athAvasite 
karmaNi |  \" brahma sampatsyata\" ityarthaH |  avasitakarmaNi j~nAnini viShaye 
putrAdayo yadi shavyaM karma kurvanti yadu cha na yadi vA na kurvanti |  
sarvathArchiShamabhisambhavati prApnotyevetyarthaH |  tadidamuktaM \" nainAM 
prApya vimuhyati\" iti |
%%% ##endlabel##

%%% ##label=<segment090_pd02>##

{\Largedvng pra\.dI\. ||} pAshupatavaisheShikAdayastvAhuH \" aniyatakAlavipAkAnyapi
karmANi j~nAnI yogasAmarthyAt samAhR^ityAnekasharIraphalAnyapi 
kAyavyUhanirmANena xapayitvA.apavR^ijyate |  tatkuto.asya dehAntaram\?\" 
iti |  tatrAha \dash \" na cha\" iti |  \" j~nAninaH karmaxayArtham\" iti 
sheShaH |  tathA hi |  aprArabdhakarmaxayArthaM vA sA syAt |  prArabdhaxayArthaM 
vA |  nA.adyaH |  teShAM j~nAnenaiva xINatvAditi bhAvena Aha \dash \" tadyathA\" 
iti |  dvitIye tu yaH kashchijj~nAnI tathA karoti, sarvo vA |  Adye 
sampratipattimuttaramAha \dash \" prArabdhe tu\" iti |  dvitIyAsambhave hetumAha 
\dash \" pramANa\" iti |  \" cha\" shabdAtprAgudAhR^itapramANavirodhAchcha |  
\" pAshupatAdishAstreShu tathoktatvAtkathaM pramANAbhAva\?\" ityata Aha 
\dash \" na cha\" iti |  \" tachChiShyA api tachChabdenochyanta\" iti 
bahuvachanam |

\ \ \ \" umApatiH pashupatiH shrIkaNTho brahmaNassutaH |
\ \ \ uktavAnidamavyagraM j~nAnaM pAshupataM shivaH\" ||

\dash (mahA\. 12\.337\.62) ityAdau tatstutirapi dR^ishyata ityata Aha \dash \" yatra 
tu\" iti |  vaiShNavashAstroktaprakAreNa shivabhaktAnAm |  \" laxaNayA\" iti 
sheShaH |  \" satyatvaM taduktArthasya\" iti sheShaH |  uktanindAvirodhAditi 
bhAvaH |  \" tarhi shaivapurANAni kAyavyUhanirmANaniyamAdau pramANAni\" ityata 
Aha \dash \" na hi\" iti |  \" teShAm\" iti buddhisthashaivapurANaparAmarshaH |
itaragranthA udAhR^itagAruDAdayaH |

\" shaivapurANAnAM gAruDAdivaiShNavagranthAnAm cha ko visheSho yena bAdhyabAdhakabhAva
ityAshaN^kya, durjanavyAmohanArthapraNItapAshupatAdimUlAni shaivapurANAni, samyagj~nAnArtha\-
praNItapaJNcharAtrAdyanusAriNo gAruDAdigranthA\" ityAshayavAn pAshupatAdishAstrANAM
mohanArthatve tAvatpramANamAha \dash \" tathA hi\" iti |  \" kAraya\" iti svArthe
Nich |  \" atathyAni\" sarvathA.apyavidyamAnAni |  \" vitathyAni\" \" vyadhikaraNAni
cha teShu darshayasva\" |  \" prakAsham\" prasiddham |  idAnIM tanmUlatvaM
shaivapurANAnAmitareShAM paJNcharAtrAdimUlatvamityatra pramANamAha \dash \" kutsitAni\" 
iti |  tachChAstrasamayena tachChAstrasiddhAntamanusR^itya |  \" vedaiH\" iti
vedAnAmApAtapratItimanusR^itya |  \" bhAgavatam\" bhagavadviShayam |  uktaM
upasaMharati \dash \" ata\" iti |  j~nAninAM muktirbhavatyeva |  na tu taddeha\-
pAtAnantaramiti niyama ityupasaMhAraH | 
%%% ##endlabel##

%%% ##label=<segment091_pd02>##

{\Largedvng pra\.dI\. ||} \" nanu bhIShmAdayo j~nAnino.antakAle brAhmyAM sthitau sthitAshcha 
na muktAH |  tatkathametaduktam\?\" ityata Aha \dash \" bhIShmAdInAntu\" iti | 
sAxAddehatyAgaxaNe |  \" yuktyA parameshvare manoyogena bhAvyamityeva kuta\?\" 
ityata Aha \dash \" smaran\" iti |  \" yaM yaM vA.api\" ityatra |  
\" bhIShmAdInAM tasmin xaNe yuktyabhAva ityetatkuta\?\" ityata Aha \dash 
\" tachcha\" iti |  \" nanu tatxaNe yuktyA muktishchedaj~nAninAmapi tatsambhavena 
muktiprasaktiH\" ityata Aha \dash \" na cha\" iti |  \" bhaktij~nAnena\" iti 
dvandvaikavadbhAvaH |  bhaktisahitaM j~nAnaM \" bhaktij~nAnam\" iti vA | 
%%% ##endlabel##

%%% ##label=<segment092_pd02>##

{\Largedvng pra\.dI\. ||} \" brahmanirvANaM brahmasvarUpAnandam\" iti vyAkhyAnaM sarvapramANaviruddhaM
ityAshayavAn \" nirbANam\" iti bhinnaM padaM vyAchaShTe \dash \" nirbANam\" iti |  
\" kathaM etad\?\" ityAha \dash \" kAya\" iti |  kAryabrahmavyAvR^ittyarthametat |  
anena brahmaNo nirAkAratvaM prAptam |  tatpratiShedhArthamAha \dash \" nirbANa\" 
iti |  \" pratipAdanam\" vyAkhyAnam |  \" ityAdivad\" ityAderiva |  
\" prAkR^itAdivigraharAhityArthatvena\" ityarthaH |

\" kimanena vyAkhyAnena nirAkArameva brahma kiM na bhaved\?\" ityata Aha \dash 
\" katham\?\" iti |  \" bhagavato viShNoH sAkAratve.api brahmaNo nirAkAratvameva |
na cha bhagavAneva brahma |  tasya taduttamatvena tato.anyatvAt |  ato na 
purANAdivirodha\" ityata Aha \dash \" na cha\" iti |  \" mahadbrahma\" ityantAni 
vAkyAni bhagavato brahmatvapratipAdakAni |  \" yasmAd\" ityAdIni tasyaiva 
sarvottamatvena taduttamAbhAvapratipAdakAni |  indriyagrAhyamatikrAntaH 
taduttamaH |  sarvameva yogIndriyagrAhyam |  

\" uttamAdhamabhAvena brahmeshvarayorbhedo mAbhUt |  brahmAsharIram |  Ishvarastu
sa vigraha ityato bhedo.astu |  abhedasyApi sattvAdbrahmashabdopapattiH\" 
ityata Aha \dash \" na cha\" iti |  \" tasya\" parAbhimatasya |  \" etat\" 
bhagavato.anyatvam |  \" kuta\?\" ityata Aha \dash \" tasyApi\" iti | 
\" daharo.asminnantarAkAshaH tasmin yadantastadanveShTavyam\" (ChA\.u\. 8\.1\.1) 
ityantaM vAkyamiha vivaxitam |  \" ityAdiShu brahmavidyAtvena sammateShu\" 
iti sheShaH |  \" kathamatra sharIrashravaNam\?\" ityata Aha \dash \" yadi\" 
iti |  \" rUpam\" vigrahaH |  \" vij~nAnamAnandaM brahma\" (bR^i\.u\. 3\.9\.28)
ityAnandashabdasya napuMsakatvadarshanAt tathopAdAnam |  \" jyotiH\" shabdo
bhAsvararUpasya vAchakaH |  ata uktaM \" suvarNarUpatvam\" iti |  \" daharatvam\" 
daharasthatvam |  avigrahasyeti vartate |  \" daharasthatvaM kathamavigrahasyAnupapannam\?\" 
ityata Aha \dash \" daharasthashcha\" iti |  evamupapattisApexANi vAkyAnyudAhR^itya
spaShTAnyapyudAharati \dash \" sahasra\" iti |  \" avasIyate\" paramAtmA |
%%% ##endlabel##

%%% ##label=<segment093_pd02>## 

{\Largedvng pra\.dI\. ||} \" prAk bhagavato.anyasyottamatvaM vAkyaviruddhamityuktam |
idAnIM vyAhataM cha tad\" iti bhAvenAha \dash \" ati\" iti |  \" ati\" AdishabdaiH
niratishayatvaM dyotyate |  \" aishvaryam\" vashitvam |  \" shrIH\" kAntiH |
parameshvara bhagavachChabdasyaupachArikatvaparihArAyaiShAM guNAnAM sadbhAve pramANAni
Aha \dash \" parA.asya\" iti |  \" AnandaM brahmaNaH\" ityatra \" yato vAchaH\" 
iti pUrvavAkyamapyabhipretam |  \" amita\"{]shabdAt paraM chandrashabdo.adhyAhAryaH |
draShTR^ipuruShayogyatAbhedAt tridhoktiH |  aishvaryAdyanantaguNatve \" mayi\" iti
pramANam |  saN^khyAparimANAbhyAM guNAnAmAnantyamanenochyate |  shakteH 
paratvaM prAguktam |  \" tadaspaShTam\" ityato \dash \" vij~nAna\" iti |  j~nAnasya
aparoxarUpatApratipAdanAya \dash \" turyam\" iti |  \" Ishvaro nAtmAnaM vetti,
kartR^ikarmabhAvavirodhAd\" ityetannirAsAya \dash \" AtmAnam\" iti |  \" Ishvare
bhagavachChabdasyaupachArikatvAsambhaM pradarshayituM tadanyasya\" tachChabdArthatA 
nirAsAya \dash \" anyatama\" iti |  anya evAnyatamaH |  bhagavachChabdasyAyamartha
ityatra \" aishvaryasya\" iti pramANam |  atra \" ShaNNAm\" ityupalaxaNam |
ShADguNye sarvaguNAntarbhAvo vA |  tadvAn bhagavAniti siddhameva |  bhagavattvAt
sa eva sarvottama iti |  samagrArthe.atIveti |  \" yadanyena kariShyAmi\" iti 
smartuM buddhisthIkartuM vA.ayuktam |  \" tachcha tvaM kartuM shaktaH\" |
%%% ##endlabel##

%%% ##label=<segment094_pd02>##

{\Largedvng pra\.dI\. ||} \" matupA j~nAnAdInAM bhagavato bhedaH pratItaH |  ShaNNAM
ityAdinA parasparaM cha |  tathA \" AkR^itirbhagavataH\" ityuktyA.akR^iteshcha\" |
tannirAsArthamAha \dash \" tAni\" iti |  tatra pramANAnyAha \dash \" vij~nAnam\" 
iti |  \" tapa\" AlochanakriyA |  \" j~nAnamayam\" j~nAnAtmakamiti dharmANAM
parasparabhedoktiH |  \" prAkR^ita\" iti N^IbabhAvaH ChAndasaH |  aNaJNbhyAmanyo vA 
pratyayaH |  mAMsamedo.asthibhiH sambhavo yasyAsA tathoktA |  etachcha na yogitvAt |  
kintvIshvaratvAt |  ata eva vibhuH |  nirdoShaguNAtmakavigrahAd \" achyutaH\" |  
\" j~nAnaj~nAnaH\" ityAderatishayitaj~nAnAdirityarthaH |  tena nirdoShatvAdinA |

\" bhagavadrUpasyaivaM bhAve kathaM parichChinnatvam\? garbhavAsAdisaMsAridharmAshcha
tatra dR^ishyanta\" ityata Aha \dash \" tadeva\" iti | \" kimartham\?\" ityata 
uktaM \dash \" lIlayA\" iti |  \" mAyayA\" vyAmohakashaktyA |  atra
pramANamAha \dash \" na cha\" iti |  \" devyA\" devakyAH |  evaM garbhavAsAdi\-
pradarshanena |  moghaM darshanaM yasmin viShaye sa tathA |  \" AtmavatAm\" 
bhAgavatAnAm |  \" AtmA nirupAdhikapriya\" iti yAvat |  \" munisuto\" 
rAvaNaH |  brahmavAkyavadrudravAkyamapyatulaM pratyastItyato rudravAkyamityuktam |
\" karuNaH\" karuNAvAn |  arsha AditvAdach |  \" tadeva\" ityAdyuktaM
upasaMharati \dash \" na tatra\" iti |  \" ata\" ityupaskartavyam |

\" yadyevaM tarhi vishvarUpaM paraM, tadapexayA kR^iShNAdirUpANyavarANIti kathaM
grantheShUchyata\?\" ityata Aha \dash \" yatra cha\" iti |  \" yatra\" granthe |  
\" tatra vishvarUpamapexyAnyatra kR^iShNAdAvavaratvamaj~nabuddhimapexyoktaM
j~nAtavyam\" ityarthaH |  \" kuta etad\?\" ityata Aha \dash \" tachcha\" iti | 
\" akhilarUpato\" akhiladharmaiH |  vimohanaM kartum |  \" nanvayamupachAro
vA stutirvA kiM na syAd\?\" ityata Aha \dash \" na cha\" iti |  asambhave
hyeShA kalpanA |  achintyashaktyaikasyaivAnekaparimANatvAdikaM sambhavati | 
anyatrAdarshanena tvapalApe.atiprasaN^ga ityarthaH |  atraiva pramANamAha \dash 
\" kR^iShNa\" iti |  \" vimohasi\" vimohayasi |  shlokArthaM upasaMharati 
\dash \" tasmAd\" iti |  
%%% ##endlabel##

%%% ##label=<segment095_pd02>##

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM dvitIyo.adhyAyaH ||}
%%% ##endlabel##

%%% ##label=<segment001_pd03>##

{\Largedvng pra\.dI\. || } pUrvottarAdhyAyebhyo.asya bhedaM svasminnekavAkyatAM cha darshayan
etadadhyAyapratipAdyamarthaM pUrvAdhyAyArthasaN^gatatvena vivaxuH tatpratipAdyaM tAvadAha \dash
\" Atma\" iti ||  jIveshvarasvarUpaM sAN^khyAkhyamityarthaH |  \" j~nAnasAdhanam\"
Atmaj~nAnasAdhanaM yogAkhyam |  \" pUrvatra\" pUrvasminnadhyAye |  na chaivaM 
dvitIyAdhyAyasyaikyAnupapattiH |  sAdhanasyaiva prAchuryAt |  prachureNa cha vyapadeshAt |
tathA cha saptamAdau vaxyati \" sAdhanaM prAdhAnyenoktamatItairadhyAyaiH\" iti |
AtmasvarUpaM ityAdi tu prakaraNabhedapradarshanAyoktamiti |  etatsaN^gatatvena 
tR^itIyAdhyAyArthamAha \dash \" j~nAna\" iti ||  yogo dvividhaH |  karmasamAdhibhedAt |
tatra tAvat \" j~nAnasAdhanatvena karma vidhIyate\" kartavyameveti j~napyate kaishchana
vAkyaiH |  \" akarma\" karmAkaraNam |  \" vinindya\" asminnadhyAye |  akarmanindA.api
karmavidhyartha ityekArthatA |  tathApi prakaraNabhedArthamevamuktam |  \" j~nAnasAdhanatvena\"
iti vadatA moxasAdhanatA nirastA |  tena prashnaprativachanApavyAkhyAnamapi apahastitam |
AnandavR^iddhyarthatA tvanuj~nAyata eva |

bIjaM pradarshayan prashnavAkyatAtparyamAha \dash \" karmaNa\" iti ||  Adipadena
\" kR^ipaNA phalahetavaH\" ityAdergrahaNam |  \" ghore\" rAgadveShAdyupete |  atrobhayatra
\" karma\" shabdena kAmyaM karmAbhipretam |  \" nivR^ittadharmAn\" 
niShkAmadharmAn |  yatyAshramavihitAn shamadamAdIn |  atra \" karmaNi kimiti niyojayasi\"
ityekaH prashnaH |  \" ghore\" iti dvitIya ityavadheyam |

idamuktaM bhavati |  AshramatrayavihitAni yaj~nAdIni yuddhAdIni cha karmANi kAmyAnyeva |
phalashravaNAt \" sarva ete puNyalokA bhavanti\" (ChA\. u\. 2\.23\.1) ityAdi |  tathA.atrApi 
\" hato vA prApsyasi svargam\" (2\.37) ityAdi |  chaturthAshramavihitAni shamadamAdIni
akAmyAni |  phalAshravaNAt |  \" shAnto dAntaH\" ityupakramya \" AtmAnaM pashyet\"
( bR^i\. u\. 4\.4\.23) iti j~nAnArthatvashravaNAchcha |  j~nAnaM cha kAmyAt karmaNo.atyuttamaM
ityabhihitam |  tatashcha kAmye karmaNi yuddhe \" yudhyasva bhArata\" (2\.18) iti
niyojanamayuktam |  kintu \" chaturthAshramaM svIkR^itya taddharmaniShTho bhava\" iti
niyoktavyam |

nanu \" yuddhamapi \" karmabandhaM prahAsyasi\" (2\.39) ityuktatvAjj~nAnArthaM bhavati\"
iti matam |  tadA vyAmishreNa vAkyena buddhimohanamivApadyate |  athaivaM matam |  yuddhAdIni
karmANi kAmyAnyakAmyAni cha |  tatra yaH sakAmaH taM prati \" hato vA\" (2\.37) ityAdi
uktam |  yaH punarj~nAnArthI tamuddishya \" karmaNyevAdhikAraH\" (2\.47) ityuktam |
tatra kA vyAmishrateti |  tathApi shuddheShu nivR^ittalaxaNeShu yatyAshramadharmeShu satsu
vaikalpikeShu niyojanamayuktameva |  tatra manovixepAbhAvAt |  atra tadbhAvAditi |

kiJNcha kAmakrodhAdInaM narakaphalatvamuktam |  yuddhe cha kAmAdayo.avarjanIyAH |  tato.api
tatra niyojanamayuktam |  nanvasyottaraM \" sukhaduHkhe same kR^itvA\" (2\.38) ityuktam |
satyam |  tathApi rAgAdiprasaktihIneShu shakyAnuShThAneShu yatidharmeShu satsu ashakyAnuShTheye
yuddhe niyojanamayuktameveti |

prathamashloke padAnAM vyavahitatvAdanvayaM darshayan kiJNchidvyAchaShTe \dash \" karmaNa \"
iti || ShaShThIbhrAntinirAsAya \" sakAshAt\" ityuktam |  \" buddhiH\" Atmaj~nAnam |
\" jyAyasI\" prashastatarA || 1|| 2||

%%% ##endlabel##

%%% ##label=<segment002_pd03>##

{\Largedvng pra\.dI\. || } evaM chetprashnastarhi kathaM parihAravAkyaM saN^gachChate |  tatra
niShThAdvaividhyakathanAdityatastadabhiprAyaM vadannavatArayati \dash \" jyAyastve.api\" 
iti ||  buddhiH kAmyakarmabhyo jyAyasIti yaduktaM tattathaivetyarthaH |  tathApi tvAM tatraiva
vaikalpike yuddhAdikarmaNi prerayAmi |  kutaH \?  \" AdhikArikatvAt\" |  tvaM karmaNyapi
vixepakAriNyapi vaikalpike.adhikR^ita iti kR^itvA |

ayamatrottarakramaH |  AshramatrayavihitAni yaj~nAdIni yuddhAdIni cha na shuddhakAmyAni |  kintu
karturichChayA svargAdyarthAni j~nAnAdyarthAni cha bhavanti |  ato buddheH kAmyakarmaNo
jyAyastve.api yuddhasya buddhyarthatvasambhavAttatra niyogo nAnupapannaH |  \" yatidharmAnvinA
kimetena niyogena\?\" iti chet \" anadhikArikANAmeva yatyAshramasvIkAro nAdhikArikANAm |
\" tairgR^ihasthAdyAshramamaparityajyaiva tadvihitAni karmANi niShkAmatayA.anuShTheyAni\" iti
IshvaraniyamAttava chAdhikArikatvAt\" iti |  \" svarAdyantopasR^iShTAchcha\" iti
kAtyAyanavachanamanityam |  atra eva na pANinirabhANIt |  \" ayamAshayaH shlokAtkathaM
labhyata\?\" ityato vyAchaShTe \dash \" dvividhA api\" iti ||  niShThA dvividheti
vyAkhyAne krameNaikasyaiva puruShasya tatsambhavAnnoktAbhiprAyo labhyata ityevaM vyAkhyAnam |
na kevalamekavidhAH sAN^khyA evetyaperarthaH |

dvaividhyameva sodAharaNamAha \dash \" gR^ihasthAdi\" iti ||  yatyAshramaparigraheNetyapi
grAhyam |  \" j~nAnaniShThA\" yatyAshramavihitaireva karmabhirj~nAnasAdhane.abhiyuktAH |
sanakAdibhistulyaM vartanta iti \" sanakAdivat\" |  evaM \" janakAdivad\" ityapi |
\" tatsthA eva\" gR^ihasthAdyAshramasthA eva |  taddharmairyuddhAdibhirj~nAnasAdhane
abhiyuktAH |

\" dvividhA api janAssanti\" ityukte karmamArgasthA j~nAnamArgasthAshcheti dvaividhyaM
pratIyate |  tannivR^ittyarthamAha \dash \" maddharma\" iti ||  j~nAnamArgasthA eva |
tatashcha \" maddharmasthA eva janA dvividhA api santi\" ityanvayaH |  \" tatkatham\?\"
ityAkAN^xAyAmuttaraM vAkyadvayaM |  \" sAN^khyAnAm\" \" yoginAm\" iti padadvayaM
anyathApratItinirAsAya vyAchaShTe \dash \" sAN^khyAnAm\" iti ||  samyak khyAtirj~nAnaM
saN^khyA |  tatra bhavAH sAN^khyAH |  teShAM \" j~nAninAm\" |  j~nAnaniShThAnAmityarthaH |
\" nanu janakAdayo.api j~nAnaniShThAH |  tatkathaM yogina\?\" ityata Aha \dash 
\" j~nAnaniShThA api\" iti ||  \" karmayogyAH\" gR^ihasthAdikarmayogyAH |
\" sAN^khyayogashabdau prasiddhArthau kiM na syAtAm\?\" ityato muktivachanAditi bhAvena
Aha \dash \" niShTA\" iti ||  \" sthitiH\" svarUpeNeti sheShaH |

\" astvevaM shlokArthaH |  tathApyAdhikArikatvAdikamatra na shrUyata\" ityato.adhyAhR^itya
Aha \dash \" tvantu\" iti ||  \" sakarmA\" gR^ihasthAdikarmavAn |  \" bhavedidaM
vyAkhyAnaM yadi te janAH pramitAH syuryeShAM j~nAnaniShThAnAmapi gR^ihasthAdikarmasvevAdhikAro
na yatyAshramakarmasu |  janakAdayastu yatyAshramaM nAnuShThitavanta ityeva pramitam |  na tu
tatrAnadhikAriNa\" iti tatrAha \dash \" santi hi\" iti ||  niveshitaH \" karmAdhikAro\"
gR^ihasthakarmAdhikAro yasmin sa tathoktaH |  \" priyavrato hi yatyAshramaM svIchikIrShuH
AdhikArikatvayuktyA hiraNyagarbheNa nivArita\" ityanenochyate || 3||

%%% ##endlabel##

%%% ##label=<segment003_pd03>##

{\Largedvng pra\.dI\. || } \" na karmaNAm\" iti moxasya karmasAdhyatvamuchyata iti
anyathApratItinirAsAyAha \dash \" itashcha\" iti ||  svavarNAshramochite yuddhAdAviti
sheShaH |  \" prAgAdhikArikatvAttvayA karma kartavyamityuktam |  idAnIM ko.aparo heturuchyata\"
ityato vyAchaShTe \dash \" karmaNAm\" iti ||

ayamabhiprAyaH |  \" karmANi na kAryANi\" iti vadanpraShTavyaH \dash \" kiM j~nAnaM na
moxasAdhanam api tu karmAkaraNameveti matvA karmANi tyajyante \?  uta j~nAnaM moxasAdhanaM
bhavatyeva, kintu \" karmaNA badhyate jantuH\" ityAdeH karmANi tatpratibandhakAnIti matvA \?
Adye.api kiM moxasya naiShkarmyashabdavAchyatvamAtramAshrityedamuchyate \?  athavA
\" kriyAkArakaphalarUpasya saMsArasya karmaiva bIjam |  akaraNe cha bIjAbhAvAtsaMsAro na
bhaviShyati\" iti yuktimAshritya\" \?

Adyasya dUShaNaM \" na karmaNAm\" iti ||  naiShkarmyashabdasyAnyathApi vyAkhyAnAnnAdya
ityarthaH |  \" tataH kim\?\" ityata Aha \dash \" j~nAnameva\" iti ||  uktamAxipya
samAdhatte \dash \" kuta\" iti ||  \" naiShkarmyashabdasyAnyArthatAmaN^gIkR^itya
karmAkaraNasya moxasAdhanatvanirAkaraNe ko hetuH\" ityarthaH | \" kathamasya hetutvam\?\"
ityato vyAchaShTe \dash \" sarvadA\" iti ||  pralaye.api sambhavArthaM \" sthUlena sUxmeNa
vA\" ityuktam |  \" tathApi kathaM hetutvam\?\" ityata Aha \dash \" yadi\" iti ||
\" syAt\" ityasya pUrvottarAbhyAM sambandhaH |  \" sthAvarANAm\"
ityanadhikR^itopalaxaNam |  tatashchAnAdau saMsAre.anadhikR^itadehasya sambhavena
muktiprasaN^gAdadhunApi dR^ishyamAnaM puruShatvaM na syAditi bhAvaH |

dvitIyanirAse.apyasyaivArdhasya tAtparyamAha \dash \" na cha\" iti ||  \" karmAbhAvAt\"
saMsArabIjAbhAvAt |  atra naiShkarmyamiti muktinAmaiva |  na tu parapramANAnuvAdaH |  \" kuto
na bhavati\?\" ityato.atrApi \" puruShatvAt\" iti hetumabhipretyAha \dash \" prati\"
iti ||  \" janmani kR^itAnAm\" ityarthaH |  \" puruShatvenAnAdau saMsAre
adhikR^itAnantajanmasambhavAttatra kR^itAnAmanantakarmaNAM bhAvAt kimadyAkAraNemAtreNa
bhavati\" ityarthaH |

\" nanu pUrvapUrvasharIrakR^itAni karmANyuttarottarasharIre bhuktAni |  tatkuto.anantakarmaNAM
bhAva\?\" ityata Aha \dash \" na cha\" iti || \" kuto na\?\" ityata Aha \dash 
\" ekasmin\" iti ||  \" hi\" shabdo hetau |  \" bahUnyapi bhujyatAM ko doSha\?\"
ityata Aha \dash \" tAni cha\" iti || \" tAni cha\" \" kAnichid\" iti sambandhaH ||
\" ekaikAni\" iti ||  pratyekamityarthaH |  tathAvidhAnyapyanadhikR^itajanmabhirbhuktAni
ityata Aha \dash \" tatra cha\" iti ||  teShu karmasu |  \" bhuJNjan\" bhuJNjAnaH |
\" sheSheNa\" karmasheSheNa |  mAnuShye chAkaraNamasambhAvitamityAha \dash \" tatashcha\"
iti ||  asamAptirbhogenaiva karmaNAmiti sheShaH |  \" sambhAvanAmAtreNedamuditaM na tu
pramitam\" ityata Aha \dash \" tachcha\" iti ||  chaturdashAdvarShAt |  anUno dashako
yasyeti vigrahaH |  hrasvadIrghavyatyayena \" chaturdashordhvajIvinI\" iti striyA
visheShaNam |  \" saMsArashcha\" iti karmaNAmanantatvopapAdanam |  \" ato\" bhogena
xayAsambhavAt |  \" avittvA\" aviditvA |

\" puruShashabdenAnAdidehasambandha uktaH | so.asiddha\" ityata Aha \dash \" yadi\"
iti ||  \" atatprAptiH\" Akasmikasya saMsArasyAprAptiH syAt |  ataH puruShatvaM
siddhamiti |  \" nanu santu prAgbhavIyAnyanantakarmANi | tathApi bandhakAni kathaM prexAvatA
kriyeran |  na hyanantAni pApAni prAktanAni santItyetAvatA.adya kriyanta\" ityata Aha \dash
\" abandhakatvaM tu\" iti ||  karmaNAM bandhAhetutvaM tvakAmAdinaiva bhavati |  na
tvakaraNena |  pratyavAyasyaiva prApterityarthaH |  akAme.abandhakatvaM bhagavatsammatamiti
bhAvenAha \dash \" tachcha\" iti ||

saN^karastu \" akaraNamasanna santaM pratyavAyaM janayati | \" kathamasatassajjAyata\" iti
shruteH\" ityavAdIt |  tadbhAskaraH pratyaShedhIt \dash \" dravyaviShayA shrutiH |
guNastvasato.api jAyata\" iti |  ubhAvapi sthUladR^ishvAnau |  na hyakaraNamasat |  tathA
sati karaNaprasaN^gAt |  kintvabhAvaH |  sa cha bhAvavattatvameveti kathamakaraNam |  guNaM
prati kAraNatve cha dravyakAraNatvaM kuto na bhavet |  na hyatropAdAnatvaM vivaxitam |
kintu nimittatvamevetyalam |

%%% ##endlabel##

%%% ##label=<segment004_pd03>##

{\Largedvng pra\.dI\. || } \" na cha sannyasanAdeva\" iti punaruktam |  atrApi
karmasannyasanasyAmoxasAdhanatvokterityata Aha \dash \" nanu\" iti ||  \" niShkAmaM
j~nAnapUrvaM cha\" iti mAnave vAkye tAvanniShkAmakarmaNA moxaH smR^itaH |  sa cha
upapattyantarAdarshanAnniShkAmakarmaNaH phalAbhAvAdityeva tatropapattiraN^gIkAryA |  yata evaM
phalAbhAvasyaiva prAdhAnyaM ato.akaraNe.api phalAbhAvasyaiva sAmyAnmoxo bhavatyeva |
yatprAgbhavIyakarmaphalamuktaM niShkAmakarmapaxe.api tatsamAnam |  na cha vinigamane
kAraNAbhAvaH |  AyAsAbhAvasya sattvAt |  na cha pratyavAyaprAptiH |
amumuxuviShayatvasambhavAt |  ato na karmANi karomIti bhAvaH |  anena kathamasya parihAra
ityata Aha \dash \" sannyAsa\" iti ||  tena cha niShkAmakarmakaraNamupalaxyata iti bhAvaH |
niShkAmakarmakaraNAnmoxaM na prApnoti |  ato na tatpratibandIgrahaNaM yuktamityanenoktam |
\" tathA cha smR^itivirodha\" ityatassmR^iterabhiprAyamAha \dash \" akAma\" iti ||
sakAshAditi sheShaH |  puMsAmiti vA |  \" akAmakarmabhirantaHkaraNashuddhidvArA j~nAnaM
jAyata ityetatkuta\?\" ityata Aha \dash \" tachcha\" iti ||  \" nanvatra vairAgyaM
jAyata ityuchyate na tu j~nAnam\" iti |  tatrAha \dash \" viraktAnAmeva\" iti ||  prAgapi
vairAgyadvAretyabhimatamiti bhAvaH |  tathApi kathaM virodhaparihAraH |  \" gItAyAM
akAmakarmaNAM moxasAdhanatvAbhAvAvadhAraNAd\" ityatastadabhiprAyamAha \dash \" na tu\"
iti ||  phalAbhAvopapattikaM moxasAdhanatvaM niShidhyate |  na tu sarvathA.apItyarthaH |
pratibandIM mochayati \dash \" karmAbhAvAd\" iti ||  ataH karmAbhAvAnna moxa ityarthaH |
shlokatAtparyamupasaMharati \dash \" ata\" iti ||

\" nanu yatyAshramo moxasAdhanatvena shrutyAdiprasiddhaH |  tatra cheyamevopapattiH
yattaddharmANAM phalAbhAvaH |  ataH tatsAmyAdakaraNe.api moxo bhavatItyetachChaN^kAnirAsArthaM
choktaM \" na cha sannyasanAdeva\" iti |  evaM tarhi shrutyAdivirodha ityata Aha \dash
\" yatyAshramastu\" iti ||  \" prAyatyam\" prayatatvam |  Ishvare manaHsamAdhAnam |
etaddvAradvayena moxasAdhanatvaM shrutyAderabhipretam |  phalAbhAvopapattikaM tu gItAyAM
nivAritamato na virodha iti bhAvaH |  \" AshramAntare.api prAyatyasambhavAtkiM tadarthaM
yatyAshrameNa\?\" ityata Aha \dash \" aprayatatvameva\" iti ||  itarakarmasu
yajanAdiShu |  \" prAyatyaM kathaM moxasAdhanam\?\" ityato vyatirekamukhenopapAdayati \dash
\" aprayatAnAM cha\" iti ||  \" praj~nAnenainamApnuyAt\" iti shrutisheShaH |
\" ashAnto\" .abhagavanniShThaH |  \" asamAhitaH\" tatra chittasamAdhAnahInaH |

\" bhagavattoShaNasyA.a.ashramAntareNa sambhavAtkiM yatyAshrameNa\?\" ityata Aha \dash
\" mahAMshcha\" iti ||  \" turIyam\" paramahaMsAkhyam |  vAkyasheSheNAnvayaH |
\" yatyAshrama eva chetprAyatyaM mahAn bhagavatastoShashcha tarhi tadrahitAnAmAdhikArikANAM
tadubhayAbhAva\" ityata Aha \dash \" AdhikArikAstu\" iti ||  \" tatsthAH\"
adhikArasthAH |  \" sa eva\" adhikAra eva |  tuShyatyaneneti \" toShaH\" |
samAsAntavidheranityatvAd \" AdirAj~nAm\" iti yuktam |  yathoktaM mahAbhAShye
\" shuchyampi taTAkAni\" iti || 4||

%%% ##endlabel##

%%% ##label=<segment005_pd03>##

{\Largedvng pra\.dI\. || } \" j~nAnarahitAt karmatyAgarUpAt yatyAshramAtsiddhiM na
samadhigachChati iti kila pUrvamuktam |  tatra hetvAkAN^xAyAM \" na hi kashchit\"
ityuchyata\" iti vyAkhyAnamasaditi bhAvena shlokatAtparyamAha \dash \" na tu\" iti ||
na hyatra j~nAnasyAvashyakatve kiJNchiduchyate |  nApi yaj~nAdikarmAkaraNasyAsambhavo
abhidhIyate |  yena prakR^itasaN^gatissyAt |  kintu sharIrayAtrAdyarthAnAM karmaNAM
aparihAryatvam |  ato nedaM vyAkhyAnam |  api tarhi \" karmaNA badhyate jantuH\" iti
shrutimAshritya yastR^itIyaH paxastamAshaN^kya \" yaj~nArthAt\" iti smR^iterarthasaN^kochaM
vaxyati |  tatra \" kutaH smR^iterarthasaN^kocha\?\" ityAkAN^xA syAt |  \" tAmapAkartuM
upodghAtanyAyena karmashabdastAvadasaN^kuchitArthaH pareNApyaN^gIkartumashakya iti pratipAdayituM
karmANi sarvAtmanA tyaktuM naiva shakyAnItyanenAha\" iti bhAvaH || 5||

%%% ##endlabel##

%%% ##label=<segment006_pd03>##

{\Largedvng pra\.dI\. || } \" tathApi \" karmendriyANi\" ityasaN^gatam |
tR^itIyapaxasthena manasendriyArthasmaraNasyAnuktatvAd\" ityata Aha \dash \" tathA.api\"
iti ||  yadyapi sharIrayAtrAdyarthAni karmANi tyaktumashakyAni |  tathApi shaktitaH
shakyatvAdyaj~nAdikarmaNAM tyAgaH kAryaH |  etaduktaM bhavati \dash \" nAshakyaviShaye
shAstrapravR^ittirityatastadvyatiriktakarmArthaH smR^itau karmashabdo bhaviShyati\" iti |

\" etachChaN^kAparihAraH shloke na dR^ishyate |  dvitIyashlokashcha vyartha\" ityata Aha
\dash \" mana eva\" iti ||  mana eva bandhamoxayoH \" prayojakam\" |  na
karmakaraNAkaraNe |  atastannigraha eva kAryo na karmatyAga iti j~nApayitumityarthaH |
anigR^ihItatve manaso bandhApexayA.a.adyo.anvayaH |  dvitIyo vyatirekaH |  moxApexayA tu vyatyAsa
iti |  etena smaraNasya mAnasatvAvyabhichArAt \" manasA\" iti vyarthamityapi parAstam |

\" karmayogena yoginAM\" (3\.3) ityatra karmayogashabdasya gR^ihasthAdikarmaviShayatvena
prakR^itatvAdatrApi tadviShayatvapratItiH syAt |  tannirAsArthamAha \dash \" karmayogam\"
iti ||  \" gR^ihasthakarmaiva vanasthakarmaiva brahmachArikarmaiveti niyamo na vivaxita\"
ityarthaH |  \" sa.nnyAsAdi\" ityAdipadena yo niyamyate tadvyatiriktagrahaNam |
karmayogashabdasya sAmAnyavAchitvAchcha |  pUrvaM \" j~nAnayogena sAN^khyAnAm\" (3\.3)
iti yatyAshramakarmaNaH pR^ithaguktatvAtsAmAnyashabdo.api visheShe vyavasthitaH |  na chAtra
tathAvidhaM kiJNchidastIti bhAvaH || 6|| 7||

%%% ##endlabel##

%%% ##label=<segment007_pd03>##

{\Largedvng pra\.dI\. || } uttarashlokaparyAlochanayA chaivameveti bhAvena saN^gatiM sUchayan
vyAchaShTe \dash \" ata\" iti ||  atashshabdaparAmarshyaM \" karma jyAyaH\"
ityAdinaivochyate || 8||

%%% ##endlabel##

%%% ##label=<segment008_pd03>##

{\Largedvng pra\.dI\. || } idAnIM tR^itIyapaxamAshaN^kya tatparihArAya shlokamavatArayati \dash
\" karmaNA\" iti ||  \" bandhakam\" moxasya pratibandhakam |  ato na karomIti
sheShaH |  tatpuruShabhrAntinirAsAyAha \dash \" karma\" iti ||  tatpuruShatve.asaN^gatiH
syAditi bhAvaH |  yaj~nashabdasya yAgArthatvapratItimapAkartumAha \dash \" yaj~na\" iti ||
avaiShNavayAgasyApi bandhakatvAditi bhAvaH |  \" tadartham\" ityuttaravAkyasya
asaN^gatiparihArAyArthAtsiddhaM pUrvavAkyArthamAha \dash \" yaj~nArtham\" iti ||
\" saN^garahitamityanuktaM kasmAduktam\?\" ityata Aha \dash \" mukta\" iti ||
\" iShTiyAjukaH\" phalechChayA yaShTA |

\" nanu \" karmaNA badhyate jantuH\" ityapi visheShavachanam |  avidyAdInAmanekeShAM
bandhakatvenAvidyAdibhiriti sAmAnyasyAnupAttatvAt |  gItAvAkyaM \" na karma bandhakam\"
itIdamapi visheShavachanam |  tatkathaM tatparihArAyAvatArya vyAkhyAtam\?\" ityata Aha 
\dash \" visheSha\" iti ||  yadyapyuktavidhayA dvayorvisheShavachanatvaM samam |  tathApi
gItAvAkye \" yaj~nArthAt\" ityAdivisheShaNamatirichyate |  atastadapexayA
tatsAmAnyavachanameva |  ato yuktametadvyAkhyAnamiti bhAvaH |

ayamatra pratyuttarakramaH |  \" karmaNA badhyate\" iti vAkyamAshritya na yuddhAdikarmatyAgaH
kAryaH |  tasyAvaiShNavakAmyakarmaviShayatvAt |  \" kutaH saN^kocha\?\" iti chet |
pareNApi parispandamAtrasya tyaktumashakyatvenAsaN^kuchitArthatAyAH svIkartumashakyatvAt |
\" tarhyata eva bAdhakAchCharIrayAtrArthakarmavyatiriktaviShayatvaM kalpyata\" iti chenna |
vaiyarthyAt |  evamapi manovyApArasyAtyaktatvena pratibandhakAbhAvo na sidhyati |  tasyaiva
anvayavyatirekAbhyAM prayojakatvAvadhAraNAt |  bAdhakAtsaN^kochamaN^gIkurvatAM chAyamapi
saN^kocho.aN^gIkAryaH |  vidhAnasAmarthyAdyuddhAdInAmapi tattadvarNAshramochitatvAt | na cha
vidhAnasyAmumuxuviShayatvam |  kalpakAbhAvAt |  na chedameva vAkyaM kalpakam |  tasya
avaiShNavatvAdidharmatyAgena charitArthatvAt |  dharmiparityAgAddharmamAtraparityAgasya
jyAyastvAt |  ato na karmasvarUpaM tyAjyamiti || 9||

%%% ##endlabel##

%%% ##label=<segment009_pd03>##

{\Largedvng pra\.dI\. || } \" sahayaj~nA\" ityAderna prakR^itena saN^gatirdR^ishyate | ata
Aha \dash \" atra\" iti ||  varNAshramochitasya karmaNaH sarvathA kartavyatve |  stutirnindA
parakR^itiH purAkalpo.arthavAdaH || 10\-13||

%%% ##endlabel##

%%% ##label=<segment010_pd03>##

{\Largedvng pra\.dI\. || } \" annAt\" ityAdeH saN^gatimAha \dash \" hetvantaram\"
iti ||  atretyanuvartate |  atra parjanyo megha Adityashcha vivaxitau |  \" tatrAdityasya
pUrvasiddhasya kathaM \" yaj~nAdbhavati parjanyaH\" iti yaj~naH kAraNatvenochyata\?\"
ityata Aha \dash \" yaj~na\" iti ||  yadyapi yaj~no devatAmuddishya dravyatyAga iti vaxyati |
tathA.apyatra parityajyamAnaM dravyaM gR^ihyate |  tasya \" parjanyAnnatvAt\"
parjanyopabhogyatvAt |  upabhuktena cha tasya balAdyupachayAdyaj~naH tasya parjanyasya
\" kAraNamuchyate\" |  \" nanu parjanyo devatAtmA yena yaj~nena parjanyatvaM prAptaH
sa yaj~no vivaxito.atrAstu |  tathA sati yaj~nAtparjanyodbhavo mukhya eva sampatsyata\" iti |
netyAha \dash \" pUrva\" iti ||  tasya parjanyapadaprAptihetoryaj~nasyeti sheShaH |
\" nanu tadA tadA chakraM pravR^ittameva |  ataH kathaM pUrvayaj~nasya chakrApravesha\"
ityata Aha \dash \" taddhi\" iti ||  tachchakramApAdyaM hyatra vivaxitam |  na tu
prAgApAditam |  kutaH \? karmavidhaye hyetaduchyate |  yadi vihitaM karma kariShyasi tadA
jagachchakrapravR^ittirbhaviShyati |  anyathA tadvighAtaH |  atastvayA karma kartavyamiti |
karmavidhyupayogitA chApAdyasyaiva |  na tvApAditasya |  ApAdye cha yaj~navyaktivisheShasya
parjanyapadaprAptihetorna pravesha ityarthaH |

\" prAkparjanyena karma kR^itam |  tena cha yaj~nAdidvArA chakraM pravR^ittam |
atastvayApi karma kartavyamityevaM prAgApAditachakroktirapi karmavidhyupayoginI bhavati\"
iti chenmaivam |  ata iti ko.arthaH \?  tvatkarmaNApi chakrapravR^ittisambhavAditi vA
karmatvAditi vA |  nAdyaH |  idAnIntanapuruShakarmajena yaj~nena parjanyotpattyasambhavena
chakrApravR^itteH |  na hi sarve.api karmakAriNaH parjanyatvaM prApnuvanti |  dvitIyaM
dUShayati \dash \" na tu\" iti ||  phalarahitena karmatvasAmyenedAnIM karma kAryaM na bhavati
svayaM klesharUpatvAditi |

prakArAntareNApi \" yaj~nAdbhavati parjanya\" ityetadghaTayitumAha \dash \" megha\"
iti ||  chakraM samUhaH |  \" tataH kim\?\" ityata Aha \dash \" tachcha\" iti ||
meghachakram |  \" kuta\?\" ityata Aha \dash \" agnau\" iti ||  \" nanu
\" svakIyamudakaM nadyaH\" iti samudrAdvR^iShTiruchyate |  ata AdityAdvR^iShTyaN^gIkAre
tadvirodhaH  syAd\" ityata Aha \dash \" ubhaya\" iti ||  vR^iShTyaN^gIkArAditi
sheShaH |  varShukA meghA iha vR^iShTishabdenochyante |  \" ato.api kim\?\" ityata
Aha \dash \" atashcha\" iti ||  prAk parjanyasya bhavanaM gauNamaN^gIkR^itya vyAkhyAtam |
idAnIM tvabhimanyamAnagatasyAbhimAnini laxaNAmAshrityeti bhedaH |  yadvA.abhimAnigatasya
parjanyashabdasyAbhimanyamAne laxaNAmAshritya dvitIyaM vyAkhyAnam |  tAtparyanirNaye tu
meghasantatau parjanyashabdo yaugiko.aN^gIkR^itaH |

\" nanu yaj~naH karmAtmakaH |  tatkathamuchyate \" yaj~naH karmasamudbhavaH\" \?\" iti |
tatrAha \dash \" yaj~na\" iti ||  \" itarakriyA\" yaj~nAN^gabhUtA |  apUrvAN^gIkAre
rUDhityAgena laxaNAshrayaNaM syAt || 14||

%%% ##endlabel##

%%% ##label=<segment011_pd03>##

{\Largedvng pra\.dI\. || } \" karma brahmodbhavaM brahmaNA vedena prakAshyam\" iti
pareShAM vyAkhyAnamasaditi bhAvenAha \dash \" karma\" iti ||  \" brahmaNaH\"
parabrahmaNaH |  \" kuta\?\" ityata Aha \dash \" eSha hi\" iti ||  apavyAkhyAnaM
pratyAkhyAti \dash \" na cha\" iti ||  udbhavashabdasya \" mukhye\" abhidheye janmani
\" sambhAvyamAne\" sati \" aupachArikam\" prakAshanamarthatayA na \" kalpyam\" |
tathA brahmashabdasya \" mukhye\" abhidheye pare brahmaNi \" sambhAvyamAne\" sati
\" aupachArikam\" amukhyaM vedAkhyaM brahmashabdArthatayA na \" kalpyam\" |

kiJNcha evaM vyAchaxANenApi vedasya karmaprakAshakatvamantaryAmidvArA paramparayA.aN^gIkAryam |
tathA chAntato.api parabrahmaNyaN^gIkArye shabdata eva prAptasya tasya parityAgo.anupapannaH |
\" nanu vedaH svayameva karma prakAshayati |  kiM parabrahmaNA \?  ato na paramparA\"
ityata Aha \dash \" na cha\" iti ||  na kevalaM vedasya jaDatvAdanyAdhInatvaM kintvAgamAt
viShNvadhInatvaM siddhamityAha \dash \" etasya\" iti ||  viShNoriti sheShaH |

\" nanu shabdasyArthaprakAshanaM svabhAvaH |  na tvAgantuko vyAparaH |  yathA.agnerauShNyam |
tato jaDatve.api na parApexetyataH svabhAvasyApi bhagavadadhInatve pramANamAha \dash
\" dravyam\" iti ||  \" etatpramANasiddhamapi svabhAvaniyamanaM viShNorasambhAvitam\"
ityata Aha \dash \" achintya\" iti ||  \" yadi jaDasya na svataH pravR^ittiH
tarhyabhimAnidevatAdvArA.astu |  tathA cha nAntato.api parabrahmAN^gIkAra\" ityata Aha \dash
\" jIvasya cha\" iti ||  tatashchAdhikyena parampareti bhAvaH |  na kevalaM
pratibimbatvAjjIvasya svataH pravR^ittyabhAvaH |  kintvAgamAchchetyAha \dash \" na\" iti ||

%%% ##endlabel##

%%% ##label=<segment012_pd03>##

{\Largedvng pra\.dI\. || } \" brahmAxarasamudbhavam\" ityasya \" brahma axarAt
parabrahmaNo jAyate\" iti pareShAM vyAkhyAnamasaditi bhAvenAha \dash \" axarANi\" iti ||
prasiddhAkArAdIni niyatAnupUrvIvishiShTAni |  veda iti yAvat |  \" nanu samudbhavashabdasya
mukhyArthAN^gIkAre kiM bAdhakam yenAbhivyajyata ityamukhyo.arthaH svIkriyate\? kiJNcha
pramANAntareNApi brahmAbhivyaktisambhavAt \" tebhyaH\" iti kimarthamuktam\?\" ityata
Aha \dash \" anyathA\" iti ||  vyaktyarthatvAnaN^gIkAre |  anAdinidhanaM brahma kathaM jAyeta
iti sheShaH |  tathA vedasya tadabhivyaJNjakatvAnaN^gIkAre paripUrNatvAdachintyaM brahma ko
jAnAti |  vAkyArthadvayasamuchchaye \" api\" shabdaH |

\" samudbhavashabdasya mukhyArthalAbhAtparoktArthaH kiM na syAd\?\" ityata Aha \dash
\" na cha\" iti ||  brahmashabdo hi parabrahmaNi rUDhaH |  vede tu bR^ihattvayogena
pravR^ittaH |  tathA.axarashabdo varNeShu rUDhaH |  brahmaNi tvaxaraNayogena pravR^ittaH |
tathA chAnyathA vyAkurvatA rUDhiM parityajya yogo.aN^gIkR^itaH syAt |  tachcha nyAyabAhyaM
ityarthaH |  itashcha brahmashabdaH parabrahmavAchItyAha \dash \" parAmarshAchcha\" iti ||
uttaravAkye brahmashabdena parabrahmaNaH parAmarshAchcha pUrvavAkyastho brahmashabdaH
parabrahmArtho j~nAyate |  tathAcha axarashabdo.apyarthAdvedavachano bhaviShyatIti bhAvaH |

\" prAgaxarashabdoktaM parabrahmedAnIM brahmashabdena parAmR^ishyate |  ataH pUrvo brahmashabdo
vedArtha eva\" ityata Aha \dash \" na hi\" iti ||  etasminneva prakaraNa iti sheShaH |
% is it 'ekasminneva prakaraNa' ???
\" annAtpuruShaH |  sa vA eSha puruSho.annarasamayaH \" (tai\.u\. 2\.1) ityAdivyAvR^ittyarthaM
\" bhedashrutiM vinA\" ityuktam |  \" shruti\" shabdashcha pramANopalaxaNArthaH |
\" atrApi \" sarvagatam\" iti visheShaNamasti\" iti chenna |  anantarameva
nirAkaraNAt |  idaM cha bhAskaraM pratyabhihitam |

%%% ##endlabel##

%%% ##label=<segment013_pd03>##

{\Largedvng pra\.dI\. || } \" mAyAvAdinA tu \" prAgbrahmashabdoktasya vedasyaivAyaM
parAmarsha\" ityaN^gIkR^itatvAdyadapyanyathAvyAkhyAne samudbhavashabdasya mukyArthAlAbha
ityabhipretaM tadapi durAshAmAtram\" ityAha \dash \" tAni cha\" iti ||  yAnyasmAbhiH
prasiddhAni vyAkhyAtAni |  anenAbhidhAnAdibalAdbrahmAxarashabdau dvAvapyubhayatra yogarUDhAviti
pratyavasthAnamapi parAstam |  parAmarshasya varNanityatvasya chAparihAryatvAt |

\" na kevalaM shrutyAdibhyo vedasya nityatvaM kiM tarhi vipaxe bAdhakAchcha\" ityAha \dash
\" doShAshcha\" iti ||  \" rachitatve cha dharmapramANasya\" ityatra |  \" nanu
vedAxarANi brahmaNo.abuddhipUrvamutpannAni |  ato na viparyayAdimUlatvashaN^kA\" ityata
Aha \dash \" na cha\" iti ||  \" niHshvasitametadyadR^igvedo yajurvedaH\"
(bR^i\.u\. 4\.4\.10) iti shrutirvedAnAM brahmaNo.abuddhipUrvamutpannatve pramANamiti chet |
kimayaM nishvasitashabdo abuddhipUrvamutpannasya vAchaka\? uta nishvasitamiva nishvasitaM,
ivArthashcha abuddhipUrvamutpannatvamiti gauNyA vR^ittyA tadabhiprAyaH\?  nAdyaH |
pramANAbhAvAt |  dvitIyaM dUShayati \dash \" nishvasita\" iti ||  akleshena
nissaraNasyApIvArthasya sambhavena nishvasitashabdasya tadabhiprAyatotpattau
nAbuddhipUrvotpattyabhiprAyatvanishchaya ityarthaH |  na cha parasyevAsmAkamapi nishchayAyoga
iti bhAvenAha \dash \" sa\" iti ||  \" so.akAmayata sa idaM sarvamasR^ijata\" iti
brahmaNaH sarvasR^iShTerichChApUrvakatvaM uchyate |  ichChA cha buddhyavinAbhUtA |  ato na
kiJNchidbrahmaNo.abuddhipUrvamutpannamiti |  \" nanu \" nishvasitametat\" iti shrutiH
nAmaprapaJNchasyAbuddhipUrvamutpattiM vakti |  \" so.akAmayata\" iti
rUpaprapaJNchasyechChApUrvamityato na virodha\" ityata Aha \dash \" iShTam\" iti ||
evaM sati \" nishvasitam\" iti shrutau \" iShTaM hutamAshitaM pAyitamayaM cha lokaH
parashcha lokaH\" iti nAmaprapaJNchasya rUpaprapaJNchena sahAbhidhAnAdrUpaprapaJNchasyApi
nishvasitashabdenAbuddhipUrvotpannatvaprAptau \" so.akAmayata\" iti shrutirnirviShayaiva
upapadyeteti bhAvaH |

ito.api nAbuddhipUrvA brahmaNaH sR^iShTirityAha \dash \" mahAtAtparya\" iti ||  brahmaNaH
sarvottamatve yatsarvavedAnAM mahAtAtparyaM tadvirodhAchchetyarthaH |  \" tadeva kuta\?\"
ityata Aha \dash \" tachcha\" iti ||  \" uktam\" sAdhitam |  \" kathaM
tadvirodha\?\" ityata Aha \dash \" na hi\" iti ||  \" prAdhAnyam\" sarvottamatvam |
\" asvAtantryeNotpattikartR^itvasya prAdhAnyavirodhitve.apyabuddhipUrvamutpAdakatvasya
kimAyAtam\?\" ityata Aha \dash \" asvAtantryaM cha\" iti ||  kAryasya
puruShamatipUrvakatvAbhAve tatra tasya puruShasyAsvAtantryaM bhavati |  tatra dR^iShTAntaM
Aha \dash \" yathA\" iti ||  rogAdInAM puruShajatve.api buddhipUrvakatvAbhAvAttatra
puruShasyAsvAtantryaM yathetyarthaH |  tatashchAbuddhipUrvamutpAdakatvAdasvAtantryam |
asvAtantryAdaprAdhAnyaM prasajyeta |  tathA cha \" mahAtAtparyavirodha\" ityuktaM bhavati |
sAxAtprasaN^gasambhave.api vyutpAdanArthamevamuktam |

%%% ##endlabel##

%%% ##label=<segment014_pd03>##

{\Largedvng pra\.dI\. || } \" nanu vedanityatvavattadutpattAvapi \" R^ichaH sAmAni
jaj~nire\" ityAdivachanAni santi |  tatkathaM nirNaya\?\" ityato vipaxe bAdhakopetAnAM
nityatvavAkyAnAM prAbalyAdutpattivachanAnyanyathA vyAkhyeyAnItyAha \dash \" utpatti\" iti ||
\" utpattivAchI shabdo.abhivyaktau kva dR^iShTa\?\" ityata Aha \dash \" nityA\" iti ||
anAdinidhanatayA nityA na tUpachAreNeti mukhyaM nityatvamuktvA punarutsR^iShTetyuchyate |
tatra gatyantarAbhAvAdvyaktireva grAhyetyarthaH |  anyatrApi prayogaM darshayati \dash
\" abhivyaJNjaka\" iti ||  shatapathAbhivyaJNjakatayA nishchite yAj~navalkye
kartR^ishabdo.astItyarthaH |  \" yAj~navalkyaH shatapathasya kartaiva kiM na syAt\?\"
ityata Aha \dash \" katham\" iti ||  prAgAditye sthitAstato yAj~navalkyenAdhItA
ityetatpramitamityarthaH |  ito.api nityatvapaxa eva balavAnityAha \dash \" vachana\" iti ||
\" R^ichaH sAmAni\" ityAdikaM vachanamAtram |  \" ata eva cha nityatvam\" iti
shArIrakoktaM vAkyaM nirNayAtmakam |  vachanaM cha vR^ittyantareNApi sambhavati |  na
tUpacharito vAkyArthAvadhAraNAtmako.api nirNayaH |  atastasmAdidaM balavadityarthaH |

\" nanu shArIraka eva \" shAstrayonitvAt\" (bra\.sU\. 1\.1\.3) iti brahmaNo
vedakAraNatvamuchyata\" ityata Aha \dash \" shAstram\" iti ||  \" nanu tatpuruShaM
parityajya ko bahuvrIhiraN^gIkriyate\? tathAtve cha brahmaNo vedAjjAtatvaM prasajyeta\"
ityata Aha \dash \" janmAdi\" iti ||  laxaNapramANAbhyAM hi vastunirNayaH |  tatra
\" janmAdyasya\" (bra\.sU\. 1\.1\.2) iti sUtreNa laxaNe.abhihite kutaH pramANAdevaM
pratipattavyamiti brahmaNo jagajjanmAdikAraNatve pramANAkAN^xA syAt |  na tu tasya
vedAjjAtatvaM vedakAraNatvaM vA.a.akAN^xitam |  AkAN^xAdivashAchcha vAkyArtho.avaseyaH |
ato yonishabdaM pramANavachanamaN^gIkR^itya bahuvrIhirevAyaM pratipattavyo na tatpuruShaH |

\" vedakAraNatvaM jagatkAraNatve hetutvenAtrochyate |  tena nAnAkAN^xitAbhidhAnametad\"
ityata Aha \dash \" na hi\" iti ||  anvayAbhAvAdekadeshakAraNatvena samudAyakAraNatvAnumAne
atiprasaN^gAchcheti herarthaH |  \" mA bhUdayaM nishchayahetuH |  tathA.api
ashakyasR^iShTervedasya karturbrahmaNo jagatsR^iShTikartR^itvaM sambhavatIti sambhAvanAheturayaM
syAd\" ityata Aha \dash \" na hi\" iti ||  sambhAvanA hyadhikenAlpasya bhavati |  yathA
sahasreNa shatasya |  na cha samudAyasR^iShTestadekadeshasR^iShTiradhiketi bhAvaH |  sR^ijyatve
vedasya |  kAryatvapaxa ityarthaH |

\" jagatkAraNatvoktyA brahmaNaH sarvaj~natvaM pratItam |  tatsphuTIkartuM tatra
vedakAraNatvaM heturanenochyate |  ato nAsaN^gatiH\" ityata Aha \dash \" na cha\" iti ||
vedakAraNatvaM heturityanuvartate |  abuddhipUrvamutpannatvAN^gIkArAditi bhAvaH |  kiJNcha
yadi jagadekadeshasya vedasya sraShTA parameshvaraH sarvaj~naH sidhyettarhyantarbhAvitavedasya
jagatassraShTA sutarAM sarvaj~nAH sidhyedeva |  tathA chArthAdapi janmAdisUtreNaiva sArvaj~nasya
sphuTaM pratItatvAtpunarhetvAkAN^xA.abhAvenAsaN^gatistadavastheti bhAvenAha \dash \" yadi\"
iti ||

sUtrArthamupasaMharati \dash \" tasmAd\" iti ||  brahmaNa iti sheShaH |  \" tAni cha\"
ityAdinoktamupasaMharati \dash \" ata\" iti ||  tathA cha samudbhavashabdasya
mukhyArthatvalAbhAya na brahmAxarashabdArthavyatyayaH kArya iti |  tasmAditi
parAmarshaviShayApratItestaddarshayanvAkyaM vyAkhyAti \dash \" yata\" iti ||
pratiShThitamityuchyata iti sheShaH || 15||

%%% ##endlabel##

%%% ##label=<segment015_pd03>##

{\Largedvng pra\.dI\. || } nanvatra kAryakAraNaparamparaivoktA na chakram |  tatkathaM
uchyate \" evaM pravartitaM chakram\" iti tatrAha \dash \" tAni cha\" iti ||
\" tAni\" vedAkhyAni |  \" chakrApravR^ittau kathamaghA.ayuShTvAdikam\?\" ityato
vyAchaShTe \dash \" tadetad\" iti ||  \" AyuSho.aghatvAbhAvAtkathamaghAyuH\?\"
ityata Aha \dash \" pApa\" iti ||  tAdarthyAttAchChabdyamityarthaH || 16||

%%% ##endlabel##

%%% ##label=<segment016_pd03>##

{\Largedvng pra\.dI\. || } evamaj~nAninaH karma kartavyamityuktam |  idAnIM j~nAninaH
kartavyAbhAvamAheti paravyAkhyAnamasaditi bhAvena saN^gatimAha \dash \" tarhi\" iti ||
yadyevaM karmAkaraNe hAnistatkaraNe lAbhastarhItyarthaH |  parameshvare \" atIva
manassamAdhAnam\" asampraj~nAtasamAdhirityarthaH |  \" na kAryam\" prasajyeteti
sheShaH |  tatra karmalopasyAvashyaMbhAvAditi bhAvaH |  atra ratitR^iptisantoShashabdAn
tAvadvyAchaShTe \dash \" ramaNam\" iti ||  pareti svarUpakathanam |  na
shabdArthAntarbhUtam |  tathA cha paJNchame.abhidhAnaM vaxyate |  tathAtve Atmashabdena
% cf. PD 5\.24
jIvanirAkaraNaM cha vyarthaM syAt |  yaddarshanAdinimittaM sukhaM tato\".anyatra\" |
\" tajjanakam\" tR^ipterjanakam |  tR^iptikAraNaM sukhamiti sheShaH |  idAnIM
Atmashabdasya jIvaviShayatvapratItinirAsArthaM \" AtmaratiH\" iti samastaM padaM
vyAkhyAti \dash \" paramAtma\" iti ||  prApta Atmaratiriti sheShaH |  anena Atmani
ratiH yasyeti vigrahaH sUchitaH |  Atmano ratiH yasyeti vA |  evamuttarAvapyAtmashabdau
paramAtmArthau j~nAtavyau |

\" nanvevaM sati tR^iptishabdasya paramAtmano.anyatrAlambuddhirarthaH syAt |
tatashchedaM na vaktavyam |  \" Atmaratireva\" ityavadhAraNenAnyaratinirAsena
paunaruktyaprasaN^gAd\" ityata Aha \dash \" anyatra\" iti ||  alambuddhiM cha prAptaH
tR^iptashabdenokta iti sheShaH |  avadhAraNenaivAnyatra ratyabhAve labdhe.api sarvAtmanA
alambuddhiM vaktuM \" tR^ipta\" iti punarvachanam |  avadhAraNasyAnyatrAlambuddhimAtradyotanena
charitArthasya \" sarvAtmanA\" ityatrApravR^itteriti bhAvaH |

\" nanu \" santuShTa\" ityanenAlambuddhijanakaM sukhaM prApta ityuchyata ityuktam |
tatkiM viShayajanyamutAtmaratyAkhyam \?  nAdyaH |  virodhAt |  na dvitIyaH |
tasyAtmaratishabdenoktatayA punaruktiprasaN^gAt |  kathaM cha tasyAnyatrAlambuddhijanakatvam\?\"
ityata Aha \dash \" mahachcha\" iti ||  \" cha\" shabdo hetau |  tadAtmaratyAkhyam |
prAguktameva sukhaM punaranyatrAlambuddhikAraNatvenochyate |  ato na doShaH |  tasya cha
mahattvaM saMshabdenoktam |  atastatkAraNatvaM chopapannamityarthaH |

\" AtmaratiH santoShashabdena gR^ihyate chetpunarAtmanIti vyartham\" ityata Aha \dash
\" tatstha eva\" iti ||  \" santoShAkhyAtmaratiH kenAsya jAyata\?\" ityapexAyAM
asampraj~nAtasamAdhilaxaNayA paramAtmani sthityeti j~nApayituM \" Atmani\" ityuktaM
ityarthaH |  avadhAraNasya prayojanamAha \dash \" nAnyad\" iti ||  anyadasampraj~nAta\-
samAdhirUpAt tatsthatvAt |  etena \" Atmaratireva\" ityavadhAraNenAsya punaruktatA
parihR^itA |

\" nanvAtmatR^ipta iti ko.ayaM samAsa\?\" ityata Aha \dash \" AtmanA\" iti ||  na
kevalenAtmaratyAkhyena sukhena kintu prasannena paramAtmanaivetyarthaH |  \" paJNchamIsamAsaH
kathaM na syAd.\?\" iti chenna |  asAmarthyAt |  anyatretyanena hyasya sAmarthyam |
na tu tR^iptashabdArthena |  \" tR^iptashabdArtha evAnyatrArtho.antarbhUto.asti\" iti
chenna |  tasya prakaraNalabdhasya tadantarbhAvAbhAvAt |  anyathA \" vayaM tu na
vitR^ipyAmaH\" ityatra tato.anyatrAlambuddhiM na prApnuma ityarthaprasaN^gAt |  \" astu
tarhi saptamIsamAsa\" iti netyAha \dash \" na hi\" iti ||  pUrvavisheShaNavirodhAt |
pramANAntaravirodhAchcheti bhAvaH |  \" syAdayaM doSho yadi tR^iptishabdasyAlambuddhivAchitvaM
syAt |  tadeva kuta\?\" ityata Aha \dash \" tadvAchitvaM cha\" iti ||

\" nanvatra tR^iptishabdaH prItyarthaH |  na chaivaMsatyarthAnupapattiH |  uttamashlokavikramaiH
shrUyamANairnimittairanyatra prItiM na prApnuma ityadhyAhAreNopapattiH\" ityata Aha \dash
\" adhyAhArastu\" iti ||  gatyantararahitA gamanikA |  adhyAhAro hyashrutashabdakalpanam |
tachcha kalpakasadbhAve na doShaH |  anyathA doSha eva |  kalpakaM cha gatyantararAhityam |
anyathA.anupapattiriti yAvat |  atra tvalambuddhyarthatve gR^ihIte vinA.apyadhyAhAreNa
vAkyArthopapatterayukto.asAviti bhAvaH |  ShaShThIsamAsastu \" pUraNaguNasuhitArtha\"
(aShTA\. 2\.2\.11) iti pratiShiddhaH |

%%% ##endlabel##

%%% ##label=<segment017_pd03>##

{\Largedvng pra\.dI\. || } apavyAkhyAnaM nirAchaShTe \dash \" Atmaratireva\" iti ||  na
j~nAnimAtrasyetyevArthaH |  ito.api na j~nAnimAtrasya kAryAbhAva ityAha \dash 
\" sthitapraj~nasyApi\" iti ||  svadharmaH kArya iti sambandhaH |  \" Atmaratireva\"
ityavadhAraNe.api kuto na j~nAnimAtraviShayametad\? ityata Aha \dash \" anyadA\"
iti ||  avadhAraNena hyanyaratirvyAvartyate |  asampraj~nAtasamAdhikAlAdanyadA sarvasya
j~nAnino.apIShadanyaratirapi bhavatItyupapAdanam |  ato.asampraj~nAtasamAdhistha\-
vyatiriktAnAM j~nAninAmapyavadhAraNena vyAvartitatvAnna tadeviShayametaditi bhAvaH |
\" nanu j~nAninAmanyaratau vidyamAnAyAmapi tatrAlambuddhirapyastIti \" Atmaratireva\"
ityavadhAraNamupapadyata\" ityata Aha \dash \" na cha\" iti ||  \" tatra\"
shloke |  \" tatra\" kAryAbhAve |  prayojakatvenAtmano.anyatrAlambuddhimAtramalpAlambuddhiH |
ratisahacharitAlambuddhiriti yAvat |  \" noktA kiM tarhi\? sarvAtmanAlambuddhiH kuta\?\"
ityata Aha \dash \" Atma\" iti ||  avadhAraNenAnyatrAlambuddhau labdhAyAmapi
yatpR^ithak \" AtmatR^ipta\" ityabhidhatte tena sarvAtmanA.alambuddhiravadhAraNena
abhipreteti j~nAyata iti prAguktam |  ato j~nAnimAtre nedamupapadyata iti bhAvaH |

\" astvAtmaratireva ityetadasampraj~nAtasamAdhistha eva sambhavatIti |  tathA.api \" yat
patati kadAchit tadguru\" itivad \" ya evaMvidhaH kadAchittasya kAryaM sarvadA na
vidyata\" ityevaM vyAkhyAne j~nAnimAtrasya kAryAbhAvaH setsyati |  na hyatra \" yadaivaM
tadeti\" kAlAvachChedakashabdo.asti |  Atmaratiriti samAsastu rateH kartAramevAchaShTe\"
ityata Aha \dash \" kartR^ishabda\" iti ||  ayaM cha yadA tadeti rahito.apItyarthaH |
AdigrahaNena \" yo dArAn pratigR^ihNAti sa gR^ihI\" ityAdeH parigrahaH |

ayaM bhAvaH \dash \" tasya kAryaM na vidyata ityukte.atiprasaktau satyAmanyavyAvartakaM
\" yastvAtmaratireva syAt\" ityanenoktam |  vyAvartakaM cha dvividhaM bhavati |
visheShaNamupalaxaNaM cha |  tatra vyavachChedyasamAnakAlaM visheShaNam |  yathA
siddhAntyudAhR^itaM bhojanam |  anyathA tUpalaxaNam |  yathA pUrvapaxyudAhR^itaM
patanam |  tatra visheShaNaM mukhyam |  visheShaj~nAnahetutvAt |  anyadamukhyam |
vaiparItyAt |  mukhyAmukhyayoshcha mukhye sampratyayaH |  na chAtra visheShaNatvagrahaNe
bAdhakamasti yenopalaxaNametaditi pratIma\" iti |

kartR^ishabda ityuktasya phalamAha \dash \" ata\" iti ||  \" etat\" kAryarAhityam |
\" samAdhAveva\" ityuktyA samAnakAlatAM sUchayati |

\" nanvasampraj~nAtasamAdhisthasya kAryAbhAve vyAkhyAyamAne kadAchidaparoxaj~nAnarahitasyApi
asampraj~nAtasamAdhisambhavAtkAryAbhAvaprasaN^ga\" iti chenna |  aparoxaj~nAnina
evAsampraj~nAtasamAdhirbhavati nAnyasyetyasyArthasya \" mAnava\" padena bhagavataiva
darshitatvAdityAha \dash \" mAnava\" iti ||  \" mAnava iti kathaM j~nAnino vAchakam\?\"
ityata Aha \dash \" manu\" iti ||  dhAtoH vyAkhyAnAditi sheShaH |  asmAddhAtoH bhAva
upratyayaH |  tato manuravabodhaH asyAstItyarthe manorayamAshraya ityarthe vA.aNpratyayaH |
yadvA dhAtorevA.aNpratyayaH |  manuShya iti vyAkhyAyAM R^iShyAdivyAvR^ittirvaiyarthyaM
chApadyeta |  AtmashabdasyApyanyathAvyAkhyAM nirAkaroti \dash \" paramAtmA\" iti ||
chashabdo.avadhAraNe |  na svAtmaratirityarthaH |  tasyaivetyavadhAraNAt || 17||

%%% ##endlabel##

%%% ##label=<segment018_pd03>##

{\Largedvng pra\.dI\. || } \" yadyayaM kAryAbhAvo na j~nAnimAtrasya kintvasampraj~nAtasamAdhisthasyaiva
tarhi \" naiva tasya kR^itenArtho\" ityuttaraM vAkyaM na saN^gachChate |  asampraj~nAta\-
samAdheH karaNasyaivAbhAvena tatprayojanAbhAvakathanasyAyogAt |  j~nAninastu
karaNasambhavena tatprayojanapratiShedhasyopapattiH\" iti chenna |  tarhyatIva
manassamAdhAnamapi na kAryamityAxepasya \" tasya kAryaM na vidyata\" ityuttaraM
kasmAduktam |  karmakR^itikAle tvayA.ahamudbodhanIya iti kaJNchitpratyuktaH samAhitaH
tena yogashAstroditopAyairudbodhitaH karma karotIti kuto noktamityAshaN^kAnirAsAya
idamevamuchyata ityabhipretya vyAchAShTe \dash \" tasya\" iti || \" tasya\"
asampraj~nAtasamAdhisthasya |  artho nAstIti sambandhaH |  uktvodbodhitasyeti
sheShaH |  evaM tarhi \" tasyaiva mahatsukhatvAt\"  ityAdyuktivirodha ityata
uktamAtmeti |  samo vA.a.atmaratyA |  samapratiShedhaH kaimutyArthaH |  na tu
samavyayaphalaM karmAnuShThIyate |

\" nanvatra kashchanetyasya visheShyAkAN^xAyAM sannidhAnAdartha iti sambadhyate |
tathA chedamayuktam |  na hi karmAkaraNe.arthaprAptirasti yena pratiShedhaH saN^gachCheta |
ata sannidhAnAdapi yogyatAyA balavattvAtkashchana doSha ityadhyAhriyate |
tathApyashvamedhAdyakR^itau pratyavAyAprApteH pratiShedho.asaN^gata eva\" ityato
\" nAkR^itena\" ityetadvyAchaShTe \" na cha\" iti ||  \" mA bhUdyaj~nAdikaraNArthaM
utthAnam |  nityanaimittikAkaraNe pratyavAyaprApteH tadarthaM tu syAd\"
ityAshaN^kAnirAsArthametat |  \" sandhyA\" iti tatkAle.anuShTheyaM karmochyate |

\" mA bhUdalpasya yaj~nAderanuShThAne prayojanAbhAvaH |  sandhyAdyakR^itau
pratyavAyashcha |  tathA.api gurudevatAdipUjAkaraNAkaraNayorarthapratyavAyau syAtAmeva |
atastatsannidhiprAptAvutthAnamAvashyakamevetyAshaN^kAnirAsArthaM \" na chAsya\"
ityuktam |  tadayuktam |  uktavirodhAdeva\" ityato vyAchaShTe \dash
\" na chaitad\" iti ||  \" etad\" asampraj~nAtasamAdhAnam |  apahAya
utthitasyeti sheShaH |  apahAyetyanena gurvAdipUjAyAmAdhikyaM niShedhati |
Adhikyasyaiva pUrvatyAgopayogitvAt |  \" sarvabhUteShu\" gurvAdiShu |
\" nanvarthavyapAshrayaH prayojanaprAptiH |  tathA cha sarvabhUtebhya iti syAd\"
ityata Aha \dash \" artha\" iti ||  anenArthasya vyapAshrayaH prAptiryena
darshanAdinA vyApAreNa bhavatIti vyadhikaraNo bahuvrIhirayamityuktaM bhavati |
tathA cha darshanAderviShayA gurvAdaya iti saptamyupapattiH | anenAnarthavyapAshrayo
apyupalaxyate |

\" syAdetat |  kimanenAyAsena |  j~nAnimAtraviShayametatkiM na syAt |  j~nAnamAtreNa
pratyavAyAbhAvAt |  tatrApyasyArthasya sambhavAt |  avadhAraNAdeshchopacharitArtha\-
sambhavAd\" ityata Aha \dash \" j~nAna\" iti ||  \" tad\" j~nAnamAtram |
itishabdo hetau |  \" etat\" kAryAbhAvavachanam |  pratyuta virodhIti hR^idayam |
\" pratyavAyo na bhavati\" ityaN^gIkR^ityaivoktam |  vastutastu j~nAnino.apyasti
pratiShiddhakaraNAdinA.aniShTaprAptirityAha \dash \" IShad\" iti ||  sUchite
cha tadaiva chittakhedaH |  upalaxaNaM chaitat |  muktAvAnandahrAsa ityapi
draShTavyam |  tathA vihitakaraNenAnandavR^iddhirapIti || 18||

%%% ##endlabel##

%%% ##label=<segment019_pd03>##

{\Largedvng pra\.dI\. || } \" tasmAdasakta\" iti parAmarshaviShayo na pratIyate |  taM darshayan
vyAkhyAti \dash \" yata\" iti ||  tvaM chedAnImasampraj~nAtasamAdhirna bhavasIti sheShaH |
% VR-- samAdhisthaH na bhavasIti vA samAdhau na bhavasIti vA bhavitavyaM iti bhAti |  mahAntaH praShTavyAH |
\" karmaNo.avashyakartavyatve.asampraj~nAtasamAdhivilopaprasaN^gAnnedamavashyaM kartavyam\"
ityato.ahamapi na kuryAmiti parichodanAyAmasampraj~nAtasamAdhisthapratibandIM mochayituM
tasya vailaxaNyamuktvA tatphalamidamuchyata iti nAsaN^gatiH || 19||

%%% ##endlabel##

%%% ##label=<segment020_pd03>##

{\Largedvng pra\.dI\. || } \" karmaNa eva muktisAdhanatvamuchyata\" (shAM\.bhA\.3\.20, rA\.bhA\.3\.20)
ityanyathApratItinirAsAya \" karmaNaiva hi\" ityasya tAtparyaM tAvadAha \dash 
\" AchAro.api\" iti |  \" vihitasya karmaNaH kartavyatAyAM pramANam\" iti
sheShaH |  \" apiH\" pUrvoktahetusamuchchaye |  \" karmaNa eva moxakAraNatvaM
tR^itIyayochyata\" iti pratItinirAsAya vyAchaShTe \dash \" karmaNA\" iti | 

\" nanvevaM sahayoge tR^itIyAyAM vyAkhyAyamAnAyAM \" janakAdayaH karmaNA sahaiva muktiM\-
AsthitA\" iti vAkyArthaH syAt\" |  \" na chAyaM yuktaH |  \" putreNa sahaivAgataH
pitA\" ityatra yathA putrasyApyAgamAnvayaH pratIyate, tathA karmaNo.api muktimAsthitatva\-
prasaN^gAd\" ityata Aha \dash \" karma\" iti |  yadyapi shrUyamANakriyAyAM
sahayogo nopapadyate |  tathApyadhyAhR^itAvAntarakriyAyAmupapadyata eva |  tatashcha
yathA \" sahaiva dashabhiH putrairbhAraM vahati gardhabhI\" ityatra \" dashabhiH
putraiH sahaiva vartamAnApyekaiva bhAraM vahati\" ityarthaH |  tathA.atrApi \" karmaNA
sahaiva vartamAnAH karma kurvanta eva\" ityartha upapadyata iti bhAvaH |  dvividhaM
hi sahayogamabhipretya samAsavidhau pANinirapi visheShaNamabhANit \" tena saheti
tulyayoga\" (aShTA\. 2\.2\.28) iti |  \" karmasAhityaM cha muktAvAnandavR^iddhyarthaM\"
iti j~nAtavyam |  \" upapadavibhakteH kArakavibhaktirbalIyasi\" iti chet \" satyam |
vaxyamANabAdhAttatparigrahopapatteH |  athavA karaNe tR^itIyA |  tathApi \" lAN^galena
vayaM jIvAma\" itivatpAramparyeNa karmaNo muktau kAraNatvam\" ityAha \dash \" karma\" 
iti |  \" siddhimAsthitA iti vA\" ityarthaH |  \" siddhi\" shabdo j~nAnArthe |
\" vA\" ityasyApyupalaxaNametat | 

\" yathA pratItArthaH kiM na syAd\?\" ityata Aha \dash \" na tu\" iti |  \" j~nAnaM
vinA kevalena karmaNA janakAdayaH siddhiM gatA\" ityarthastu \" na\" ityarthaH |
\" kuta\?\" ityata Aha \dash \" prasiddhaM hi\" iti |  \" hi\" shabdo hetau |
\" astu teShAM j~nAnitvam |  muktau tu karmaiva kAraNam\" ityata Aha \dash 
\" tamevam\" iti |  \" atrAyAm\" gItAyAmapi |  \" karmajaM buddhiyuktA
hi\" (2\.51) ityAdAvityarthaH |  \" prAjj~nAnAjj~nAnasAdhanaM pashchAnmuktisAdhanam\"
iti samuchchayavAdinAM matam |  na tu kevalakarmavAdinAm |  na chAtra pramANaM
apyasti |  \" nanu yathA moxasya j~nAnasAdhyatve \" tamevam\" (tai\.A\. 3\.12\.17)
ityAdyAgamAssanti, tathA karmasAdhyatve.api \" apAmasomam\" ityAdayo.api vidyante |
tatkathaM nirNaya\?\" ityataH \" sAvakAshatvaniravakAshatvabalAd\" ityAha 
\dash \" gatyantaraM cha\" iti |  \" j~nAnadvAreti vyAkhyAne.api\" ityarthaH |
\" nanu karmavAkyAnyapi \" brahmaj~nAnena vA\" ityAdIni niravakAshAni santi |
tatra brahmaj~nAnasamakaxyatayA tIrthasnAnAderuktatvenoktavyAkhyAnAyogAt |  ataH 
punaranirNaya eva\" ityAshaN^kya teShAmapi sAvakAshatvamAha \dash \" yatra\" 
iti |  \" tIrthAdi\" iti \dash \" tatsnAnAdi\" ityarthaH |  \" pApAdimuktiH
muktishabdArtha\" ityarthaH |  \" na cha sarvatra muktishabda evAsti |  samsAra\-
muktirityAderapi sambhavAt\" |  ato gatyantaramAha \dash \" stuti\" iti |  
\" prashastatvopalaxaNA\" ityarthaH |  prashastatvasAdR^ishyena gauNI vA | duShTa\-
janamohanArthasyApyupalaxaNametat |  \" kuta etatkalpyata\?\" ityata Aha \dash 
\" tatrApi\" iti |  yatra tIrthasnAnAdikaM muktisAdhanamuchyate tatraiva prastAve |
\" sAdhanatvam\" tIrthasnAnAdInAm |  \" anyathA\" j~nAnaM vinA |  \" yA\"
muktiH |  yanmuktisAdhanatvam |  \" vAkyatvavisheShAt \" brahmaj~nAnena vA\" 
ityAdibhireva \" brahmaj~nAnaM vinA\" ityAdInAM bAdhaH kiM na syAd\?\" ityata 
Aha \dash \" na cha\" iti |  \" asAdhAraNasAdhAraNaprasaN^goktatvAdinA\" iti
bhAvaH |  atra dR^iShTAntamAha \dash \" yathA\" iti |  \" ityAdIni\" \" nAyaM
rAjA kintu tadbhR^itya eva\" ityAdIni tatprastAve.apyuktAni na nighnantIti sheShaH |
\" AgamasiddhA cheyaM vyavasthA\" ityAha \dash \" yathA\" iti |  \" maddR^iShTeH\"
ityetatadarthapratipattyarthaM \" bhagavAn\" ityuktiH \dash \" tIrthAdivAkyAni\" 
iti |  \" tIrthaxetravAsAdInAM moxasAdhanatvavAkyAni\" ityarthaH |  \" karma\" 
iti yaj~nAdergrahaNam |  \" Adi\" padena dhyAnAdessaN^grahaH |  pUrvavadarthaH |
\" aj~nAnAm\" samyajj~nAnAyogyAnAm |  upasaMharati \dash \" ata\" iti || 20||

%%% ##endlabel##

%%% ##label=<segment021_pd03>##

{\Largedvng pra\.dI\. || } \" sa yatpramANaM kurute\" ityatra yachChabdena pramANamapramANaM
vA vivaxitam\?  Adye pramANaM kuruta ityayuktam |  sthitasya karaNAbhAvAt |  dvitIye.api
evameva |  ashakyatvAdityata Aha \dash \" sa\" iti ||  pramANameva sad \" yadvAkyAdikam\"
loke pramANatayA.anavagataM tatpramANatayA j~nApayatItyarthaH |  yadvA ekamevedaM padam |
yatpramANakaM laukikaM vaidikaM vA karma kuruta ityanenAbhiprAyeNa tAtparyArthamAha \dash
\" yadukta\" iti || 21\-26||

%%% ##endlabel##

%%% ##label=<segment022_pd03>##

{\Largedvng pra\.dI\. || } \" prakR^iteH kriyamANAni\" iti shlokadvayasya saN^gateH
asphuTatvAttAtparyamAha \dash \" vidvad\" iti ||  yathAyogaM sambandho na yathAkramam |
\" karmabhedam\" karmavailaxaNyam |  prapaJNchayatItyarthaH |  \" saktAH karmaNi\"
ityAdinoktatvAt |  vyavahitatvAdanvayaM darshayan guNashabdasyAnekArthatvAdvivaxitamarthaM
Aha \dash \" prakR^iteH\" iti ||  \" Adi\" padena sharIramanasorgrahaNam |

\" kathamindriyAdInAM dravyANAM prakR^itiguNatvam\?\" ityata Aha \dash \" prakR^itim\"
iti ||  \" guNabhUtAni\" apradhAnAni |  prakArAntareNa vyAchaShTe \dash \" tat\" iti ||
prakR^itikAryANi chetyarthaH |  \" guNashabdaH kAryArtha\" ityuktaM bhavati | \" nanu
jIvasyApi kartR^itvAt \" ahaN^kAravimUDhAtmA kartAhamiti manyate\" iti kathamuchyata\?\"
ityata Aha \dash \" na hi\" iti || svAtantryeNeti sheShaH || 27||

%%% ##endlabel##

%%% ##label=<segment023_pd03>##

{\Largedvng pra\.dI\. || } \" guNAnAM karmaNAM chAnyonyaM yo vibhAgastasminvaktavye ekavachanena
alam |  kathaM dvivachanam\?  kena vA.asyAnvaya\?\" iti shaN^kAM vibhAgashabdasyArthaM
vadanpariharati \dash \" karma\" iti ||  jIveshvaraprakR^itilaxaNasambandhibhedAt karmaNAM
indriyAdInAM cha bhedo.atra vivaxito granthAntarAdavagantavyaH |  \" guNA guNeShu\" iti
padadvayasya vivaxitamarthamAha \dash \" guNA\" iti || 28||

%%% ##endlabel##

%%% ##label=<segment024_pd03>##

{\Largedvng pra\.dI\. || } \" prakR^iterguNasammUDhAH\" ityatra guNashabdasya vivaxitamarthaM
vadanvigrahaM cha darshayati \dash \" prakR^iteH\" iti ||  nityasApexatvAdguNashabdasya
nAsAmarthyamiti pradarshanAya \" prakR^iteH\" ityanuvAdaH |  \" devadattasya gurukulam\"
iti yathA |  prakR^iterguNasammUDhatvAt sajjante guNakarmasu iti hetuhetumadbhAvo.atra
vivaxitaH |  anyathA vaiyarthyApatteH |  tamupapAdayati \dash \" indriyAdi\" iti ||  abhimAnaH
mamaivaitAni svAtantryeNa karaNAnIti bhramaH |  \" viShayAdi\" ityuktyA guNashabdo.atra
viShayArtha iti darshayati |  \" Adi\" shabdena karmagrahaNam |  viShayeShu \" saN^gaH\"
snehAdiH |  karmasu svAtantryabhramaH |  \" guNAnAM karmasu\" iti kenachidvyAkhyAtam |
tadasaditi bhAvena dvandvo.ayamiti darshayati \dash \" guNa\" iti ||  dvandvaparigrahe
adhikArthalAbhAt |  anena \" viShayAdi\" ityetadapi samarthitaM bhavati |

\" guNashabdasyoktAnekArthatvaM kuta\?\" ityata Aha \dash \" shabdAdyA\" iti ||  niruchyata
iti niruktiH shabdArthaH |  \" niruktiM gachChantyavagachChanti\" iti niruktigAH |  \" astu
guNashabdasyAnekeShvartheShu shaktiH |  tathApi vivaxA.atraikasyaivArthasya yuktA |  anyathA
\" na hyekashabdena\" (gI\.bhA\. 3\.15) ityuktavirodhAt |  shabdo hi yamarthamAdau
smAritavAn sa evArtho buddhau sannihitaH punaruchcharitena smArayituM yuktaH |  tathA chAtra
sarvatra satvAdaya eva grAhyAH |  tadgrahaNe shabdAdInAmapi tadAtmakAnAM grahaNasambhavAt\"
ityata Aha \dash \" satvAdi\" iti ||  kartR^itvAdhAratvayorekatra virodhAditi bhAvaH |
tadAtmakAnAmindriyANAM upalaxaNe vR^ithA prayAsaH |  anayaivAnupapattyA anekArthagrahaNopapatteH
|| 29||

%%% ##endlabel##

%%% ##label=<segment025_pd03>##

{\Largedvng pra\.dI\. || } \" mayi sarvANi\" ityasya saN^gatiM darshayati \dash \" ata\"
iti ||  yato vidvatkarmaivaMvidhaM tvaM cha vidvAnasi \" ataH\" |  \" nanu sa.nnyAso visargaH |
sa cha svakIyasya bhavati |  na cha jIvasya karmANi santItyuktam |  tatkathaM teShAM visargo
vidhIyata\?\" ityata Aha \dash \" bhrAntyA\" iti ||

\" karmaNAM parameshvare sa.nnyAso nAma tadAtmakatvaj~nAnam\" iti kashchit |  tadasat |
ashabdatvAdaprAmANikatvAtpramANaviruddhatvAchcheti bhAvena svapaxe tadabhiprAyamAha \dash
\" bhagavAneva\" iti ||  iti j~nAtveti sheShaH |  prakArAntaraM chAha \dash \" mad\" iti ||
iti samarpaNaM cha karmaNAM mayi sa.nnyAsa iti sheShaH |  \" karmANi parameshvarAtmakatvaM
pratipadya tatprAptaye kalpyanta ityadhyAtmachetasA\" iti vyAkhyAnamashAbdamiti bhAvena
vyAchaShTe \dash \" AtmAnam\" iti ||  anenAvyayIbhAvagarbhaH karmadhAraya ityuktaM bhavati |
asya \" nirAshIH\" ityanenAnvayaH |  paramAtmalAbhenetarAshArahita ityarthaH |

\" nanu nirmamatvaM na mama karmANi santIti j~nAnam |  tachcha \" mayi sarvANi karmANi
sa.nnyasya\" ityanena gatArtham\" ityato dvayorbhedamAha \dash \" sa.nnyAsastu\" iti ||
ubhayatretishabdAtparaM j~nAnamiti sheShaH || 30||

%%% ##endlabel##

%%% ##label=<segment026_pd03>##

{\Largedvng pra\.dI\. || } anyathApratItiM nirAkartuM tAvaduttarashlokadvayapratipAdyamAha \dash
\" phalam\" iti ||  \" kiM vidvAMsa evaM kurvantItyetAvatA mayA kAryam\?\"
ityAshaN^kya svoktakaraNAkaraNayoH phalamAhetyarthaH |  \" muchyante te.api karmabhiH\" iti
\" api\" shabdena j~nAnamiva nivR^ittaM karmApi moxasAdhanamuchyata iti anyathApratItinirAsAya
vyAchaShTe \dash \" ye tu\" iti ||  kaimutyadyotanArtho.apishabdo na samuchchayArtha ityarthaH |
prAsaN^gikaM chaitat |  samuchchaye yadyapishabdaH sa cha dvedhA \dash \" j~nAnamiva karmApi
pR^ithagsAdhanam |  j~nAnakarmasamuchchaya eva\" iti |  atrAdyaM paxaM nirAkaroti \dash
\" na tu\" iti ||  niShkAmatvAdinA.anuShThitAni yaj~nAdIni nivR^ittAni |  Adipadena
nityanaimittikAnAM grahaNam |  aparoxA cha sA IshadR^iShTishcha |  tAdarthye chaturthI |
\" muktau\" muktisAdhane |  kiJNchitsahakAri |  \" karmApi muktisAdhanam\" ityata
uktaM \dash \" sarvam\" iti ||  tatsarvaM nivR^ittAdikam |  \" antarA\" madhye |
j~nAnamAdhAya muktaye |  mukteH |  \" ahalyAyai jAra\" ityAdi yathA |  \" sAxAtsAdhanatvena
shrutamapi karma yathA vyavahitaM jAtaM kiM j~nAnamapi tathA\?\" \" na\" ityuktam \dash
\" na kiJNchid\" iti ||  dvitIyamapi prakAramatideshena nirAchaShTe \dash \" ata eva\"
iti ||  \" aparoxeshadR^iShTistu muktau kiJNchinna mArgate\" ityuktatvAdevetyarthaH || 31|| 32||

%%% ##endlabel##

%%% ##label=<segment027_pd03>##

{\Largedvng pra\.dI\. || } \" sadR^isham\" iti shlokasya saN^gatirna pratIyate |  atastamAha
\dash \" evaM chet\" iti ||  yadi tvanmatAnuShThAne moxo.anyathA nAsha ityarthaH |
\" mUlaprakR^iterekatvAtkathaM \" svasyAH\" iti prAtisvikatvamuchyata\?\" ityata
Aha \dash prakR^itiH\" iti ||  tatkAryau rAgadveShAvupalaxyete || 33||

%%% ##endlabel##

%%% ##label=<segment028_pd03>##

{\Largedvng pra\.dI\. || } \" indriyasya\" ityasya saN^gatimAha \dash \" tathA.api\" iti ||  
evaM tarhi \" mayi sarvANi karmANi\" iti vidhAnaM phalakathanaM cha vyarthamityAshaN^kya
iti bhAvaH |  yadyapi \" prakR^itiM yAnti bhUtAni\" iti nigraho.akiJNchitkarastathApi
vyAhatametaduchyata ityata uktam \dash \" nigrahAd\" iti ||  \" nigrahAd\"
ityAdi \" AshayavAn\" \" tathApi\" iti \" Aha\" iti yojanA |  atrA.a.agamasammatiM
Aha \dash \" tathA hi\" iti || 34||

%%% ##endlabel##

%%% ##label=<segment029_pd03>##

{\Largedvng pra\.dI\. || } \" shreyAn\" ityasya saN^gatimAha \dash \" tathApi\" iti ||
\" jyAyasI chet\" (3\.1) ityatra dvAvAxepAvarjunena kR^itau |  tatrAdyo \" loke.asmin\"
(3\.3) parihR^itaH |  idAnIM \" yudhyasva vigatajvaraH\" \" tayorna vashamAgachChet\"
ityuktyA smAritaM dvitIyamAxepamAshaN^kya pariharatItyarthaH |  yadyapi karma kartavyam |
tathApyugramavarjanIyarAgadveSham |  na kuryAmiti sheShaH || 35||

%%% ##endlabel##

%%% ##label=<segment030_pd03>##

{\Largedvng pra\.dI\. || } \" atha kena ityarjunaprashno.anupapannaH |  \" tau hyasya
paripanthinau\" iti rAgadveShayoH paripanthitvasyoktatvAt |  na hi pApaprayojakatvAdanyat
rAgAdeH puruShaparipanthitvam\" ityataH prashnAbhiprAyamAha \dash \" bahava\" iti ||
\" kAraNa\" shabdaH karoterNyantAtkaraNe lyuDantaH |  sa cha triliN^gaH |
\" ayamanumAnaH\" iti bhAShye prayogAt |  athavA \" NyAsashrantho yuch\" (aShTA\. 3\.3\.107)
iti karaNe yuch |  ayaM cha strIliN^gaH |  bahava ityapi strIliN^ga eva |  \" voto
guNavachanAt\" (aShTA\. 4\.1\.44) iti vikalpavidhAnAt |  karmeti pApaM vivaxitam |
\" dvayorevoktatvAtkathaM bahava ityanuvAda\?\" ityata Aha \dash \" krodhAdaya\" iti ||
pUrvaM bhagavatA dveShashabdena madamatsarAdayo.apyupalaxitAH |  ariShaDvargaprasiddheH |
tadetadviditvaivamanuvadatIti bhAvaH |  rAgashabdena kAmaH dveShashabdena krodhAdayashcha
tvayoktA ityarthaH |  \" asya prashnasya prakR^ite ka upayoga\?\" ityata Aha \dash
\" atha\" iti ||  nAsya prakR^itena hetuhetumadbhAvAdilaxaNA saN^gatiriti svayameva
sUchitamityarthaH |  \" atha\" iti shabdenArthAntaramidamiti sUchyate |  tarhyasaN^gataM
na praShTavyamityatassaN^gatyantarAbhAve.api prAsaN^gikI saN^gatirastItyAshayavAn
prasaN^gaM darshayati \dash \" tayoH\" iti ||  tatrApi yo balavAMstaM prati mahAntaM
yatnaM kariShyAmIti bhAvena prashno yukta eveti bhAvaH || 36||

%%% ##endlabel##

%%% ##label=<segment031_pd03>##

{\Largedvng pra\.dI\. || } \" balavadviShayashchetprashnastarhi parihAro na saN^gachChata\"
ityataH parihAraM vyAchaShTe \dash \" yastu\" iti ||  \" pravartakaH\" pApeShu puruShasya
tvayA pR^iShTa iti sheShaH |  \" evaM yojanAyAM krodhasyApi kAmasAmyaM syAt |  tathA cha
uttaratra kAmasyaivAnuvR^ittirvirudhyeta\" ityataH \" krodha eShaH\" ityetadanyathA
vyAchaShTe \dash \" krodho.api\" iti ||  kAma eva kiM mukhyayA vR^ittyA evamuchyate\?
neti brUmaH |  kintUpachAreNeti bhAvenAha \dash \" tad\" iti ||  \" tadeva kuta\?\"
ityata Aha \dash \" kAmAd\" iti ||  \" nAyamasti niyamaH |  yadA gurunindA.a.adishravaNe
nindakAya krudhyati tadA kAmAbhAve.api krodhodayadarshanAd\" ityata Aha \dash
\" yatrApi\" iti ||  bhaktinimittashchAsau anindAkAmashcheti vigrahaH |  \" saN^gAt
saJNjAyate kAmaH\" (2\.62) ityetaddarshayituM \" bhaktinimittA\" ityuktam |  \" kAma
eva kenachitpratihataH krodhatvena pariNamata\" iti pareShAM vyAkhyAnaM dUShayati \dash
\" ye tu\" iti ||  ekAntaH karaNopAdAnatvalaxaNAdAnantaryalaxaNAchcha saN^karAtsUxmaM
kAmakrodhayoratyantabhedam |  na hi guNo guNasyopAdAnam |  kintu nimittameva |  idAnIM
vyatireke.apyAha \dash \" uktaM cha\" iti ||

\" mahAshanaH\" iti kAme durghaTatvAdgauNamityAha \dash \" mahAshana\" iti ||
\" bhogyam\" viShayaH |  yasmAtkAmabhogyaM mahattasmAdasau \" mahAshanaH\" iti
herarthaH |  \" kAma eSha\" iti pApakAraNatvenoktvA kathaM \" mahApApmA\" ityuchyata\?
ityato na karmadhArayo.ayam kintu mahAn pApmA yasmAditi bahuvrIhiriti bhAvenAha \dash
\" mahAbrahma\" iti ||  mahachChabdAtparataH pApmashabdo.adhyAhAryaH |
\" vadhAdikartR^itvAbhAvAtkathaM vairI\?\" ityata Aha \dash \" sarva\" iti ||
\" sarvaH\" sampUrNaH |  \" puruShArtho\" moxaH || 37||

%%% ##endlabel##

%%% ##label=<segment032_pd03>##

{\Largedvng pra\.dI\. || } \" nanu prashnasyottaraM jAtaM |  kimuttareNa\?\" ityataH shlokadvayasya
saN^gatimAha \dash \" katham\" iti ||  \" saH\" kAmaH |  \" kathaM moxasya virodhI\?\"
iti jij~nAsAyAmAha dhUmenetyAdIti sheShaH |  vivaxitArthasyAsphuTatvAdvyAkhyAti \dash
\" idam\" iti ||  IshvarAntaHkaraNajIvalaxaNaM vastutrayam |  kena kimivetyAkAN^xAyAM
AdyapAdaM vyAchaShTe \dash \" yathA\" iti ||  \" paramAtmA\" kAmenAvR^itaH |  svayaM
sarvaj~no.api anyairna j~nAyata iti sheShaH |  anyasya mukhAdeH |  \" paramAtmAdeH\"
iti \" Adi\" padena jIvo gR^ihyate |  bandhApexayA.a.avaraNasya samAnakartR^ikatvam |
\" baddhaH\" saN^kuchitaH |  vyApArAxama iti yAvat |  \" ulbo\" garbhaveShTanam |
kAmenAvR^ito jIvo neshvarAdij~nAne xama ityarthaH || 38||

%%% ##endlabel##

%%% ##label=<segment033_pd03>##

{\Largedvng pra\.dI\. || } evaM j~neyaj~nAnakAraNaj~nAtR^ipratibandhakoktyA j~nAnaprati\-
bandhakatvamuktam |  \" AvR^itaM j~nAnam\" ityanena punaH kimuchyata ityata Aha \dash
\" shAstrata\" iti ||  pUrvaM j~nAnotpattipratibandhakatvamuktam |  idAnIM tu
kathaJNchijjAtamapi j~nAnaM na svakAryAya prabhavatItyuchyate |  ato na punaruktidosha iti
bhAvaH |  \" kAmakAreNa chaika\" iti vachanAdaparoxaj~nAnasya moxasAdhane na kenApi
pratibandha ityata uktam \dash \" shAstrata\" iti ||  \" paramAtmA.aparoxyAya\"
iti cha ||  \" na prakAshate\" na prabhavati |  \" j~nAnina iti vyartham |  j~nAnasya
j~nAnisambandhAvyabhichArAd\" ityata Aha \dash \" j~nAnino.api\" iti ||  shastra\-
janitaj~nAnavato.api |  \" alpaj~nAninaH\" gurUpadeshamAtrajanitaj~nAnavataH |  apare
tu \" j~nAnino nityavairiNA |  na mUrkhasya |  j~nAnI hi nAshayiShyAmi kAmamiti yatate |
mUrkhastu tamanuvartate\" iti varNayanti |  tadanenaiva nirastam |  apakAritvaM khalvatra
vairitvaM vivaxitam |  tachcha j~nAnyapexayA mUrkhe.adhikam |  na hi mUrkhastannAnusandhatta
ityetAvatA tannAsti |

\" ichChAnurUpaM rUpaM yasyAsau kAmarUpa ityuchyate |  na chaitatkAme.antaHkaraNadharme
sambhavati\" ityata Aha \dash \" kAma\" iti ||  \" rUpyate.anayeti rUpamAkhyA.atra
vivaxitA\" ityarthaH |  \" tarhi visheShaNapadamidaM jAtam |  kimasya visheShyam\?\"
ityata Aha \dash \" nitya\" iti ||  \" yo na pUrayituM shakyassa duShpUraH |  kAmastu
viShayasampAdanena pUrayituM shakhyaH kathaM duShpUraH\?\" ityato.anyathA vyAchaShTe \dash
\" duShpUreNa\" iti ||  na naJNarthe dushshabdaH |  kintu kR^ichChrArtha ityarthaH |
tadupapAdayati \dash \" na hi\" iti ||  kAmaviShayopalaxaNametat |  \" nanu
prajvalanAtmakatvAtkrodho.analo yuktaH |  kAmastu kathamanala\?\" ityataH sopapattikaM
anyathA vyAchaShTe \dash \" yadyapi\" iti ||  idamapi prAptAdAdhikyasyopalaxaNam |

shlokadvayArthe pramANasammatimAha \dash \" uktaM cha\" iti ||  \" kAmakaH\"
kutsitaH kAmaH |  \" j~nAnasya brahmaNashchAgnerdhUmaH |  tathA buddherantaHkaraNasya |
Adarshasya malam |  atha jIvasya garbhasyolba\" iti sarvatra gUDhopamA |  etena
\" idamityuktasya vivaraNaM dvitIyashloka\" iti vyAkhyAnamapAkR^itaM bhavati || 39||

%%% ##endlabel##

%%% ##label=<segment034_pd03>##

{\Largedvng pra\.dI\. || } \" indriyANi ityAdikamapR^iShTaM kimarthamuchyata\?\" ityata
Aha \dash \" vadhArtham\" iti ||  etadarthameva hyarjunena balavAn pR^iShTaH |
kriyAdvayashravaNAtkaM pratIndriyAdInAM karaNatvamiti na pratIyate |  sannidhAnAdvimohanaM
pratItyanyathA cha pratIyate |  ata Aha \dash \" etaiH\" iti ||  tadupapAdayati \dash
\" buddhyAdibhiH\" iti ||  indriyAditvenoktAnAmapi buddhyAditvena grahaNaM
prAdhAnyakramaj~nApanArtham || 40||

%%% ##endlabel##

%%% ##label=<segment035_pd03>##

{\Largedvng pra\.dI\. || } tasmAttvamitIndriyANAM nigrahaH kAmahananopAyatayopadishyate |
\" hR^ita\" iti ||  \" nashyati\" nAshayituM shakyo bhavati || 41||

%%% ##endlabel##

%%% ##label=<segment036_pd03>##

{\Largedvng pra\.dI\. | } \" indriyANi parANi\" ityasya pUrveNa saN^gatirna dR^ishyate |
ata Aha \dash \" shatru hanana\" iti ||  \" evaM buddheH param\" ityanena
\" vaktum\" |  j~nAnasyAtrA.a.ayudhatve pramANamAha \dash \" asaN^ga\" iti ||
asaN^gaM vairAgyasahitam |  \" tarati pAram\" pAramatitara |  \" Chandasi
pare.api\" iti vachanAt |  \" paratvasyAvadhisApexatvAtkasmAdindriyANi parANi\?\"
ityata Aha \dash \" sharIrAd\" iti ||  sannidhAnAditi bhAvaH |  \" kiM paratvaM
anyatvam\?\" |  netyAha \dash \" utkR^iShTAni\" iti ||

\" yo buddheH paratastu saH iti paramAtmochyate |  tasya buddheH paratve mahatA.a.atmanA
sAmyaM syAd\" ityata Aha \dash \" na kevalam\" iti ||  \" kA.asau shrutiryadbalAd
adhyAhAra\?\" ityata Aha \dash \" avyaktAd\" iti ||  \" astu bhagavAnavyaktAdapi
paraH |  tathA.api kAmAdijayArthaM buddheH paratvenaiva j~nAtenAlam |  kiM 
pramANAntarasiddhAdhyAhAreNa\?\" ityata Aha \dash \" na cha\" iti ||  kAmAdijayo hi
muktidvAram |  na cha muktirekadeshaj~nAnamAtreNa bhavati |  \" kuta\?\" ityata Aha \dash
\" sArvatrika\" iti ||  tasyAnyathAvyAkhyAne.api spaShTaM pramANamAha \dash \" tathA
cha\" iti ||  sarvatraiveti sambandhaH |  vedAdyanuktA api bhagavatsampradAyagatAH |
\" taiH saha\" taiH sahitam |  \" na cha tatra\" ityuktamupasaMharati \dash
\" tasmAd\" iti ||

mAyAvAdI tu \" yo buddheH paratastu saH ityanena jIva uchyata\" ityAha |  tannirAkaroti
\dash \" na cha\" iti ||  \" kuta\?\" iti chet \" evaM buddheH paraM 
ityetajj~nAnasya kAmavinAshasAdhanatvokteH, tasyAshcha bhagavatparigrahe ghaTanAd
anyathA.aghaTanAd\" iti bhAvenobhayatra pramANamAha \dash \" raso.api\" iti ||
\" na chAtra\" ityuktamupasaMharati \" ata\" iti ||  bhAskarastu \" kAmo
atrochyata\" ityAha |  tadatIva mandam |  \" kAmaH saN^kalpaH\" ityAdishrutestasya
manodharmasya tatparatvAnupapatteH paxadvaye.api \" indriyANi parANi\" ityAditAratamyokteH
na prayojanamastIti || 42||

\" saMstabhyAtmAnamAtmanA\" ityasya \" jIvAtmAnaM paramAtmanaikIkR^itya\" iti
vyAkhyAnaM shabdabAhyamityAshayavAnAtmashabdadvayaM vyAkhyAti \dash \" AtmAnam\"
iti || 43||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM tR^itIyo.adhyAyaH ||}

%%% ##endlabel##

%%% ##label=<segment001_pd04>##

{\Largedvng pra\.dI\. ||} pUrvasaN^gatvena adhyAyArthamAha \dash \" saptama\" iti |  
\" bhagavanmAhAtmyam\" iti sheshhaH |  \" padArthaj~nAnapUrvakaM vAkyArthaj~nAnam\" 
iti saptamoktapadArthAnashhTame vyAkhyAya navame tadvAkyArthaM spashhTIkaroti, 
ityarthaH |

{\Largedvng pra\.dI\. ||} \" uktayorj~nAnakarmaNorubhayorvisheshhavistarAtmako.ayamadhyAya\" 
iti pUrvasaN^gatAdhyAyArthasthitAviha prakaraNabhedapratipAdanArthamAha \dash \" buddheH\" 
iti |  \" evaM j~nAtvA\" (4\.15) ityataH prAktanena granthena buddheH parasya vishhNoH 
mAhAtmyamuchyate |  Adyasya prakaraNasya pUrveNa saN^gatiM sUchayituM \" buddheH parasya\" 
ityuktam \dash \" shreyAn\" (3\.35) ityataH pUrveNa karmabhedaH |  nivR^ittasya 
karmaNo.anyasmAdbhedaH |  nivR^itta eva karmaNyupAsanAyaj~nAdirUpeNa vA bhedaH | 
\" j~nAnamAhAtmyam\" sheshheNa iti |  \" imaM vivasvate yogam\" (4\.1) iti 
\" upadeshaparamparAkathanaM prakR^itAnupayuktam\" ityatastAtparyamAha \dash \" pUrva\" 
iti pUrvairanushhThitaH |  \" ye me matam\" (3\.31) ityuktena hetunA sahAsya 
samuchchayArthashchashabdaH |  ayaM dharmaH \" mayi sarvANi\" (3\.30) ityanenoktaH |    
yogashabdo.apyanena vyAkhyAtaH |  na kevalamupadeshaparamparA.atrochyate |  
kintu teshhAM anushhThAnamapyupalaxyate |  \" tachcheto.api tvayA.anushhTheyam\" iti 
\" pratipAdanArtham\" iti bhAvaH \dash \" karmaNaiva hi samsiddhim\" (3\.20) iti 
\" anenaitadgatArtham\" iti chenna |  \" gR^ihasthakarma tvayA na tyAjyam\" iti 
asyopapAdanAyAchArasya tatroktatvAt |  atra tu nivR^ittadharmAnushhThAne 
sadAchArasya uchyamAnatvAt |  ata eva tatrA.a.achAra ityevoktam |  
iha tu \" ayaM dharma\" iti \dash \" loke.asmin dvividhA\" (3\.3) ityatroktasya 
\" karmaNaiva\" (3\.20) ityAdyudAharaNamuktamiti tatrApi na doshhaH || 1\-3|| 

%%% ##endlabel##

%%% ##label=<segment002_pd04>##

{\Largedvng pra\.dI\. ||} nanu \" natvevAham\" (2\.12) ityAdinA sarvaprakAreNa 
utpattinAsharAhityamuktaM bhagavataH |  tachchhrutvA \" kathaM \" aparam\" iti 
pR^ichchhati?\" ityata Aha \dash \" mayi\" (3\.30) iti | tanmAhAtmyamityupalaxaNam | 
AditaH pramitikAraNataH \dash \" mayi sarvANi\" (3\.30) ityatra parameshvarasya 
mAhAtmyaM pUjyatvAdilaxaNamuktam |  arjunasya cha pUjakatvAdikam |  \" tamimaM 
IshvarajIvayoH pUjyapUjakatvAdinA bhagavatAN^gIkR^itaM bhedaM pramANena j~nAtumevaM 
pR^ichchhati\" ityarthaH | ata eva j~nAtAshayo bhagavAn \" tava cha\" , \" na tvaM 
vettha\" iti pariharati |  anyathAnupayuktaM tanna vaktavyameva || 4\-5|| 

%%% ##endlabel##

%%% ##label=<segment003_pd04>##

{\Largedvng pra\.dI\. ||} prashnasya parihR^itatvAt \" ajo.api\" iti kimarthamityata 
Aha |  \" na tarhi\" iti |  \" yadi janmAni vyatItAni tarhi\" ityarthaH |  
anAdirdehato.api |  upalaxaNaM chaitat |  maraNarahitaH, sarvabhUtAnAmIshvarashchetyapi 
drashhTavyam | \" tathAchoktavirodha\" iti bhAvaH |  \" nanu dehato.apyanAditvAdeH 
Axepe.ajatvAdimAtraM kathamuchyata\?\" ityataH \" avyayAtmA\" ityetattAvaddehato.api 
avinAshamAchashhTe |  tatsAhacharyAt \" ajo.api\"  ityetadapi \" tathaiva vyAkhyeyam\" 
iti bhAvenAha \dash \" avyaya\" iti |  apipadAtparaM \" asya\" ityadyAhAryam |  
syAdevaM vyAkhyAnaM yadi bhagavadvigrahasyApyavyayatvaM gItAchAryasyAbhimataM syAt |  
\" tadeva kuta?\" ityata Aha \dash \" anantam\" iti |  iti cha \" rUpavisheshhaNam\" 
iti vartate |  evaM tarhi kathaM tatraiva \" jagR^ihe paurushhaM rUpam\" (bhA\.pu\. 1\.3\.1) 
iti rUpagrahaNamuchyate\? \" gR^ihItasya cha tyAgo niyata eva\" ityata Aha \dash 
\" jagR^iha\" iti |  \" vyaktiruchyata\" iti sheshhaH |  \" kuta evaM kalpyata\?\" 
ityata Aha \dash \" yuktaya\" iti |  \" yujyata ebhiH\" iti yuktayaH pramANAni |  
asambhAvanAparihArArthA achintyashaktitvAdyA yuktayo vA |  uktA 
dvitIye |  astu bhagavadvigrahasyApyavyayatvam |  \" atra tu svarUpasyaivochyata 
iti kiM na syAt\?\" ityata Aha \dash \" AtmA\" iti |  AtmanaH
svarUpasvavigrahasyApyavyayatvopapAdanenAjatvamapi \" sAhacharyAttasyaiva\" 
iti yo.abhiprAyastaM prakaTayitumavyayatvamupakramya \" anAditvam\" ityuktam |  
sarvasamaM jIvAnAmapyasti |  ataH \" tadvishhaya AxepaH parihAro vA na 
sambhavati\" iti bhAvaH |  

\" Atma\" shabdo.apyanyathA vyarthaH |  asmatpaxe svarUpadehayorupAdAnArthaH | 
ata eva \" deho.api\" (bhA\.pu\. 11\.13\.37, 3\.29\.37) ityuktam |  \" evaM 
tarhi \" prakR^itiM svAmadhishhThAya\" iti kathamuktam\?\" ityatastadanyathA 
vyAkhyAtumAha, \" katham\" iti |  svarUpato dehatashchAnAdinityasya 
\" sambhavAmi\" iti janiH kathamuchyate\?  \" vyAhatatvAt\" ityata Aheti 
sheshhaH |  \" adhishhThAya\" ityataH paraM \" iti\" shabdashcha |  \" kathamanena 
parihAra\?\" ityato vyAchashhTe \dash \" prakR^ityA\" iti |  \" vasudevAdishhu 
prAdurbhUtatvAt\" iti sheshhaH |  anena janmabhrAnternimittamuktam |  
yathoktaM \" strIpumprasaN^gAt\" ityAdi |  bhrAnterupAdanamAha \dash \" tathaiva\" 
iti |  tamorUpayA |  yadi \" mAtApitR^isambandho.aN^gIkR^itastarhi 
tannimittaduHkhAdikamapi prasajyata\" ityAshaN^kAnirAsAya svAmiti padaM 
vyAkhyAti \dash \" natu\" iti |  \" prakR^iterbhagavadadhInatvaM kuta\?\" ityata 
Aha \dash \" dravyam\" iti | \" atra vAkye prakR^itirnashrUyata\" 
ityata Aha \dash \" sA hi\" iti |  \" dravyapadena\" iti sheshhaH |  
\" tasyAtra prakR^itivAchitvaM kuta\?\" ityata Aha \dash \" tata\" iti |  
sarvasR^ishhTikAraNAni hyatra nirdishyante |  tachchha prakR^itereva sambhavati |  
\" na pR^ithivyAdeH\" ityarthaH |  \" AtmamAyayA.a.atmAvidyayA\" iti 
pratItinirAsAyAha \dash \" Atma\" iti |  \" kuto hetorevaM jIvavilaxaNaM te 
janmA\?\" ityAshaN^kAnirAsArthametat |  anyathApratItirapyanena parihR^itA |  
sarvaj~nasyAvidyA.ayogAt |  \" prakR^itiratra mAyA kiM na syAt\?\" ityata 
Aha \dash \" prakR^iteH\" |  iti  \" mAyAshabdasya j~nAnavAchitvaM kuta\?\" ityata 
Aha \dash \" ketuH\" iti |  \" iti praj~nAyA nAmadheyAni\" 
iti vAkyasheshhAt |  

prAk \" prakR^itiM svAmadhiShThAya\" ityanenaiva bhramanimittatvamupAdAnatvaM cha 
prakR^iteruktamiti mAyAshabdo na prakR^itivAchI |  punaruktiprasaN^gAdityuktam | 
idAnIM tasya nimittamAtraparatve mAyAshabdasya prakR^ityarthatAyAmapi na doshhaH | 
\" upAdAnArthatvAt\" iti bhAvena Aha \dash \" sR^ishhTi\" iti |  \" prakR^ityA\"
iti sheshhaH |  teshhAM vasudevAdInAm |  sR^ishhTvA tatra prAdurbhUtaH |  
vimohikayA mAyAkhyayA |  atrAgamasammatimAha \dash \" uktam cha\" iti |  
AtmachidbalAdajAta eva |  nanvIshanashIlAnAmapi brahmAdInAmutpattimaraNadarshanena 
virodhAbhAvAt \" Ishvaro.api sambhavAmi\" iti kathamuchyata ityataH 
\" stheshabhAsapisakaso varach\" (ashhTA\. 3\.2\.175) ityetadvihAyAnyathA 
vyAchashhTe \dash \" Ishvara\" iti |  \" kuta etat\?\" ityata Aha \dash 
\" Ishebhya\" iti |  etadAgamabalAdeva samAsAkAralopAvanumantavyau |  
\" ajatvAdessambhavena shabdo vyAghAto.asya tu vyAptyA\" iti j~nApanAya 
kramamullaN^ghya vyAkhyAtam || 6||   

%%% ##endlabel##

%%% ##label=<segment004_pd04>##

{\Largedvng pra\.dI\. ||} \" paritrANAya sAdhUnAm\" iti sAdhuparitrANAdikaM bhagavadavatArasya 
prayojanamuktam |  \" tatra kiM \" janmanaiva paritrANAdikaM kAryam\" iti niyama\?\" 
ityapexAyAmAha \dash \" na\" iti |  \" janmanA vinA.api kartuM samarthatvAt\" iti 
bhAvaH |  \" tarhi kimarthaM janmA\" ityata Aha \dash \" tathA.api\" iti |  
yatheshhTachArI ichchhayaiva tathA charati |  \" tathechchhaiva kimarthA\?\" ityata 
uktam \dash \" lIlayA\" iti |  \" lIlA.apyAlasyaparihArAdyarthA na bhavati\" 
ityuktam \dash \" svabhAvena cha\" iti |  atraiva pramANAnyAha \dash \" tathA 
hi\" iti |  ayameshhaH iyamichchhA |  atra pravR^ittishhu |  viruddheshhuM 
lokaviparItechchham || 8|| 

%%% ##endlabel##

%%% ##label=<segment005_pd04>##

{\Largedvng pra\.dI\. ||} \" janma karma cha\" iti \" bhagavajjanmAdij~nAnamAtreNa 
muktiruchyata\" iti pratItinirAsAyAha \dash \" pR^ithak\" iti |  
\" ekadeshaj~nAnena\" ityarthaH |  darshanArthamupalaxaNArtham |  \" yathA pratItArthaH 
kiM na syAt\?\" ityata Aha \dash \" na tu\" iti |  uktaM tR^itIye |  pramANAntaraM 
chAha \dash \" vedAdi\" iti |  \" vAkyatvAvisheshhAdetasya gItAbAdhakatvaM kuta\?\" 
ityataH sAvakAshatvaniravakAshatvAbhyAmityAha \dash \" atra\" iti |  \" ayoga\-
vyavachchhedamAtraparatvAm\" ityarthaH | etachcha \" pUrvoktAdarthAntaram\" iti j~neyam |  
\" itaravAkyAnyadhikArivisheshhApexayA sAvakAshAni\" iti \" kuto nAnyA 
gatiH\?\" ityata Aha \dash \" na\" iti |  visheshhaNAtpaxAntaravyavachchhedAt | 
\" ito.apyatra sarvaj~nAnamaN^gIkAryam\" ityAha \dash \" tattvata\" iti |  \" Apatati\"
ityanenArthApattimabhipraiti |  etameva nyAyamanyatrApyatidishati \dash 
\" yatra\" iti |  evaM bhavati sarvaj~nAne pramite.apyekadeshaj~nAnoktirbhavati |  
\" tattvato j~nAnaM kutassArvaj~namAxipati\" ityata Aha \dash \" uktaM cha\" iti |  
\" jij~naset\" jij~nAseta |  anyatrApi \dash

\" eko bhAvaH tatvato yena dR^ishhTaH sarve bhAvAH tatvatastena dR^ishhTAH\" iti | 
\" sarvatra sArvaj~naM yathAshakti vivaxitam\" iti dhyeyam || 9||

%%% ##endlabel##

%%% ##label=<segment006_pd04>##

{\Largedvng pra\.dI\. ||} \" kiM chottarashloke.adhikAnuvAdAnnAtretAvanmAtraM vivaxitam\" 
iti bhAvena tattAtparyamAha \dash \" santi cha\" iti |  tathoktaj~nAnena 
Aha |  \" shraddhotpAdanArtham\" iti sheshhaH |  \" manmayA madAtmakA\" iti 
pratItinirAsArthamAha \" manmayA\" iti |  sarveshhAM bhagavAn prachuraH | 
\" ko visheshho j~nAninAm\?\" ityata Aha \dash \" sarvatra\" iti |  sarveshhu 
padArtheshhu |  kiJNchitsattAdikam | \" madAyattameva sarvaM pashyanti\" ityarthaH || 10||

%%% ##endlabel##

%%% ##label=<segment007_pd04>##

{\Largedvng pra\.dI\. ||} \" ye yathA\" iti vAkyaM na prakR^itena sAxAtsaN^gatam | 
atastatsaN^gamayituM madhye shaN^kAntaraM nirAkaroti \dash \" na cha\" iti |  
\" mAmupAshritA madbhAvamAgatA\" ityuktyA \" anyadevatAdirUpeNa madbhajanamAtreNa 
traividyAnAmapi muktirbhavatIti nA.a.ashaN^kanIyam\" ityarthaH |  vishhNuM sAmAnyataH 
sarvottamaM j~nAtvA.anyadevatAH pitR^I.nshcheshhTvA.ante vishhNau samarpaNamanyadevatAdirUpeNa 
bhagavadbhajanam |  \" upapattiM tUttaratra vaxyAmi\" iti bhagavato.abhiprAyaH |  
\" tatkiM traividyAnAM tvadbhajanaM nirarthakameva\" ityata Aha \dash \" tathA.api\" 
iti |  \" yadyapi na muktiM dadAmi |  tathA.api tadabhipretaM svargAdikaM dadAmi\" 
iti sheshhaH |  evaM tarhi \" j~nAnibhyo muktiM traividyebhyo.alpaphalaM dadadvishhamo 
bhagavAn syAt\" ityAshaN^kAnirAsArthatvenottaravAkyaM saN^gamayannAha \dash 
\" sarveshhAm\" iti |  AnurUpyeNa sevAnusAreNa |  \" sarveshhAM j~nAninAM 
traividyAnAM cha\" iti chaturthyarthe shhashhTI |  \" tathaiva bhajAmi\" 
ityetadanyathApratItinirAsAya vyAchashhTe \dash \" sevayAmi\" iti | 
\"  bahulametannidarshanam\" iti vachanAtsvArthe Nich |  \" mama vartma\" ityasya 
saN^gatyapratItestAmAha \dash \" katham\" iti |  yaH phalatAratamye heturayaM 
j~nAnibhyastraividyAnAM sevAyAM visheshhaH katham |  \" kimprakAra\" ityarthaH |  
\" kathamanenaitachchhaN^kAparihAra\" ityato vyAchashhTe \dash \" anya\" iti |  \" na 
kevalaM j~nAninaH |  kintvanyadevatA yajanto.api |  traividyA\" iti yAvat |
\" kiM tatsarveshhAM tvadvartmAnuvartanam\" ityata Aha \dash \" sarva\" iti |  
bhoktR^itvAddhavirAdInAm |  etaddvayameva bhagavadvartmAnuvartanam |  tathA vyavahAre 
nimittatvAt paJNchamI |  idamuktaM bhavati |  \" ahameva  sarvayaj~nAnAM bhoktA cha 
prerakashcha |  tadetajj~nAtvA bhAgavatA nishhkAmA mAmeva yajante |  traividyAstvetat 
tattvato.ajAnAnAH karmaNAM siddhiM kAN^xanto.anyadevatA yajante |  evaM sevAvisheshhAdyuktaM 
phalatAratamyam\" iti |  \" kuta idaM bhagavato.abhipretam\" ityata Aha \dash 
\" ye.api\" iti |  anena shlokadvayamupAttam |  tatra cha spashhTameshho.arthaH 
pratIyate |  \" nanvindrAdinAmavadbhirmantrairdattaM havirAdikaM kathaM bhagavAn 
bhuN^kte\?\" \dash \" bhagavatassarvanAmavattvena mantrANAM tatparatvAt\" iti 
bhAvena Aha \dash \" ya\" iti |  \" nanu vishvakarmA evamuchyata\" ityata 
Aha \dash \" bhagavAneva\" iti |  tatra cheti sambandhaH |  anena bhagavataH 
sarvayaj~nAdibhoktR^itve bAdhakaM parihR^itam || 11|| 

%%% ##endlabel##

%%% ##label=<segment008_pd04>##

{\Largedvng pra\.dI\. ||} sAdhakaM tu pramANaM pR^ichchhati \dash \" kuta\" iti | 
\" mama vartmAnuvartante\" (4.11) iti \" yatsarvayaj~nAdibhoktR^itvaM bhagavata 
uktaM tatkutaH pramANAjj~nAyata\?\" ityarthaH |  \" sarvakartR^itvaM tu jIvAnAM 
asvAtantryadarshanAtsiddham,  ityata Aha\" iti sheshhaH |  \" hi\" ityataH 
paramitishabdashcha |  \" kimanena pramANamuktam\" ityata Aha \dash \" ata eva\" 
iti |  karmajA siddhiH |  phalaprAptistAvat xipraM pratyaxopalabhyA.asti |  sA 
chA.ata eva karmaNAM bhagavatA bhuktatvAdeva hi yujyate |  \" nAnyathA\" ityarthaH |  
\" indrAdibhyo.api phalaprAptyupapatterupaxINA.arthApattiH\" ityata Aha \dash 
\" ata eva hi\" iti |  bhagavata eva |  atra \" hi\" iti sUchitaM 
pramANamAha \dash \" tasmAt\" iti | dhanasanayaH dhanalAbhavantaH || 12|| 

%%% ##endlabel##

%%% ##label=<segment009_pd04>##

{\Largedvng pra\.dI\. ||} \" chAturvarNyam\" ityasya saN^gatiM sUchayan 
tAtparyamAha \dash \" ahameva hi\" iti |  \" yasmAdahameva chAturvarNyasya 
kartA traividyAshcha tadantarbhUtAstasmAt svapitaraM mAM parityajyA.anyadevatA 
yajantaH kathaM mahAphalabhAjo bhaveyuH\" ityAhetyarthaH |  \" vichitrA hi 
taddhitagatiH\" iti vachanAdatiriktArthasambhave \" chaturvarNAdibhyaH 
svArtha upasaN^khyAnam\" iti nAdaraNIyamiti bhAvenAha \dash \" chaturvarNa\" 
iti |  varNAshchatvAro guNAstrayaH |  \" tatkathaM teshhu guNavibhAga\" ityata 
Aha \dash \" sAttvika\" iti |  \" rAjasasthasAttvikeshhvevAyaM vibhAga\" iti 
j~nAtavyam |  nirdeshaprAthamyAt xatriye rajasassattvamadhikaM  |  tata eva 
vaishye tamaso rajaH |  tachcha samasattvayutam |  \" rajo.apexayA tamo.adhikaM 
shUdra\" ityasau tAmasaH |  sattvaM tu tamaso.apyadhikam |  \" karmavibhAgaH 
kIdR^isha\?\" ityata Aha \dash \" karma\" iti |

yadi chAturvarNyaM tvayA sR^ishhTaM tarhi kartR^itvAttavApi jIvavatkarmalepaH 
prasajyata ityataH karmalepAbhAvaM vaktuM hetustAvaduchyate \dash \" tasya\" 
iti |  \" tadetadvyAhatam\" ityata Aha |  \" kriyAyAm\" iti |  
\" kathaM vailaxaNyam\?\" ityataH shrutyaiva darshayati \dash \" tathA hi\" iti |  
\" vishvakarmA.api vimanAH tatrAbhinivesharahita\" ityarthaH |  prakArAntareNa 
vailaxaNyaM purANena darshayati \dash \" tanuH\" iti |  \" kriyAyA mithyAtvAt 
kartA.apyakartA\" iti paravyAkhyAM pratyAkhyAti \dash \" sAdhitaM cha\" iti | 
etatkriyAyAH satyatvam |  purastAddvitIye || 13||  

%%% ##endlabel##

%%% ##label=<segment010_pd04>##

{\Largedvng pra\.dI\. ||} apavyAkhyAnasya dUshhaNAntaraM sUchayan \" kriyAvailaxaNyakathanasya 
kA saN^gatiH\" ityata uttareNa saN^gatimAha \dash \" ata eva\" iti | evashabdena 
\" asmadvyAkhyAna eva hetuhetumadbhAvo yujyate na paravyAkhyAna\" iti sUchayati | 
\" jIvAnAM karmalepe.abhiniveshAdikaM kAraNaM tadasya nAsti\" iti |  \" mithyAtvaM 
tu jIvakriyANAmapi samAnam\" iti |  teshhAmapi lepAbhAve kimAshraya AxepaH syAt |  
\" j~nAnena visheshha\" iti chenna |  tasyAshravaNAt |  lepanivAraNaM cha vyartham | 
tasyApi mithyAtvena j~nAtavyatvAt | \" hetuhetumatoruktatvAt \" na me karma\" 
iti kimartham\" ityata Aha \dash \" itashcha\" iti |  nanvAtmArthaM bhagavataH 
phalaspR^ihAbhAve.api parArthamastyeva |  \" tatkathamevamuchyata\?\" ityata 
Aha \dash \" ichchhA\" iti | tatra karmaphale |  yena tatprAptiparyantaM manaso 
vixepaH so.abhiniveshaH |  atra pramANamAha \dash \" tachcha\" iti |  \" vyatyayo 
bahulam\" iti vyatyayaH | 
 
j~nAnaM j~nAnamiva |  \" iti mAm\" ityevaM j~nAnino muktiH phalamuchyate |  sA cha 
vartamAnapratyayena |  prAk cha bhUtapratyayena \" madbhAvamAgatA\" (4\.10) iti | 
tatraikajIvavAdinAmAxepamudbhAvya pratishhedhati \dash \" na cha\" iti |  
\" kechididAnIM muktA bhavanti, kechidbhUtA\" iti paxe \" atIta eva kAle krameNa 
sarvamuktitassyAt |  tathA chedAnIM saMsArAnupalambhassyAt\" iti na shaN^kanIyam |  
kasmAt\?  \" yataH shrutirevaivamAshaN^kya paryahArshhIt\" ityAha \dash \" tathA 
hi\" iti |  hR^idA buddhyA cha |  ityetatkathaM vai yujyate |  \" uktAxepAt\" iti | 
shaN^kAyAM \" anantA jIvAH\" ityuttaram |  nanu kAlo.apyananto.ata ityasyottaraM 
\" anantavat\"  iti |  yathA bhagavAn kAlaxaNebhyo.apyatishayenAnantastathA.anantAH | 
\" kutaH\?\" iti hovAcha \" shrutyantaram\" iti || 14|| 

%%% ##endlabel##

%%% ##label=<segment011_pd04>##

{\Largedvng pra\.dI\. ||} nanu \" evaM j~nAtvA\" iti punaruktam |  karmakaraNa AchArasya 
prAgevoktatvAdityata Aha \dash \" evam\" iti |  yadi j~nAnI karmabhirna
badhyate tarhi mamApi j~nAnitvena karmabandhAbhAvAtkathaM karmavidhAnamityAshaN^kya 
j~nAninAmapyadhikamoxAkAN^xAyAM karmakaraNa AchAro.atrochyate |  prAk tu janakAdInAM 
vivasvadAdInAM cha vidyamAnamapi j~nAnitvaM bhagavatA na vivaxitamiti bhAvaH |  
ata eva bhAshhyakAreNa tatra \" karma kR^itvaiva\" (gI\. bhA\. 3\.20) ityAdyuktam |  
na hi j~nAninAM karma j~nAnadvArA muktihetuH |  mumuxubhiriti tatsAdhukAriNyupratyayaH | 
\" pUrvaiH kR^itam\" ityanenaiva pUrvataratvasyoktatvAtpunaruktirityata Aha | 
\" pUrvataram\" iti |  tairapi tato.api \" pUrvabhAvikR^itam\" ityarthaH |  
karmaNaH xaNikatvAtkathaM tadeva kartavyamityato vA idamuktam |  \" pUrvamiva
bhavati\" iti pUrvabhAvi |  ata eva \" karma\" ityanuvAdaH || 15||

%%% ##endlabel##

%%% ##label=<segment012_pd04>##

{\Largedvng pra\.dI\. ||} \" kiM karma\" ityasya saN^gatirna pratIyate |  ata 
Aha \dash \" karma\" iti |  tasya kartavyatayoktasya |  kimartham\? 
\" samyagvaktum\" |  etadeva samyagvachanaM yajjij~nAsave kathanam |  
\" jij~nAsA cha durvij~neyatvoktau bhavati\" iti bhAvaH |  ata eva 
\" prakarshheNa vaxyAmi\" ityAha |  \" nanUttarashloke vikarmaNo.api 
gR^ihItatvAdihApyakarmashabdastadupalaxaNArthaM\" iti sthite \" karmAdInAm\" 
iti vaktavyam |  \" karmaNa\" iti katham | anushhTheyatvAt |  akarmAdikaM 
hi heyatayA j~neyam |  ata eva \" tatte karma pravaxyAmi\" ityAha | 
tatrApyakarmAderupalaxaNAt || 16||  

%%% ##endlabel##

%%% ##label=<segment013_pd04>##

{\Largedvng pra\.dI\. ||} nanu \" yajj~nAtvA moxyase.ashubham\" ityanenaiva karmAdi 
svarUpaM mumuxuNA j~nAtavyamiti labdham |  tatkimarthaM \" karmaNo hi\" 
ityAdyuchyata ityata Aha \dash \" na kevalam\" iti |  tatkarmAdikam |  
\" siddhe satyArambho niyamArtha\" iti bhAvaH |  atraiva pramANamAha \dash 
\" tachcha\" iti |  darshanApexayA samAnakartR^itvAt ktvAnirdeshaH | 
karmashabdArtho bhagavataiva vaxyate |  akarmavikarmashabdArthAvAha \dash \" akarma\" 
iti |  \" kiM tadvikarma\" ityata Aha \dash \" nishhiddham\" iti |  evaM chet 
\" kAmAdyupetasya kutrAntarbhAva\?\" iti chet \" vikarmaNi\" iti brUmaH | 
\" kathaM tasya nishhiddhatvam\" ityata Aha \dash \" bandhakatvAt\" iti |  
astvevaM shabdArthaH |  \" yojanA tu kathaM\" ityato lAghavArthaM dvitIyapAdayojanAM 
tAvadAha | \" tata\" iti |  tataH vikarmaNaH |  karmAdi karmAkarma cha |  
\" ityAdi\" ityanenAdyatR^itIyapAdayojanAM sUchayati |  \" karmaNo vivichya 
vikarmAdi boddhavyam |  akarmaNashcha vivichya karmAdi boddhavyam\", iti |
nanu \" kavayo.apyatra mohitAH\" ityanena \" karmAderdurj~neyatvamuktam |  
tatpunaH kimarthamuchyata\?\" ityata Aha \dash \" na cha\" iti |  j~nAtuM 
\" svabhAvena\" iti sheshhaH |  \" etachcha shroturadhikAdarajananArtham\" 
iti j~neyam || 17||    

%%% ##endlabel##

%%% ##label=<segment014_pd04>##

{\Largedvng pra\.dI\. ||} \" karma pravaxyAmi\" iti pratij~nAtam |  karmAdipravachanaM cha 
kvApi nopalabhyate |  \" karmaNi\" iti shlokasya \" yatkiJNchiddarshanastutirUpatvAt\" 
ityata Aha \dash \" karmAt\" iti yadyapyayaM shloko.anyathA pratIyate |  tathApyavihitasya 
stutyayogAt \" vAkyabhedena karmAdikaM pratipAdya tatstutiH kriyata \" iti bhAvaH |  
\" kathamanena tatsvarUpamuchyata\?\" ityato vyAchashhTe \dash \" karmaNi\" iti | 
varNAshramochite | akarma karmAbhAvaM svasya |  tadvivR^iNoti \dash \" vishhNoreva\" 
iti |  \" chitpratibimba\" ityanena \" tadadhInaH karomi\" ityapi sUchayati |  
\" suptyAdikaM kathamakarma\?\" ityata uktaM \" akaraNa\" iti |  jIvApexayedam |  
etadapi vivR^iNoti \dash \" ayameva\" iti |  sarvadA jIvavyApArAbhAve bhAve cha |  
sarvasya mahadAdeH svApnagajAdeshcha |  anena bhagavataH parAnapexayA kartR^itvaM 
svasya tadadhInaM cha j~nAtvA \" varNAshramavihitAnushhThAnaM karma\" ityuktaM bhavati |  
\" anenaivoktalaxaNe vikarmAkarmaNI proktaprAye |  yaH pashyetsabuddhimAn\" iti 
\" ko.arthabhedaH\? kathaM cha stutiH\?\" ityata Aha \dash \" sa\" iti |  
j~nAni shabdo hi pAmaravilaxaNe prasiddhaH |  matubAdInAM prashaMsArthatvAt |  
\" sa yukta\" ityetatstutiryathA syattathA vyAchashhTe \dash \" sa eva cha\" iti | 
\" kR^itsnakarmakR^it\" ityetanmukhye bAdhakaM pradarshayan gauNaM vyAkhyAti \dash 
\" sarva\" iti |  sarvasyAshvamedhAdeH |  \" kR^itsnakarmaNAM phalasya j~nAnasya 
moxasya cha prAptaprAyatvat\" ityarthaH || 18||

%%% ##endlabel##

%%% ##label=<segment015_pd04>##

{\Largedvng pra\.dI\. ||} nanu pratij~nAtamuktam |  \" tatkimuttaraiH shlokaiH\" ityata 
Aha \dash \" etadeva\" iti |  karmasvarUpameva |  anenAtrApi \" vAkyabhedena 
kAmAdivarjanavishhayA stutiH kriyata\" iti sUchitam |  \" mithyAtvaj~nAnena 
karmaNAmupamardo j~nAnAgnidagdhakarmatvam\" (shaM\.bhA\. 4\.19) iti vyAkhyAnamasat, 
iti bhAvenAha \dash \" ukta\" iti |  \" parameshvarasyaiva kartR^itvaM j~nAtvA 
svasya svAtantryeNa karmAbhAvaj~nAnameva j~nAnAgnidagdhakarmatvam\" ityarthaH || 19|| 

%%% ##endlabel##

%%% ##label=<segment016_pd04>##

{\Largedvng pra\.dI\. ||} \" yasya sarve samArambhAH kAmasaN^kalpavarjitAH\" ityanena
yaduktaM tadeva \" tyaktvA karmaphalA.asaN^gam\" ityanenochyate |  saN^kalpo 
hi karmA.asaN^gaH |  kAmashcha phalA.asaN^ga ityataH saN^gatipUrvamanyathA 
vyAchashhTe \dash \" na cha\" iti | \" naitAvatA karmasvarUpaM sampUrNam\" 
ityarthaH | \" kiM tarhi\?\" ityadhyAhAraH |  \" nanu nityatR^ipto nirAshraya\" 
iti sAdhyo.arthaH |  \" sa kathaM sAdhane niveshyata\?\" ityata Aha \dash \" j~nAnena\" 
iti |  \" karmaNyakarma\" (4\.18) ityapexayA \" punaH\" iti |  \" mithyAj~nAnametat\" 
ityato.abhiprAyamAha \dash \" nitya\" iti |  iti hetorahamapi tathAvidhaH |  
\" kintvavidhyayA tathA na pratIyata\" iti jAnannityarthaH || 20||

%%% ##endlabel##

%%% ##label=<segment017_pd04>##

{\Largedvng pra\.dI\. ||} kAmavarjitatvameva \" nirAshIH\" ityanenochyata ityata
Aha \dash \" kAmAdi\" iti |  Adipadena saN^kalpAdiparigrahaH |  \" katham\?\" 
ityato yojayati \dash \" yata\" iti |  \" nirAshIH tyaktasarvaparigrahashcha bhavati\" 
iti sheshhaH |  \" sendriyaM sharIramAtmA\" ityasat |  \" antaHkaraNavR^ittiniyamenaiva 
tanniyamasiddheH\" iti bhAvenAha \dash \" Atma\" iti |  \" nanu parigraho 
dehAdiH |  tattyAgaH kathaM sAdhakasya\?\" ityata Aha \dash \" parigraha\" iti |  
\" anabhimAnam\" iti \" sthitiH\" ityAdi kriyAvisheshhaNam |  arthAbhAve.avyayIbhAvo 
vA.ayam |  \" abhimAnAbhAva\" ityarthaH |  pUrvashloke \" karmaNyabhipravR^itto.api naiva 
kiJNchitkaroti\" iti \" karmaNAM mithyAtvaj~nAnAt\" iti vyAkhyAnamasat  |  atra 
shloke.anyathA \" tadabhiprAyasya varNitatvAt\" iti bhAvenAha \dash \" naiva\" iti |  
\" gauNyA vR^ittyedamabhiprAyakathanam\" ityavadheyam || 21||

%%% ##endlabel##

%%% ##label=<segment018_pd04>##

{\Largedvng pra\.dI\. ||} kAmAdivarjane yadR^ichchhAlAbhasantushhTatvAdikamarthAtsiddham |
\" tatkimarthamuchyata\?\" ityata Aha \dash \" yata\" iti |  \" dvandvAtIta\" 
ityuktameva \" samassiddhAvasiddhau cha\" ityanenochyata ityata Aha |  
\" katham\?\" iti |  \" kimprakAram\?\" ityarthaH |  \" iti jij~nAsAyAm\" iti 
sheshhaH |  \" vyAkhyAnavyAkhyeyatvena na punaruktidoshha\" ityarthaH || 22||

%%% ##endlabel##

%%% ##label=<segment019_pd04>##

{\Largedvng pra\.dI\. ||} yaduktaM kAmAdivarjanaM tadeva \" gatasaN^gasya\"
ityanenochyate |  \" tyaktasarvaparigraha\" (4\.21) ityetat \" muktasya\" ityanena,
\" karmaNi\" (4\.20) iti \" nityatR^ipta\" (4\.20) iti cha \" j~nAnAvasthitachetasa\"
ityanena |  \" ataH punaruktiH\" ityata Aha \dash \" upasaMharati\" iti |  
\" vixiptaM piNDIkaroti\" ityarthaH |  \" gatasaN^gasya\" iti vishhayasApexam |  
atastatpradarshanena vyAkhyAti \dash \" gata\" iti |  \" muktasya\" ityetatsAdhake 
ghaTayati \dash \" muktasya\" iti |  anena \" abhimAnAnmuktasya\" iti vA 
\" muktasadR^ishasya\" iti vA vyAkhyAtaM bhavati |  j~nAnasya vishhayasApexatvAttaM 
pradarshayan vyAchashhTe \dash \" j~nAna\" iti |  Atmaj~nAnasyApyupalaxaNametat || 23||

%%% ##endlabel##

%%% ##label=<segment020_pd04>##

{\Largedvng pra\.dI\. ||} nanu karmasvarUpaM pratij~nAya saN^xepavistarAbhyAM
pratipAdyopasaMhR^itam |  \" kimidaM \" brahmArpaNam\" ityanenochyata\?\"
ityata Aha \dash \" j~nAnAvasthita\" iti |  etena \" iti yo jAnAti\" 
ityadhyAhAro.atra sUchito bhavati |  \" atrArpaNAderbrahmasvarUpatvamuchyata\" 
ityanyathApratItinirAsAyAha \dash \" sarvam\" iti |  praj~nA brahma netraM netR^i 
yasya tattathoktam |  \" etaM hi\" ityanena sarvAntaryAmitvamuchyate |  
\" brahmakarma\" brahmavishhayaH samAdhiryasyAsau tathokta iti vyAkhyAnaM 
prakramaviruddhamiti bhAvenAnyathA vyAkhyAti \dash \" samAdhinA\" iti |
\" samAdhirapi brahmA\" ityarthaH || 24||

%%% ##endlabel##

%%% ##label=<segment021_pd04>##

{\Largedvng pra\.dI\. ||} uttaraprakaraNapratipAdyaM buddhyArohArthamAha \dash \" yaj~na\"
iti |  sAmAnyataH karmasvarUpamuktam |  tachcha yaj~nAdibhedabhinnam |  tatra \" nAyaM
loko.asti\" (4\.31) iti vaxyati |  tadanupapannam |  \" yatyAshramavilopaprasaN^gAt 
ityAshaN^kAnirAsArtham\" iti sheshhaH |  atra \" daivaM devavishhayam\" iti 
vyAkhyAnamasat |  \" dravyayaj~nA\" (4\.28) ityasya punaruktatvAditi bhAvenAha \dash
\" daivam\" iti |  evaM tarhi kechidbhagavantamupAsata ityuktaM syAt |  tathA cha 
neyaM yaj~noktirityata Aha \dash \" sa eva\" iti |  \" sa\" iti parAmR^ishhTaM 
darshayati \dash \" bhagavat\" iti |  \" bhagavadupAsanasya yaj~natvamiha kathaM 
labhyata\?\" ityata Aha \dash \" yaj~nam\" iti |  bhagavadityAdikaM kriyAvisheshhaNatva\-
pradarshanArthamekameva vAkyam |  sAdhanaM parityajya dhAtvarthamAtrasya 
visheshhaNaM hi kriyAvisheshhaNam |  avadhAraNArthaM darshayati \dash \" nAnyat\" 
iti |  anyadbhagavadupAsanAt |  \" anenaivashabdo bhinnakrama\" ityuktaM bhavati |  
daivamevopAsate nAnyaditi tu prakR^itAsaN^gatam |  keshhAJNchitparamahaMsAnAm |  
anyeshhAM bAhyakarmaNo.api bhAvAt |  yadvA \" keshhAJNchidityasyaiva vyAkhyAnaM yatInAm\" 
iti |  \" brahmAgnau\" ityasya \" AtmAnamAtmanaiva manasA vA brahmaNaikIbhAvayanti\" 
iti vyAkhyAnamasaditi bhAvena \" yaj~nam\" ityetadvyAchashhTe \dash \" yaj~nam\" iti |  
\" bhagavato yaj~nashabdArthatvaM  kuta\?\" ityata Aha \dash \" yaj~nena\" iti | 
yaj~nenetyasyArthamAha |  \" yaj~nena\" iti |  evashabdenApavyAkhyAnaM nirAkaroti |  
\" evaM chedyaj~namityasya kathamanvaya\?\" ityata Aha \dash \" yaj~nam\" iti |  
etadvyAkhyAnamanyatrAtidishati \dash \" iti sarvatra\" iti |  atiprasaN^ganivAraNAya 
\" sarvatra\" ityuktaM vivR^iNoti \dash \" tam\" iti |  \" evaM tarhyagrato jAtaM 
taM purushhaM yaj~naM bhagavantaM prati barhishhi prauxan\" ityarthaH syAt |  \" sa cha 
nirmUla\" ityata Aha \dash \" uktaM cha\" iti || 25\-26||

%%% ##endlabel##

%%% ##label=<segment022_pd04>##

{\Largedvng pra\.dI\. ||} \" AtmasaMyama\" ityetaddurgamArthatvAdvyAkhyAti \dash \" Atma\" 
iti Atmano manasaH |  AtmasaMyamAkhyo ya upAyaH sa evAgniH || 27||

%%% ##endlabel##

%%% ##label=<segment023_pd04>##

{\Largedvng pra\.dI\. ||} \" nanu dravyaM yaj~no na bhavati |  tatkathaM bahuvrIhiH\? 
tatpurushhatve cha kathaM purushhasAmAnAdhikaraNyam\?\" ityata Aha \dash\" dravyam\"
iti |  anena nAyaM yaj~nashabdo bhAvArthaH |  kintu kartrarthaH |  tathA cha \" dravyasya
yaj~nA yAjakA\" ityuktaM bhavati | etadAshaN^kAparihArAyaiva \" tapoyaj~nAH\"
ityetadapyevameva vyAchashhTe \dash \" tapa\" iti |  tatra parameshvare |  
\" yogayaj~nAH\" \" ityAdikamapyevameva vyAkhyeyam\" iti darshayati | \" ityAdi\"
iti |  \" tapaso homaH katham\?\" ityata Aha \dash \" idam\" iti |  
\" tapashcharaNameva tapoyaj~naH kiM na syAt\?\" ityata Aha \dash \" tadarpaNa eva\" 
iti |  \" anenaiva prakAreNa yaj~natvasampAdanam |  nAnyathA\" ityarthaH || 28||

%%% ##endlabel##

%%% ##label=<segment024_pd04>##

{\Largedvng pra\.dI\. ||} \" apAne juhvati\" ityetatpUrakarechakakumbhakaparatayA
kechidvyAchaxate |  tadasat |  adhyAhArAdiprasaN^gAt |  \" pUrakarechakayoH 
kumbhakArthatvena pR^ithakprANAyAmatvAbhAvAchcha\" iti bhAvena kumbhakamAtraparatayA 
yojayati \dash \" apara\" iti \" parAyaNA\" ityataH paraM \" prANApAnagatI 
ruddhvA\" iti drashhTavyam |  abhiprAyamAha \dash \" kumbhakasthA eva\" iti 
evashabdenApavyAkhyAnaM vyAvartayati || 29||

%%% ##endlabel##

%%% ##label=<segment025_pd04>##

{\Largedvng pra\.dI\. ||} \" apare niyata\" ityatra \" prANAnAM prANeshhu kIdR^isho homaH\? 
niyatAhAratvasya kathamatropayoga\?\" ityata Aha  \dash \" niyata\" iti | 
prANashoshhAdindriyavR^ittInAM vR^ittimatsvindriyeshhu saN^kochAt |  \" juhvati\" 
\" ityuchyata\" iti sheshhaH |  evashabdena shrotrAdInItyato bhedaM darshayati |
\" tatra pratyAhAreNAtra niyatAhAratvenaiava\" iti |  \" prANAn\" ityAdikaM 
prakArAntareNa vyAkhyAti \dash \" yachchheda\" iti |  vAk vAcham |  manasI manasi | 
yachchhet tanniyatAM dhyAyet |  avarANAmindriyadevatAnAmuttamendriyadevatAniyatatva\-
chintanaM prakArArthaH |  vA \" prANAnAM prANeshhu homa\" iti sheshhaH |  \" asmin 
paxe niyatAhArA\" iti pR^ithagyaj~no j~nAtavyaH |  idamevAstu vyAkhyAnam |  shrautatvAt |  
\" kiM pUrveNa\?\" ityata Aha \dash \" anyadapi\" iti || 30\-31||

%%% ##endlabel##

%%% ##label=<segment026_pd04>##

{\Largedvng pra\.dI\. ||} \" brahmaNo mukhe vitatAH\" ityasya vede pratipAditA iti 
vyAkhyAnamasat | \" mukhashabdavaiyarthyAt\" ityabhiprAyeNAha \dash \" brahmaNa\" 
iti |  \" paramAtmanaH sarvayaj~nabhoktR^itvaM kuto bhagavatsammatam\?\" ityata 
Aha \dash \" ahaM hi\" (9\.24) iti |  \" upAsanAdInAM karmajatvAbhAvAtkathaM 
\" karmajAn viddhi tAn sarvAn\" ityuktam\?\" ityata Aha \dash \" mAnasa\" 
iti |  atra \" vimoxyase\" iti sannantAnmuchaH karmakartari laT |  tasya 
prakR^itopayuktatayArthamAha \dash \" evam\" iti |  \" evaM j~nAtvA yadi sarvepi yaj~nAH 
karmajA\" iti jAnAsi tarhi tAni yuddhAdIni svavihitAni karmANi kR^itvaiva vimoxyase |  
saMsArAdAtmAnaM moktumichchhasi |  \" sarveshhAM karmajatvaj~nAne tavaiva moxArthaM 
yuddhAdikaM kartavyamitIchchhA bhavishhyati\" ityarthaH |  \" tatkatham\?\" ityata 
Aha \dash \" yuddham\" iti |  \" yadyevamaneke yaj~nAH tarhi kiM karmAtmakena
yuddhena\? upAsanAdinaivAhaM kR^itI syAm\" ityarjunasya hArdaM j~nAtvA bhagavatedamuktam | 
asyAyaM bhAvaH |  \" moxArthaM yadupAsaanAdikaM yuddhaM parityajya karishhyasi tadapi
karma |  tathA cha tvayA vihitAtikrama eva kR^itaH syAt |  na tu karmatyAgaH |
ata evaM jAnatastava vihitaM yuddhAdikaM na tyAjyam\" iti buddhirbhavishhyatItyarthaH |
vimoxyase iti lR^iDantatvapaxe.ayamarthaH |  \" kiM sarvayaj~nAnAM karmajatvaj~nAnamAtreNa 
moxaH\? tathA cha \" kuru karmaiva\" (4\.15) iti vidhAnaM vyartham\" ityata Aha 
\dash \" evam\" iti |  \" karmajAn viddhi\" ityanena \" kathamarjunasya 
shaN^kAyAH parihAra\?\" ityata Aha \dash \" yuddham\" iti || 32||

%%% ##endlabel##

%%% ##label=<segment027_pd04>##

{\Largedvng pra\.dI\. ||} \" sarvaM karma\" ityuktatvAt \" akhilam\" iti 
punaruktirityata Aha \dash \" akhilam\" iti |  karmasamR^iddhyarthAnyupAsanAni veda 
evochyante |  khilaM sasheshhaM na bhavatItyakhilamityarthaH |  \" j~nAne parisamApyate\" 
ityasya \" j~nAne jAte na karma kAryam\" ityanyathApratItinirAsAya tAtparyamAha \dash 
\" j~nAna\" iti |  parisamAptiH sampUrNatA saphalatA |  \" sA cha j~nAne sati\" iti  
\" sannidhAnAjj~nAnalaxaNenaiva phalena\" iti bhAvaH ||  33||

%%% ##endlabel##

%%% ##label=<segment028_pd04>##

{\Largedvng pra\.dI\. ||} \" tadviddhi\" ityuktatvAt \" idAnImarjuno na jAnAti\" iti 
pratItiM nivArayati \dash \" idAnImapi\" iti |  \" tadviddhi\" ityadhika\- 
j~nAnArthamuktamiti bhAvaH |  \" j~nAnIchettarhi \" yajj~nAtvA\" iti tasya mohaH 
kathamuchyata\?\" ityata Aha \dash \" tathA.api\" iti |  abhibhavAjj~nAnasya |  
arjunasya j~nAnitve siddhe bhavedetat |  \" tatraiva kiM pramANam\?\" ityata 
Aha \dash \" mA tu\" iti |  

\" yena bhUtAni\" ityasya \" yena mohena sarvANi bhUtAnyAtmani svasmin 
atho mayi cha draxyasi\" ityanyathApratItinirAsArthamAha \dash \" yena\" iti |  
\" AtmabhUte sarvAntaryAmiNi |  draxyasItyetatpashyasi\" iti vyAkhyAtaM 
\" idAnImapi j~nAnyeva\" iti j~nApayitum || 34\-35||

%%% ##endlabel##

%%% ##label=<segment029_pd04>##

{\Largedvng pra\.dI\. ||} \" yena\" iti \" j~nAnasyaiva nirdesha\" iti sthApayan \" api 
cha\" ityAdeH pratipAdyamAha \dash \" karaNa\" iti |  \" yeneti karaNatayA
nirdishhTam\" ityarthaH \" shreyAn\" (4\.33) ityAdyapexayA \" punaH\" 
iti || 36\-38||

%%% ##endlabel##

%%% ##label=<segment030_pd04>##

{\Largedvng pra\.dI\. ||} uttarashlokatrayasya saN^kIrNArthatvAdekoktyaiva tAtparyamuktvA 
\" tasmAt\" iti chaturthasya pratipAdyamAha \dash \" tat\" iti |  \" tasya 
j~nAnasya sAdhanamantaraN^gaM shraddhAdikam |  virodhyaj~nAnAdikam |  j~nAnasya 
phalaM parashAntyAdikam |  virodhinaH phalaM vinAshAdikam\" iti || 39\-42||

iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TIkAyAM
jayatIrthamunivirachitAyAM prameyadIpikAyAM chaturtho.adhyAyaH samAptaH || 

%%% ##endlabel##

%%% ##label=<segment001_pd05>##

{\Largedvng pra\.dI\. ||} pUrvasaN^gatatvenaitadadhyAyapratipAdhyamAha \dash \" tR^itIya\" 
iti |  \" karmayogo nAma karmANi kR^itvA teShAM brahmAtmakatvaj~nAnam\" iti 
kashchit |  tadvyAvartayituM \" eva\" shabdaH |  phalakAmanAdityAgeneshvarArpaNa\-
buddhyA varNAshramavihitAnuShThAnameva karmayogo.atra prapaJNchyate |  tasyaiva 
pUrvamuktatvAt |  nAnyaH |  tasyAprakR^itatvAt |  dvyaMshashchAyaM karmayogaH |  
\" karmAdivarjanamIshvarArpaNabuddhyA karmAnuShThAnaM cha\" iti |  tatrAdyaM \" sannyAsa\"
shabdoktam |  dvitIyamupachAreNa \" karmayoga\" shabdoktam |  tadabhiprAyeNa 
yogasannyAsayorlaxaNaM spaShTayatItyanyatroktamiti |  \" sanyAsamityAdinA 
kutroktamarjuno.anuvadati\?\" ityata Aha \dash \" yadR^ichChA\" iti |  \" karmayogam\" 
iti vadatA \" karmaNAM ityetad \" yoga\" shabdena sambadhyata\" ityuktaM bhavati |  
tathA cha \" karmaNAM sannyAsaM tyAgam\" iti vyAkhyAnamasaditi sUchitam |  
\" shaMsasi\" ityanvayaH |  chaturthAdhyAyoktasyArthasyaitadadhyAyotthAnabIjatvAt
tR^itIyAdhyAyaprapaJNchanAtmakasyApyasya chaturthAnantaryaM yuktamityanena j~nApitam |  

\" kR^iShNashabdo varNavisheShamAtravachana\" iti pratItinirAsAyAha \dash \" niyamanAdina\" 
iti |

\" nityanaimittikakAmyaniShiddharUpasarvakarmaparityAgaH sannyAsashabdArtha\" 
(shAM\.bhA\.5\.1) iti vyAkhyAnaM dUShayati \dash \" sannyAsa\" iti |  \" j~neyaH sa 
nityasannyAsI (5\.3) iti sannyAsashabdasya bhagavataivAnyathAvyAkhyAtatvAttadviruddhaM 
paravyAkhyAnam\" ityarthaH |  \" yadi sarvakarmaparityAgo na sannyAsashabdArthaH kintu 
dveShAdivarjanameva tarhi tasya yogena virodhAbhAvAt sannyAsayogayorvirodhAbhiprAyeNa 
shreyaH prashno.anupapannaH syAd\" ityata Aha \dash ayam\" iti |  atra \" shreya\" iti 
yathAsthitagItApadamanUdya \" sannyAsapadAnuguNyenAdhika\" iti vyAkhyAtam |  
\" nanvetat \" ghora\" iti choditam |  \" shreyAn\" iti parihR^itaM cha\" |  satyam |  
ata evAtra \" IShad\" ityuktam |  atastattyaktvA \" sannyAsa eva kartavye 
kiM vaiguNyamaN^gIkR^ityApi yuddhaM vidhIyata\?\" ityAshayasheShaH || 1||

%%% ##endlabel##

%%% ##label=<segment002_pd05>##

{\Largedvng pra\.dI\. ||} \" sannyAsam\" iti prashnavAkye, \" sannyAsa\" iti parihAravAkye 
cha, \" sannyAsa\", \" yoga\" shabdau yatigR^ihasthAshramaviShayAveva | 
tayoH sarvakarmatyAgatadanuShTAnarUpatvAt |  \" j~neya\" (5\.3) iti vachanaM tu na 
sannyAsashabdavyAkhyAnaparam |  kintu \" yo dveShAdivarjito gR^ihI so.api 
sannyAsI j~nAtavya\" iti stutiparameva, ityata Aha \dash \" nAyam\" iti |  \" ayam\" 
parihAravAkyasthaH |  prashnavAkyasthasya tAtparyanirNaye tathA.abhyupagatatvAt |  \" yogashcha 
na gR^ihasthAshrama\" ityapi draShTavyam |  \" kuto na\?\" iti chet, \" atra \" tayostu\" 
iti sannyAsAt karmayogasya vishiShTatvavachanAt |  tasya chAsmatpaxa eva 
sambhavAt | anyatrAsambhavAd\" iti bhAvaH |  \" kuto bhavatpaxe sambhava\?\" ityata 
Aha  \dash \" dvandva\" iti |  \" matpUjA\" \" madarpaNabuddhyA karmAnuShThAnam\" |
\" AshramArthatve kuto.asambhava\?\" ityata Aha \dash \" tAni\" iti | \" tAnyi\"
AdhAnAdIni |  \" atyarechayat\" atirichyate |  \" iti vachanAd\" iti vartate | 
\" nyasyate.asmin sarvamiti brahmaiva nyAsa\" iti kashchit |  tadasat |  
tapo.apexayottamatvAbhidhAnasyAsaN^gatatvAt |  \" upAyopeyabhAvena saN^gatiH\" iti 
chettarhi tatsiddhau lokata evottamatvasiddherabhidhAnavaiyarthyAt |  

\" gR^ihasthAshramAdyatyAshramasyottamatvamayuktam |  gR^ihasthAshramo hi 
sarvadharmopapannaH |  tatsamarthe madhyame vayasyanuShTheyo mahAphalashcha |  
yatyAshramastu niShkriyashcharame vayasi gR^ihasthakarmAnadhikR^itairandhapangvAdibhiH
anuShTheyo.alpaphalashcha\" iti kechit |  tannirAsArthamAha \dash \" sannyAsastu\" 
iti |  \" kAmyakarmarahitatvAnniShkriyAkhyo.api sadharmakaH |  na kevalaM 
sadharmakaH |  kintu na tasmAdyatyAshramAnuShTeyAdyatibhaktyApi yatphalaM prApnuyAnna 
tat sarvairgR^ihasthadharmaiH\" ityarthaH |  \" brahmacharyAdeva\" brahmacharyaM visR^ijyaiva |  
\" virajet\" virakto bhavet |  \" tadahareva pravrajet\" iti shrutisheShaH |  
karmetyAshramAntaram |  yaduktaM nAyamityAdi tadupasamharati \dash \" ata\" 
iti |  \" atra\" parihAravAkye || 2|| 

%%% ##endlabel##

%%% ##label=<segment003_pd05>##

{\Largedvng pra\.dI\. || } \" j~neya\" ityasyApavyAkhyAnaM dUShayamstattAtparyamAha \dash \" sannyAsa\" 
iti |  \" arthAntarasyApratIteH\" iti bhAvaH |  \" nanu \" yadR^ichChAlAbhasantuShTa\" 
ityAdinoktaM \" kAmAdiparityAgaM sannyAsaM karmaNAm\" ityanUdya arjunasyAyaM 
prashna ityuktam |  tatashcha \" jAnAtyevAsau sannyAsashabdArtham\" iti na 
taM prati sa vaktavyaH |  tathA cha pUrvapaxyutprexita evAsyArtha\" ityata Aha 
\dash \" sannyAsasya\" iti |  \" sannyAsaH karmayogashcha niHshreyasakarAvubhau\" 
(5\.2) iti yatsannyAsasya niHshreyasakaratvamuktaM tadupapAdayituM j~nAtamapi 
sannyAsashabdArthaM smArayatyanena |  \" dveShAdivarjanaM hi sannyAsaH |  tasya 
niHshreyasakaratvaM shrutyAdiprasiddhameveti |  ataH sannyAsashabdArthakathana eva 
tAtparyAbhAvAnnAnupapattiH\" ityarthaH |  \" j~nApakaM chAsyArthasyAsti\" ityAha 
\dash \" j~neya iti\" iti | \" j~neyaH smartavya iti hyanenoktam\" ityarthaH |  
yogasya tu niHshreyasakaratvamuttaravAkya eva setsyati || 3||

%%% ##endlabel##

%%% ##label=<segment004_pd05>##

{\Largedvng pra\.dI\. || } \" sannyAsaM gR^ihItvA yogaM tyaxyAmi ityAshayena dvayoH shreyasi 
pR^iShTe \" dvAvapi niHshreyasakarau |  tatrApi sannyAsAdyogo vishiShTaH |  ato
na yuddhaM tvayA tyAjyamiti parihAro jAtaH |  kimarthaM \" sAN^khyayogau\"
ityuchyata\?\" ityata Aha \dash \" sannyAso hi\" iti |  \" hi\" shabdo hetau |  
\" j~nAnAntaraN^gatvena\" j~nAnotpattAvatyAvashyakatvena |  \" na tasya\" ityatra 
\" viShayavairAgyAbhAve j~nAnAnutpattivachanena tata eva tadutpattiH\" iti hi 
labhyate |  evaM \" karmayogastu j~nAnavirodhitvenokto \" agnimugdha\" ityAdAu\" 
ityapi grAhyam |  \" avamo\" yogAt |  anena yogasya niHshreyasakaratvaM
apyAxiptam | 

\" nanu \" sAN^khyam\" j~nAnam |  \" yogaH\" karma |  tayoH kathamatra 
pR^ithaktvAbhAva uchyate\?  kathaM vA.anenoktAxepaparihAra\?\" ityata Aha \dash 
\" ubhayorapi\" iti |  \" na kevalaM sannyAsasya |  kintu yogasyApi iti
ubhayorapi j~nAnAntaraN^gatvAnnokto virodha\" ityarthaH |  anena \" sAN^khyayogau 
pR^ithaksAdhyasAdhanabhAvahInAviti na paNDitA manyanta\" ityevaM vyAkhyAtaM 
bhavati |  

\" nanu shrutipurANAbhyAmeva karmaNo j~nAnavirodhitvamuchyata ityuktam |  ataH 
kathamevamabhidhIyata\?\" ityata Aha \dash \" agni\" iti | \" agni\" upalaxite 
\" karmaNi mugdhaH shreyaskarametad\" iti bhrAntaH |  \" dhUmatAnto\" homadhUmena 
glAnaH |  dhUmato dhUmAditvamevA.antaHparyavasAnaM yasyeti vA |  \" svalokaM\"
svIyamAshrayam, paramAtmAnam |  \" yaj~nashAlAsanena dhUmopalaxitamArgavatAM 
vaH padavyo.asmadAshritA naivA\" tyarthaH |  \" nanvakAmyamapi nityaM naimittikaM 
cha karma pratyavAyaparihArArthameva |  na j~nAnAntaraN^gamiti vidvAmsa eva manyanta\"
ityata Aha \dash \" ye tu\" iti | \" bAlA\" avivekinaH || 4||

%%% ##endlabel##

%%% ##label=<segment005_pd05>##

{\Largedvng pra\.dI\. || } \" yogasya j~nAnasAdhanatve pramite bhavedetat |  tadeva katham\?\" 
ityata uktam \dash \" ekamapi\" iti |  \" tadanupapannam |  ubhayormadhye 
samyagekamapyAsthitaH phalaM vindati\" iti hi yojanAyAM dvayoH sAphalyamAtramuchyate |
\" ekamapi samyagAsthita ubhayoH phalaM vindata\" iti paxe tu \" dvayaM kiJNchit
phalaM pratisvatantraM sAdhanam\" ityuchyate |  \" paxadvaye.api na prakR^itopayoga\" 
ityata Aha \dash \" ekamapi\" iti |  evamanupayoge.api bhagavAneva svavAkyamabhiprAyaM
Aha |  \" sa grAhya\" ityarthaH |  \" anenApi yogasya j~nAnasAdhanatve kiM 
pramANamuktam\?\" ityato vyAchaShTe \dash \" yogibhirapi\" iti |  \" tarati 
shokamAtmavit\" (ChA\.u\.7\.1\.3) ityAdinA \" yajj~nAnaphalaM moxAkhyaM pramitaM 
tattAvadyogibhirapi prApyata\" ityuchyate \" apAma somaM\" ityAdinA |  tatra 
vichAryam |  \" kiM dvayamapi svatantraM muktisAdhanamuta samuchchitam\?  
athachaikaM sAxAt sAdhanamaparaM tatsAdhanatvena\" iti |  na prathamadvitIyau | 
\" nAnyaH panthAH\" ityAdi virodhAt |  tR^itIye.api chintyaM \" kiM kasya 
sAdhanam\?\" iti |  tatra na tAvajj~nAnaM karmasAdhanatvena moxahetuH |  \" na 
kiJNchidantarAdhAya\" ityAdivirodhAt |  ataH parisheShAd \" yogibhirapi 
j~nAnadvArA j~nAnaphalaM prApyata\" iti sidhyati |  tathA cha \" yogasya 
j~nAnasAdhanatvaM siddham\" ityarthaH |  atra \" yogibhiH\" iti vadatA 
\" yoga\" shabdo dharmiNAmupalaxako.arsha Adyajanto veti sUchitam || 5||

%%% ##endlabel##

%%% ##label=<segment006_pd05>##

{\Largedvng pra\.dI\. || } \" sannyAsastu\" ityasya saN^gatimAha \dash \" itashcha\" iti |  
\" nanu prAk sannyAsAdyogasya varatve na ko.api heturuktaH |  tatkathamevamuchyate\?\" 
maivam |  sannyAsasya yogAvaratve bAdhakaM parihR^itam |  sAdhakamidAnImuchyate |  
bAdhakAbhAvasahitameva sAdhakaM vastuno vyavasthApakam |  tasmAd \" itashcha\" 
iti yuktam |  \" pUrvaM sannyAsasya niHshreyasakaratvamuktam |  idAnIM kathaM 
duHkhahetutvamuchyate\? kiM chAnena sAdhakamuktam\?\" ityato vyAchaShTe \dash \" yoga\" 
iti |  viShNvarpaNabuddhyA karmakaraNAbhAve |  \" sannyAsamAtreNa\" iti sheShaH | 
\" Adi\" padena j~nAnaM gR^ihyate |  \" tasya\" kevalasannyAsinaH |  \" yogAbhAve 
sannyAso niShphala evetyetanna yujyate |  moxAdyabhAve tAtkAlikApamAnAdiduHkhAbhAvAdeH\-
bhAvAd\" ityata Aha \dash \" moxAd\" iti |  tatra purANasammatimAha \dash 
\" tachcha\" iti |  \" nanu moxaphalAbhAve.api dhAnyAdinaiva kR^iShyAdikaM saphalaM
ityuchyate |  tatkathamevamabhihitam\?\" ityata uktaM vivR^iNoti \dash \" yattu\" 
iti |  \" mahAphalaM sAdhayituM yogam\" ityarthaH |  \" moxAdigrahaNaM 
prakR^itApexayaiva kR^itam\" iti bhAvaH |  \" nanu sannyAsAdyogasya varatvamanena 
sAdhitam |  tatkimuttarArdhena\" ityata Aha \dash \" mahAphalashcha\" iti |  
\" mahat phalaM yasmAt sa tathoktaH |  yogAN^gatvena sannyAsasya tato.avaratvaM 
siShAdhayiShitam |  tachchAnvayavyatirekAbhyAM sidhyati |  tatra pUrvArdhena 
vyatirekamuktvA.anenAnvayamAchaShTa\" iti bhAvaH |  \" nanu yogo.apyevameva\" iti 
chetsatyam |  tathA.api charamabhAvitvena visheShaH |  \" nanvatra sannyAsavAchakaM 
na shrUyate |  tatkathamevamuchyata\?\" ityata Aha \dash \" muniH\" iti |  
\" munishabdasya kAmAdivarjanalaxaNasannyAsavachanatvaM kuta\?\" ityata Aha 
\dash \" tachcha\" iti || 6||

%%% ##endlabel##

%%% ##label=<segment007_pd05>##

{\Largedvng pra\.dI\. || } prakR^itaprameyasya samAptatvAduttarasya vaiyarthyamAshaN^kyAha \dash 
\" etadeva\" iti |  yogayuktasya sannyAsasya mahAphalatvameva |  prapaJNchanaM 
cha \" yo na dveShTi\" (5\.3) ityatroktadveShAdivarjanakAraNopanyAsena 
\" brahmAdhigachChati\" (5\.24) ityuktabrahmaj~nAnAvAntaraphalopanyAsena 
cheti j~nAtavyam |  \" sarvabhUtAtmabhUtAtmA ityanena jIvasya paramAtma\-
svarUpatvamuchyata\" (shAM\.bhA\.5\.7) ityanyathApratItinirAsAyAha \dash \" sarva\" 
iti |  \" sarvabhUtAnAmAtmabhUtaH katham\?\" ityata uktam \dash \" yachcha\" iti |  
etannirvachanamAshritya \" na svarUpatvam\" ityarthaH |  \" sa AtmabhUtaH\"
iti \" sarvabhUtAtmabhUta\" ityuktasyAnuvAdaH |  \" svasamIpam\" ityAdi 
dvitIyAtmashabdasyArthaH |  evaM jAnannatra vivaxitaH || 7||

%%% ##endlabel##

%%% ##label=<segment008_pd05>##

{\Largedvng pra\.dI\. || } \" naiva kiJNchit\" ityAdeH pratipAdyamAha \dash \" sannyAsam\" 
iti |  \" j~neya\" (5\.3) ityAdinA \" vishuddhAtmA\" (5\.7) ityAdinA cha 
spaShTIkR^itatvAt \" punaH\" iti |  spaShTanaM cha prAganuktasaN^kalpatyAgasya
abhidhAnAt || 8\-9||

%%% ##endlabel##

%%% ##label=<segment009_pd05>##

{\Largedvng pra\.dI\. || } \" nanu \" yogayukta\" ityanena yatsannyAsayogayuktasya 
karmAlepalaxaNaM phalamuktaM tadeva tasya muktasya \" brahmaNyadhAya\" iti 
kimarthaM punaruchyata\?\" ityata Aha \dash \" sannyAsa\" iti |  \" prAguktasyaiva 
niyamo.atra kriyate |  siddhe satyArambhasya niyamArthatvAd\" iti bhAvaH | 
\" yogavivaraNaM cha kiJNchidadhikam\" iti chArthaH |  \" nanu \" sannyAsastu\"
ityanenaiva sannyAsayogau militAveva phalaM sAdhayata iti niyamo.api 
labdha eva |  tatkimarthamidaM sannyAsayogayuktasya \" kurvannapi na lipyate\", 
\" lipyate na sa pApena\" iti punaH punaH phalakathanam\?\" ityata Aha 
\dash \" sAdhana\" iti |  \" sAdhananiyamasya\" iti \" tadukteH\" ityarthaH |  
\" sannyAsayogau militAveva phalasAdhanamiti niyamokterupachAratvamapi 
sambhavati lokavat |  tannivR^ittyartham\" ityarthaH || 10||

%%% ##endlabel##

%%% ##label=<segment010_pd05>##

{\Largedvng pra\.dI\. || } \" kAyenetyanenApi sannyAsayogayuktasyA.a.atmashuddhilaxaNaH pApAlepa 
uchyata\" ityata Aha \dash \" evaM cha\" iti |  \" ubhayasamuchchayarUpa eva\" 
ityarthaH |  \" anyatra tAtparyAnna punaruktiH\" iti bhAvaH  |  AchArakathanamapi 
niyamasamarthanArthamiti j~nAtavyam || 11||

%%% ##endlabel##

%%% ##label=<segment011_pd05>##

{\Largedvng pra\.dI\. || } \" tathA.api \" yukta\" ityetatpunaruktam\" ityata Aha \dash 
\" punaH\" iti |  \" yuktiH\" yogaH |  \" Adi\" padena sannyAsaH |  \" yuktAyukta\" 
ityupalaxaNam |  \" sannyAsyasannyAsi\" ityapi grAhyam |  \" prAk 
sannyAsayogau militAveva phalaM sAdhayato nAnyataraparityAgenAnyatara\" 
iti niyamaj~nApanArthaM tayoH phalamuktam |  \" idAnIM tu tAveva moxasAdhanaM 
na tu tadubhayaparityAgenAnyaditi niyamaj~nApanAya yogasannyAsavataH 
tadubhayAbhAvavatashcha muktisamsAravistAralaxaNaM phalamAha\" ityarthaH |  
\" yukta\" shabdasya sahitAdyarthanivAraNArthamAha \dash \" yukta\" iti || 12|| 

%%% ##endlabel##

%%% ##label=<segment012_pd05>##

{\Largedvng pra\.dI\. || } \" sarvakarmANi ityasya svarUpeNa sarvakarmatyAgo.artha\" 
(shAM\.bhA\.5\.13) iti pratItinivAraNAya pratipAdyamAha \dash \" punaH\" iti |  prAk 
kartR^itvAbhimAnatyAga ukta, idAnIM tu kArayitR^itvAbhimAnatyAgo.apIti spaShTanam |
\" svarUpeNa sarvakarmatyAgo.atra uchyata\" (shAM\.bhA\.5\.13) ityetannirAchaShTe 
\dash \" manasA\" iti |  \" anyathA tadvyarthaM syAd\" iti bhAvaH || 13||

%%% ##endlabel##

%%% ##label=<segment013_pd05>##

{\Largedvng pra\.dI\. || } \" nanu \" na kartR^itvam\" ityetatprAguktAnna vishiShyata\" 
ityata Aha \dash \" na cha\" iti |  \" darshanAdikaM \" kurvanneva naiva kiJNchit
karomi\" iti manyeta\" ityuktam |  \" tarhi mithyAj~nAnI prasajyeta\" ityAshaN^kA\-
nirAsAya \" parameshvarapreritaH kurvan kArayannapi vastutaH svAtantryeNa na karoti
na kArayati cha ityanenAha\" ityarthaH |  \" asya jIvaviShayatve \" prabhuH\" 
ityetanna sambhavati\" ityata Aha \dash \" prabhurhi\" iti |  anena vibhurityetat
upapAditaprAyam || 14\-15||

%%% ##endlabel##

%%% ##label=<segment014_pd05>##

{\Largedvng pra\.dI\. || } \" nanu j~nAnasyAj~nAnanAshakatvamarthaprakAshakatvaM cha prasiddhameva |
tatkimarthamuchyata\?\" ityata Aha \dash \" j~nAnameva\" iti |  \" aj~nAnenAvR^itaM
j~nAnam\" ityuktam |  \" evaM tarhi tasyAvinAsha eva syAt |  tathA cha na 
kadAchidbrahmaprakAshaH |  vinAshakAntarAN^gIkAre cha j~nAnArthayoH sannyAsayogayoH
vaiyarthyam\" ityAshaN^kya \" j~nAnamevAj~nAnasya nAshakAmato noktadoShaH |  
kintu svarUpaj~nAnamavidyayA.a.avR^itam |  vR^ittij~nAnaM tvavidyAM shithilayati
brahma prakAshayati ityetadanenAha\" ityarthaH | 

atra kechit \" yathaika evAdityo.andhakAraM nAshayati bhUmaNDalaM cha prakAshayati
tathaikameva j~nAnamaj~nAnaM nivartayati paraM cha prakAshayati\" (shAM\.bhA\.5\.16) 
iti vyAchaxate |  \" tadasad\" iti bhAvenAha \dash \" prathama\" iti | 
tR^itIyAntapadoktam |  \" dvitIyamaparoxam\" iti sheShaH |  \" anyathA
dvirj~nAnagrahaNaM vyarthaM syAd\" iti bhAvaH || 16||

%%% ##endlabel##

%%% ##label=<segment015_pd05>##

{\Largedvng pra\.dI\. || } \" tadbuddhitvAdikaM yadyapunarAvR^ittisAdhanatvenochyate tadA
aparoxaj~nAnAdeva moxa iti gataH paxaH |  atha tadbuddhayo j~nAnanirdhUtakalmaShA 
iti j~nAnasAdhanatvena\" |  tadasat |  \" j~nAnena iti paroxaj~nAnasyAparoxaj~nAna\-
sAdhanatvenoktatvAd\" ityata Aha \dash \" aparoxa\" iti |  \" satyam |  paroxa\-
j~nAnamaparoxaj~nAnasya sAdhanam |  kintu vyavahitam |  na hi shravaNamananAnantaraM
evA.aparoxaj~nAnamutpadyate |  idaM chAvyavahitasAdhanamAha\" ityarthaH || 17||

%%% ##endlabel##

%%% ##label=<segment016_pd05>##

{\Largedvng pra\.dI\. || } \" vidyAvinaya ityAdinA prakR^itAnupayuktamayuktaM cha kathaM
uchyata\?\" ityata Aha \dash \" parameshvara\" iti |  sarvatra brAhmaNAdiShu
sthitAnAm |  \" sarvatra\" guNeShu doShAbhAveShu vA |  \" sAmyam\" 
tAratamyAbhAvaH |  tadbuddhitvAdinA sahAsya samuchchayArthaH \" cha\" shabdaH |
\" parameshvaraviShayatA \" nirdoShaM hi\" ityuttaravAkyagamyA |  aparoxaj~nAna\-
sAdhanatAM cha prakaraNagamyA\" ityata \" AshayavAn\" ityuktam |  
\" paNDita\" shabdastu paroxaj~nAnavachanaH |  \" pANDityamAgamaj~nAnam\"  
iti vachanAt || 18||

%%% ##endlabel##

%%% ##label=<segment017_pd05>##

{\Largedvng pra\.dI\. || } \" nanUttaravAkye sAmyadarshanaM muktisAdhanamevochyate |  tatkathaM
uchyate.aparoxaj~nAnasAdhanamiti\? prAjj~nAnino.api janmAntarasadbhAva uktaH |  
tatkathaM \" ihaiva\" iti taddeha eva muktiruktA\?\" ityata Aha \dash \" tadeva\" 
iti |  \" stutAvadhikoktiH sambhavati\" iti bhAvaH || 19||

%%% ##endlabel##

%%% ##label=<segment018_pd05>##

{\Largedvng pra\.dI\. || } atra kashchid \" adhyAyaparisamApterj~nAninaH karmAbhAvaH
pratipAdyata\" (shAM\.bhA\.5\.19) ityAha |  aparastu \" j~nAnasvarUpaM tatsahakAri\-
sAdhanaM cha pratipAdyata\" iti |  tadubhayamasat |  \" apratIteH\" iti bhAvena
adhyAyasheShapratipAdyamAha \dash \" sannyAsa\" iti |  \" militvA\" melayitvA |
\" shaN^kAnusAreNaiva, na tu prakaraNabhedena\" ityarthaH |  punaruktiparihArArthaM
\" prapaJNchayati\" ityuktam |  \" sannyAsasyAdau grahaNena \" na prahR^iShyet\" 
iti sannyAsaprapaJNchanam\" iti sUchitam || 20||

%%% ##endlabel##

%%% ##label=<segment019_pd05>##

{\Largedvng pra\.dI\. || } \" prakR^itasya sannyAsina evAxayasukhaprAptiruchyata\" iti 
paravyAkhyAnamasaditi bhAvenAha \dash \" punaH\" iti |  \" sannyAsastu\" ityAdinA
prAguktatvAt \" punaH\" iti |  \" Adhikyam\" sannyAsAt |  \" prAgyogAbhAve
sannyAsya vaiyarthyamuktam\" |  tadasat |  \" kAmAdyupadravaxaye svarUpasukhasya
AvirbhAvAd\" ityAshaN^kAnirAkaraNAtspaShTanam |  \" naitadatra pratIyata\" ityato 
vyAchaShTe \dash \" kAma\" iti |  \" bAhyasparsheShvasaktAtmA\" iti asyArthaH |  
\" kAmarahita\" iti |  \" AtmasvarUpasyApi sukhasya na nirvisheShatvam\" iti 
j~nApanAya \" Atmani\" ityuktam |  sa eva kAmarahita eva |  tadeva 
Atmasukhameva |  \" brahmaNA yoga\" iti pratItinirAsAyAha \dash \" brahma\" 
iti |  \" kathaM anena sannyAsAdyogasyAdhikyaM spaShTIkR^itam\?\" ityato 
\" brahmayoga\" shabdArthaM vivR^iNvan tAtparyamAha \dash \" dhyAnAdi\" iti |  
\" j~nAnadvArA\" iti sheShaH |  \" axayam\" punastirobhAvarahitam |  anyathA 
sannyAsamAtreNa |  \" tirobhAvopetaM tvalpatvAdaphalameva\" ityuktameva |  
\" vyAkhyAnantare tu bahUnAM padAnAM vaiyarthyam\" iti bhAvaH || 21||

%%% ##endlabel##

%%% ##label=<segment020_pd05>##

{\Largedvng pra\.dI\. || } \" nanUttarashloke sannyAsAditritayAntargataM na kiJNchiduchyata\" 
ityata Aha \dash \" sannyAsArtham\" iti |  \" nindayati\" svArthe Nich | 
\" sannyAsArthinA\" iti vA || 22||

%%% ##endlabel##

%%% ##label=<segment021_pd05>##

{\Largedvng pra\.dI\. || } uttarashlokamapyantarbhAvayitumAha \dash \" tad\" iti | 
\" kAmabhogaparityAgaM sannyAsArtham iti vartate |  \" ihaiva sharIramoxaNAtprAg\"
iti prashansAyAmanupayuktam\" iti bhAvena tadvihAyAnyadyojayati \dash \" kAma\" iti |  
\" vegam\" manaso.anavasthAnam |  \" evaM tarhi \" ihaiva sharIramoxaNAtprAg\" iti 
kimarthamuktam\?\" ityatastadanUdya tAtparyamAha \dash \" sharIra\" iti |  \" ihaiva\" 
ityanuvAde grAhyaM \" asminneva loka\" iti |  ata evoktaM \" manuShyasharIra\" 
iti |  \" ato.atraiva tatsahanAya prayatitavyam\" ityabhiprAyasheShaH |  \" nanu 
brahmalokAdau tatsahanamatyantasushakam |  tatkathaM evamuchyata\?\" ityata 
Aha \dash \" brahma\" iti |  \" tathAchAnyonyAshraya\" iti bhAvaH |  \" anyatra\" 
iti pashvAdisharIraM vyudastamiti hR^idayam |  etenAtra vAkyabhedaH kArya 
iti sUchitam |  \" sharIravimoxaNaparyantaM na sakR^id\" iti kashchit |  
tadasat |  tathA \" satyasharIravimoxaNAd\" iti syAt |  \" ihaiva\" 
iti cha vyartham || 23||

%%% ##endlabel##

%%% ##label=<segment022_pd05>##

{\Largedvng pra\.dI\. || } \" nanu yogino brahmAdhigatiH prAguktA |  tatkiM punaruchyata\?\" 
ityata Aha \dash \" j~nAni\" iti |  \" dvitIye kathitatvAtprapaJNchayati\" 
ityuktam |  yathA yogasyAdhikyakathanaM yoganirUpaNameva |  sannyAsArthe nindAstutI
cha sannyAsanirUpaNameva |  tathA j~nAnilaxaNakathanaM cha j~nAninirUpaNamiti | 
\" ArAma\" shabdArthaM tAvadAha \dash \" ArAma\" iti |  idAnIM \" antarArAma\"
shabdalabdhArthamAha \dash \" atra tu\" iti |  \" tat\" sukham |  \" evaM tarhi 
\" antaHsukha\" ityanenaiva gathArthametad\" ityAshaN^kya sukhashabdasya 
tAvadarthabhedamAha \dash \" sukhaM tu\" iti |  \" vyaktaMAtmasukham\" iti 
sambandhaH |  \" tarhi \" antaHsukha\" iti katham\?\" ityatastallabdhArthamAha 
\dash \" atra tu\" iti |  anena \" ArAmasukhashabdArthAntargatayoH
paropadravaxayayorantarityetat sAmarthyAdvisheShaNam\" ityuktaM bhavati |  \" jyotiH\"
shabdArthaM tAvadAha \dash \" svayam\" iti |  \" jyotiShTvam\" iti sheShaH |  
\" yadyapi jyotiH shabdaH prakAshamAtre pravartate |  tathA.api bhagavata eva 
parAnapexyaprakAshatvAnmukhye na sampratyayAt sa eva jyotiH\" ityarthaH | 
idAnIM \" antaHjyotiH\" shabdArthamAha \dash \" tadvyakteH\" iti |  \" tasya
bhagavato.antarhR^idaye vyakteH\" ityarthaH |  \" nanvantarjyotiryasyAsau 
\" antarjyotiH\" |  \" vyakteH\" iti tu kathaM labhyata\?\" ityata Aha \dash 
\" sarveShAm\" iti |  \" shabdataH prAptamantarjyotiShTvaM sarvasAdhAraNam |  
atra tu j~nAnivisheShaNatvenochyate |  tatsAmarthyAdidaM labdham\" iti bhAvaH |
yadvA \" tadvyakteH\" ityadhyAhAreNa tAtparyamuktam |  adhyAhArasyedAnIM prayojanaM
uchayte |  \" nanu \" eva\" shabdo yadi dharmAntaranivR^ittyarthaH tadA \" antaHsukham\"
ityAdi vyAhatam |  atha vastvantaradarshananivR^ittyarthaH tadA.asambhavitvam\" 
ityata Aha \dash \" asampraj~nAta\" iti |  \" bAhyam\" bhagavato.anyat |
\" darshane.apyanyad\" iti sheShaH |  \" akiJNchitkarAdvixepakaraNAbhAvAd\" 
ityarthaH |  \" evashabdaH sambhavadartha\" iti sheShaH |  etena \" laxyamevedaM 
kathaM laxaNatvenochyata\?\" iti parihR^itam |  vyavachChedapradhAnatvAt |  
\" evashabdasya sAmarthyAjjyotiShA sambandha\" iti |  \" ArAmasukhashabdayoH
uktArthatvaM kuta\?\" ityata Aha \dash \" uktaM cha\" iti |  \" na kevalaM
punaruktibalAd\" iti chArthaH |  dvandvaikatvAdekavachanam |  \" kAma\" iti
upadravopalaxaNam |  \" uditam\" vyaktam |  antarjyotirityasyoktArthatve
pramANamAha \dash \" sva\" iti |  \" sa sthito yasmin\" iti \" tatsthitaH\" |
\" antareva jyotirdarshanaM yasya\" (shAM\.bhA\.5\.24) ityevaM vyAkhyAne.api
yadyapyuktArtho labhyate, tathApi \" ArthikAchChAdbaM varam\" ityevaM vyAkhyAtam |
\" brahmaiva bhUta\" (shAM\.bhA\.5\.24) ityanyathApratItinirAsAya \" brahmabhUta\"\-
shabdasya vigrahaM darshayan prakR^itasaN^gatimAha \dash \" antaH\" iti | 
\" brahmaNi bhUta\" ityevaM vigraho na tu \" brahmaiva bhUta\" iti |  pramANa\-
virodhAt |  \" nanu brahmaNi bhUtatvaM sAdhakadharmaH |  tatkathaM j~nAnilaxaNatvena
uchyate\?\" maivam |  yato.antaHsukhatvAdeH kAraNatvenochyate |  \" nanvevaM
satyarthAdidaM j~nAnasAdhanatvenochyate |  tachcha \" tadbuddhaya\" ityanenaivoktam\" |
\" satyam |  tadbuddhitvAdikaM brahmaNi bhUtatvaM yasya kAraNaM tadvAnevaMlaxaNaka
ityevaM saN^gatisUchanArtho.ayamanuvAda\" iti bhAvaH |  evaM cha \" adhigachChati\" 
ityasya \" jAnAti\" ityartho j~nAtavyaH || 24||

%%% ##endlabel##

%%% ##label=<segment023_pd05>##

{\Largedvng pra\.dI\. || } \" uttarashloke j~nAnino brahmaprAptiH punaH kimarthamuchyata\?\" 
ityata Aha \dash \" pApa\" iti |  brahmabhUtatvena sahAsya samuchchayArthaH 
\" cha\" shabdaH |  \" etad\" uktalaxaNaM j~nAnam |  ato \" labhanta\" 
ityasya \" upalabhanta\" ityarthaH |  \" kathaM tarhi j~nAnilaxaNaprapaJNchArthatvaM
shlokatrayasyoktamiti\?\" uchyate \dash \" j~nAnapratibandhakapApaxayAkhyamasAdhAraNaM
kAraNaM kAryasya laxaNaM bhavatyeva\" iti |  \" atra kAryakAraNabhAvo na 
pratIyata\" ityata Aha \dash \" xINa\" iti |  \" bhavanti tato brahmopalabhanta\" 
ityarthaH |  \" Chinnadvaidha\" shabdArthaM j~nApayan \" dvaidha\" shabdaM vyAchaShTe \dash 
\" dvaidha\" iti |  \" viShayApexayA.anyaprakAratvamayathArthatvamiti yAvat |  
tena cha tajj~nAnamupalaxyata\" iti bhAvenAha \dash \" samshaya\" iti |  
\" vA\" shabdaH \" cha\" arthe |  atraiva pramANamAha \dash \" tachcha\" iti |  
\" akR^itAtmanAm\" ashuddhabuddhInAm |  \" Chinna\" ityAdeH
samAsatvamabhipretya vigrahamAha \dash \" Chinna\" iti |  \" Ayata\" shabdasya,
\" Atma\" shabdasyAnekarthAtvAt \" AyatAtmAnaH\" ityetadvyAchaShTe \dash 
\" dIrgha\" iti |  \" aNuno manasaH kathaM dIrghatvam\?\" ityata Aha 
\dash \" sarvaj~nA\" iti |  \" bahuviShayatvamupalaxyata\" iti bhAvaH |  
\" shravaNAdinA viditavedyA ityarthaH |  samAsenoktayorapyarthayorbuddhyA 
viviktayorhetuhetumadbhAvo.asti\" iti bhAvenAha \dash \" tata eva\" iti |  
AyatAtmAtvAdeva |  xINakalmaShatvAyatAtmatvaChinnadvaidhatvAnAM 
hetuhetumadbhAve pramANamAha \dash \" tachcha\" iti |  \" vyaste vA ete 
pade\" ityAha \dash \" Chinna\" iti |   \" niyatamanasa\" ityarthaH || 25||

%%% ##endlabel##

%%% ##label=<segment024_pd05>##

{\Largedvng pra\.dI\. || } \" yatInAM sarvaM brahmatayaiva pratIyata\" (shAM\.bhA\.5\.26)
ityanyathApratItinirAsAyAha \dash \" sulabhaM cha\" iti |  \" na kevalamuktalaxaNA\" 
iti chArthaH |  \" idaM cha sAdhAraNadharmatvAjj~nAnilaxaNaM bhavatyeva |  saulabhya\-
vAchi kimapyatra na pratIyata\" ityatastadupAdAya vyAchaShTe \dash \" abhita\" 
iti |  \" sarvadeshakAleShu\" ityarthaH || 26||

%%% ##endlabel##

%%% ##label=<segment025_pd05>##

{\Largedvng pra\.dI\. || } \" dhyAyinAM muktatvaM sAxAchchetpramANavirodhaH |  j~nAnadvArA
chetpunaruktiH\" ityataH shlokadvayatAtparyamAha \dash \" dhyAna\" iti |  \" mukta 
eva saH iti stutiH\" iti bhAvaH |  padAnAM vyavahitatvAdanvayamAha \dash 
\" bAhyAn\" iti |  \" spR^ishyanta\" iti \" sparshA\" shabdAdyAH |  \" sparshA 
bAhyA eva |  teShAM kiM bahiShkaraNam\?\" ityata Aha \dash \" shrotrAdIni\" 
iti |  \" yogena\" pratyAhAreNa shrotrAdInAmaniyame paTvabhyAsAd\-
arapratyayavashAchChabdAdyA antarA iva bhavanti |  tanniyame tu bAhyAH bahiShkR^itAH 
syuH iti bhAvaH |  \" kR^itvA\" ityasyAnuvR^ittyA yojayati \dash \" chaxuH\" 
iti |  \" durghaTametad\" ityata Aha \dash \" bhruvoH\" iti |  \" chaxurvR^ittau 
\" chaxuH\" shabda\" ityarthaH |  \" samprexya nAsikAgraM svaM iti vaxyamANavirodha\" 
ityata Aha \dash \" uktaM cha\" iti |  \" nyUnAdhikabhAvarAhityaM samIkaraNam\" 
(shAM\.bhA\.5\.27, rA\.bhA\.5\.27) ityanyathApratItinirAsAyA.anUdya vyAchaShTe \dash 
\" prANa\" iti |  \" kumbhake prANAyAme tatashcha samau nirvikArau nishchalau\" 
ityarthaH |  \" itaratsamIkaraNaM kumbhakArthameva\" iti bhAvaH || 27\-28||

%%% ##endlabel##

%%% ##label=<segment026_pd05>##

{\Largedvng pra\.dI\. || } \" bhagavajj~nAnasya shAntisAdhanatvaM punaH kimarthamuchyata\?\" 
ityata Aha \dash \" dhyeyam\" iti |  tatashcha \" j~nAtvA\" ityasya \" dhyAtvA\" 
ityarthaH |  \" shAntisAdhanaj~nAnatvamapi bhoktR^itvAdivat dhyeyavisheShaNameva\" 
iti bhAvaH || 29||

%%% ##endlabel##

%%% ##label=<segment027_pd05>##

iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TIkAyAM
jayatIrthamunivirachitAyAM prameyadIpikAyAM paJNchamo.adhyAyaH samAptaH || 

%%% ##endlabel##

%%% ##label=<segment001_pd06>##

{\Largedvng pra\.dI\. || } saN^gatiM sUchayan etadadhyAyapratipAdyamarthamAha \dash \" j~nAna\-
antaraN^gam\" iti |  \" yoge tvimAM shR^iNu (2\.39) iti pratij~nAya dvitIyaShaTke
vaxyamANaM bhagavajj~nAnaM prati karmayogasya bahiraN^gatvAt sa prAdhAnyenAtIte granthe
pratipAditaH |  tatsAdhyatvAjj~nAnAntaraN^gatvAchchAvasaraprAptaM samAdhiyogamAhAnena
ShaShThAdhyAyena\" ityarthaH |  AsanAdInAmaN^gAnAM vaxyamANatve.api teShAM samAdhyarthatvAt
prAdhAnyena samAdhiyogasya grahaNam |  paJNchamAntoktasya \" prapaJNcho.ayam\" 
ityadoShaH | 

\" gR^ihasthasyApi stutyarthamupacharitaM sannyAsitvaM yogitvaM chA.adyena shlokenochyata\" 
(shAM\.bhA\.6\.1) iti parakIyatAtparyakathanamasaditi bhAvenAha \dash \" vivaxitam\" 
iti |  \" samAdhiyogaM vidhAtuM tatrAdhikAriNaM j~nApayiShyan 
sAN^khyAdyabhimatatadadhikArinirAsAya tadvisheShaNaM prAgvivaxitaM 
karmAdivarjanalaxaNaM sannyAsamIshvarArAdhanasvakarmAnuShThAnalaxaNena yogena 
sahA.aha\" ityarthaH |  \" yadi hi sanyAso yatyAshramo.atra vivaxitaH syAdyogashcha
kashchidgR^ihasthAsambhavIsyAt, tadopachAreNa tatstutiriyam |  na chaivam\" iti 
bhAvaH |

\" na kevalaM niragnirakriyashchaturthAshramisannyAsi yogI cha kintvanAshrita ityAdyukto
gR^ihastho.api\" iti parakIyAM yojanAM nirAkaroti \dash \" chaturtha\" iti |  atraiva 
spaShTaM vAkyAntaraM paThati \dash \" agniH\" iti |  chastvarthaH |  \" ato na 
parakIyA yojanA yuktA\" iti sheShaH |  \" tarhi katham\?\" ityata Aha \dash \" tasmAd\" 
iti |  parakR^itayojanAyAH nirastatvAt |  \" nanu niragnerakriyasya chaturthAshramiNo.api
sannyAsitvAdyogitvAchcha kathaM na niragnirityAdyuktam\?\" ityato vA.aha \dash \" chaturtha\-
AshramiNo.api\" ityAdi |  \" na bhavatyeveti yuktam\" iti sheShaH |  \" anagnitvAdi\-
pravAdashcha bAhyAgnyAdyabhAvanibandhana\" iti bhAvaH || 1||

%%% ##endlabel##

%%% ##label=<segment002_pd06>##

{\Largedvng pra\.dI\. || } \" nanu sannyAsayogau bhinnalaxaNau |  tatkathaM tayoraikyamuchyata\?\" 
ityata Aha \dash \" sannyAso.api\" iti |  \" sannyAsI cha yogI cha\" ityuktyA
\" prAptAtyantabhedashaN^kAnivR^ittyartham\" iti sheShaH |  \" amukhyayogApexayA
pR^ithagukto.api\" ityaperarthaH |  yogashabdena mukhyo.atrAbhihitaH |  ata eva
vaxyati \" upAyavAn\" iti |  \" antarbhUtatvAdaikyoktirityarthaH |  sannyAsasya 
yogAntarbhUtatvamupapAdyate \" na hi\" iti\" |  tadasat |  \" saN^kalpatyAgamAtrasya
asannyAsatvAt, IshvarArAdhanAya svakarmakaraNamAtraM yogaH, tasya sannyAsAbhAve.api\-
upapatteH\" ityata Aha \dash \" kAma\" iti |  \" saN^kalpashabdasya kAmAdyupa\-
laxaNatvAdyogashabdasya j~nAnopAyarUpamukhyayogArthatvAnnAnupapattiH\" iti bhAvaH || 2||

%%% ##endlabel##

%%% ##label=<segment003_pd06>##

{\Largedvng pra\.dI\. || } \" nanvevaM samAdhiyogasyAdhikAriNi nirUpite taM prati samAdhirabhidheyaH | 
\" Aruruxo\" ityAdi kimarthamuchyata\?\" ityata Aha \dash \" kiyad\" iti |  
\" samAdhiyogAdhikAratvenoktaM karma kiM sakR^idanuShTheyam |  utA.aphalaprApteH\" 
iti prashnArthaH |  \" nanu yogo nAma nAshvAdivAroDhavyaH |  tatkathamuchyate 
\" yogamAruruxoH\" yogamArUDhasya iti\?\" tatrA.aha \dash \" yogam\" iti |  
\" uparibhavanasAdR^ishyAdupachAra\" ityarthaH |  \" upAyaH\" samAdhireva |  
\" samAdheH phalaparimANAdi avachChedAbhAvAt kIdR^ishI sampUrNatA\?\" ityata 
Aha \dash \" aparoxa\" iti |  sAdhanasya hi pUrNatA sAdhyAya paryAptatvam |  
\" ato yAvatA.aparoxaj~nAnaM sampadyate tAvattvaM sampUrNattvam\" iti bhAvaH |  
\" nanu yogamAruruxoH karma kAraNam |  sannidhAnAdyogArohasyeti labhyate |  
kAraNatvAchcha tatparyantaM kartavyamiti |  kAryApexayA niyatapUrvibhAvitvAt 
kAraNasya |  yogArUDhasya tu shamaH kiM prati kAraNam\? j~nAnasya tata eva 
siddheH\"  ityata Aha \dash \" kAraNam\" iti |  \" paramasukham\" muktigatam |  

\" nanvayaM prashno \" yadA te mohakalilaM\" (2\.52) iti parihR^itaH\" |  maivam |
tatra j~nAnArthino.atra tu yogArohArthina iti bhedAt |  tayoshcha sAdhyasAdhanayoH 
pR^ithaktvAt |  \" aparoxaj~nAnina\" iti chAnativiprakarSheNoktatvAt |  tathoktaM 
aihikamaprastutapratibandha iti |  athavA \" yogArUDhasyApi kartavyaM vaktuM 
prashnottarAnuvAdo.ayam\" iti |

\" nanvaparoxaj~nAnino.anAdheyAtishayasya kathaM shamaH paramasukhakAraNamuchyata\?\" 
ityata Aha \dash \" aparoxa\" iti |  uktaM samarthitaM dvitIye |  \" samAdhyAdi\" 
ityanena \" shamashabdArthaH samAdhiH\" iti sUchitam |  \" tatkiM tasyAnyat 
kartavyameva nAsti\?\" ityata Aha \dash \" tasya\" iti |  \" sarvopashamena\" 
sarvaviShayoparatilaxaNeneti samAdhau shamashabdaM samarthayitumuktam |  
\" kAraNam\" sukhAbhivR^iddheH |  \" tadavirodhenAnyat kAryam\" iti bhAvaH |  
\" yadi j~nAninaH samAdhiH AnandavR^iddheH kAraNaM tarhi tameva kuto na kuryuH\? 
kutashcha vyAkhyAnAdau pravartanta\?\" ityata Aha \dash \" tathA.api\" iti |  
\" bhoktavyoparamaH\" pratibandhakaprArabdhakarmoparamaH |  anyadA samyak 
samAdhipratibandhakakarmAnuparamakAle |  atrA.agamasammatimAha \dash \" tachcha\" 
iti |  \" param\" kevalam |  \" teShAmeva samyageva samAdhishcha jAyata\" 
iti yojanA |  \" vartayanti\" \" vartante kAlaM nayanti\" iti vA || 3||

%%% ##endlabel##

%%% ##label=<segment004_pd06>##

{\Largedvng pra\.dI\. || } sphuTamapi tAtparyaM mandAnujighR^ixayA.a.aha \dash \" yoga\" iti |
aparoxaj~nAnaM tu yogArohasya kAryaM sati pratibandhe vilambata iti na laxaNam |
\" nanvidaM sAdhake.api vidyate |  \" vashe hi yasyendriyANi\" (2\.61) ityAdeH |  
ato ativyApakaM\" ityata Aha \dash \" samyag\" iti |  \" prayatnaM vinA\" 
ityarthaH |  \" tasyaiva\" yogArUDhasyaiva |  atra pramANamAha \dash \" uktaM cha\" iti | 
\" paramAtmAnaM dR^iShTvA tvApyata\" iti sheShaH |  \" mukhya eva chAnanuShaN^go.atra
vivaxita\" iti bhAvaH || 4||

%%% ##endlabel##

%%% ##label=<segment005_pd06>##

{\Largedvng pra\.dI\. || } \" nanveyaM vidhyupayuktamuktvA samAdhiyoge vidheye kimarthamAtmoddhAra\-
kartavyatochyata\?\" ityato \" anayA vAchobhaN^gayA yoga eva vidhIyata\" ityAha
\dash \" sa cha\" iti |  \" yasyAdhikAryAdikamuktaM sa eva cha yoga\" iti vaktavye
\" yadArohagrahaNaM kR^itaM tat tAvatparyantaM yogaH kartavyaH |  na madhya eva tyAjya\"
iti j~nApanArtham |  \" prayatnena\" abhiyogena || 5||

%%% ##endlabel##

%%% ##label=<segment006_pd06>##

{\Largedvng pra\.dI\. || } \" Atmaiva hi ityuktamevottarashloke kimiti kathyata\?\" iti 
mandAshaN^kAnirAsArthamAha \dash \" kasya\" iti |  \" kiM visheShaNashcha\" ityapi 
grAhyam |  tasyaiva tameva prati bandhutvaM riputvaM cha viruddham |  tadvisheShaNabhedena
vyavasthApyam |  \" tathA cha kiM visheShaNasyAtmanaH kiM visheShaNo vA.atmA bandhU
ripushcha\" ityarthaH |  \" iti pR^ichChAyAm\" iti sheShaH |  \" AtmA\" \" AtmanaH\" 
iti padadvayaM \" Atma\" shabdasyAnekArthadvyAchaShTe \dash \" AtmA\" iti | 
\" nanvAdyashloke svaparyAya evAtmashabdaH prakR^itaH |  tadupapAdakadvitIye kathaM
anyo.artha\?\" ityata Aha \dash \" AtmanA\" iti |  anayaiva rItyA.adyashlokottarArdha\-
gatAtmashabdavyAkhyAnaM draShTavyam |  \" yenAtmaivAtmanA jitaH\" ityatrAtmashabdau
vyAchaShTe \dash \" Atmaiva\" iti |  \" eva\" shabdopAdAnam vyAkhyeyavivekArtham |
\" jIvenaiva\" ityavadhAraNaM prAdhAnyaj~nApanArtham |  yadA.a.atmashabdo jIve 
tadA kartari tR^itIyA |  \" yadA buddhau tadA karaNa\" iti j~nApayannupapAdayati 
\dash \" sa hi\" iti |  \" vijayati\" \" vijayate mana\" iti sheShaH |  
\" svenaiva\" (shAM\.bhA\.6\.6) ityAdivyAkhyAnanirAsArthamukte.arthe pramANAnyAha
\dash \" uktaM cha\" iti |  \" anAtmana\" iti naJNsamAso bahuvrIhirvAsyAt |
nAdyaH |  AtmanaH AtmA.anyatvAnupapatteH |  AtmAntarAdanyatvasya 
cha prakR^ite.anupayogAt |  na dvitIyaH |  \" Atmashabdasya jIvavAchitve 
vA manovAchitve vA samsAriNI tadabhAvasya asambhavAd\" ityata Aha 
\dash \" anAtmana\" iti |  bahuvrIhiparigrahasUchanAya \" puruShasya\" ityanyapadArtho 
darshitaH |  anAtmashabdArthaM darshayitumAha \dash \" ajita\" iti |  \" nanu 
avidyamAna AtmA yasyAsAvanAtmA |  tatkathamuchyate \" ajitAtmana\" iti\?\" 
tatrAha \dash \" sadapi\" iti |  \" vidyamAnamapi mano ajitamanupakAri\" iti 
avidyamAnasAdR^ishyAt avidyamAnatAmupacharya \" ajitAtmA anAtmokta\" ityarthaH |  
\" gauNaprayoge kiM prayojanam\?\" iti chenna, \" rUDhopachAre prayojanAnapexaNAd\"
iti bhAvenAha \dash \" sannapi\" iti |  \" bhR^ityapade\" sevAdau |  padAnAM 
vyavahitatvAt \" anAtma\" ityardhaM vyAchaShTe \dash \" tasya\" iti |  \" tasya\" 
ajitamanaskasya |  \" bandhureva\" iti \" eva\" arthaH |  \" shatruvat\" 
prasiddhashatruriva |  \" shatrutve\" apakAritve || 6||

%%% ##endlabel##

%%% ##label=<segment007_pd06>##

{\Largedvng pra\.dI\. || } \" yogo vihitaH |  tatkiM \" jitAtmanaH\" ityanena\?\" ityata 
Aha \dash \" jitAtmana\" iti |  \" upakArI bandhuruchyate |  tatra jitaM manaH 
kamupakAraM karoti\? yena bandhuH syAt |  \" AtmoddhAraM karoti\" iti chet |  sa 
eva cha ka ityAshaN^kya\" iti sheShaH |  \" jitAtmanaH phale vaktavye \" prashAntasya\" 
ityanuvAdaH kimartham\?\" ityata Aha \dash \" jitAtmA hi\" iti |  \" vAkya\-
bhedenedameva phalakathanam\" iti bhAvaH |  \" nanu jitAtmatvameva prashAntatvam |
tatkathaM tatphalaM syAd\?\" ityata Aha \dash \" na\" iti |  \" tasya jitAtmanaH
svata eva\" iti sheShaH |  \" tarhi nirAkAN^xatvAduttaraM vAkyaM vyartham\"
ityataH paramaphalaM darshayituM taditi bhAvena nyUnamadhyAhAreNa pUrayan vyAchaShTe
\dash \" tadA cha\" iti |  \" prashAntatve sati paramAtmA sarveShAM hR^idi sannihita
eva |  tatkutaH prashAntasya visheSha\?\" ityataH samyakpadasUchitArthaM vivR^iNoti
\dash \" aparoxa\" iti |  \" yogArUDha\" ityarthaH |  \" yadA hi\" iti
yogArUDhasya laxaNamuktam |  \" tatkimarthaM punaruchyata\?\" ityata Aha \dash 
\" aparoxa\" iti |  sArdhashlokadvayagrahaNAya \" Adi\" padam |  atra
saptamyA anvayo na dR^ishyate |  ata Aha \dash \" shIta\" iti | 

atra bhAskaro.anvayamapashyan \" paramAtmA samAhita\" iti sampradAyagataM pAThaM
visR^ijya \" paramAtmasamA matiH\" iti pAThAntaraM prakalpya \" samA matiH\" iti 
tvAvR^ittyA saptamyA anvayamuktvA pUrvapAThe.anvayAbhAva ityavAdIt |  tadanena
apahastitaM bhavati |  kR^itrime.api pAThe suhR^ityAdikaM AtmaupamyenetyAdikaM 
cha punaruktaM syAt | 

\" nanu yaH shItoShNAdiShu kUTasthaH tasya j~nAnavij~nAnatR^iptamanastvaM vijitendriyatvaM
chArthAt siddhameva |  tatkimarthaM punaruchyata\?\" ityata Aha \dash \" j~nAna\" iti |  
pratyekamanvayAdekavachanam |  \" nanu shilpAdiviShayA buddhirvij~nAnam |  \" moxe
dhIrj~nAnamanyatra vij~nAnaM shilpashAstrayoH\" ityabhidhAnAt |  tatkathaM vij~nAnena
tR^iptAtmA.ayaM syAd\?\" ityata Aha \dash \" vij~nAnam\" iti |  anena sAmAnyaj~nAnaM
paroxaj~nAnaM vA \" j~nAnam\" iti sUchitam |  \" kuta etad\?\" ityata Aha \dash 
\" tachcha\" iti |  \" prasiddhAbhidhAnArtho.apyaN^gIkriyata\" iti \" cha\" shabdaH |
\" sAmAnyaiH\" sAdhAraNaiH puruShaiH |  \" sAmAnyaviShayaM tu j~nAnam\" ityapi
draShTavyam |  \" tadeva j~nAnam\" iti sambandhaH |  \" aN^gAdeH\" vyAkaraNAdeH |
shilpasya cha vishiShTaM darshanaM vaiShNavashAstram |  \" kUTasthashabdo 
nityAdiparyAyaH |  tena kathamanvayaH saptamyA\?\" ityata Aha \dash \" kUTastha\" 
iti |  \" tatkatham\?\" ityata Aha \dash \" kUTavad\" iti |  \" supistha iti 
vachanAt kUTashabdo.anR^itavAdyAdivAchI |  tatparigrahe nirvikAratvaM na labyata\"
ityata Aha \dash \" kUTam\" iti |  \" etaiH shabdairAkAsha uchyata\" ityarthaH |
\" yukto, yogI iti punaruktiH\" iti mandAshaN^kAnirAsArthamAha \dash \" yogi\" 
iti |  inerastyarthvAt \" kurvan\" ityuktam |  niShThAyA bhUtArthatvAt \" sampUrNa\" 
iti |  \" vaxyamANAnvayApexayA kramollaN^ghanam |  tarhi viruddhArthayoH kathaM
sAmAnAdhikaraNyam\?\" ityata Aha \dash \" evambhUta\" iti |  dhAtusambandhe 
pratyayA iti hyuktam || 7\-8||

%%% ##endlabel##

%%% ##label=<segment008_pd06>##

{\Largedvng pra\.dI\. || } \" madhye laxyasyoktatvAt \" suhR^it\" ityAdikaM na yogArUDhalaxaNam\" 
(shAM\.bhA\.6\.9) iti pratItinirAsAyAha \dash \" sa eva\" iti |  \" sAdhupApAdiShu
samabuddhishcha sa yogArUDha eva (shAM\.bhA\.6\.9) iti na, kintu sarvasmAdayogivargAd
vishiShyata ityetadvaktuM pR^ithaganvaya\" iti bhAvaH |  \" sAdhutvam\" dharmitvam |
\" pApatvaM pApavattvaM cha niyataM, na tu suhR^ittvAdivadavyavasthitam\" ityataH
\" suhR^idAdiShu\" ityanuktvA \" sAdhupApAdiShu\" ityuktam |  \" samabuddhitvaM nAma 
pUjAdisAmyam\" ityanyathApratItinirAsAyAha \dash \" jIvachita\" iti |  \" eSha 
chetanayA yukto jIva ityabhidhIyata\" iti chetanAchetanapiNDe jIvashabdaprayogAt
\" chita\" ityuktam |  \" suhR^idAdichaitanyasya tathA sarvatra suhR^idAdiShu sthitasya
paramAtmanaH |  evaM sarvatra suhR^idAdiShu sthitasya suhR^ittvAdeH paramAtmanimittakatvasya
chaikarUpyeNa kAraNena taddarshI samabuddhiH\" ityarthaH |  tatrA.adyaM prakAraM vivR^iNoti 
\dash \" chidrUpa eva\" iti |  \" manuShyeShu yadekaM ekaM prati suhR^idityAdi 
tanna jIvasvabhAvAntargatam |  kintu chidrUpatvAdikameva\" ityarthaH |  \" tarhi 
suhR^ittvAdidharmaH kimAtmaka\?\" ityata Aha \dash \" visheShastu\" iti |  
antaHkaraNopAdAnako bAhyadharmaH |  etaduktaM bhavati \dash \" muktAvavashiShyamANaM 
yajjIvarUpaM tat \" trividhA jIvasanghAH\" \footnote{\normaldvng mahAbhAratatAtparyanirNayodAhR^itAni bhaviShyatparvavachanAni mahA\.bhA\.tA\.ni 1\.99} ityAdipramANaviShayameva |  kintu 
dehendriyAntaHkaraNadharmaiH yadvaiShamyaM tattatsvarUpa evAropya viShamabuddhitvaM
yogArUDhasya nAsti\" iti |  dvitIyaH prakAraH sphuTaH |  tR^itIyaM vivR^iNoti \dash 
\" sarveShAm\" iti |  \" svataH\" svAtantryeNa |  atra pramANamAha \dash 
\" uktaM cha\" iti |  \" svataH\" svarUpeNa |  doShairaritvAdibhiH |  evaM
suhR^ittvAdiguNairityapi grAhyam |  \" AgantukadharmA na svarUpAntargatA\" ityarthaH |
\" kiM tarhi\?\" ityata Aha \dash \" teShAM tu\" iti |  doShAH guNAshcha
upAdhirantaHkaraNAdiH sarva suhR^ittvAdikam |  ata eva prakAradvayena yadanAtmadharmA\-
nAtmasvantarbhAvya vaiShamyaM yachcha kvachit parameshvarAnadhInarUpatvaM tadbhrAnti\-
pratItam |  \" yoge pravartamAnaM prati yatsuhR^ittvAdikaM tanmanuShyeShveva svarUpa\-
vaiShamyakAraNaM na bhavati |  na tu devAdiShu\" ityuktasyApavAdamAha \dash \" evaM\" 
iti |  \" tu\" shabdo.avadhAraNe |  avadhAraNArthaM vivR^iNoti \dash \" visheSha\" 
iti |  visheSho yoginaM prati suhR^ittvAdiH |  tadeva prapaJNchayati \dash \" asurAdeH\" 
iti |  \" tathA\" shabdo vaxyamANasamuchchaye |  doShA yoginaM pratyaritvAdyAH |
tathA choktaM \dash \" viddhyenamiha vairiNam\" (3\.37) iti |  guNadoSho suhR^ittvAritvAdI
anAgantukau |  guNaiH suhR^ittvAdibhirekamAtraM guNaikamAtram |  tathA cha shrutiH
\dash \" yathA ha vai bahavaH pashavaH\" (bR^i\.u\. 1\.4\.10) ityAdikA |

%%% ##endlabel##

%%% ##label=<segment009_pd06>##

{\Largedvng pra\.dI\. || } \" suhR^it ityAdishlokasya pratItArtha evArthaH kiM na syAd\?\" 
ityata Aha \dash \" na tu\" iti |  sarvashabdaparyAyasya samashabdasyaiva sarvanAmasaJNj~nA |
na sAdhAraNArthasya \" same deshe yajati\" iti yathA |  \" na kevalaM samapUjAyAM
doShaH |  kintu viShamapUjAvidhAnaM chAsti\" ityAha \dash \" vittam\" iti | 
\" bandhuH\" iti bandhutvaM mAnyAni cha tAni sthAnAni cha |  vittAdishabdaiH 
taddhanta upalaxyante |  dR^iShTirevoktaprakAratrayeNa samA kAryA, pUjA tu 
viShamaivetyatra pramANAntaramAha \dash \" guNa\" iti |  yA viShamA pUjA sA 
\" vaiShamyam\" |  tasyaiva vyAkhyAnaM \" uttamattvam\" |  sAmyaM \" dadAti\" |  
viduHkhatvaM animittam |  samabuddhitvaM prakArAntareNa vyAchaShTe \dash 
\" suhR^idAdiShu\" iti |  etanna yogArUDhaviShayamiti tatraiva noktam |  na 
hi yogArUDho laukikeShu airShvapakAraM karoti |  karoti yaH |

%%% ##endlabel##

%%% ##label=<segment010_pd06>##

{\Largedvng pra\.dI\. || } suhR^inmitrashabdayoH, aridveShyashabdayoH, udAsInamadhyasthashabdayoshcha
arthabhedo na pratIyate |  ata Aha \dash \" pratyupakAra\" iti |  \" nirapexayA\" 
anapexayA |  \" avAsitam\" apriyam |  tataH upakriyamANAt || 9||

%%% ##endlabel##

%%% ##label=<segment011_pd06>##

{\Largedvng pra\.dI\. || } \" nanu \" uddharet\" ityanenaiva yogo vihitaH |  tatkiM
punarvidhIyata\?\" ityata Aha \dash \" samAdhi\" iti |  \" prakArakathanAya 
vidhyanuvAda\" ityarthaH |  \" yuJNjIta iti yogamAtramuchyate |  tatkathaM
samAdhItyuktam\?\" ityata Aha \dash \" yuJNjIta\" iti |  \" sAmAnyashabdo.api
prakaraNAdvisheShe.avatiShThata\" ityarthaH |  AtmashabdasyAtra vivaxitamarthamAha \dash 
\" AtmAnam\" iti || 10\-11||

%%% ##endlabel##

%%% ##label=<segment012_pd06>##

{\Largedvng pra\.dI\. || } \" upavishyAsane ityatrApi yogashabda evameva vyAkhyeya\" 
ityAha \dash \" yogam\" iti |  sthAnavivekArthaM \" yuJNjyAt\" ityuktam |
\" kuryAd\" iti yAvat || 12\-14||

%%% ##endlabel##

%%% ##label=<segment013_pd06>##

{\Largedvng pra\.dI\. || } \" nanu shAntiH nirvANamiti moxaparyAyau |  tatkathaM shAnternirvANa\-
paramatvam\?\" ityata Aha \dash \" nirvANa\" iti |  \" na jIvanmuktimAtram\" 
ityarthaH |  upashAnteryogakAraNatvAdyogaphalatvamanupapannam || 15||

%%% ##endlabel##

%%% ##label=<segment014_pd06>##

{\Largedvng pra\.dI\. || } \" na chaikAntamanashnataH, jAgrato naiva cha iti yuJNjAnasyAnashana\-
jAgaraNaniShedhaH kriyate |  sa sarvaviShaya\" (shAM\.bhA\.6\.16) iti pratItinirAsAya
arthamAha \dash \" anashanAdi\" iti |  \" kuta\?\" ityataH \" shaktasya tadvidhAnAd\" 
ityAha \dash \" uktaM hi\" iti |  \" AnimIlitAxa\" IshannimIlitAxaH |  
\" shaktastu\" iti sambandhaH || 16||

%%% ##endlabel##

%%% ##label=<segment015_pd06>##

{\Largedvng pra\.dI\. || } \" AhArAdInAM kena yuktatvam\?\" ityata Aha \dash \" yukta\" 
iti |  \" upAyaH\" samAdhiH |  samAdhirhi dhAtvarthaH |  tadvattA cha pratyayArthaH |
ataH \" sopAya\" ityuktam |  \" AhArAdeH sopAyatvaM nAma kIdR^isham\?\" ityata 
Aha \dash \" yAvatA\" iti |  \" Adi\" padenendriyotsekA.alasyAdeH saN^grahaH |
upAyena sAhityaM nAma tadavirodhitvam |  \" tachchaivaMbhUtam\" ityarthaH || 17||

%%% ##endlabel##

%%% ##label=<segment016_pd06>##

{\Largedvng pra\.dI\. || } \" AtmanyevAvatiShThate ityatra svasminneva\" (shAM\.bhA\.6\.18) iti
pratItinirAsAyAha \dash \" Atmani\" iti |  anyathA \" j~nAtvA mAm\" ityAdi\-
virodhaH || 18||

%%% ##endlabel##

%%% ##label=<segment017_pd06>##

{\Largedvng pra\.dI\. || } \" yuJNjato yogAmAtmanaH\" ityatrA.atmashabdasya ShaShThyAshcha
vivaxitamarthamAha \dash \" Atmana\" iti |  \" yogina Atmana\" (shAM\.bhA\.6\.19)
ityanvayanirAsAya \" yogam\" ityuktam |  anyathA vaiyarthyAt || 19||

%%% ##endlabel##

%%% ##label=<segment018_pd06>##

{\Largedvng pra\.dI\. || } \" yatra chaivA.atmanA\" ityatra padatrayaM vyAkhyAti \dash \" AtmanA\" 
iti |  anvayApexayA vyutkramaH |  \" pashyan\" iti sthAnavivekArthaM
uktam || 20||

%%% ##endlabel##

%%% ##label=<segment019_pd06>##

{\Largedvng pra\.dI\. || } \" tattvataH tadbhAvAt brahmatvAd\" iti pramANaviruddhaM
vyAkhyAnaM vyAvartayitumAha \dash \" tattvataH\" iti || 21\-22|| 

%%% ##endlabel##

%%% ##label=<segment020_pd06>##

{\Largedvng pra\.dI\. || } \" nanu duHkhasambandhasya viyogo dhvamsaH |  sa kathaM yogaH
syAd\?\" ityata Aha \dash \" duHkha\" iti |  karaNe.api ghaJNaH smaraNAt |
\" evaM tarhi \" duHkhaviyogam\" ityeva vaktavyam |  kiM \" samyoga\" shabdena\?\" 
ityata Aha \dash \" na kevalam\" iti |  \" viyogashabdo nivAraNe vartata\" iti 
bhAvaH |  etachcha padAdhikyAdeva labhyate |  nAnyathA |  \" nanu \" sa nishchayena
yoktavyaH\" iti punarvidhAnaM kimartham\?  \" nishchayena\" ityAdivisheShavidhAnArthamiti
chenna |  mahAphale sandehAt pravR^ittyabhAvena \" nishchayena\" ityasya vaiyarthyAd\" 
ityata Aha \dash \" nishchayena\" iti |  ayogavyavachChede nishchayashabda ityarthaH |
\" kutrAyogo vyavachChidyata\?\" ityata uktaM \dash \" bubhUShuNA\" iti |  \" mumuxuNA\" 
ityarthaH || 23||

%%% ##endlabel##

%%% ##label=<segment021_pd06>##

{\Largedvng pra\.dI\. || } \" sarvAn\", \" asheShataH\" ityetayostAtparyamAha \dash \" sarvAn\" 
iti |  \" kAmaH svalpaH kAdAchitko.api\" iti mUlapAThaH |  nanvindriyagrAmaniyamanaM
evAvashyakam |  na tu karaNaniyamaH |  \" kathamuchyate \" manasaivendriyagrAmam\" 
iti\?\" tatrAha \dash \" manasaiva\" iti |  \" svarUpakathanametad\" iti bhAvaH |
\" iti j~nApayitum\" iti sheShaH || 24||

%%% ##endlabel##

%%% ##label=<segment022_pd06>##

{\Largedvng pra\.dI\. || } \" shanaiH shanairuparamedbuddhyA iti buddherapIndriyagrAmaniyamane
kAraNatvasya vaxyamANatvAt kathametad\?\" ityata Aha \dash \" buddheH\" iti |  
anenoparamedityasyArthadvayamuktaM bhavati || 25||

%%% ##endlabel##

%%% ##label=<segment023_pd06>##

{\Largedvng pra\.dI\. || } \" yato yataH shrotrAdeH\" (shAM\.bhA\.6\.26) iti pratItinirAsAya
Aha \dash \" yata\" iti |  \" shabdAu\" ityarthaH |  \" kutaH saptamyarthe 
tasirlabhyata\?\" ityata Aha \dash \" yata\" iti |  tathAchoktaM \" AdyAdibhya 
upasaN^khyAnam\" iti |  anyathA dvAramAtraniyame smaraNasya ko nivArayitA\? 
\" ShaShThyA hyatra bhAvyaM, saptamI tu katham\?\" ityata Aha \dash \" Atmani\" 
iti || 26||  

%%% ##endlabel##

%%% ##label=<segment024_pd06>##

{\Largedvng pra\.dI\. || } \" prashAntamanasaM ityuktameva punaH kasmAduchyata\?\" ityata Aha 
\dash \" pUrva\" iti || 27\-28||  

%%% ##endlabel##

%%% ##label=<segment025_pd06>##

{\Largedvng pra\.dI\. || } \" evaM yuJNjan iti yogaprakaraNasya phalakathanenopasaMhR^itatvAt
kimuttareNa\?\" ityata Aha \dash \" dhyeyam\" iti |  \" nanu \" machchito yuktaH\" (6\.14) 
ityAdinA dhyeyamuktameva\" |  satyam |  tathA.apyuttamAdhikAriNAM dhyeyamanena
uchyata ityadoShaH |  \" AtmAnaM svAtmAnam\" (shAM\.bhA\.6\.29) ityAdipratIti\-
parAkaraNArthamAha \dash \" sarva\" iti |  \" kuto.ayamartha\?\" ityataH
\" purANasamAkhyAnAd\" ityAha \dash \" tachcha\" iti |  \" sarvatra samadarshanaH\"
ityasyoktArthatAM gItAsaMmatyopapAdayati \dash \" samam\" iti || 29|| 

%%% ##endlabel##

%%% ##label=<segment026_pd06>##

{\Largedvng pra\.dI\. || } \" kiNchaitadarthAnuvAdena phalapratipAdakamuttaravAkyamapyasya
bhagavadviShayatvaM j~nApayati\" iti bhAvenAha \dash \" phalam\" iti |  \" asya
dhyAnavisheShasya\" iti sheShaH |  \" nanu bhagavAn taddhyAyI cha sarvAn prati
nityau |  tatkathametad\?\" ityata Aha \dash \" tasya\" iti |  \" kathamayamartho
labhyata\?\" ityata Aha \dash \" satyapi\" iti |  \" avidyamAnanAtho.ayam\" iti
bhR^itye prasiddhiH |  evaM satyapi bhR^itye abhajati \" avidyamAnabhR^ityo.ayam\" iti
svAmini prasiddhiH |  etaduktaM bhavati \dash \" vidyamAnasyApi svayogyavyApArAkaraNa\-
sAdR^ishyAdupachAreNAvidyamAnatA |  prakR^ite tu tathAtvAbhAvAt \" na praNashyAmi\" 
ityAdi |  rUDhopachArashchAyam |  ato na prayojanAnveShaNam\" iti |  atra 
purANasammatimAha \dash \" uktaM cha\" iti || 30|| 

%%% ##endlabel##

%%% ##label=<segment027_pd06>##

{\Largedvng pra\.dI\. || } \" yo mAm ityuktameva punaH kimarthamuchyata\?\" ityata Aha \dash 
\" etadeva\" iti |  \" ekatvamAsthita\" ityasyAnyathApratItinirAsArthamarthamAha
\dash \" ekatvam\" iti |  \" mayi vA madvikAre vA vartamAno.api\" (shAM\.bhA\.6\.29) 
ityapavyAkhyAnanirAsArthamAha \dash \" sarva\" iti |  \" nyAyena vA.anyAyena vA\" 
ityarthaH |  \" apavyAkhyAne thAl-pratyayo na yukta\" iti bhAvaH |  \" bhagavantaM
bhajato.adharmAcharaNaM sarvathA.apyakiJNchitkaram\" (shAM\.bhA\.6\.31) iti pratItinirAsAya
Aha \dash \" evam\" iti |  \" adharmAcharaNe.api\" iti sheShaH |  \" j~nAnaphalam\" 
moxaH |  \" AnandahrAsAdikaM tu vidyata eva\" iti bhAvaH |  \" nanu j~nAnino moxa
evApexitaH |  so.adharmAcharaNe.api na pratibadhyate iti chet tatkimadharmaM karoti\?\" 
ityata Aha \dash \" tathA.api\" iti |  \" sarvathA.apyakaraNe \" sarvathA vartamAno.api\" 
ityuktamayuktam\" ityata uktam \dash \" prAya\" iti |  etena \" na hIdR^ishasya
yatheShTacheShTatA sambhavati\" (shAM\.bhA\.6\.31) iti parakIyamasmadvyAkhyAnadUShaNamapi
nirastaM bhavati |  prArabdhavashena kadAchittathAbhAvadarshanAt |  \" kuto na karoti\?\" 
ityata Aha \dash \" kurvatastu\" iti |  atra pramANamAha \dash \" Aha cha\" iti | 
\" kiyanmahad\" iti sheShaH |  \" karmaNaH\" prArabdhasya \" bAhulyAt\" prAbalyAt |  
\" loke pravR^ittikarmaNo bAhulyena chittavixepAd\" iti vA || 31||

%%% ##endlabel##

%%% ##label=<segment028_pd06>##

{\Largedvng pra\.dI\. || } \" sarvatra samadarshanaH\" ityasyAnyathAvyAkhyAnamito.apyasaditi
bhAvenAha \dash \" sAmyam\" iti |  sAmyadarshanam |  \" samadarshanaH ityukte kiM 
gogavayAdivat bhavati sAmyadarshanam\?\" ityAkAN^xAyAM \" ekatvamAsthitaH\" 
iti svayameva vyAkhyAtam |  idAnIM tu bhagavadanuvartiviShayatayA.api vyAchaShTa 
ityarthaH || 32||

%%% ##endlabel##

%%% ##label=<segment029_pd06>##

{\Largedvng pra\.dI\. || } \" sAmyasya yogasya cha prakR^itatvAt \" etasya\" iti kasya
parAmarsha\? iti na j~nAyate\" |  ataH tatpradarshanAya vyavahitAnAM padAnAmanvayamAha
\dash \" etasya\" iti |  \" yogasya prAdhAnyena sAmyasya tu tR^itIyayA.aprAdhAnyena
prakR^itatvAd\" iti bhAvaH |  \" chaJNchalatvAt ityasyAnyo dharmI na pratIyate |
ato yoga eva sambadhyate |  tathA cha sAdhyAvishiShTatA\" ityata Aha \dash 
\" manasa\" iti |  \" etachchottaravAkyAdavagamyata\" iti bhAvaH || 33||

%%% ##endlabel##

%%% ##label=<segment030_pd06>##

{\Largedvng pra\.dI\. || } atrA.agamaM chAha \dash \" uktaM cha\" iti |  etena \" asamshayam\" 
iti parihAravAkyamapi vyAkhyAtam || 34\-35||

%%% ##endlabel##

%%% ##label=<segment031_pd06>##

{\Largedvng pra\.dI\. || } \" asa.nyata iti shloko vyartha iva pratIyate\" |  tannivartyAM
AshaN^kAM sUchayan tAtparyamAha \dash \" na cha\" iti |  \" yathA mattamAtaN^gaH 
svayameva shrAntaH shAnto bhavati tathA viShayaiH tR^iptaM manaH kadAchit svayameva
niyataM bhavati |  kimabhyAsAdinA\?\" ityetad \" naiva\" ityarthaH | \" kuta\?\" 
ityata Aha \dash \" shubha\" iti |  \" sadA\" iti pUrveNa sambandhaH |  anenAtra
\" shubhechChAdikamapyupalaxitam\" iti sUchitam |  muktibIjatvAnmanoniyamasya
muktirityuktam || 36|| 

%%% ##endlabel##

%%% ##label=<segment032_pd06>##

{\Largedvng pra\.dI\. || } \" achaturthAshramI\" iti pratItinirAsAyAha \dash \" ayatiH\" 
iti || 37\-43|| 

%%% ##endlabel##

%%% ##label=<segment033_pd06>##

{\Largedvng pra\.dI\. || } \" u\" pratyayaprayoge \" na lokAvyaya\" iti ShaShThIniShedhAd
\" yogasya svarUpam\" adhyAhR^itya kashchidvyAkhyAtavAn |  sa shramo vR^ithaiva |
\" naJNAnirdiShTamanityam\" ityasyAnityatvAt |  ataH kAtyAyanaH \" dviShaH 
shaturvA vachanam\" ityAdi \" avochad\" ityabhipretyAha \dash \" yogasya\" iti | 
\" brahmajij~nAsA\" ityAdAviva vichArthatAshaN^kAnirAsAya vyAchaShTe \dash \" j~nAtavya\" 
iti |  \" atIva\" iti \" u\" pratyayasyArthaH |  \" sanAshaMsabhixa uH\" iti 
tachChIlAdau tasya vihitatvAt |  \" ichChArthe bAdhakAbhAvAd\" iti bhAvaH |
\" shabdabrahmAtivartate\" ityetat \" vedoktakarmakAribhyo.atirichyata\" 
(shAM\.bhA\.6\.44) iti kashchidvyAchaShTe |  tadasat |  \" tato yAti parAM gatim\" 
ityasyArthasya parAmarshAditi bhAvenAha \dash \" shabda\" iti |  \" shabdabrahma\" shabdena
vaidikavidhiniShedhAvatrochyate |  \" tadativartanaM parabrahmaprAptasyaiva\" ityata
evamuktam || 44||

%%% ##endlabel##

%%% ##label=<segment034_pd06>##

{\Largedvng pra\.dI\. || } \" yogajij~nAsAmAtreNa parabrahmaprAptishchedyogAnuShThAnavaiyarthyaM
syAd\" ityata etadevAshaN^kya \" bhagavataivottaraM dattam\" ityAha \dash \" naika\" 
iti |  \" na yogajij~nAsAmAtreNa\" ityabhiprAyaH |  \" atra yogajij~nAsoraparAmarshAt
kathaM tadviShayametad\?\" ityato.adhyAhAreNa vyAchaShTe \dash \" jij~nAsuH\" iti | 
\" j~nAtvA yogam\" iti sheShaH |  \" yatanAnantaramanekajanmasamsiddha\" 
(shAM\.bhA\.6\.45) ityanyathApratItinirAsAyAha \dash \" evam\" iti |  \" yoge 
sampUrNe samsiddhervilambe kAraNAbhAvAd\" iti bhAvaH |  vyAkhyAtArthe purANasammatiM
Aha \dash \" Aha cha\" iti || 45|| 

%%% ##endlabel##

%%% ##label=<segment035_pd06>##

{\Largedvng pra\.dI\. || } \" nanu j~nAnaM yogasya phalam |  tatkathaM j~nAnibhyo.apyadhiko
mata\?\" ityata Aha \dash \" j~nAnibhya\" iti |  yadyapi \" j~nAnatapasA pUtA\" 
iti j~nAnamapi tapaH |  tathApi tadatiriktamevAtra vivaxitamityAha \dash 
\" tapasvibhya\" iti |  \" brahmaj~nAnAdAdhikyasyAsambhavAdyogaj~nAnAdhikyasya 
pR^ithaguktatvAd\" iti bhAvaH |  ata eva pUrvaM tadvyAkhyAtam |  
uktArthamupapAdayan shlokadvayArtha purANavAkyenA.aha \dash \" uktaM cha\" iti |  
mumuxUNAm |  etena \" sarveShAmapi yoginAM madhye yo mAM bhajate sa 
yuktataro mataH |  tatrApi madgatenAntarAtmanA yo bhajate sa yuktatamo mata\" iti 
vyAkhyAtaM bhavati |  \" j~nAnibhyo.api mato.adhikaH ityetadyogaj~nAnaviShayameva, 
na tat brahmaj~nAnaviShayam\" ityetat purANavAkyena sthApayati \dash \" aj~nAtvA\" 
iti |  \" yogam\" iti sheShaH |  \" sAdhanAdhikam\" sAdhaneShvadhikam || 46\-47||

%%% ##endlabel##

%%% ##label=<segment036_pd06>##

iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TikAyAM
shrIjayatIrthamunivirachitAyAM prameyadIpikAyAM ShaShTho.adhyAyaH samAptaH || 

%%% ##endlabel##

% shrImadhveshakR^iShNArpaNamastu 

%%% ##label=<segment001_pd07>##

{\Largedvng pra\.dI\. || } \" j~nAnasAdhanAdanyaduttarAdhyAyapratipAdyaM vaktuM \" yoge
tvimAM shR^iNu\" iti pratij~nAtamasamApya kathamarthAntaramuchyata\?\" ityAshaN^kAM
tAvatpariharati \dash \" sAdhanam\" iti |  \" j~nAnasya\" iti sheShaH |
tatra tatra bhagavanmahimno.api varNitatvena \" prAdhAnyena\" ityuktam |  
\" prAchuryeNa\" ityarthaH |  \" uktam\" ityanena pratij~nAtasamAptiM 
sUchayati |  tachcha pratij~nAntakaraNAdavagamyate |  idAnImuttaragrantha\-
pratipAdyamAha \dash \" uttaraistu\" iti |  \" adhyAyaiH\" iti vartate |
anena \" j~nAnavij~nAnashabdau j~neyabhagavanmAhAtmyaparau\" iti sUchitam |
atrApi kvachitsAdhanasyoktatvAt \" prAdhAnyena\" ityuktam |  saN^gatistu
prathamashloka evoktA |  anena \" dvividhena yogena yajj~nAtavyaM tachChR^iNu\" 
ityuktatvAt ||

%%% ##endlabel##

%%% ##label=<segment002_pd07>##

{\Largedvng pra\.dI\. || } \" AsaktamanAH sambaddhamanAH\" (shAM\.bhA\. 7\.1) iti pratItinirAsaM
Aha \dash \" Asakta\" iti |  \" atIva\" ityAN^o.arthaH |  \" sambandhamAtrasya 
yogAnaN^gatvAd\" iti bhAvaH |  \" bhagavadAshrayatvaM sarvasAdhAraNaM kathaM 
yogino visheShaNam\?\" ityata Aha \dash \" madAshraya\" iti |  \" sharaNam\" 
raxakaH |  \" iti sthita\" \" iti jAnan\" iti yAvat |  \" asamshayaM\", 
\" samagraM\" ityubhayaM bhagavadvisheShaNatvena bhAskaro vyAkhyAtavAn 
\" samshayarahitaM samagraM kR^itsnaM mAm\" iti |  aparastu \" samagramityeva 
samagraM samastavibhUtibalashaktyaishvaryAdiguNasampannaM mAM samshayamantareNa\" 
iti |  tannirAsArthaM Aha \dash \" asamshayam\" iti |  \" tava samagraM 
yathA bhavati tathA\" ityarthaH |  na hi bhagavataH samshayarAhityamidAnIM 
vaktavyam |  na cha bhagavAn samagro.anyena kenachichChakyo j~nAtum |  
\" svayamevA.atmanA.a.atmAnaM vettha tvam\" (10\.15) iti vaxyamANatvAditi 
bhAvaH || 1||

%%% ##endlabel##

%%% ##label=<segment003_pd07>##

{\Largedvng pra\.dI\. || } \" nanu j~nAnaM vaxyate |  na tUktam |  tatkathamidamiti parAmarsha\?\"
ityata Aha \dash \" idam\" iti |  \" mAm\" iti svasya prakR^itatvAttatsambandhitvena
j~nAnamapi prakR^itamiti bhAvaH |  \" savij~nAnaM svAnubhavasamyuktam\" (shAM\.bhA\. 7\.2)
ityetadapAkartuM vij~nAnapadArthamAha \dash \" vij~nAnam\" iti |  asyaiva vaxyamANatvAt |
aparasya tadabhAvAditi bhAvaH || 2||
%%% ##endlabel##

%%% ##label=<segment004_pd07>##

{\Largedvng pra\.dI\. || } \" nanu j~nAnAdivachanaM pratij~nAya yatkiJNchitkathamuchyata\?\" 
ityata Aha \dash \" daurlabhyam\" iti |  \" shroturAdarajananArtham\" iti sheShaH |
j~nAnasya daurlabhye vij~nAnasya tatsutarAm || 3||

%%% ##endlabel##

%%% ##label=<segment005_pd07>##

{\Largedvng pra\.dI\. || } \" manuShyANAM itivaduttaramapyanyArtham\" iti pratItinirAsArthaM
\" pratij~nAtayorubhayoH kimAdAvuchyata\?\" ityapexAyAJNchAha \dash \" pratij~nAtam\" iti | 
asaN^gatiparihArAyAnanyArthatAj~nApanAya cha j~nAnasya prAthamye hetusUchanAya cha 
\" pratij~nAtaM\" ityuktam |  pratij~nAtvena saN^gataM \" pratij~nAtaM\" eva |  na tu 
tadarthaM prAthamyena pratij~nAtam |  \" raso.aham\" ityataH prAktanagranthasaN^grahAya 
\" Adi\" padam |  \" mahattatvamatra nopAttam |  tatkiM nAstyeva\?\" ityata 
Aha \dash \" mahata\" iti |  \" ahaN^kAre\" ahaN^kArashabdArthe.antarbhAvaH |  
\" kAryavAchinA.ahaN^kArashabdena kAraNasya mahato apyupalaxaNameva |  
na tvabhAva\" ityarthaH || 4||

%%% ##endlabel##

%%% ##label=<segment006_pd07>##

{\Largedvng pra\.dI\. || } aparashabdasyAnekArthatvAdvivaxitamarthamAha \dash \" apara\" iti | 
\" anuttamatvasya sApexatvAtkimapexayA\?\" ityata Aha \dash \" vaxyamANAm\" iti | 
\" sannidhAnAd\" iti bhAvaH |  \" jIvalaxaNAM jIvatvaM prAptAm\" iti vyAkhyAna\-
nirAsArthamAha \dash \" jIvabhUtA\" iti |  \" kathaM sA jIvabhUtA\?\" ityata 
Aha \dash \" jIvAnAm\" iti |  \" prANadhAriNI\" ityevokte \" svaprANadhAriNi\" 
iti pratItiH syAt |  tannirAsArthamuktaM \dash \" jIvAnAm\" iti |  \" sarvajIvadeheShu
sthitvA tadIyAnprANAn tatra dhArayati\" ityarthaH |  \" svaprANadhAriNI kuto na
syAd\?\" ityata Aha \dash \" chidrUpA\" iti |  j~nAnAtmakavigrahavatI |  yadvA
\" jIvaprANadhAraNa\" ityato jIvashabdasya yaugikArthamuktvA gauNIM vR^ittimAshritya
arthAntaramanenoktam |  \" bhUta\" shabdasya sarvadA satvavAchitve prayogaM 
darshayati \dash \" etad\" iti |  prakR^itimapexya shriyaH paratvopadAnadArthaM
etat |  \" bhUmiH\" ityAdeH abhimatamarthaM purANavAkyena sthApayati 
\dash \" jagAda cha\" iti |  devasyaiva |  \" sR^ijyata\" iti sR^iShTiH kAryam |  
\" kAryarUpeNa\" ityarthaH |  anena bhUmyAdishabdaiH paJNchatanmAtrANyevochyante |  
na sthUlAni bhUtAni |  \" mana iti tatkAraNamahaN^kAraH |  buddhiriti 
mahattatvam |  ahaN^kAra ityavidyAsahitamavyaktam |  \" bhinnA 
prakR^itiraShTadhA\" iti vachanAd\" (shAM\.bhA\. 7\.4) iti vyAkhyAnaM
nirastam |  \" kAryarUpeNAShTadhA bhinnA\" iti vyAkhyAnasambhavena prasiddhArtha\-
parityAgAyogAt |  mahatyahaN^kArasyAntarbhAva ityeveti sambandhaH |  \" jaDA\" 
ityavaratvopapAdanam |  \" shrIH parA\" ityasyopapAdanaM \" iyaM dhAryate tayA\" 
ityAdi |  anantA deshataH guNatashcha |  \" parA\" mukhyA |  anAdinidhanA 
na tvavyaktavad vikriyAvatI |

%%% ##endlabel##

%%% ##label=<segment007_pd07>##

{\Largedvng pra\.dI\. || } \" nanvatrAparaparanirUpaNapUrvakaM bhagavato yatparataratvaM vaktuM
abhipretaM tatra sharIrendriyaviShayalaxaNAkhyakAryasya jIvAnAM cha tayorevAntarbhAva\" 
iti darshayituM \" etadyonIni\" ityuktam |  \" idAnImahaM paratara\" iti 
vaktavyam |  \" idantu kimarthamuchyata\?\" ityata Aha \dash \" na kevalam\" 
iti |  pUrvaM vAkyabhedena prakR^ityoravaratvaM, paratvaM \" me\" iti svavashatvaM 
choktvA \" yayedaM dhAryate jagat\" , \" etadyonIni\" iti jagadAdhAratva\-
kAraNatve kathite |  tatra prakR^itI eva bhagavadvashe, \" jagajjanmasthitilayAstu 
prakR^ityadhInA eva, na bhagavadadhInA\" iti pratItam |  tannirAsArthametadityarthaH |
\" jagatpratimamaishvaryamityetAvat prakR^itidvArakamupacharitam\" iti yAvat |
\" prakR^ityoH kAraNatvAdikaM madAyattam\" iti bhAvaH |  \" jagaddharmayoH 
prabhavapraLayayoH sAxAdbhagavadaikyamuchyata\" iti pratItinirAsArthamAha \dash 
\" prabhavAdeH\" iti |  yathA putrAdiprabhavo ripupraLayashcha upalabdhaH 
sukhaheturityupalabdhuH pitrAdeH tadbhoktR^itvaM tathA tadbhoktR^itvAt |  \" bhagavataH 
sarvabhoktR^itvaM kuta\?\" ityata Aha \dash \" tathA cha\" iti |  \" sarvakAmaH\" 
ityAdeH dviruktatvAdekaM bhogaviShayamiti j~nAyate |  kAmyanta iti kAmA 
dravyANi |  gandharasashabdau guNAntarasyApyupalaxakau |  sarvamidamapi abhitaH |
Atto dhR^itaH sthita ityarthaH |  na vidyate vAkyamanugrahamantareNa yasyAsAvavAkyaH |
na vidyate AdaraH AshcharyabuddhiH yasyAsau nAdaraH |  avAkyashchAsau nAdarashcheti
\" avAkyanAdaraH\" |  \" kAraNatvAdinaivaikyavyapadesha ityetatkuta\?\" ityata Aha 
\dash \" Aha cha\" iti |  \" sukharUpasya\" sukhakAraNasya |  nanu \" straShTA 
pAtA\" ityAdikamayuktam |  kAdAchitkakriyA.aveshe vikAritvaprasaN^gAt |
\" bhogena yadbhAvyaM sukhaM tasya pUrvamabhAvenApUrNatvaprasaN^gAchcha\" ityata
Aha \dash \" AgamiShyat\" iti |  \" yadbhogenAgamiShyatsukhaM tachcha
sadA.apyastyeva kriyAshcha shaktirUpeNa cheti\" chArthaH |  \" tarhi kathaM
\" bhogena jAtam\" ityuchyata\?\" iti bhAvena pR^ichChati \dash \" api tu\" 
iti |  uttaramAha \dash \" tathA.api\" iti |  \" sadA\" sadbhAve.api |  
\" yadyapi prabhavatyasmAditi prabhavaH, pralIyate.asminniti pralaya\" iti shakyate
vyAkhyAtum |  tathA.api mahimAtishayalAbhAyaivaM vyAkhyAtam |  \" etena
yasmAnmama prakR^itI yonI sarvabhUtAnAM tato.ahaM kR^itsnasya jagataH prabhavaH
pralayastathA\" (shAM\.bhA\.7\.6) iti vyAkhyAnamapahastitaM bhavati || 5\-6||

%%% ##endlabel##

%%% ##label=<segment008_pd07>##

{\Largedvng pra\.dI\. || } \" nanvaparaM paraM cha tattvamuktvA parataro.ahaM\" iti vaktavyam |  
\" matta iti kimuchyata\?\" ityatastAtparyamAha \dash \" ahameva\" iti |
parAparaprakR^ityoH svAdhInatvoktyaiva svasya parataratvamuktaprAyam |  \" kintu
aparatatvaM yathA.anekaM bhUmyAdibhedena, yathA cha paratatvaM \" muktastu syAt
parAbhAsa\" iti vachanAt, tathA paratarapi kimanekamuta tvekameva\?\" iti 
jij~nAsAyAM \" ahameva parataraH ityanenochyata\" ityarthaH |  \" kathamanenedaM 
labhyate\? bhagavatpratiyogikAdhikyavanniShedhasyAtra pratIteH\" ityato 
yojayati \dash \" matta\" iti |  anyathA tarapo.anyashabdasya cha vaiyarthyAditi 
bhAvaH |

\" bhUmirityAdinA\" ityatrAvadheranUkteH \" raso.ahaM\" ityAdyapi j~nAna\-
prakaraNamiti pratItiH syAt |  tannirAsAya tatsamAptimAha \dash \" idam\" 
iti |  etAvatA granthena j~nAnaM nirUpitamityarthaH || 7||

%%% ##endlabel##

%%% ##label=<segment009_pd07>##

{\Largedvng pra\.dI\. || } \" kuto.atra j~nAnaprakaraNasya samAptiH\?\" ityata Aha \dash 
\" raso.aham\" iti |  \" iti\" shabdadyabhAve.api prakaraNAntarArambha eva 
samAptiM gamayiShyati |  alaukikamAhAtmyapratipAdanAdasya vij~nAnaprakaraNatvaM 
j~nAyata iti bhAvaH |  prabhavAderityuktanyAyenaiva \" raso.aham\" ityAderapi 
vyAkhyAnaM siddham |  \" rasAdInAM sattAdikAraNatvAdbhoktR^itvAchcha bhagavAn 
rasAdiH\" iti |  \" nanvabAdayo.api dharmiNo bhagavadadhInAH tadbhogyAH 
chetyaN^gIkriyate na vA |  neti paxe \" ahaM kR^itsnasya\" ityukta virodhaH |  
Adye tvapsu rasaH ityAderdharmibhyo niShkR^iShya dharmANAM grahaNasyAnupapattiH\" 
ityataH prathamaM paxaM tAvadaN^gIkaroti \dash \" abAdayo.api\" iti |  dharmiNo.api 
tadadhInA eva tadbhogyAshchaiva |  \" nanu tatrokto doSha\" ityataH kAraNatve 
tAvadvisheShashabdopAdAne prayojanamAha \dash \" tathA.api\" iti |  \" yadyapi 
dharmiNo.api bhagavadadhInA eva |  tathA.api dharmibhyo niShkR^iShya dharmANAmupAdAnaM 
yujyata\" iti sheShaH |  \" katham\?\" ityata Aha \dash \" rasAdi\" iti |  
rasAdayashcha te svabhAvAH abAdInAmanAgantukadharmAshcheti rasAdisvabhAvAH |  
teShAM sArANAmabAdidharmeShu saN^khyAdiShu shreShThAnAM cha teShAmevAbAdisvabhAvabhUtAnAM
taddharmeShu shreShThAnAM cha rasAdInAmiti yAvat |  \" svabhAvatve.abAdInAm\" 
iti sheShaH |  \" sAratve.abAdidharmeShu\" iti sheShaH |  rasAditve cheti chArthaH |
sa bhagavAneva |  \" visheShato.api\" ityasya vyAvartyaM \dash \" na tu\" iti |
anubaddho.anuShaN^gasiddhaH |  tatsAratvAdishcheti |  tasya rasAderabAdidharmeShu 
sAratvamabAdisvabhAvatvaM rasatvAdikaM chetyarthaH |  yathA loke kuvindAdiH 
paTAdidravyaShveva vyApAravAnanubhUyate na tu tadIyeShu gandharasAdiShu guNeShu 
taddharmeShu cha gandhatvAdiShu pR^ithagvyApAravAn |  kintu te paTAdijanmAnuShaN^gi\-
janmAna eva |  na tathA bhagavAn |  api tvabAderdharmeShu rasAdiShu taddharmeShu 
cha svabhAvatvAdiShu pR^ithakprayatnavAn |  na tvabAdiniyamAnuShaN^gisattAdikAsta
iti darshayituM visheShashabda upAttA ityarthaH |  bhogapaxe.api prayojanaM
Aha \dash \" bhogashcha\" iti |  \" abAdibhogAdapyatishayena rasAderbhogaH
parameshvarasya\" iti darshayati visheShashabdairiti sambandhaH |  \" raso.aham\" 
ityAdyabhedokterarthAntaraM sUchayan tatrApi visheShashabdopAdAne prayojanaM
Aha \dash \" upAsanArthaM cha\" iti |  visheShato rasAderiti vartate | 
arthavashAdrasAderiti saptamItvena vipariNamyate |  rasAdayaH parameshvaropAsane
pratimAtvenAtra vivaxitAH |  pratimAyAM chAbhedoktiH prasiddhA |  pratimAtvamabAdInAM
samAnam |  \" yo.apsu tiShThan\" (bR^i\.u\. 2\.7\.4) ityAdeH |  ataH \" kiM
visheShashabdagrahaNena\?\" iti chet |  abAdibhyo visheShato rasAdiShu bhagavad\-
upAsanArthaM tadupapattiriti |  ukte.arthatraye pramANamAha \dash \" uktaM cha\" 
iti |  tathA cha shabdAvanyonyasamuchchaye |  evashabdasya \" IshvaraH\" ityanena 
sambandhaH |  sarvatrAbAdiShu |  \" Ishvaro rasAdikaM jagadityuchyata\" ityarthaH |  
\" abAdayo\" abAdyabhimAninaH |  \" j~nAninAm\" j~nAnArthinAM \" sampattyai\" 
prAptyai anyeShAM rasArthinAm |  \" abAdayaH\" iti \" rasAdi\" iti cha 
pAdayoH saptanavAxaratve.api \" na vA ekenAxareNa ChandAmsi viyanti\" iti 
vachanAdadoShaH |  svabhAvasya bhagavadadhInatvamalaukikamityatastatrAnyAnyapi 
vAkyAni paThati \dash \" svabhAva\" iti |  \" astvevaM dharmibhyo niShkR^iShya
dharmANAmupAdAnam |  dharmANAM visheShaNopAdAnaM tu kimartham\?\" ityata 
Aha \dash \" dharma\" iti |  Adipadena \" puNyo gandhaH\" ityasya grahaNam |
kAmAdiShu vishiShTeShveva bhagavAnupAsyo na dharmaviruddheShvashuchiShviti j~nApanAya 
kAmAdInAM dharmANAM dharmAviruddhatvAd \" Adi\" visheShaNopAdAnamityarthaH |  
atra pramANamAha \dash \" uktaM cha\" iti |  \" kAmam\" puruShArtham |
kAmarAgAdeH kAmarAgAdinA |  anichChadbhiH kAmAdikam ||

%%% ##endlabel##

%%% ##label=<segment010_pd07>##

{\Largedvng pra\.dI\. || } gandhasya visheShaNopAdAne prayojanAntaramAha \dash \" puNya\" iti | 
\" puNyagandhasyaiva bhagavato bhogo na durgandhasyeti j~nApayitumatra visheShaNopAdAnam\"
ityarthaH |  nanu durgandhaM bhagavAnanubhavati na vA |  neti paxe sArvaj~nAbhAvaH |  
Adye kathaM bhogAbhAvaH\? uchyate \dash \" anubhUyamAnA api durgandhAdayo na phalahetava\" 
ityabhiprAyaH |  sugandhastu sukhaheturityupapAditam |  shuchivastveva bhagavato
bhogyamityatra pramANamAha \dash \" tathA hi\" iti |  \" amum\" upAsakam | 
kutaH\? tasya devatvAt |  tathApi kutaH\? na ha vai devamAtrasya puNyabhoganiyame
devottamasya sutarAM tatsiddhiH |  \" R^itamiti shrutiH kathaM prakR^itopayogini\?\"
ityata Aha \dash \" R^itaM cha\" iti |  \" kuta\?\" ityataH sAmAnyavisheSha
abhidhAnAdityAha \dash \" R^itam\" iti |  \" prayogagaH\" shabdajanyaH |  tathA 
cha shrutAvR^itashabdaH puNyaphalasyopalaxaka iti bhAvaH |  \" syAdidaM vyAkhyAnaM
yadi bhagavato viShayabhogo yuktaH syAt\" |  na chaivam |  tadaN^gIkAre 
shrutyAdivirodhAt |  \" R^itaM pibantau\" iti chAta eva ChatrinyAyenopacharitaM
ityata Aha \dash \" sa cha\" iti |  \" kuto na\?\" ityata Aha \dash \" sthUla\" 
iti |  \" shrutyAdiShu sthUlasya jIvabhogyasya viShayasyAbhogokteH sUxmabhogasya
chAN^gIkArAd\" iti bhAvaH |  sUxmAshane pramite bhavediyaM vyavasthA |  \" tadeva
kuta\?\" ityata Aha \dash \" Aha cha\" iti |  \" gandhAdiShu yo jIvendriyAgocharaH
sArabhAgastasya bhogaM parameshvaro.asmAchChArIrAdAtmano jIvAdatishayena vilaxaNabhoga
eva bhavati |  avatAreShu sthUlamapi bhuN^kta\" iti \" iva\" shabdaH |  \" nanu 
praviviktA.ahArataro.ayaM jIva eva\" ityata Aha \dash \" na cha\" iti |  na hi
jIvo jIvAdeva vilaxaNA.ahAra iti yujyata ityarthaH |

\" nanu shArIrAjjAgarAvasthAjjIvAt svapnasuShuptyavasthaH sa eva praviviktA.ahAra
ityavasthAbhedopAdhikaM jIvasya bhedamaN^gIkR^itya vyAkhyAsyAmi\" ityata Aha \dash 
\" svapnAdishcha\" iti |  svaponanniti svapnashabdaH kartari |  svapnaH suShuptashcha
shArIra eva na kevalaM jAgrat |  tathA cha tryavasthasyApi shArIrashabdena
gR^ihItatvAnna tato bhedaH svapnasuShuptayorityarthaH |  \" avasthAtrayavato.api
shArIratvaM kuta\?\" ityata Aha \dash \" shArIrastu\" iti |  jAgradAdiShvavasthAsu |
astu tryavastho.api shArIraH |  \" tathA.apyasmAd\" iti visheShaNAtra shArIrAditi
jAgradavastho gR^ihyate |  tasmAchcha svapnAdyavasthasya bhedoktiruktavidhayA
sambhavati |  bhavatpaxe.api shArIrAditi jIve siddhe \" asmAt\" iti visheShaNaM
vyarthaM syAditi |  tatrAha \dash \" asmAd\" iti |  naitadvisheShaNasArthakyAya
IshvaraM parityajya jIvo.atra grAhyaH |  shArIrAdityevoktAvIshvarasyApi 
prAptAvIshvarAdeveshvarasya bhedAnupapattestadvyAvR^ittyarthaM jIvamAtraparigrahAya
visheShaNamiti sArthakyopapatterityarthaH |  \" bhavedevaM yadi shArIratvamIshvarasyApi
syAt |  tadeva kuta\?\" ityata Aha \dash \" shArIrau\" iti |  \" nanvevaM 
paxadvaye.apyupapattau Ishvara evAtrochyate na jIva iti kuto vinigamanam\?\" ityata
Aha \dash \" bheda\" iti |  \" cha\" hetau |  bhedashruteH svAbhAvikabhedarUpe
gatyantare sambhavati puruShabheda evArthatayA grAhyo na tvavasthopAdhiko bhedaH |
mukhyAmukhyayormukhye sampratyayAt |  ato yuktaM vinigamanam |  na kevalamuktavyavasthA
nyAyaprAptA |  kintvAgamasiddhAchetyAha \dash \" Aha cha\" iti |  abhoktA cha 
bhoktA chetyetayorvyutkrameNAnvayaH || 8\-11||

%%% ##endlabel##

%%% ##label=<segment011_pd07>##

{\Largedvng pra\.dI\. || } \" sarvabhUtasthamAtmAnaM (6\.29) ityuktatvAt na tvahaM teShviti 
kathamuchyata\?\" ityata Aha \dash \" na tvaham\" iti |  tadanAdhAratvaM
tadupajIvanena sthityabhAvaH |  \" kuta etad\?\" ityata Aha \dash \" uktaM cha\" 
iti |  na kevalamuktavirodhAditi chArthaH || 12||

%%% ##endlabel##

%%% ##label=<segment012_pd07>##

{\Largedvng pra\.dI\. || } \" nanu vij~nAnanirUpaNaM prArabhya \" tribhiH\" ityAdikaM
kimarthamuchyata\?\" ityata Aha \dash \" tarhi\" iti |  ye chaiveti vij~nAnanirUpaNa
upasamhAravAkye sattvAdiguNanirvR^ittAnAM bhagavAn kAraNamAshrayashcha tadanAshrayashcha
ityuktam |  tenaiva guNAtItA iti choktaprAyam |  tasyAyamAxepaH |  \" evaM 
guNAtItatayA saguNashcha j~nAyasa\" iti sheShaH |  \" evamanupalambha\-
viparItopalambhAbhyAmuktaM asad\" iti bhAvaH |  vikArArthatAnirAsArthamAha 
\dash \" tAdAtmya\" iti |  \" mayaTaH tAdAtmyArthatvaM kuta\?\" ityata Aha 
\dash \" tachcha\" iti |  tAdAtmye prayogaM darshayitumupoddhAtamAha \dash \" na hi\" 
iti |  \" kAryabhUtA\" ityupalaxaNam |  guNaprAchuryAdikamapi tasyAM na 
sambhavati |  \" tataH kim\?\" ityata Aha \dash \" guNa\" iti |  \" daivI hyeShA 
guNamayI mama mAyA\" (7\.14) iti mAyAyA guNamayItvamuchyate |  na cha 
tatra vikArAdyarthatA sambhavati |  tataH parisheShataH tAdAtmyArthatA 
grAhyetyarthaH |

\" astu mayaTaH tAdAtmye shaktiH |  atra vikArArthatAM parityajya tadgrahaNe ko 
hetuH\?\" iti cheduchyate \dash vikArArthatAgrahaNe \" mAmebhyaH param\" ityatra
guNakAryebhya eva bhagavataH paratvamuktaM syAnna tu guNebhyaH |  ataH tatsaN^grahAya
tAdAtmyArthatAgrahaNam |  evaM tarhi guNebhya eva paratvamuktaM syAnna tu guNakAryebhyo
apIti samAnamityata Aha \dash \" siddhaM cha\" iti |  \" siddham\" pramitam | 
tatashcha guNAtmakairityukte guNAnAM tatkAryANAJNchopAdAne satyubhayaparatvamuktaM 
bhavati \dash \" kAryadharmAdeH\" iti |  kAryadravyasyopAdAnena guNakriyAjAtipUrvANAM
dharmANAM guNyAdibhirityarthaH |  bhAvashabdasyAnekArthatvAttasya vivaxitamarthaM
Aha \dash \" bhAvaiH\" iti |  evaM sati sarvaparatvalAbhAditi bhAvaH |  \" nanvevamapi
\" ebhiriti\" purovartinAmeva grahaNAnna sarvaparatvasiddhiH\" ityata Aha \dash \" sarva\" 
iti |  \" pramitaparAmarsho.ayaM na purovartimAtrasya\" iti bhAvaH |  \" jaganmohitam
ityalaM kiM \" idaM\" ityanena\?\" ityata Aha \dash \" j~nAni\" iti |  
vyavahArapatitamityarthaH |  \" nanu bhagavadviShayasya saguNatvamohasya kathaM
guNAtmakAH padArthAH kAraNam\?\" ityata Aha \dash \" guNamayA\" iti | 
\" dehatvAdihetunA\" iti sheShaH |  \" mAyA\" iti guNamayAnAM grahaNam |
mohito janaH |  tatra pramANamAha \dash \" jagAda cha\" iti |  Adipadena
indriyAdigrahaNam |  yadarthaM tAdAtmyArthagrahaNaM kR^itaM tadAha \dash \" ebhya\" 
iti |  nanu bhagavato guNAtItatve pramite tadartho.ayaM shramaH saphalaH syAt |
\" tadeva kuta\?\" ityata Aha \dash \" guNebhyashcha\" iti || 13|| 

%%% ##endlabel##

%%% ##label=<segment013_pd07>##

{\Largedvng pra\.dI\. || } \" upAyAbhAvAnumAnAbhAsAbhyAmanupalambho viparItopalambhashcha
ityuktaM ataH kimuttareNa vAkyena\?\" ityata Aha \dash \" katham\" iti | 
bhagavAn guNamayavigraha ityayaM na mohaH |  bAdhakapratyayAbhAvAt |  \" j~nAninAM
samyakpratyayo bAdhaka ityuktam\" iti chenna |  bahutaraj~nAnavirodhena 
katipayaj~nAnAnAmevAyathArthatvApatteH |  \" nanUttarakAle bAdhakapratyayo bhaviShyati\" 
iti chenna |  anAdau kAle.ajAtasyottaratrApyasambhavAditi bhAvaH |  

\" nanu bAdhakapratyayAbhAvAdyathArtha evAyaM pratyaya iti shaN^kAyAM 
kimetadasaN^gatamuchyata\?\" ityata Aha \dash \" ayam\" iti |  \" eSha\" 
ityanuvAdena \" mohikA\" iti vyAkhyAtam |  mohitamiti dhAtvarthamAtraM parAmR^ishya 
yogyapratyayasambandhena vyAkhyAnAt |  guNamayI tadabhimAninI durgA yA hi 
tamoguNenaivamvidhaM mohaM janayati |  anumAnaM tu nimittamAtram |  \" tataH kim\?\" 
ityata Aha \dash \" sA cha\" iti |  sA cha \" duratyayA\" |  tatkR^itamohaM ko.api 
nAtyetuM shaknoti |  na kasyApi bAdhakapratyayo bhavati |  \" kuto duratyayA\?\" 
ityato \" atishakteH\" iti heturadhyAhR^ityoktaH |  \" kuto atishaktitvam\?\" 
ityato \" daivI\" ityetaddhetugarbhamiti vyAkhyAtaM \dash \" devasambandhitvAd\"
iti |  

sambandhitvaM paramapriyatvam |  sati devasyAtishaktitve tatsambandhinyAH tatsyAt |  
\" tadeva kuta\?\" ityato devashabdArtho niruktaH \dash \" sR^iShTyAdi\" iti |  sR^iShTyAdishcha 
sA krIDA cha |  prathamAdipadena sthityAdeH saN^grahaH |  dvitIyena vijigIShAdeH |  
\" krIDAdimattvenAtishaktirna siddhyati\" iti \" krIDA\" vyAkhyAtA |  
\" devashabdasya krIDAdimattvamarthaH kuta\?\" ityata Aha \dash \" tathA hi\" iti |  
\" deva\" shabde yA prakR^itiH tadarthamityarthaH |  \" pratyayastvigupadhalaxaNasya 
kasya bAdhakaH pachAdyach\?\" |  \" daivIityanena nirAkAN^xatvAt \" mama\" iti 
vyartham\" ityata Aha \dash \" katham\" iti |  tasyaiva vyAkhyArthametaditi bhAvaH |  
\" tvadIyatve.api kathaM daivI\?\" ityataH sheShaM pUrayati \dash \" ahaM hi\" iti |  
AshayavarNanasamAptau iti shabdaH |  atra pramANamAha \dash \" abravIchcha\" iti | 

uttarasya prakR^itopayogitayA saN^gatimAha \dash \" tarhi\" iti |  yadi na 
kevalamanumAnaM, kintu bhagavatopodbalitA mAyA mohahetuH tarhItyarthaH |  tatashcha
j~nAnivyAvR^ittyarthaM yadidamityuktaM tadasaditi bhAvaH |  \" nanu mAyA.atyayopAyasya
asambhAvanAshaN^kAyAM tadupAya eva vaktavyo na tUpAyAntarapratiShedhaH |  ato 
anupapannaM avadhAraNam\" ityata Aha \dash \" anyad\" iti |  svapratipattAvitthaM
bhAvasUchaka evaivashabdo nopAyAntarapratiShedhapara ityarthaH |  evaM tarhi 
gurvAdivandanAbhAvaH prApta ityato.abhiprAyamAha \dash \" gurvAdi\" iti |  \" bhAgavatA
ete\" ityAdibuddhyA vandanAdi kurvantIti yAvat |  etanmadhyamabhaktAnAM charitramuktam |
uttamAnAntvAha \dash \" sa eva\" iti |  bhagavAneva tatra gurvAdiShu |  dvayaM
pramANenopapAdayati \dash \" Aha cha\" iti |  \" ahaM cha sA\" \" sampattiH\" 
cha |  \" madupAdhitayA\" \" matpratimAtvena\" |  \" chaityam\" chittastham |
\" svagatim\" svaj~nAnam |  \" vyanaN^xi\" vyaJNjayasi || 14||

%%% ##endlabel##

%%% ##label=<segment014_pd07>##

{\Largedvng pra\.dI\. || } \" uttaravAkyaM prakR^itAnupayuktam\" ityata Aha \dash \" tarhi\" 
iti |  yadi tvatprapattirmAyAtaraNopAyaH tarhItyarthaH |  \" tvaM prapadya\" iti
sheShaH |  tathA cha \" mAmevetyuktamasad\" iti bhAvaH |  \" duShkR^ititvAdInAM
prayojanAntarAbhAvAddhetutvenAnvaye sthite kiM te paJNchApi sAxAt bhagavadaprapattihetavaH
kiM vA hetuhetumadbhAvena\?\" ityapexAyAmAha \dash \" duShkR^ititvAd\" iti |  
\" mUDhA\" mithyAj~nAninaH |  viparyayasyAdharmakAryatvaprasiddheH |  ata eva 
mUDhatvAdeva |  devAnAmuttamamadhyamamanuShyANAM cha kevalamithyAj~nAnitvAbhAvAt |
adhiShThAnayAthAtmyaj~nAnasya viparyayahetutvaprasiddherapahR^itaj~nAnatvAchcha mUDhAH |
ata eva narAdhamatvAdeva |  jIvatraividhyavivaxAyAM narAdhamAnAmasureShvantarbhAvasya
prasiddhatvAt |  \" AsurabhAvAshrayaNAnna mAM prapadyanta\" ityarthaH |  \" nanvAsuro
bhAvo hi himsAnR^itAdilaxaNo.anyairvyAkhyAtaH (shAM\.bhA\. 7\.15) |  tadrahitAshcha
xapaNakAdayo na bhagavantaM prapadyante |  tatkathamasya hetutvam\?\" ityata 
Aha \dash \" sa cha\" iti |  eteShAmanyatamaH sarveShvapyastIti bhAvaH |  \" nanu
muktau yogyAnAmayogyAnAM cha bhagavantamapratipadyamAnAnAM ete dharmAH vaktavyAH |
tatra muktiyogyAnAM samyag-j~nAnasvabhAvAt tatkathamapahR^itaj~nAnatvam\?\"
ityata Aha \dash \" apahAra\" iti |  AgamavAkyamapi sajjIvaviShayam |  
muktiyogyAnAM AsurabhAvAshrayaNaM pravR^ittyAdyaj~nAnenoktam |  prakArAntareNa 
ghaTayitumAha \dash \" asuShu\" iti |  indriyeShu tatprINana eva ratAH |  
\" asau\" iti jAtAvekavachanam |  padasandhervivaxA.adhInatvAdasandhiH
nadoShaH |  tribhirityatra bhagavato gauNavigrahatvaj~nAnasya kAraNamuktam |
\" atra tu svadoShAdeva na mAM prapadyante |  na tu matprapatteH
mAyAtaraNopAyatvAbhAvad\" ityato mahAn bhedaH || 15\-16||

%%% ##endlabel##

%%% ##label=<segment015_pd07>##

{\Largedvng pra\.dI\. || } \" ekA bhaktiryasya\" iti vigrahe bhaktishabdasya priyAditvAt
tasmin parataH pUrvapadasya puMvadbhAvo na sidhyatItyAlochyAha \dash \" ekasminneva\" 
iti |  \" asya\" ityadhyAhAryam |  \" tathApi vaiyadhikaraNyAdbahuvrIhirna
sidhyati\" iti chenna |  AgamasiddhatvAchchetyAha \dash \" tachcha\" iti | 
yasyetyupaskartavyam || 17\-18||

%%% ##endlabel##

%%% ##label=<segment016_pd07>##

{\Largedvng pra\.dI\. || } \" bahUnAM janmanAmityatra j~nAnotpattyanantaraM bhagavatprapattau
bahujanmavyavadhAnamuchyata\" (shAM\.bhA\. 7\.19) iti nirAsArthamAha \dash \" bahUnAm\" 
iti |  \" pratItameva kiM na syAt\?\" ityata Aha \dash \" tachcha\" iti |  tataH
tadaiva || 19||

%%% ##endlabel##

%%% ##label=<segment017_pd07>##

{\Largedvng pra\.dI\. || } \" nanu mUlaprakR^iteH sarvatraikatvAt kathaM svayA iti prItisvikatvamuchyata\?\" 
ityata Aha \dash \" prakR^ityA\" iti |  svabhAva evetyevashabdasambandhaH || 20||

%%% ##endlabel##

%%% ##label=<segment018_pd07>##

{\Largedvng pra\.dI\. || } \" rAmakR^iShNAdirUpAM bhagavattanum\" iti pratItinirAsAya 
Aha \dash \" yAM yAm\" iti |  \" kuta etat\?\"  \" antavattu phalaM teShAm\" iti
tadbhaktAnAmantavatphalavachanAt |  tasya cha brahmAdigrahaNe sambhavAt bhagavadgrahaNe 
chAsambhavAditi bhAvenA.aha \dash \" uktaM cha\" iti |  \" phalasya\" iti sheShaH |
gamyata iti \" gatiH\" |  \" ityAdeH\" prashnasya parihArarUpavAkyasandarbhAchcha |
bahutvAdanudAharaNamiti bhAvaH |  \" anantaphalatvaM mUlarUpabhaktAnAmastu |
avatAratanubhaktAnAmantavatphalAN^gIkAre ko virodha\?\" ityata Aha \dash 
\" avatAra\" iti |  \" kutra\" chAvatAre || 21\-23||

%%% ##endlabel##

%%% ##label=<segment019_pd07>##

{\Largedvng pra\.dI\. || } \" avyaktam\" iti shlokasya prakR^itena sAxAt saN^gatyabhAvAttaM
saN^gamayitumAha \dash \" ka\" iti |  \" anyebhyo\" brahmAdibhyaH |  \" yena tAn
prAptAnAmanantavatphalatve.api tvAM prAptAnAmantaphalatA\" iti shaN^kAsheShaH |
\" kathamanenoktashaN^kAparihAra\?\" ityata Aha \dash \" kArya\" iti |  anena 
yathAshrutaM padaM paThitvA vyAkhyAtam |  vastutastu \" avyaktam\" \" mAm\"
ityanuvAdAt \" avyakto.aham\" iti yatsiddhaM tasyedaM vyAkhyAnamiti j~nAtavyam |
idAnImuttarasya saN^gatimAha \dash \" tadvAn\" iti |  \" kAryadehAdimAn iva\"
iti mR^idUktiH vastutastveveti |  \" ato na tadvarjita\" iti sheShaH |  prakR^itopayogitayA
vyAchaShTe \dash \" kArya\" iti |  \" bhagavataH kAryadehAdivarjitatvaM tadvattApratItishcha
aj~nAnamUletyetat kutaH? yena vAkyadvayamuktArthaM syAd\" ityato.arthadvaye krameNa
pramANAnyAha \dash \" tachcha\" iti |  \" kAryAt kAraNAchchedamaparaM rUpaM paraM tu
rUpamajAnanta\" (7\.24) iti pratItinirAsArthamAha \dash \" bhAvam\" iti | 
yAthArthyaM pramANAvyabhicharitasvarUpam |  ata eva param |  \" kuto.ayamarthaH?
samAkhyAnAd\" ityAha \dash \" tathA\" iti |  yadyapyayamarthaH \" tribhiH\" 
ityatroktaH |  tathApi prasaN^gAtpunarukta ityadoShaH || 24||

%%% ##endlabel##

%%% ##label=<segment020_pd07>##

{\Largedvng pra\.dI\. || } tathApi \" nAhaM prakAshaH\" iti punaruktirityataH tAtparyaM Aha 
\dash \" aj~nAnaM cha\" iti |  \" yenAj~nAnena mAmanyathA manyante tadaj~nAnaM cha 
madichChAdhInameva, na svatantram |  yena tayA nindayA mama khedaH syAd\" 
iti bhAvaH |  \" yoga eva mAyA\" (shAM\.bhA\.7\.25) iti vyAkhyAnamasaditi 
bhAvena Aha \dash \" yogena\" iti |  sAmarthyamevopAyaH |

\" yujyate yena yogo.asAvupAyashshaktireva cheti vachanAdyogashabdasyobhayArthatvena
dvandvaikavadbhAvaH kiM na syAd\?\" iti chenna |  mAyayAchetyasya vaiyarthyApatteH |
tasyA apyupAyavisheShatvAt |  ata evopAyArthatvaM gR^ihItvA sAmarthyeti tadvyAkhyAnaM
kR^itam |  idaM tAtparyaM shloke na pratIyata ityata Aha \dash \" mayaiva\" iti | 
uktArthasthApanAya purANasammatimAha \dash \" tathA\" iti || 25|| 

%%% ##endlabel##

%%% ##label=<segment021_pd07>##

{\Largedvng pra\.dI\. || } \" akasmAtsvasya sArvaj~naM kimityuchyata\?\" ityata Aha \dash \" na\" 
iti |  \" yavanikAdyubhayabhAgavartinoH parasparAj~nAnavattavApi bhUtaviShaye j~nAnaM 
na syAd\" iti shaN^kAnirAsArthamiti sheShaH |  tathApi \" mAM tu veda na kashchana\" 
iti punaruktamityata Aha \dash \" na kashchana\" iti |  asamartho loko na jAnAtu | 
atisamarthastu brahmAdirj~nAsyatIti shaN^kAnirAsArthametaduktam |  \" kashchana\" iti 
visheShaNAditi bhAvaH |  tarhi \" j~nAnI cha bharatarShabha\" (7\.16) ityAdivirodha
ityata uktam \dash \" sva\" iti || 26|| 

%%% ##endlabel##

%%% ##label=<segment022_pd07>##

{\Largedvng pra\.dI\. || } \" ichChAdveShau\" dvandvam |  tajjanyo moho \" dvandvamohaH\" |
teneti kashchit (shAM\.bhA\.7\.27) |  tadasaditi bhAvenAha \dash \" dvandva\" iti |  
anyathA ichChAdveShasamutthena mohenetyeva syAditi bhAvaH |  vyAkhyAna\-
vyAkhyeyabhAvashchAgatikA gatiH |  \" dvandvamohasyechChAdveShasumutthatvaM 
katham\?\" ityata Aha \dash \" ichChA\" iti |  \" kiJNchitsukhAdikaM 
heyatvAdinA\" iti sheShaH |  \" nanu \" nAhaM prakAshaH\" (7\.25) iti 
bhagavato \" daivI hyeShA\" (7\.14) iti tadadhInAyAH guNamayyA mAyAyAshcha 
mohakatvamuktam |  tatkathaM bhagavadviShayasaMmohasyechChAdveShasamuttho 
dvandvamohaH kAraNamuchyata\?\" ityata Aha \dash \" kAraNAntaram\" iti |  
ichChAdveShasamutthadvandvamohalaxaNaM etadbhagavadviShayasya saMmohasyAvAntara\-
kAraNamuchyata ityarthaH |  \" kuta etad\?\" ityataH tatsUchakaM padaM 
paThati \dash \" sarga\" iti |  \" sargaH\" kriyA |  \" kathaM tasyA 
adhikaraNatvam\?\" ityato laxaNAmAshritya vyAchaShTe \dash \" sarge\" iti |  
\" taduttarakAlaM kiM tanna kAraNam\?\" ityataH punarlaxaNA.a.ashrayeNa Aha 
\dash \" Arabhya\" iti |  \" sargakAlam\" iti sambandhaH |  \" kathamanena
avAntarakAraNatvaM j~nAyata\?\" ityataH sAvadhAraNametadityuktameveti |  uktaM
upapAdayannAhA \dash \" sharIra\" iti |  Adipadena dveShasya dvandvAnAM cha 
grahaNam |  ataH sargakAlamArabhyaivaitat kAraNamiti siddham |  \" etAvatA 
kathamavAntarakAraNatvasiddhiH\?\" ityata Aha \dash \" pUrvaM tu\" iti | 
sargAtpUrvaM tvichChAdinA vinA.aj~nAnamastyeva bhagavadichChAdyadhInam |
ata etadavAntaraM kAraNamiti siddhamityarthaH || 27||

%%% ##endlabel##

%%% ##label=<segment023_pd07>##

{\Largedvng pra\.dI\. || } \" chaturvidhAH\" (7\.16) ityanena gatArthamuttaraM vAkyamityata
Aha \dash \" viparItAshcha\" iti |  \" tvatprapattermAyAtaraNakAraNatvAtsvadoShAdvA
tvAM na prapadyanta ityatra kathaM nirNaya\?\" ityatastaduktam |  sarvabhUtAni 
saMmohaM yAnti chellupto muktimArgaM ityAshaN^kyAtra dvandvamoharahitAshcha
kechitsantItyAhetyarthaH || 28||

%%% ##endlabel##

%%% ##label=<segment024_pd07>##

{\Largedvng pra\.dI\. || } \" mAM bhajante\" ityuktAnuvAdena phalamuchyate |  tatra \" jarAmaraNa\-
moxAya\" ityanuktasyAnuvAdasambhavAdaprAptatvena \" vidhyarthaM madbhajanaM cha jarAmaraNa\-
moxoddeshena kAryam\" ityevaM pratItinirAsArthamAha \dash \" jarA\" iti | 
laxaNayA svargAdikAmanivR^ittirartho.asyeti tathoktam |  moxaviShayAsaktiranyasakteH
prashasteti tatstutyarthaM vA |  sarvathA na vidhiH |  \" kuta\?\" ityata Aha \dash 
\" mumuxoH\" iti |  itarasyAmumuxorbhaktasya |  na hi prashaste satyaprashastaM
niyantuM yuktamiti bhAvaH |  \" iti chetarastuteH\" iti sambandhaH |  prakAra\-
bhedAtpR^ithaguktiH |  itashcha na moxakAmavidhirityAha \dash \" devAnAm\" iti | 
satva evaikamanasaH shuddhasAttvikasya puMso devAnAmindriyANAm |  guNaliN^gAnAM
gandhAdyupalabdhilaxaNaguNAnumeyAnAm |  tathA vachanAdikriyA.anumeyAnAM cha |
AnushrAvikakarmaNAM vaidikAnuShThAne kAraNAnAm |  yA bhagavatyanimittA phaloddesha\-
rahitA kevalaM svAbhAvikI niravadhikasneharUpasvabhAvanirvR^ittA vR^ittiH sA bhaktiH |
sA cha sakAmabhaktyA jAtAyAH siddheH mukterapi garIyasI |  yA sA kAmanA.abhAve.api
koshaM liN^gasharIraM svabhAvAdeva jarayatyanalavadityanimittatvasya bhaktilaxaNatvena
uktatvAchchetyarthaH |  na hi laxaNavaikalyaM vidheyamiti bhAvaH |

Aha cha spaShTametadanyatra |  \" devArthA\" devapratipattyarthAH |  pratipannA
devA nArAyaNaj~nAnArthAH |  moxArthe j~nAtavyaH |  nAnyArthaH |  \" paraH\" 
puruShArthaH |  madhyamabhaktAnAm |  chittavR^ittiH |  ekAntAnAM niyatAnAmuttama\-
bhaktAnAM na kasyachidarthe |  sa eva paramapuruShArthaH |  \" nanu \" mAmeva ye
prapadyante\" (7\.14) ityuktatvAt \" te brahma tadviduH\" (7\.29) iti
punaruktam\" ityata Aha \dash \" ta eva\" iti |  anyopAyanivR^ittyarthaM
etadityarthaH |  \" syAdevaM vyAkhyAnam |  yadi bhagavadbhajanena vinA j~nAnasya
anyopAyAbhAvaH pramitaH syAt sa eva cha kuta\?\" ityata Aha \dash \" yam\" 
iti |  \" bhaktameva cha vR^iNuta\" iti cha prasiddham || 29\-30||

%%% ##endlabel##

%%% ##label=<segment025_pd07>##

{\Largedvng pra\.dI\. | } 

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM saptamo.adhyAyaH ||}

%%% ##endlabel##

%%% ##label=<segment001_pd08>##

{\Largedvng pra\.dI\. || } adhyAyasyAvAntarapratipAdyamarthamAha \dash \" maraNa\" iti |  gamyata
iti \" gatiH\" |  \" Adi\" padena mArgAdikam |  \" maraNakAlakartavyaM cha gatishcha
te AdI yasya, tat\" tathoktam |  \" kartavyasmaraNaviShayatvagamyatvAdirUpo
bhagavanmahimaiva varNyata\" iti ShaTkAntarbhAvasiddhiH |  uktavyAkhyAnapUrvakamiti
chopaskartavyam |  tenAnantaryalaxaNA.api saN^gatiH siddhA \dash tatprasaN^genaiva
maraNakAlakartavyAdyupadeshAt |

\" nanu pUrvAdhyAye \" te brahma\" (7\.29) iti nirvisheShaNamevopaxiptam |  ata
evAtra \" kiM tadbrahma\" iti tathaiva pR^iShTam |  uttare tu kasmAt \" axaraM
paramaM brahma\" iti savisheShaNamupAdIyata\?\" ityata Aha \dash \" paramam\" iti |
\" axarasyaiva paramatvavisheShaNam |  na brahmaNa\" ityarthaH |  \" tarhi \" axaram\"
ityevAlam |  kiM visheShaNena\?\" ityata Aha \dash \" veda\" iti |  \" Adi\" padena
prakR^itiH gR^ihyate |  tayorapi brahmAxarashabdavAchyatvAtprasaktiH |

\" svabhAvo.adhyAtmam\" iti shabdadvayasyaikaviShayatvasiddhaye.adhyAtmashabdaM tAvad
dvedhA vyAchaShTe \dash \" Atmani\" iti |  \" AtmAnaM jIvaM adhikR^itya tadupakAritvena
vartamAnaM vastu\" ityarthaH |  \" AtmA.adhikAre\" iti granthavisheShasya saJNj~nA |
\" yatpratipAdyaM tadadhyAtmaM iti vA\" ityarthaH |  atrAdhyAtmashabdaM prathamAntaM
gR^ihItvA prathamaM vyAkhyAtam |  saptamyantamupAdAya dvitIyam |  AtmashabdaM
dehaviShayamAdAya vyAkhyAne parameshvaraprasakteH na tathA vyAkhyAtam |

\" evaM tarhi \" svabhAva\" ityubhayasya kathamuttaram\?\" ityataH tAvattadvyAkhyAnaM
pratijAnIte \dash \" tathA hi\" iti |  tatrAdyottaratvenAdau vyAchaShTe \dash
\" jaiva\" iti |  jIvasyAyaM \" jaivaH\" antaHkaraNAdiH dehaparyantaH padArthaH
svabhAvaH |  \" svasya bhAva\" iti vyutpattyA |  \" te brahma tadviduH\" iti 
jIvAnAM prakR^itatvAt, \" sva\" shabdo jIvavAchI |  tathA cha \" Atmanyadhi yattat,
ityevaM vyAkhyAtAdhyAtmashabdArthaprashnasyedamuttaraM bhavati\" iti bhAvaH |

idAnIM dvitIyottaratvena vyAkhyAti \dash \" svAkhya\" iti |  pUrvavadatrApi
\" sva\" shabdo jIvavAchI |  tathA cha \" AtmA.adhikAre, iti
vyAkhyAtAdhyAtmashabdArthaprashnasyedamuttaraM bhavati\" ityAshayaH |

\" nanu jaivavAchitve \" bhAva\" shabdaH sArthakaH |  ShaShThyAH sAkAN^xatvAt |
jIvavAchitve tu padArthatvAvyabhichArAtsvashabdenaivAlaM, kiM \" bhAva\" shabdena\?\"
ityato \" bhAva\" shabdaM tAvadanyathA vyAchaShTe \dash \" sarvadA\" iti |  yadyapi
bhavanakartA \" bhAvaH\" |  tathA.api visheShAnupAdAne mukhyasya grAhyatvAt 
\" sarvadA\" ityAdi sidhyati |  \" tathA.api tasya kiM prayojanam\?\" ityata
Aha \dash \" antaHkaraNAdi\" iti |

\" svashabdamAtropAdAne tasyAtmIye.api prayogAdantaHkaraNAdikamapi prasajyeta,
tathA cha na dvitIyasyedamuttaraM syAt\?  Atmaiva hyAtmA.adhikAre pratipAdyo
vaktavyo, nAntaHkaraNAdikam |  atastadvyAvR^ittyartho \" bhAva\" shabdaH prayuktaH |
kathaM tena tadvyAvR^ittiH\?\" ityata Aha \dash \" na hi\" iti |  \" annamayaM hi
somya manaH\" (chhA\.u\. 6\.5\.4) ityAderiti bhAvaH |  \" tathA chAntaHkaraNAdau
vyAvR^itte \" sva\" shabda AtmArthatayA vyAkhyAto bhavati\" iti hR^idayam |

\" evaM tarhi bhAva ityevAstu, kiM svashabdena\?\" ityata Aha \dash \" svashabda\"
iti |  Ishvaro.api hi sarvadaikaprakAreNAstyeva |  ato \" bhAva\" ityevokte
tatprasaktau pUrvavaddvitIyottaratvAsambhave tadvyAvR^ittyarthaH \" sva\" shabdaH |  na 
hIshvaro jIvAnAM \" svaH\" |  bhedapramANavirodhAt |  ata eva \" IshvarasvabhAvo
jIva\" iti vyAkhyAnamapAstam |

\" nanvevamapi svashabdasyA.a.atmIyArthatvAdIshvaraprasaktiH\" |  maivam |  dviShTho yadyapi
sambandhaH \" ShaShThyutpattiH pradhAnataH\" iti vachanAt |  tasyA.a.atmIyatvAbhAvAt |
ShaShThyantAtkhalvayaM ChaH |

\" sakalakAryotpattinimittabhUto devatoddeshena cha puroDAshAdidravyatyAgaH
tajjanyamapUrvamiti yAvad\" (shAM\.bhA\.8\.3) iti vyAkhyAnamasat |  tasyAdhyAtmapadenaiva
gR^ihItatvAditi bhAvena \" bhUtabhAva\" ityAdikaM vyAkhyAti \dash \" bhUtAnAm\" iti |
udbhavakArI cha sA IshvarakriyA cheti vigrahaH |  IshvarakriyAgrahaNaM karmashabdena
aikArthyapratipattyartham |  evaM laxaNo yo visargaH sa karmasaJNj~nito na tu
kulAlAdisambandhItyarthaH |  \" nanu visargashabdaH tyAgArthaH |  tatkathamevaM
vyAkhyAnam\?\" ityata Aha \dash \" visheShaNa\" iti || 1\-3||

%%% ##endlabel##

%%% ##label=<segment002_pd08>##

{\Largedvng pra\.dI\. || } parihAraM saN^gamayitumadhibhUtashabdArthaM tAvadAha \dash \" bhUtAni\" 
iti |  \" adhikR^itya\" tadupakAritvena yadvartate |  \" xaraH sarvANi bhUtAni\" 
(15\.16) iti vaxyamANaM xaraM vyAvartayituM vyAchaShTe \dash \" xara\" iti |  
\" xara\" shabdavyAkhyA \" vinAshI\" iti |  

\" bhAva\" shabdasyArthadvayaM \" kArya\" iti, \" padArtha\" iti |  bhavati, 
utpadyate iti \" bhAvaH\" |  \" utpattimAn padArtho nAshavAn padArtha\" iti
pratyekamuttaram |  sarvabhUtAnAmadhyAtmatvAnna grahaNam |

\" nanvavyaktamapi sasharIrAn jIvAnadhikR^itya vartata iti tasyApyadhibhUte
antarbhAvo.astyeva |  na chaitadvinAshi kAryaM vA |  \" nAsata\" (2\.16) 
ityuktatvAt |  tato.avyApakamuttaram\" ityata Aha \dash \" avyakta\" iti |
\" avyaktasya adhibhUtAntarbhAve.api nAvyApakamuttaram\" iti sheShaH |  \" kuta\?\" 
ityata Aha \dash \" tasyApi\" iti |  anyathAbhAvo vaiShamyaparityAgena 
sAmyAvasthApattiH |  \" yata\" iti sheShaH |  tathA vikriyAlaxaNaM janma 
chetyapi grAhyam |  ubhayatra krameNa pramANAnyAha \dash \" tachcha\" iti |  
\" vyomni\" vyApte |  praLaye prachuravyApArAbhAvAt \" niShkriye\" |

\" nanu puruShaH paramAtmA |  sa \" brahma\",\" adhiyaj~na\" shabdAbhyAM ukta\" ityata
Aha \dash \" puri\" iti |  sharIre |  \" adhikaraNe sheteH\" (ashhTA\. 3\.2\.15)
iti DaH |  \" varNAgamo varNaviparyayashcha\" ityAdinA sAdhuH |  \" tathA.api
adhyAtmashabdena gatArthatA\" ityata Aha \dash \" sa cha\" iti |  
sarvajIvAbhimAnitvAditi bhAvaH |  \" tasyAdhidaivatvaM katham\?\" ityato 
dvedhA.a.aha \dash \" sa\" iti |  adhikR^itya vartate ityasyaiva vivaraNaM \" patiH\" 
iti |  \" devAdhikArasthaH\" tatprakaraNeShu mukhyataH pratipAdyaH |  
sarvadevatAsaN^grahArthaM vA dvitIyaM vyAkhyAnam |  \" axara\" arthastu pUrvavat |

%%% ##endlabel##

%%% ##label=<segment003_pd08>##

{\Largedvng pra\.dI\. || } \" adhiyaj~naH katham\?\" ityasyottaraM bhagavatA.anuktaM bhAShyakR^idAha 
\dash \" sarva\" iti |  \" Adi\" padena tatpravartakatvAdi |  nAdhyAtmashabdavad
adhiyaj~nashabde.avyayIbhAvaH |  kintu \" adhigato yaj~nam\" iti prAdisamAsaH |  
\" adhiShThito yaj~no.anena\" iti bahuvrIhirvA |

\" adhiyaj~naH ka\?\" iti prashne tatparihAre cha \" deha\" ityasya prayojanamAha \dash
\" anya\" iti |  \" anyo\" bhagavata iti siddhArthatAparihArArthaM prashnavAkye 
\" deha iti visheShaNam\" prayuktam |  \" kartR^ibhoktR^iphaladAtR^INAM dehaprerakatvena 
vartamAna\" iti |  \" ataH parihAravAkye.api yathAprashnaM tadupAttam\" iti 
vAkyasheShaH |

\" bhagavataH sarvayaj~nabhoktR^itvaM kuto yenaivamuttaramadhyAhriyata\?\" ityata Aha \dash 
\" bhoktAram\" iti |  \" traividyAnuShThitayaj~nabhoktR^itvAbhAvAt \" sarva\" 
ityanupapannam\" ityata Aha \dash \" traividyA\" iti |  pravartakatve shrutimAha 
\dash \" etasya\" iti |  yaj~naphaladAtR^itvAdau pramANamAha \dash \" kuto hi\" iti |  
\" dhruvaH\" chirantanaH |  \" naishreyasam\" muktau bhavaM \" padam\" sukhaM ityAdeH 
prashnasya |

\" nanveSha parihAro bhagavataiva kuto nokta\?\" ityata Aha \dash \" bhagavAn ched\"
iti |  \" chet\" shabdaH \" yadA\" shabdArthe |  \" adhiyaj~no.ahamiti yadA
adhiyaj~natvena bhagavAnuktaH tadA tasya sarvayaj~nabhoktR^itvAderadhiyaj~natvamarjunasya 
siddhameva |  \" bhoktAram\" ityAderarthasya tena shrutatvAt |  anyatvapaxa eva 
kathamiti pR^iShTatvAt |  evamAlochya bhagavatA \" katham\" ityasya prashnasya 
parihAro \" adhiyaj~no.aham\" ityataH pR^ithaN^ noktaH |  asmAbhistu mandAn 
bodhayitumukta\" iti bhAvaH |

\" nanu yadyadhiyaj~naH svayameva kathaM tarhi \" sAdhiyaj~naM mAm\" (7\.30) iti
prAgavochad\?\" ityata Aha \dash \" sarva\" iti |  \" rUpavisheShApexayA 
sAhityamuktam\" iti bhAvaH |  anena parihAravAkyasthasya \" dehe\" iti 
visheShaNasya prayojanAntaraM choktaM bhavati |

%%% ##endlabel##

%%% ##label=<segment004_pd08>##

{\Largedvng pra\.dI\. || } \" atra iti dehavisheShaNaM kimartham\?\" ityata Aha \dash \" atra\" 
iti |  iha laukike deha ityarthaH |  \" kuta Ishvaradeho vyAvartanIya\" ityata 
Aha \dash \" na hi\" iti |  \" tatra\" svadehe |  \" pR^ithak\" pR^ithagbhAvena |  
\" yathA \" adhiyaj~no.ahameva\" ityuktaM na tathA \" brahmAham\" iti |  ato 
bhagavato.anyadevedam |  \" brahma paramam\" iti tu svarUpakathanam |  na tu 
visheShaNam\" iti shaN^kAM nivArayati \dash \" nAtra\" iti |  pUrvAdhyAye \" te brahma 
tadviduH\" (7\.29) \" ityuktvA\" \" kathambhUtaM brahma\?\" ityAkAN^xAyAM 
\" sAdhibhUtAdhidaivaM sAdhiyaj~naM cha brahma\" iti vaktavye \" mAm\" iti brahmaNaH \" 
parAmarshAt\" |

\" tatrAstu bhagavAneva brahma |  atra tu kuta\?\" ityata Aha \dash \" tasyaiva\"
iti |  pR^iShTasyaiva vaktavyatvAt |  \" tarhyadhiyaj~nasya brahmaNashcha bhagavattvAdekatra 
\" ahameva\" ityuktiraparatra tadanuktiH kinnibandhena\?\" ityata Aha \dash 
\" sAdhiyaj~nam\" iti |  sheShaM tAtparyanirNaye |  etenApavyAkhyAnamapi
nirastam |  dvAdashAdau cha vistareNa |

AgamasammatyoktaM sthApayati \dash \" Aha cha\" iti |  yAni \" dehasthaviShNurUpANi\" 
saH \" adhiyaj~naH itIritaH\" |  tadapIchChAprayatnAdyameva |  na tu pariNAmarUpam |  
\" jaDam\" dehAdbAhyam |  \" na kevalameShAM padAnAM etAvanmAtrArthatvaM, 
kintu \" yathApratItam\" pratItimanatikramya shabdashaktyA yAvatpratItaM, 
pramANAviruddhaM cha tadatra vyAkhyAyamAnaM vakturabhiprAyaM na vyabhicharati\" 
ityarthaH |  kiJNchidvyavahitatvAnmadhye.api \" iti\" shabdaH |

etadeva vAkyAntareNa spaShTayati \dash \" skAnde cha\" iti |  Atmano.abhimAnasya
viShayaH |  AtmAdhikArasthaM tatra pratipAdyam |  \" dehAdbAhyaM vinA\" iti
sAmarthyAdAtmAbhimAnasthena sambadhyate |  tatra yuktiH \" atIva bAhyatvAt\"
atyabhimAnaviShayatvAbhAvAt |  \" mahAbhUtAdhikAragam\" mahAbhUtam |
kAryakAraNagrahaNahetuH |  \" tadantikAt\" tattAdAtmyAt |  devAnAmupakArakR^it || 4||

%%% ##endlabel##

%%% ##label=<segment005_pd08>##

{\Largedvng pra\.dI\. || } \" madbhAvam, ityasya madAtmakatvam\" iti anyathApratItinirAsAya
Aha \dash \" madbhAvam\" iti |  \" nanu bhagavati sthitiH sarvadA.asti |  sA 
kathaM phalam\?\" ityato vishinaShTi \dash \" nirduHkha\" iti |  kvachitpATho 
\" madbhAvam madvadbhAvam\" iti |  tatra \" bhagavatpratibimbAnAM jIvAnAM 
tatsAdR^ishyaM sadA.asti |  tatkathaM prApyamuchyata\?\" ityata uktaM \dash \" nirduHkha\" 
iti |  atra \" Atmakam\" iti pAThaH |  \" abhivyaktam\" iti sheShaH |  
\" pratIta evArthaH kiM na syAd\?\" iti chenna \dash muktAnAM bhagavadAshritatvena 
tadbhAvAyogAt |  \" tadapi kuta\?\" ityata Aha \dash \" tachcha\" iti |  
\" xetraj~naH\" paramAtmA \" gatiH\" iti samarthitaH || 5||

%%% ##endlabel##

%%% ##label=<segment006_pd08>##

{\Largedvng pra\.dI\. || } \" nanu kaLebaratyAgasyAntAvyabhichArAt \" anta\" iti vyartham\" 
ityata Aha \dash \" smaran\" iti |  na \" ante\" ityetat \" kaLebaraM tyajati\" 
ityasya visheShaNam yena vyarthaM syAt |  kintu \" ante smaran\" iti 
smaraNasyaiva |  \" tatrApi kiM prayojanam\?\" iti cheduchyate |  \" laxaNahetvoH 
kriyAyAm\" (ashhTA\. 3\.2\.126) iti laxaNe.api shaturvidhAnAt \" smaran 
puruShaH kaLebaraM tyajati\" iti smaraNakaLebaratyAgayoH bhinnakAlatve.api na 
kashchichChabdavirodha\" iti mandamateH shaN^kA syAt\?  \" sA mA bhUd\" ityevamarthaM 
\" ante\" iti smaraNasya visheShaNamupAttam |  \" tenAtra smaraNakalevaratyAgayoH 
ekakAlatvasiddhiH\" iti |

\" mandamateH\" ityasya kR^ityamAha \dash \" sumateH\" iti |  \" kutaH\?\" ityata 
Aha \dash \" smaran\" iti |  \" laTaH shatR^ishAnachau\" (aShTA\. 3\.2\.124) iti 
laDAdeshatvenA.api shaturvidhAnamasti |  sa cha \" laD\" iti vartamAne\footnote{\normaldvng vartamAne laT (aShTA\. 3\.2\.123)} punaH
laN^grahaNasAmarthyAt kvachit prathamAsAmAnAdhikaraNye.api bhavati |  laxaNe 
vihitatvAchcha laDAdesho balIyAn |  tatra kriyAyAmityupapadasApexatvAt |  
asyAnapexatvAt |  \" aprathamAsamAnAdhikaraNa\" (aShTA\. 3\.2\.124) ityasya 
atiprasaktiparihAramAtrArthatvAt |  \" tathA cha balavato grAhyatve \" smaran tyajati\" 
ityasya smarati cha tyajati cha\" ityarthaH syAt\?  evaM cha \" anta\" ityanukte.api 
smaraNatyAgayoH ekakAlInatvapratIteH \" sumaternaiva shaN^kAvakAsha\" iti bhAvaH |

\" nanu durmatirapi shAbdaM nyAyaM jAnAtyeva anyathA shAstre nAdhikriyeta\?
kevalamadhyAtmaviShaye na pravINaH |  tatkathaM tasyA.apyeShA shaN^kA syAt\?  
tatashcha taM pratyapi \" anta\" ityetadvyartham\" ityata Aha \dash \" durmateH\" 
iti |  durmaterbhavishyati shaN^kA bhinnakAlatvaviShayA |  \" kutaH\" \?  
\" maraNakAle mahadduHkhaM jAyate |  duHkhasya cha saMskAravilopahetutvaM prasiddham |  
ato duHkhAt kAraNAt mUrChito na smaran tyajati |  kaLebaratyAgasamaye 
smaraNamasambhavi iti yAvat |  etAmanupapattiM pashyan balavantamapi laDAdeshaM 
vihAya laxaNArthameva hi manyata\" iti bhAvaH |

\" nanu sumaterapyevaM shaN^kA syAdeva |  kathaM cheyaM shaN^kA tatvapratItireva\?\" iti 
chenna |  aj~nAnina eva dehAbhimAnino dehatyAgamAtmatyAgamiva manyamAnasya maraNakAle 
duHkhaM bhavati |  tadapi maraNaxaNAtpUrvameva |  j~nAnI tu sarvadA dehaM heyameva manyamAnaH 
na manAgapi duHkhAyate |  kintu vishiShTameva tasyotkramaNamityadhyAtmashAstramanusandadhAnasya 
sumateH shaN^kA.anavakAshAt |  \" kiM tadadhyAtmashAstram\?\" ityata Aha \dash 
\" tyajan\" iti | \" kashchit\" vidvAn |  avidvAnapi tatkAle |  \" tasya\" iti 
maraNavaishiShTyamAtraparam |

\" nanu \" anta\" ityetat smaraNavisheShaNaM chet \" sadA tadbhAvabhAvitaH\" ityanenaiva 
gatArthaM syAt\? anyathA tadvyarthaM bhavet\" ityata Aha \dash \" sadA\" iti |  
\" antakAlasmaraNameva tatprAptisAdhanam |  na cha tadakasmAdbhavati |  ataH
tadupAyatvena \" sadA tadbhAvabhAvitatvam\" uchyata\" iti bhAvaH |  \" katham\?\" 
ityato yathA.ayaM tadupAyaH syAttathA vyAchaShTe \dash \" bhAva\" iti |  \" tathA.abhidhAnAt\" 
iti |  syAd \" bhAvo.antargataM manaH\", ityevaMrUpAbhidhAnAt ityarthaH |  
\" vAsitatvam\" saMskR^itatvam |  tasmin bhAvaH \" tadbhAvaH\" |  \" tena 
bhAvita\" iti manodharmeNAtmopacharyate || 6\-7||

%%% ##endlabel##

%%% ##label=<segment007_pd08>##

{\Largedvng pra\.dI\. || } \" kuto.ayamartha\?\" ityata \" uttaratraivameva vyAkhyAnAd\" iti bhAvena
Aha \dash \" sadA\" iti |  dvandvAdishaN^kAvyudAsArthamAha \dash \" abhyAsa eva\"
iti |  \" abhyAsAtiriktasya yogasya prakR^ite upayogino.abhAvAt\" iti 
bhAvaH |  \" puruShashchAdhidaivataM iti prakR^ito hiraNyagarbho.atrochyata\" (shAM\.bhA\.8\.4)
iti pratItinirAsArthamAha \dash \" divyam\" iti |  \" divyatvena visheShaNAdIshvara
evAyam\" ityarthaH |  \" pR^i pAlanapUraNayoH\" ityato \" vidipuroshcha\" iti
kuShanpratyayavidhAnAt \" pUrNaM cha\" iti sidhyati | \" sarvAsu pUrShu vartamAna\"
iti svarUpAnuvAdena \" puruSha\" iti vidheyam |  tasya vyAkhyAnaM \" purishayam\" 
ityAdi |  \" AvaraNam\" antarvyAptiH |  \" saMvaraNam\" bahirAchChAdanam |

\" nanu divi bhavo divyaH |  sa cha sUryamaNDalasthatvAddhiraNyagarbho.api bhavati\"
(shAM\.bhA\.8\.8, 8\.4) iti kvachit |  ata Aha \dash \" divyam\" iti |  auNAdiko 
yak-pratyayaH |  \" paramam\" iti visheShaNAditi bhAvaH || 8||

%%% ##endlabel##

%%% ##label=<segment008_pd08>##

{\Largedvng pra\.dI\. || } \" uttarashlokagatavisheShaNabalAchcha paramAtmaivAyam\" iti bhAvena
tattAtparyamAha \dash \" dhyeyam\" iti |  \" Aha\" vishinaShTi ityarthaH |  \" nanu
kavitvamanyeShAmapyasti |  tatkathaM bhagavato visheShaNam\?\" ityata Aha \dash
\" kavim\" iti |  \" parameshvarasya sArvaj~ne pramite bhavedidaM vyAkhyAnam |
tadeva kuta\?\" ityata Aha \dash \" ya\" iti |  \" sarvaj~naH kavishabdArtha
ityetatkuta\?\" ityata Aha \dash \" tvam\" iti |  anyeShAM tu \" sarve
vimohitadhiyaH\" ityAdinA sArvaj~nAbhAvaH pramitaH |

\" nanu dhAtA viriJNcho.api prasiddhaH |  tatkathametadbhagavato visheShaNam\?\"
ityata Aha \dash \" dhAtAram\" iti |  \" kuto.ayamartha\?\" ityata Aha \dash
\" DudhAJN\" iti |  tR^ichaH kartR^ivAchitvaM prasiddhameva |  \" parameshvarasya
dhAtR^itvasadbhAve kiM pramANam\?\" ityata Aha \dash \" dhAtA\" iti | \" vidhAtA\"
kartA |  \" paramA sandR^ik\" paramaj~nAnarUpaH |

\" sarvasya dhAtAraM ityetadbhagavata eva nAnyeShAm\" ityatra pramANamAha \dash
\" brahmA\" iti |  tena bhagavatA diShTaM dattaM phalaM sukhaM yasyAM sA tathoktA |
\" moxadharme kathitam\" iti sheShaH |

\" tamasaH parastAt\" ityetad \" AdityAdisAdhAraNam\" ityato dvedhA 
sapramANakaM vyAchaShTe \dash \" tamasa\" iti |  \" sthitam\" iti sheShoktiH |
aprAkR^itavigrahamityarthaH || 9||

%%% ##endlabel##

%%% ##label=<segment009_pd08>##

{\Largedvng pra\.dI\. || } \" uttarashlokoktaM sarvaM sarvochchikramiShusAdhAraNam\" iti 
pratItinirAsArthamAha \dash \" vAyujayAdi\" iti |  

sAdhakAH dvividhAH \dash bhaktyAdipradhAnA vAyujayAdipradhAnAshchetyato 
visheShaNam |  \" visheShataH\" ityanena bhaktyAdInAM sAdhAraNyamAha |

\" nanu cha \" anusmaret yaH sa taM paraM puruShamupaiti\" ityanvayAdekasya vAkyasya 
kathaM bhinnaviShayatvamuchyate\?\" ekasminnapi vAkye yogabalenaiva \" bhruvormadhye
prANamAveshya\" ityetanna sarvaviShayamityetAvanmAtramatra pratipAdyate |  yathA
\" prAtarutthAya\" iti shrutau \" na bhR^ishaM vaded\" ityAdikaM kiJNchitsAdhAraNaM
kiJNchidasAdhAraNam |  \" kuto.asyAsAdhAraNyaM kalpyata\?\" ityata Aha \dash
\" vAyujayAdi\" iti |  \" ato na tatsarvasAdhAraNam\" iti sheShaH |  
\" tarhi ko visheSho.anyeShAM yena vAyujayAdikleshamadhikamanubhavanti\?\" ityata 
Aha \dash \" tadvatAM tu\" iti |  \" nipuNAnAM vAyujayAdau kathaJNchid alpA\" 
ityarthaH |  \" kiJNchit shIghraM cha\" ityapi grAhyam |

atra pramANAnyAha \dash \" uktam\" iti |  \" yathA\" yathArthaM \" bodham\" |
\" dhiShNyam\" mandiram indriyam |  \" tvAM vishantyeva na tu ta ivAJNjasA\" |
\" tadbhAvitA\" tena bhagavatA vAsitAH |  etanmuktilaxaNaM phalam |  \" tejo\"
nArAyaNAkhyam | \" IraH\" samIraH |  \" dhruvam\" brahma \" Apyate\" taiH || 10||

%%% ##endlabel##

%%% ##label=<segment010_pd08>##

{\Largedvng pra\.dI\. || } \" kramamuktyarthamoN^kAropAsanamuchyata\" (shAM\.bhA\.8\.11)
ityanyathAvyAkhyAnaM apAkartumAha \dash \" tadeva\" iti |  vAyujayayutAnAM maraNakAle 
kartavyameva |  \" mAmanusmaran\" ityAdi virodhAditi bhAvaH |  \" nanu padatvaM 
shabdasyaivoN^kArasya sambhavati, na viShNoH\" ityata Aha \dash \" prApyata\" iti |  
karmaNyakArapratyayaH |  \" padaM svarUpam\" iti prayogadarshanam \" tadviShNoH\" 
iti || 11||

%%% ##endlabel##

%%% ##label=<segment011_pd08>##

{\Largedvng pra\.dI\. || } \" nanu \" mano nirudhya\" ityanenaiva sarvendriyasaMyamanaM labdham |  
tatkiM punaruchyate\?\"  maivam |  vAyusaJNcharaNadvArANAM nADInAmatra grahaNAt |  
\" tanniyamanaM kimartham\?\" ityata Aha \dash \" brahma\" iti |  \" iti\" hetau |  
\" ityuktam\" iti sheShaH |  atra pramANamAha \dash \" nirgachChan\" iti |  
\" sUryam\" gachChati |  \" moxadharme chAyamevArtha ukta\" iti sheShaH |

\" hR^idi\" ityasya prasiddhArthatAnirAsArthamAha \dash \" hR^idi\" iti |  harateH 
\" kvip cha\" (aShTA\. 3\.2\.76) iti kvip |  \" prasiddhArtha eva kiM na syAt\?\" 
ityata Aha \dash \" na hi\" iti |  \" kuto na sambhavati\" ityata Aha \dash 
\" yatra\" iti |  \" Adau \" hR^idi nirudhya\" ityadhyAhAro doShaH |
\" maraNavelAyAmakhaNDasmR^itirvaktavyA |  tatkathaM dhAraNochyata\?\" ityata Aha \dash
\" yoga\" iti || 12\-13||

%%% ##endlabel##

%%% ##label=<segment012_pd08>##

{\Largedvng pra\.dI\. || } \" nityayuktasya\", \" yoginaH\" ityetayoH ekArthatAnirAsArthaM
Aha \dash \" nitya\" iti |  \" nityopAyavatvena sampUrNayogasya\" ityarthaH || 14||

%%% ##endlabel##

%%% ##label=<segment013_pd08>##

{\Largedvng pra\.dI\. || } \" sa yAti paramAM gatim\", \" tasyAhaM sulabhaH\" iti dvedhA vachanAt 
\" paramagatiH, bhagavallAbhashcha pR^ithag\" iti na mantavyam |  bhagavatprAptereva
uttaratra stuteH |  anyathobhayastutiprasaN^gAd ityabhiprAyeNAha \dash \" tatprAptim\" 
iti |  \" tarhi kathaM \" mAmupetya\" ityuktvA \" saMsiddhiM paramAM gatAH\" 
iti pR^ithaguktiH\?\" ityata Aha \dash \" paramAm\" iti |  \" ye mAmupetAH 
te paramAM siddhiM moxalaxaNAM hi gatAH |  na cha muktAnAM nirbIjaM janma 
sambhavati ityevaM tatra svayaM prAptAnAM janmAbhAve heturayamuchyate |  na tu 
bhagavatprApteranyA paramasaMsiddhiprAptiH\" ityarthaH || 15||

%%% ##endlabel##

%%% ##label=<segment014_pd08>##

{\Largedvng pra\.dI\. || } \" AbrahmabhuvanAllokAH punarAvartina, iti satyalokasahitAnAM
punarAvR^ittiruchyata\" (shAM\.bhA\.8\.16) ityetadapavyAkhyAnaM iti bhAvenAha \dash 
\" mahAmerustha\" iti |  parataH sthitAnAm |  \" evaM janalokamArabhya\" 
ityapi grAhyam |  \" kuta etad\?\" ityataH shlokamAgamenaiva vyAchaShTe \dash 
\" tachcha\" iti |  pR^ithivIsambandhinAM tadasambandhinAM lokAnAM grahaNAyobhayopAdAnam |
parataH sthitAnAm |  \" yadyapi\" iti sheShaH |  \" abhAvo janerlabhyata\" 
iti sheShaH |  anenaivaM vyAkhyAtaM bhavati \dash \" mahAmerusthabrahmasadanaM 
janalokaM chArabhya na punarAvR^ittiH\" |

\" ato \" mAmupetya punarjanma\" iti kimuchyata\?\" iti chet\?  satyam |
\" AbrahmabhavanAdevamAjanAchchArvAgbhavA eva lokAH \" punarAvartinaH\" |  
pare, na punarAvartinaH\" iti yAvat |  tathA.api noktamayuktam |  \" yatasteShu 
lokeShu sthitaM mmAmupetyAvasthitasya punarjanma na vidyata\" iti |  anyathA 
\" mAmupetya punarjanma\" ityuktatvAt uttarArdhavaiyarthyaM cha || 16||

%%% ##endlabel##

%%% ##label=<segment015_pd08>##

{\Largedvng pra\.dI\. || } uttaraprakaraNasyAsaN^gatimAshaN^kyAha \dash \" mAM prApya\" iti |  
\" avasthitAnAm\" iti sheShaH |  pratij~nAmAtreNa hi taduktam |  
\" avyaktasAmarthyasya atra kathanAtkathaM \" Atma\" ityuchyata\?\" ityata uktam 
\dash \" avyaktAkhya\" iti |  \" praLayAdi\" iti |  tatkAraNatvaM AtmanaH |  
sR^iShTipraLayayoH idaM pUrvatvAbhAvaj~nApanAya gItAmullaN^ghyoktam |

\" atra \" sahasra\" shabdo dashashatavAchI\" iti pratItinirAsAyAha \dash 
\" sahasra\" iti |  bahushabdaparyAyo.ayam, na tu prasiddhArthaH |  
\" viriJNchAhorAtrayoH prasiddhasya sahasrachaturyugaparyantatvAtkathametad\?\" 
ityata Aha \dash \" brahma\" iti |  tathA cha dviparArdhapraLayasyAdisR^iShTeshchAtra 
vivaxitatvAduktaM yuktam |

\" nanu parasya brahmaNo nityatvAdahorAtre na staH |  tatkathaM tatparametad\?\" 
ityata Aha \dash \" sA\" iti |  \" sA\" nirvyApArAvasthA paripUrNarUpasyApi 
hareH rajanItyarthaH |  anenAharapi siddham |

\" bhavedetadyadyatra dviparArdhapralayasyAdisR^iShTeshcha vivaxetyatra pramANaM syAd\"
ityata Aha \dash \" dviparArdha\" iti |  \" evamAdisR^iShTeshcha\" ityapi grAhyam |  
\" na hyavAntarasR^iShTipraLayayoH sarvakAryotpattivinAshau\" iti bhAvaH |  
AgamAntarasammateshcha evamityAha \dash \" uktaM cha\" iti |  \" ito.apyevam\" 
ityAha \dash \" ya\" iti |  \" na hyavAntarapraLaye sarveShAmAkAshAdInAM bhUtAnAM 
nAshaH |  nApi viriJNchasya paJNchabhUtanAshe.apyavinAshitvam\" iti bhAvaH || 17\-20||

%%% ##endlabel##

%%% ##label=<segment016_pd08>##

{\Largedvng pra\.dI\. || } idAnIM \" avyaktAkhyAtma\" iti yaduktaM tatsAdhayitumAha \dash
\" avyakta\" iti |  \" mAmupetya\" ityuktArthasya \" yaM prApya na nivartante\"
ityavyaktaviShayatayA \" parAmarshAt\" |  \" na kevalam \" avyakta\" shabdo 
yuktibalAdbhagavati nIyate, kintu vAchakashcha tasya\", ityAha \dash \" avyaktam\" 
iti |  \" kathaM tarhi bhagavatA.avyaktasya svasthAnatvamuchyata\?\" ityata Aha \dash 
\" dhAma\" iti || 21||

%%% ##endlabel##

%%% ##label=<segment017_pd08>##

{\Largedvng pra\.dI\. || } \" bhaktyA yukta (8\.10), iti bhakteH bhagavatprAptisAdhanatvasya
uktatvAtpunaruktamuttaraM vAkyam\" ityata Aha \dash \" parama\" iti |  anyaiH 
sAdhanaiH sahoktatvena tatsAmyashaN^kAyAM sAdhaneShu bhakteH paramatvaM anenA.aha |  
tachcha \" punarvachanenaiva dyotyam\" iti bhAvaH || 22||

%%% ##endlabel##

%%% ##label=<segment018_pd08>##

{\Largedvng pra\.dI\. || } \" yasmin kAle mR^itA AvR^ittyanAvR^ittI yAnti tatpratipAdanArthaM
uttaro grantha\" (shAM\.bhA\.8\.23) ityanyathApratItinirAsArthamAha \dash \" yad\" 
iti |  yAshcha tAH kAlAbhimAninyashcha iti vigrahaH |  \" devatAgatA\" iti |  
\" tadadhiShThitamArgAbhyAM gatA\" ityarthaH |  \" kAla, ityuktatvAtkathaM 
\" Adi\" padapraxepeNa vyAkhyAnam\?\" ityata Aha \dash \" kAla\" iti |  
\" kuta\?\" ityata Aha \dash \" agnyAdeH\" iti |  agnijyotirdhUmAnAm || 23||

%%% ##endlabel##

%%% ##label=<segment019_pd08>##

{\Largedvng pra\.dI\. || } \" jyotiH\" shabdasyAnekArthatvAt vivaxitamarthamAha \dash \" jyotiH\" 
iti |  \" abhisambhavanti\" prApnuvanti |  shrutipurANayoH \" ahnaH
prAgarchiShaH prApteH\" ukteH tatsamAkhyAnAdityarthaH |  \" prAtItika evArthaH 
kiM na syAt\?  kuto.abhimAnidevatAgrahaNam\?\" ityata Aha \dash \" abhimAni\" 
iti |  \" Adi\" shabdasamarthanena saha samuchchayArthaH \" cha\" shabdaH |  
\" anyathA\" maraNakAlaparigrahe |  iti shrutiH |  upalaxaNametat |  \" ahaH shukla\" 
iti gItA.api |  \" ahorAtravyatiriktapaxAbhAvAd\" iti bhAvaH |

samAkhyAnAchchaivamityAha \dash \" divAdi\" iti |  kiM cha \" ShaNmAsA 
uttarAyaNam\" \" ShaNmAsA daxiNAyanam\" ityetadapyabhimAnidevatAM gamayati |  
\" mAsAtiriktAyanAbhAvAt |  abhimAninAM cha pR^ithaktvena pR^ithaguktisambhavAd\"
iti bhAvenAha \dash \" mAsa\" iti |  anena \" ShaNmAsA evAyanam\" iti 
vyAkhyAnaM nirastaM bhavati |  purANavirodhAt |

atrAnuktamapi kiJNchidadhyAharati \dash \" ahaH\" iti |  \" sahasthitaM yAtItyapyatra
draShTavyam\" iti bhAvaH |  etadapyabhimAnidevatAparigrahasamarthanArtham |
prAdhAnyAderavivaxitatvAt \" sAhnA\" ityuktam |  \" sapUrNimA\" sapUrNimena
\" supAM suluk\" (aShTA\. 7\.1\.39) ityAdeH |  \" viShu\" shabdasya
uvaN^yaNAdeshavikalpashChAndasaH || 24\-26||

%%% ##endlabel##

%%% ##label=<segment020_pd08>##

{\Largedvng pra\.dI\. || } \" naite sR^itI pArtha, iti mArgaj~nAnamAtreNa mohAbhAvo
abhidhIyata\" (shAM\.bhA\.8\.27, rA\.bhA\.8\.27) iti pratItinirAsArthamAha \dash \" eta\" 
iti |  \" anuShThAya\", \" upAyam\" iti sheShaH |  \" kuta etat\?\" 
\dash \" yogI\" ityuktatvAt |  purANasaMvAdAchchetyAha \dash \" tachcha\" iti |
\" moho\" bhagavadvismR^itirUpaH |  \" anyA\" bhagavatprApteH |

bhAShye, purANe cha \" anuShThAya\" ityAkArasthAne kvachidIkAro lekhakadoSheNa
patitaH |  mUlapustakeShvadarshanAt || 27\-28||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrIbhagavadgItAbhAShyasya}
\centerline{TIkAyAM jayatIrthamunivirachitAyAM prameyadIpikAyAM aShTamo.adhyAyaH ||}

%%% ##endlabel##

%%% ##label=<segment001_pd09>##

{\Largedvng pra\.dI\. ||} pUrvasaN^gatatvena adhyAyArthamAha \dash \" saptama\" iti |  
\" bhagavanmAhAtmyam\" iti sheshhaH |  \" padArthaj~nAnapUrvakaM vAkyArthaj~nAnam\" 
iti \" saptamoktapadArthAnashhTame vyAkhyAya navame tadvAkyArthaM spashhTIkaroti\", 
ityarthaH |

\" rAj~nAmashvapatijanakAdInAM vidyA rAjavidyA\" (abhi\.bhA\. 2) iti kashchit |  
tadasat, \" brAhmaNAdInAmanadhikAraprasaN^gAd\" iti bhAvenAha \dash \" rAja\" iti |
rAjeva rAjA |  \" rAjA chAsau vidyA cha\", iti \" rAjavidyA\" ityarthaH |
\" pratyaxeNAvagamo yasya\" (shaM\.bhA\. 2) iti vyAkhyAnamasat \dash bhagavanmAhAtmyasya
shAstraikasamadhigamyatvAt |

\" advaitodgArasya pramANaviruddhatvAd\" iti bhAvenA.aha \dash \" pratyaxam\" iti |
\" shAstraikavedyaM brahma kathaM pratyaxam\?\" ityata Aha \dash \" axeshhu\" iti |
\" pratyaxaH\" paramAtmA |  \" prAdisamAso.ayaM, na avyayIbhAva\" iti j~nApanAya
napuMsake prakR^ite.api pulliN^ganirdeshaH |  anyathA shhashhThI na shrUyeta\?

\" paramAtmano.axeshhu sthitatve kiM mAnam\?\" ityata Aha \dash \" tathA cha\" iti |
\" prANa\" iti prANAbhimAninI devatochyate |  \" prANAdantaro\" bhinnaH |
\" aN^gushhTha\" iti karmendriyAdhishhThAtR^itvamuchyate |  \" mana\" ityAdeH
\" manaAdistha\" ityarthaH |  \" pratyaxa\" shabdasyAyamartha, ityatra shrutimAha, 
\" sa\" iti |  \" prati\" sthitaH |  \" axavAn\" prashastendriyaH |  yo 
\" vidvAn\" \" evam\" \" pratyaxa\" shabdArthaM \" veda\" |

\" dharmAdanapetaM dharmyam iti nirvachane.api na prasiddhadharmAviruddhatvam\", 
ityarthaH |  nivR^ittadharmasya brahmaj~nAnAviruddhatAyAH prasiddhatvAt |
\" pravR^ittilaxaNasya tu tadviruddhatvAd\", iti bhAvena Aha \dash \" dharma\"
iti |  \" tasmAdanapetamityarthastadvishhayam\" iti |  \" kathaM bhagavAn
dharma\?\" ityata Aha \dash \" sarvam\" iti |  dhR^iJNo manpratyaya auNAdikaH |  
\" dhArake dharmashabdapravR^ittiH kuta\?\" ityata Aha \dash \" pR^ithivI\" iti |
\" parvatopari\" ityarthaH |  \" bhagavataH sarvadhArakatve kiM mAnam\"
ityata Aha \dash \" bhArabhR^id\" iti |  \" sarvatra sthito bhagavAn sarveNa
dhriyate |  sa kathaM sarvasya dhAraka\?\" ityata Aha \dash \" bhartA\" iti |
\" bhartA\" \" san\" eva \" bhriyamANaH\", na svakIyasthityai |

\" dharmashabdasya bhagavadvAchitvam kuta\?\" ityata Aha \dash \" dharmo vA\"
iti |  \" idamagre\" asyAgre |  \" atra puNyaM dharmaH kiM na syAd\"? iti
shaN^kAnirAsArthaM \" so.adhyAyat\" iti vAkyasheshhodAharaNam  || 1\-3||
%%% ##endlabel##

%%% ##label=<segment002_pd09>##

{\Largedvng pra\.dI\. ||} \" evaM tarhi punaruktiH syAt\?  \" brahmavishhayaM j~nAnam\" ityasya 
brahmAvagamyate vishhayIkriyata anena j~nAnenetyasya cha bhedAbhAvAd\" ityata Aha 
\dash \" pratyaxa\" iti |  na \" avagama\" shabdena vishhayIkaraNamuchyate |  kiM 
tvavagatisAdhanatvam |  na cha j~nAnasya tadviruddham |  \" paroxaj~nAnasya
aparoxaj~nAnasAdhanatvopapatteH\" iti bhAvaH |  \" j~nAnaM vij~nAnasahitaM pravaxyAmi\" (9\.1) 
iti pratij~nAya \" yajj~nAtvA\" (9\.1) ityAdinA tatprashaMsAdikamuktam |  \" ato 
\" mayA tatam\" ityAdikamapi tathAbhUtameva kiJNchit, uta pratij~nAtamuchyata\?\"
iti shaN^kAyAmAha \dash \" tad\" iti |  \" pratij~nAtam\" ityarthaH |
\" yasyAparoxaj~nAnasAdhanatvamuktaM, tad\", iti vA |  kR^itsnAdhyAyapratipAdya
uktiriyam |  visheshhaNa vaiyarthyamAshaN^kyA.aha \dash \" tarhi\" iti |  \" sarvavyApi 
ched\" ityarthaH |  \" na dR^ishyate sarvatra\" iti sheshhaH || 4||
%%% ##endlabel##

%%% ##label=<segment003_pd09>##

{\Largedvng pra\.dI\. ||} \" matsthAni sarvabhUtAni (9\.4) ityuktvA, punaH kathaM \" na cha 
matsthAni\" iti vyAhatamuchyata\?\" ityata Aha \dash \" matsthatve.api\" iti |  
\" spR^ishhTvA\" iti \" sparshanenendriyeNa tAM j~nAtvA.anyonyadharmasaN^krAntimAsAdya 
cha\" ityarthaH |  parameshvarasya sparshanAdyavedyatve pramANamAha \dash \" na\" iti |  
\" sa.nj~nayA shabdenaiva sa.nj~nA samyak j~nAnaM yasya, asau\" tathoktaH |  \" matsthAni, 
ityaderuktatvAd bhUtabhR^ittvAdikaM punaruktam\" ityata Aha \dash \" mama\" iti |  
\" prAk bhUtAdhArakatvAdikaM svasyoktam |  atra punaH \" avyaktamUrtinA\" iti 
mUrtAvuktAyAM sA.asmadAdInAmiva bhinnA, iti bhrAntinirAsArthaM svalaxaNaM svadehasyochyata\" 
ityarthaH |  \" bhUtabhAvanatvasyAdhikasyokteshcha na punaruktiH\" iti bhAvenoktam 
\dash \" bhUta\" iti |  \" syAdidaM vyAkhyAnaM, yadi bhagavaddehasyedaM bhavet |  
tadeva kutaH\?\" ityata Aha \dash \" mahAvibhUteH\" iti |  \" mAhAtmyameva sharIraM 
yasya, asau\" tathoktaH || 5||
%%% ##endlabel##

%%% ##label=<segment004_pd09>##

{\Largedvng pra\.dI\. ||} \" ekamekatrAshritamityatrAsambhAvanA.abhAvAt kiM tad
dR^ishhTAntatvoktyA\?\" ityata Aha \dash \" matsthAni\" iti |  \" tatra sthitve.api
anyonyadharmAsaN^krAntyAdau\" ityarthaH |  \" tadatra na pratIyata\" ityato 
vyAchashhTe \dash \" na hi\" iti | \" sparshAd\" iti taddharmopalaxaNam  || 6||
%%% ##endlabel##

%%% ##label=<segment005_pd09>##

{\Largedvng pra\.dI\. ||} yathA \" mayA tatam\" (9\.4) ityAdyuktopapAdanArthAni
uttaravAkyAni, na tathA \" sarvabhUtAni\" ityAdi, kintu svatantrameva 
j~nAnapratipAdakam, iti bhAvenAha \dash \" j~nAna\" iti |  \" praLayAdi\" 
iti tatkAraNatvam || 7||
%%% ##endlabel##

%%% ##label=<segment006_pd09>##

{\Largedvng pra\.dI\. ||} \" prakR^itiM svAmavashhTabhya\" iti vachanAt \" tadvikalasya 
bhagavato na sAmarthyam\" iti pratItinirAsArthamAha \dash \" prakR^iti\" iti |  
\" tathA lIlayaiva na tu kevalasya sAmarthyAbhAvAd\" iti sheshhaH |  

\" kuta etat\?\" \" bhagavataH sarvasAmarthyasampUrNasya pramitatvAd\" ityAha \dash 
\" sarva\" iti |  sarvavastusAmarthyaiH |  evaM bhUtavat pAratantryAdyupetam |  
kintu daivaM devottamam |  paJNchabhUtAni mahadahaN^kArau cha \" sapta sUxmANi\" |  
\" sarvaj~natA tR^iptiH\" ityuktaprakAreNa \" shhaDaN^gam\" |  pradhAnasya 
mUlaprakR^iteH \" viniyogaH\" kAryeshhu yo vyApAraH |  tatsthaH tajj~nAnI |

\" mAyAmadhiruhya\", \" prakR^itim\" \" avashhTabhya\" |  

\" kam\" kaH, \" pravocham\" pravochat |

\" prakR^itervashAd visR^ijAmi iti Avidyakameveshvarasya kartR^itvam |  vastutastu
nishhkriyatvamityuchyata\" ityanyathApratItinirAsAyA.anyathA.anvayamAha, \" prakR^iteH\"
iti |  \" kuta etad\?\" ityataH pUrvoktArthasahite.atra pramANamAha \dash \" tvameva\"
iti |  \" etatsarjane\" etasya lokasya sR^ishhTyAm |  anyasminnapi pAlanAdau
sarvakarmaNi |  tasmAt mAyAvashatvAdeva \" avasham\" |  \" etat\" etaM
\" sraxyasi\" sR^ijasi || 8||
%%% ##endlabel##

%%% ##label=<segment007_pd09>##

{\Largedvng pra\.dI\. ||} \" svataH kartR^itve, kathamudAsInatvamuchyata\" iti chenna |  \" vatinA 
tasya nishhiddhatvAd\" iti bhAvenAha \dash \" udAsInavad\" iti |  \" anudAsInatve.api 
vatirvyarthaH syAt\?  anyasya tadarthasyAbhAvAd\" ityata Aha \dash \" tadartham\" 
iti |  \" vatyarthaM sAdR^ishyaM svayameva vivR^iNoti\" ityarthaH |  parameshvarasya 
karmasu saktyabhAve pramANamAha \dash \" avAkya\" iti |  \" sarvathodAsIna eva kiM 
na syAd\?\" iti chenna |  \" tathA sati, prakR^ityAdInAM asattvaprasaN^gAd\" iti 
bhAvenAha \dash \" dravyam\" iti |  \" yadIshvarasya svataH kartR^itvaM syAt 
tadodAsInamityetat \" na tu mAM tAni karmANi nibadhnanti\" ityatra kathaM hetuH 
syAd\?\" ityata Aha \dash \" yasya\" iti |  \" asaktyA, anAdareNa, anAyAsena\" 
iti yAvat |  \" bhagavato.api karmabandho.asti\" iti keshhAJNchit pralApo, yathA 
\" vishhNuryena\"\footnote{\normaldvng \" vishhNuryena dashAvatAragahane xipto mahAsaN^kaTe\" (nItishataka 96)} ityAdi |  tannirAsAya shrutyupapattI prAha \dash \" na karmaNA\" iti |  
\" niyAmayati\" niyachchhati  || 9||
%%% ##endlabel##

%%% ##label=<segment008_pd09>##

{\Largedvng pra\.dI\. ||} kathaM tarhyahaM kevalaM drashhTaiva |  prakR^itireva charAcharaM sUyata 
ityuttaravAkyamityataH tannivartyAshaN^kAM pradarshya vyAchashhTe, \" udAsIInavad\" iti |  
bhagavatodAsInasAdR^ishyaM svayameva vyAkhyAtam |  tadaj~nAtvA \" kriyA.abhAva evokta\" 
iti matvA shaN^kitam |  purA, \" prakR^itiM svAmavashhTabhya visR^ijAmi\" ityuktam |  
idAnIM tu \" udAsInavad\" (9\.9) iti nishhkriyatvamuchyate |  evaM tarhi prakR^itireva 
sUyate |  tvayi tu tatsannidhAnAt kartR^itvopachAramAtramityApannamiti tannivR^ittyarthamidaM 
vAkyam |

tatra \" adhyaxeNa\" ityanena prakR^itisUteH drashhTAhameva ityuchyate |  tR^itIyayA cha 
taprayojakakartA chAhameva |  na tu \" tasyAH svAtantryam\" iti darshanapUrvakatvAt
prayojakatvasya taduktiH |  \" anyathA tR^itIyA vyarthA syAd\" iti bhAvaH |
\" prakR^itiprayojakatvaM parameshvarasya kuta\?\" ityata Aha \dash \" yata\" iti |
\" prasUtA\" sR^ishhTAvabhimukhIbhUtA |  \" prasUtI\" prasUtiH |  \" toyena\" karmaNA |  
\" vyasasarja\" visasarja |  bahuLagrahaNAt  || 10||
%%% ##endlabel##

%%% ##label=<segment009_pd09>##

{\Largedvng pra\.dI\. ||} uttaravAkyasya saN^gati apratItestAM Aha \dash \" tarhi\" iti |
\" yadi tvameva jagataH sR^ishhTisthitisaMhArANAM kartA |  kaishchidavaj~nAnAt |
teshhAM chAnarthAbhAvAduktamasad\" iti shaN^kAbhiprAyaH |  \" mAnushhIM tanumAshritam\"
ityetadanyathApratItinirAsAya vyAchashhTe \dash \" mAnishhIm\" iti |  \" bhrAntyAnuvAda
evAyam\" iti bhAvaH |  

\" kuto na\?\" ityata Aha \dash \" uktam cha\" iti |  cho hetau |  sharIrANi hi 
bhautikAni bhavanti |  bhUtAni cheshvarasya buddhijAni |  \" tatkathaM tAni badhnIyuH\?\" 
ityarthaH |  atraiva \" Ishvaro hi\" ityAdinA.anyehetavo.abhidhIyante |  \" virAT\"
nityAbhivyaktarUpaH |  \" varado\" moxapradaH |  \" saguNaH\" svAtantryAdiguNavAn |
bhUtAni pralIyante yasmin, tat |  \" avyaktam\" tadabhimAninI devatA |  tasya
shushrUshhuH |  liN^gavyatyayashchhAndasaH |

\" astu etanmUlarUpavishhayam |  avatArasya tu kR^ishhNasya mAnushhatvaM bhavatu\",
ityata Aha \dash \" avatAra\" iti |  \" yat tat dadR^ishivAn brahmA
rUpaM hayashirodharam\" iti hayagrIvAvatAraprasaN^ge.astu hayagrIvasyaivam |
\" kR^ishhNastu mAnushhasharIra eva kiM na syAd\?\" iti chenna, yuktisAmyAt |

\" visheshhapramANAchcha\", ityata Aha \dash \" rUpANi\" iti |  \" asR^ijat\"
vyabhajat |  \" prAdurbhAvabhavAya\" uttaratra sa \" nArAyaNaH\" |  \" mAnushham\"
kR^ishhNAdikam |  \" tatraiva\" moxadharma eva |  \" prathamasargakAla eva\" |
\" mAnushhAdijAtyutpatteH prAgeva\" ityarthaH |

upasaMharati \dash \" ata\" iti |  \" teshhAm\" avatArANAm |
\" uttarapadavirodhashchAnyathA\" iti bhAvena tadvyAchashhTe \dash \" bhUtam\" iti |
\" bhUtaM sarvadA vidyamAnam\" iti kAlAnantyamAchashhTe |  \" mahad\" iti
deshAtyanantyam |  \" Ishvaram\" iti guNAnantyam |  \" bhAvaM yAthArthyam\"
iti vyAkhyAna apexayA napuMsakam |

atra shrutiM paThati \dash \" tathA hi\" iti |  \" IshaM varANAm\" iti Ishvaram |
shhashhThyA paranipAtaH |  devAH vIryaM putrA yasyAsau tathoktaH |  \" mahato
bhUtasya\" iti deshakAlAnantyamuchyate |  \" varANAM devAnAmIshatve brahma\" iti 
moxadharmavAkyaM pramANam |  \" purohitAdidevanikAyAstvadadhInA\"  ityarthaH |
\" brahma\" iti dviruktirAdarArthA  || 11||
%%% ##endlabel##

%%% ##label=<segment010_pd09>##

{\Largedvng pra\.dI\. ||} \" kiM cha teshhAM phalam\?\" ityasya parihAro na dR^ishyate, ata Aha 
\dash \" teshhAm\" iti |  anarthatvapradarshanAya vyAchashhTe, \" vR^ithA\" iti |  
\" sampadAdiprAptidarshanAt katham\?\" ityata Aha \dash \" bhagavad\" iti |  
\" yuddhAdhikarmaNAM sAphalyadarshanAt kathaM moghakarmANa\?\" ityata Aha \dash \" yaj~nAdi\" 
iti |  \" j~nAnaM tattvavishhayaM teshhAM nAstyeva |  ataH, kathaM moghatvamuchyata\?\" ityata 
Aha \dash \" j~nAnaM cha\" iti |  \" j~nAnaM cha teshhAM vR^ithaivetyasya kenApi, ityartha\", 
iti sambandhaH | \" anena \" j~nAna\" padaM upalaxaNam\", iti choktaM bhavati |  

\" na kevalaM purushhArthAnavAptiH, api tu duHkhAvAptishcha\" iti bhAvena tatra
pramANAnyAha \dash \" vaxyati cha\" iti |

\" A\" samyak |  \" lokAntasya\" chaNDAlAdeH |  pushhkaravishhTarAdye
padmAsanasya pitari |  \" bhrUNAnantaghno\" anantabhrUNaghnaH |

\" yadyevaM kathaM tarhi bhAgavatAdau bhagavaddveshhasya moxasAdhanatvavachanam\?\" ityata 
Aha \dash \" dveshhAd\" iti |  \" tadgatiM gatA\" iti sambandhaH |  vaireNa 
dhyAyantaH yadIyagatyAdibhiH \" AkR^itadhiyaH\" AkR^ishhTabuddhayaH |  ye pUrvaM 
bhaktAH shishupAlAdayaH tadvishhaye bhavatyeshhA gatiH |  na tu pauNDrasAlvAdivishhaye |
ata Aha \dash \" nitya\" iti |  \" bhaktapriyatvaj~nApanArtham\" ityuktaM vivR^iNoti, 
\" svabhaktasya\" iti |  \" iti bhaktapriyatvaj~nApanArtham\" iti yojanA |
%%% ##endlabel##

%%% ##label=<segment011_pd09>##

{\Largedvng pra\.dI\. ||} \" syAdetat, yadi teshhAM svato bhaktatvaM, shApabalAdeva dveshhitvaM,
ityetat pramitaM syAt |  tadeva kuta\?\" ityata Aha \dash \" bhaktA eva hi\" iti |
\" prasiddhamevaitat bhAgavatAdau\" ityarthaH |  \" kuto vachanAnAmarthAntarakalpanA\?\"
iti chet, \" yo dvishhyAt\" ityAdyudAhR^itavAkyavirodhAt |

hetvantaraM chAha \dash \" tatprashna\" iti |  

\ \ \" aho atyadbhutaM hyetad durlabhaikAntinAmapi  |
\ \ \ vAsudeve bhagavati gatishchaidyasya vidvishhaH\"  || (bhA\.pu\. 7\.1\.17)

\dash iti yudhishhThireNa dveshhiNaH kathaM muktirjAtetyevaMrUpe tadvishhaye prashne
kR^ite sati, nAradena

\ \ \" mAtR^ishhvaseyo vashchaidyo dantavakrashcha pANDava  |
\ \ \ pArshhadapravarau vishhNorviprashApAt padachyutau\"  || (bhA\.pu\. 7\.1\.34)

\dash iti taduttaratvena pUrvapArshhadattvAdikaM kathyate |  tato.api \" dveshho na
moxasAdhanam\" ityetajj~nAyate |

\" katham\?\" ityata Aha \dash \" anyathA\" iti |  \" yadi dveshho moxasAdhanaM 
syAt, tadA kimatrAdbhutaM yato dveshho.apyeko muktimArga ityuttaraM vaktavyam\?
pUrvapArshhadatvAdikamaprastutamanupayuktaM na vaktavyaM syAd\?\", ityarthaH |

\" nanu nAradena \" nindanastavasatkAraH\" (bhA\.pu\. 7\.1\.24) ityAdinA bhagavato 
nindA.adau sAmyamapi taduttarattvena kathyate |  yadi stuteriva nindAyA na moxasAdhanatvaM 
syAt, tadA tadanupayuktaM na vaktavyam\" iti satpratipaxA.arthApattityato
asyAnyathopattimAha, \" bhagavata\" iti |  \" sAmyaM nirvikAratvaM, bhaktAnAmaparAdhaM 
bhagavAn na gaNayati, ityetat kuta\?\" ityata Aha \dash \" na\" iti |

\" dveshhasya muktisAdhanatvAbhAve, bhAvo yathAkathaJNchichchintanaM, bhavasya moxasya
kAraNam, ityAdivachanavirodhaH syAd\?\" ityata Aha \dash \" na cha\" iti |
\" kuto na\?\" ityata Aha \dash \" dveshha\" iti |  \" hi yasmAdetad vachanamiti 
yuktaM ghaTanopetaM tasmAd\" ityarthaH |  yathoktam, \" yAdR^ishI bhAvanA j~neyA 
siddhirbhavati tAdR^ishI\" iti\footnote{\normaldvng daive tIrthe dvije mantre daivaj~ne bhishhaje gurau |
yAdR^ishI bhAvanA yasya siddhirbhavati tAdR^ishI ||} |

\" pratIta evArthaH kiM na syAd\?\" ityata Aha \dash \" anyathA\" iti |
\" bhagavaddveshhiNo muktibhAjastadAkR^itadhItvAt bhagavadbhaktavad, 
ityanumAnavirodha\", ityata Aha \dash \" na cha\" iti |  \" ubhayorAkR^itadhItve
sati phale.apyavisheshha iti cha na\" ityarthaH |

\" kuta\?\" ityataH, \" kAlAtItatvAd\" ityAha, \" teshhAmeva\" iti |
AkR^itadhInAmeva |  

\" vivixuH\" vexyatIti sambhAvanAvishhayaH |  AshaN^kAyAmachetaneshhUpasaN^khyAnAt |  
\" mahyam\" mama |  \" nanu vachanatvAvisheshhAt \" yo dvishhyAd\" ityAdibhiH, 
\" dveshhAchchaidya\" ityAdInAM kathaM bAdhanam\?\" ityata Aha \dash \" bahu\" iti |  
\" nishhedho\" dveshhasya muktisAdhanatAyAH |  

\" na kevalaM bahutvAbahutvarUpo.anayorvisheshhaH, kintu svavyAhatatvAsvavyAhatatvarUpo.api\"
ityAha, \" yasmin\" iti |  bhAgavatAdau granthe \" bhagavannindayA\" ityAdirnishhedhaH |  
\" bhagavadguNotkarshha eva sarvavedAnAM yanmahAtAtparyaM, tadvirodho dveshhAnmuktivAchinAm |  
itareshhAM tu tadAnukUlyamiti cha visheshha\" iti bhAvenAha \dash \" mahAtAtparya\" iti |  
\" uktaH\" uktaprAyaH |

\" ito.api bAdhyabAdhakabhAvo yukta\", iti bhAvena vyAptiM tAvadAha \" ayuktimadbhya\"
iti |  saptamyarthe matup |  \" tataH kim\" ityata Aha \" yuktayashcha\" iti |
\" mahAtAtparyavirodhashcha\" ityapexayA |  

\" anyeshhAm\" anukUlAH \dash \" avyayam\", \" vibudhashreshhTham\", \" pushhkaravishhTarAdya\" iti |

\" sAvakAshatvaniravakAshatvavisheshhAchchaivam\", ityAha \dash \" na cha\" iti |
\" itareshhAM tUktaiva\" iti sheshhaH |  \" itashcha bAdhyabAdhakabhAvo yukta\"
ityabhipretya vyAptiM tAvadAha \dash \" sAmye.api\" iti |  guNAntareNa \" sAmye.api\"
iti kaimutyArtham |  \" lokAnukUla\" shabdena lokadR^ishhTavyAptikAnumAnAn
anukUlatvamuchyate |  \" tataH kim\?\" ityata Aha \dash \" loka\" iti |
itarat dveshhipriyatvaM, bhagavatprItyaiva moxa, iti tu prasiddhameva |  

\" shishupAlAdInAM pUrvabhaktatvaM prasiddhamityuktam |  tat katham\?\" iti chet, 
\" pArshhadavat, vachanAcha\" ityAha \dash \" uktaM cha\" iti |  trayANAM 
lokAnAmadhIshe saMrambheNa mArgamAtreNAbhinivishhTachittAn |

upasaMharati \dash \" ata\" iti |  \" gatiH\" sadgatiH |  svamauDhyAdeva \" mAm\" 
\" avajAnanti\" (9\.11), na maddoshhAt |  teshhAM cha mahAn anartha iti sarvaM 
samAhitam |  \" rAxasIM ityAdi tu kimartham\?\" ityata Aha \" dveshha\" iti |  
\" mauDhyAnmithyAj~nAnaM bhavatu, prajvalanAtmako dveshhastu kuta\?  ityAshaN^kA
nivR^ittyartham\", iti sheshhaH |  \" anyeshhAM avidyamAnaM mauDhyameva teshhAM kuta\?  
ityAshaN^kAnivR^ittyartham\" iti vA |  atra \" kAraNam\" iti mUlakAraNam || 12||
%%% ##endlabel##

%%% ##label=<segment012_pd09>##

{\Largedvng pra\.dI\. ||} \" nanu kuto.ayaM viveka\?\" ityAkAN^xAyAM \" rAxasAdibhya itare na 
dvishhanti\" ityetAvadeva vaktavyam |  \" bhajantItyAdi tu vyartham\" ityata Aha 
\dash \" netare\" iti |  \" satyametat, tathA.api devAnAM svarUpakathanArthametat |  
tachcha dveshhAbhAvopapAdanArtham\", iti bhAvaH |  

\" devAn\" iti uttamajIvopalaxaNam || 13\-14||
%%% ##endlabel##

%%% ##label=<segment013_pd09>##

{\Largedvng pra\.dI\. ||} \" ekatvenAdvaitabhAvanayA\" iti vyAkhyAnamasat, mithyAbhAvanatvAd\" iti 
bhAvenAha \dash \" sarvatra\" iti |  \" sarvatra sthito nArAyaNa eka eva\" iti 
yojanA |  \" pR^ithaktvenAdityachandrAdirUpeNa\" (shaM\.bhA\. 9\.15) ityasaditi bhAvenAha, 
\" pR^ithaktvena\" iti |  

aparastu \" pR^ithaktvena\" ityetat samyak vyAkhyAya \" bahudhA\" ityetat 
\" AdityAdirUpeNa\" iti vyAkhyAtavAn |  ata Aha \dash \" bahudhA\" iti |  
\" katham\" ityata Agamenaiva darshayati \dash \" shuklamiva\" iti |   \" iva\" shabdo
\" api\" arthaH |  prakArAntareNa vyAkhyAti, \" daivameva\" iti || 15||
%%% ##endlabel##

%%% ##label=<segment014_pd09>##

{\Largedvng pra\.dI\. ||} \" vishvato mukham (9\.15) ityuktaM sarvAtmakatvaM prapaJNchayatyuttareNa\" 
iti anyathAvyAkhyAnanirAsArthamAha \dash \" pratij~nAtam\" iti |  \" anyathA 
pratij~nAtA.anuktiprasaN^ga\" iti bhAvaH |  vyAkhyAnaM tu \" raso.aham\" (7\.8) 
ityAderiva drashhTavyam |  

\" kratava\" iti \" kratu\", \" yaj~na\" shabdayorarthabhedamAha |  \" sAmAnyavisheshhabhAvena 
bheda\" ityarthaH || 16\-17||
%%% ##endlabel##

%%% ##label=<segment015_pd09>##

{\Largedvng pra\.dI\. ||} \" gatiH karmaphalam\" (shaM\.bhA\. 9\.18) iti vyAkhyAnamapAkartumAha,
\" gamyata\" iti |  \" sharaNam\" ityato bhedArthamuktam, \" mumuxubhiH\" iti |  
ata eva \" gamyata\" ityasya \" avagamyata\" ityarthaH |

\" kuta etad\?\" ityata Aha \dash \" tathA hi\" iti |  \" kimuchyate\?\" ityapi
prashno.adhyAhAryaH |  \" sAxI\" ityaudAsInyaM pratIyate |  ata Aha \dash \" sAxAd\" 
iti |  \" kuta etad\?\" ityata Aha, \" tathA hi\" iti |  \" yadadrAxIt\" 
\" sAxAt\" \" tat\" \" sAxiNaH\" \dash parameshvarasya \" sAxitvam\" 
\" sAxi\" shabdapravR^ittinimittam |  taduktaM, \" sAxAd dR^ishhTari sa.nj~nAyAm\"
(ashhTA\. 5\.2\.91) iti |  \" nivAsa\" shabdAgatArthatayA \" sharaNa\" shabdArthamAha,
\" sharaNam\" iti |  \" saMsArabhItasya\" iti muktopalaxaNam |

vishhNormuktAshrayatve pramANamAha \dash \" paramam\" iti |  \" parAyaNam\"
muktAnAM AshrayaH |  \" tathA.api \" nidhAnam\" iti punaruktiH\" ityata
Aha \dash \" saMsAra\" iti |  \" sarvabhUtAni prakR^itiM yAnti (9\.7)
ityuktatvAt kathaM bhagavati nidhIyanta\?\" ityata uktam, \" prakR^ityA\" iti |
\" prathamaM prakR^itiM yAnti, pashchAt tatra nidhIyanta\", ityarthaH |

\" tat kuta\?\", ityata Aha \dash \" tathA hi\" iti |  \" vishvakarmaNi\" Ishvare,
\" shubhrachaxuH\" shuddhadR^ishhTiraham  || 18||
%%% ##endlabel##

%%% ##label=<segment016_pd09>##

{\Largedvng pra\.dI\. ||} \" asato niyamyatvAnupapatteH \" sadasachchAham\" ityayuktam\" ityata 
Aha \dash \" sad\" iti |  kAryaM \" sad\" ityuchyate |  \" abhivyaktirUpatvAd\" 
ityanena sadeH gatyarthasya \" kvipi karmaNi\" rUpametad, ityuchyate |  kAraNamapi 
avyaktarUpatvAdeva \" asach\" chhabditam |  kAryakAraNayoH sadasachchhabdaprayogaM 
cha darshayati \dash \" asachcha\" iti |  tasmAt, \" sadasatorvishvasmAt brahma 
param\" || 19||
%%% ##endlabel##

%%% ##label=<segment017_pd09>##

{\Largedvng pra\.dI\. ||} \" sadasachchAhamarjuna\" (9\.19) iti vij~nAnasyopasaMhR^itatvAd
uttarasyAsaN^gatimAshaN^kyAha \dash \" tathA.api\" iti |  \" ahaM kratuH\" (9\.16) 
ityAdinA sarvakratvAdibhoktR^itvaM yaduktaM bhagavad, \" tadasad iti vaxyAmi\" 
iti gUDhAbhisandhinA \" yadi sarvatra bhoktA bhagavAn, tarhi kiM bhAgavatAnAM 
traividyAnAM phalasAmyameva\?\" iti pR^ishhTasyedamuttaraM, ityAshayaH |

tathA.api sarvatra bhagavataH bhoktR^itve.api madbhajanaM bhAgavatairanushhThitam |
\" devatA\" iti pitrAdyupalaxaNam |  traividyAdyanushhThitAt varamutkR^ishhTaphalam |
\" ityAdinA\" shlokatrayeNa || 20\-21||
%%% ##endlabel##

%%% ##label=<segment018_pd09>##

{\Largedvng pra\.dI\. ||} \" advaitaj~nAnino ananyA\" iti pratItinirAsArthamAha \dash 
\" ananyA\" iti |  avidyamAnamanyat yeshhAM, te \" ananyAH\" |  tachcha 
\" ananyAshchintayanto mAm\" iti prasaN^gAchchintanIyaM, iti labdhe.anyadachintayitvA 
iti siddhyati |  \" pratIta evArthaH kiM na syAd\?\" ityata Aha \dash \" tathA hi\" 
iti |  \" devamevA.avishanti\" ityanena \" yogaxemaM vahAmyaham\" ityuktArthaM
bhavati |  

atraiva \" kAmam\" iti AgamAntaram |  \" prabhayA sa.ndR^ishyaM maNDalaM svarUpaM 
yasya\", asau tathoktaH |  darshanasya yogaxemasAdhanatvaM prasiddhameva |
\" nityAbhiyuktAnAm\" ityasya \" apavAdavishhayANAm\" ityanyathApratItinirAsArthaM
Aha \dash \" nityam\" iti |  \" sarvataH\" sarvasmin deshe |
sharIrendriyamanobhirvA yuktAnAM bhagavati sevodyuktAnAm || 22||
%%% ##endlabel##

%%% ##label=<segment019_pd09>##

{\Largedvng pra\.dI\. ||} \" uktaprashnasyottaraM jAtam |  tat kimuttareNa\" ityataH 
\" prashnAbhisandhyuddhATanasyedamuttaram\" ityAha \dash \" tarhi\" iti |
\" bhagavadbhoganimittaM hi phalam |  sa chet sarvatra samaH tadA sarveshhAM
phalasAmyena bhAvyam |  tadabhAvashchettarhi \" ahaM kratuH\" (9\.16)
ityuktaM sarvatra bhagavataH bhoktR^itvamapyasatyam\" ityarthaH  || 23||
%%% ##endlabel##

%%% ##label=<segment020_pd09>##

{\Largedvng pra\.dI\. ||} \" ahaM kratuH ityAdinoktatvAt \" ahaM hi\" iti punaruktiH\" 
ityata Aha \dash \" kAraNam\" iti |  \" traividyAdikR^itAnAM yaj~nAnAM bhagavA.nshchet 
bhoktA kathaM tarhi avidhipUrvakatvam\? iti shaN^kAyAm\" iti sheshhaH || 24||
%%% ##endlabel##

%%% ##label=<segment021_pd09>##

{\Largedvng pra\.dI\. ||} \" te puNyamAsAdya (9\.20) iti, \" yogaxemaM vahAmyam\" (9\.22)
iti cha phalabhedasyoktatvAt, kiM \" yAnti\" ityAdinA\?\" ityata Aha, 
\" phalam\" iti |  \" tasyaivAyaM prapaJNcha\" iti bhAvaH || 25||
%%% ##endlabel##

%%% ##label=<segment022_pd09>##

{\Largedvng pra\.dI\. ||} \" patram\" ityasya saN^gatyapratIterAha \dash \" durbalaiH\" iti |  
\" ataH, tadbhajanasya mahAphalatve.api tadvihAya alpAnAM devAnAM bhajanaM
alpaphalamapi sushakatvAt karomi\" iti prAsaN^gikashaN^kAsheshhaH |  \" sAdhanA
anAdarasyoktatvAt, \" yatkiJNchit patrAdikam\" iti na mantavyam\", ityAha 
\dash \" na tu\" iti |

\" tat kiM kimapi bhagavate samarpaNIyameva, iti niyamo.atrAbhipreta\" ityata
Aha \dash \" bhaktyaiva\" iti |  \" kuta\?\" ityata Aha \dash \" bhakta\" iti |  
\" svArthaH\", svArthasAdhanopAyaH  || 26||
%%% ##endlabel##

%%% ##label=<segment023_pd09>##

{\Largedvng pra\.dI\. ||} \" Atmano govindasyAsAdhanAnAdarasya pUrvamevoktatvAt
vyarthamuttaram\" ityata Aha \dash \" ata\" iti |  \" sAmAnyamuktvA visheshhe
nigamanametad\", iti bhAvaH  || 27\-28||
%%% ##endlabel##

%%% ##label=<segment024_pd09>##

{\Largedvng pra\.dI\. ||} \" bhaktapriyatvamuktvA, tadviruddhaM sarvatra sAmyaM kathamuchyata\?\" 
ityata Aha \dash \" tarhi\" iti |  \" yadi tvaM bhaktapriyastadA dveshhyapriyashcha 
syAH |  tatashcha bhakteshhu dveshhishhu yathAsaN^khyaM snehadveshhavattvAd alpabhaktasyApi 
kasyachit bahuphalaM sukharUpaM dadAsi |  viparItasyAlpadveshhiNo.api kasyachit 
bahuphalaM duHkharUpaM dadAsi\" ityAdi Apadyate, rAjAdishhu tathA darshanAt |  
\" tathA cha vaishhamyanairghR^iNye tava\" iti shaN^kArthaH |  \" pUrvArdhenaiva shaN^kAyAH 
parihR^itatvAt, kimuttarArdhena\?\" ityata Aha \dash \" tarhi\" iti |  \" ahaM hi 
sarvabhUteshhu samo, na vaishhamyAdimAn, yato me tadIyaM dveshhamapexyAdhikaM dveshhyo 
nAsti |  tadIyAM bhaktimapexyAdhikaM priyashcha nAsti\" iti bhagavatokte.api 
viparItamarthaM gR^ihItvA shaN^kate \dash \" yadi te priyo nAsti, tarhi na bhaktiH 
prayojanam\?\" \" phalasya tathA choktavirodha\" iti bhAvaH |  \" mayi te teshhu 
chApyaham\" ityetan \" na phalaM svabhAvasiddhatvAd\", ityata Aha \dash \" mayi\" iti |  
\" ityasya ityarthaH\" iti yojanA |  \" kuta etad\" ityata Aha \dash \" uktaM cha\" 
iti |  \" mama te vashAH ityetadapi tAdR^igeva bhajanAbhAve.api tadvashatvasvAbhAvyAd\"
ityata Aha \dash \" tad\" iti |  \" yadyapi\" iti sheshhaH |  atra dR^ishhTAntaM, 
pramANaM cha Aha \dash \" uddhavAd\" iti |  \" abuddhipUrvam\" \" yo vashassaH\"  || 29||
%%% ##endlabel##

%%% ##label=<segment025_pd09>##

{\Largedvng pra\.dI\. ||} \" api ched\" ityAdinA bhakteH prashaMsA kriyate |  tatra 
vishhNubhaktessudurAchAreNaikatra samAveshapratItau yathAvad vyAchashhTe \dash \" na 
bhavatyeva\" iti || 30||
%%% ##endlabel##

%%% ##label=<segment026_pd09>##

{\Largedvng pra\.dI\. ||} \" bahupuNyena svayogyAdadhikenArjitena \" samyagvyavasito
hi sa\" iti hetoruktatvAt, \" xipram\" ityAdi vyartham\" ityata Aha,
\" kuta\" iti |  \" samyag vyavasAyatve.api sudurAchAraH kutassAdhurmantavya\?\"
iti shaN^kArthaH |  \" samyagvyavasAyavattvAt xipraM bhavati dharmachittaH |
yadetadbhakteH sudurAchAreNa sahaikatra kvachidanavasthAnamaN^gIkR^itaM tadapi na
manushhyavishhayam\" ityAha \dash \" deva\" iti |  \" devAH\" cha indrAdayaH,
tad \" aMshAH\" sugrIvAdayaH |  \" Adi\" padena vishvAmitrAdInaM R^ishhINAM
grahaNam |  etachcha \" devadevAMshAdishhveva\" vishhayeshhu \" bhavati\", iti
yojanA |  

\" kuta\?\" ityata Aha \dash \" uktaM cha\" iti |  \" dushcharitAd\" \" avirato\"
yaH kashchit so\" amalAshayo\" bhUtvA vAsudeve samyag bhakto na bhavet |  
tathA.abhaktaH, shravaNakIrtanAdibhaktiliN^garahitaH |  evaM \" asamAhito\"
vishhayavixiptamanAshcha |  devAdayashcha kvachidevambhUtA api samyagbhaktA
bhavanti |  \" kutaH\?\", j~nAnataH samyagvyavasAyatvAt |

\" nanu devAdibhyo.anyo.api sudurAchArastadbhakto dR^ishyate |  shaN^khachakrAN^kita
bAhumUlatvAdiliN^gavattvAt, tatkathametad\?\" ityata Aha \dash \" ato.anya\" iti |  
\" bhavati chet sudurAchAro.api bhaktiliN^gavAn\" iti sheshhaH |  \" mA bhUt
sudurAchAro bhaktaH |  madhyamadurAchArastu tathAvidhaH katham\?\" ityata Aha,
\" sAdhAraNa\" iti |  \" mahati\" iti vaxyamANasAdhAraNabhaktivyavachchhedArtham |
\" sudurAchArANAmapi bhagavatpremNo.anubhavasiddhatvAt kathaM DAmbhikatvAnumAna\?\"
ityata Aha \dash \" sAdhAraNa\" iti, \" alpa\" ityarthaH |  \" premAnubhavAbhAve
anumAnamuktam |  mahAbhaktyabhAvavishhayaM vA\" iti bhAvaH |

\" sudurAchAro.api bhaktiliN^gAn mahAbhakta evAstu |  kiM DAmbhikatvAdikalpanayA\?\"
ityata Aha \dash \" sa\" iti |   \" shaThamatiH\" DambhabuddhiH |  

\" mahAbhakteH durAchAropashamahetutvokteshcha na tayorekatra samAvesha\" ityAha \dash \" sa\" 
iti, haribhaktiH |  

\" itashchaivam\?\" ityAha \dash \" vedA\" iti |  \" mama\" mayA, \" parasya guhyaM na cha 
bhinnapUrvam\", pishunatvaM nA.achAritam |  upasthaM, udaraM, pANiH, vAk, iti 
chatvAri |  \" me\" mayA |  

\" ekAntabhAvena\", niyatamanasA |  \" sattvam\" antaHkaraNam |  kAraNasAmagryAM
satyAM kAryAnudayo hyAshcharyahetuH |

\" nanvAchArasya j~nAnasAdhanatvoktyA, durAchArANAM j~nAnAbhAvaH siddhyatu |
mahAbhaktyabhAvastu kuta\?\" ityata Aha \dash \" j~nAna\" iti |  \" kuta etad\?\" 
ityata Aha, \" tathA hi\" iti |  \" bhaktij~nAnayoravinAbhUtattvAchcha tadabhAve
tadabhAvasiddhiH\" ityAha \dash \" bhaktiH\" iti  || 31\-34||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM navamo.adhyAyaH ||}

%%% ##endlabel##

%%% ##label=<segment001_pd10>##

{\Largedvng pra\.dI\. ||} prakR^itasaN^gatatvenAdhyAyapratipAdyaM darshayati \dash \" upAsanArtham\" iti |  
ShaShThe dhyAnamuktam |  tannavamAnte \" manmanA bhava\" iti smAritam |  tachcha 
dhyeyasApexam |  vishiShTAdhikAriNAM cha bhagavadvibhUtaya upAsyAH |  atastA 
AhAnena dashamAdhyAyena |  tatrA.adau keShAJNchit \" buddhyAdInAM maharShyAdInAM cha 
visheShakAraNatvamapi bhagavata Aha\" ityarthaH |  \" vibhUti\" shabdArthastAtparyanirNaye
abhihitaH |  tadukterbhUyastvAt prathamamupAdAnam |  ata evaikavAkyatA |  
\" nanu vibhUtayo \" raso.aham\" ityAdinoktA eva\?\" |  satyam |  ata eva 
\" vistareNA.atmana\" (10\.18) iti vaxyati | \" visheShakAraNatvam\" nAma 
sAmarthyAtishayopetatayA nirmANam |

%%% ##endlabel##

%%% ##label=<segment002_pd10>##

{\Largedvng pra\.dI\. ||} prAk \" shokasaMvignamAnasaH\" (1\.47) ityuktam |  \" tadviruddhaM
kathaM \" priyamANAya\" ityuchyata\" ityato vyAchaShTe \dash \" priyamANAya\" iti | 
\" pUrvaM bandhusnehAchChoka uktaH |  idAnIM bhagavadvachanashravaNanimittA santoShaprAptiH
shrotR^itvasampatpratipAdanAyochyata iti na virodha\" iti bhAvaH || 1||

%%% ##endlabel##

%%% ##label=<segment003_pd10>##

{\Largedvng pra\.dI\. ||} \" prabhava\" shabdaH kenachit sAmarthyamAtravAchitvena vyAkhyAtaH |  
anyena tu bhagavadutpavichitvena |  tadubhayamaN^gIkurvannadhikamapi vivaxurAha \dash 
\" prabhavam\" iti |  \" madIyAmutpattiH\" iti sambandhaH |  \" jagadutpattiH 
\" me\" iti kathaM visheShyata\" ityata Aha \dash \" tad\" iti |  \" jagadutpattiH\" 
iti vartate |  evaM tarhi bhagavatprabhAvavat jagadutpattivachcha bhagavadutpattirastyeva |  
\" kiM tu durj~nAnA evetyApannam\?\" ityata Aha \dash \" yadi\" iti | 
\" bhagavadutpattiH\" iti sheShaH |  \" sarvaj~natvAtsAmAnyata\" iti sheShaH |  
tataH paraM \" na cha sAmAnyato.api jAnanti\" ityadhyAhAraH |  ataH sarvathA
anupalambhAt |  \" prabhAvAdikaM tu visheShata eva na jAnanti na tu sAmAnyato.api\" 
iti bhAvaH |  \" nanu bhagavadutpatterabhAvashchedatrAbhipretastadA \" ahamAdirhi\" 
iti hetuvachanaM na saN^gachChate\" |  atra hi \" devAdayo arvAktanA mayA sR^iShTAH 
kathaM pUrvatanImutpattiM jAnIyuriti pratIyata\" ityata Aha \dash \" aham\" iti | 
\" api\" shabdo.adhyAhR^itena \" sarvasya\" ityanena sambadhyate |  \" kuto 
janakAt\?  nanvatra sarvasyApyutpattiH bhagavadadhIna\" iti \" na\" uchyate |  
kiM tu devAdInAmeva |  \" tatkathamanena kAraNAbhAvaH sidhyati\" iti chenna |  
devA.adishabdasyopalaxaNArthatvAt |  \" tatkuta\?\" ityata Aha \dash \" aham\" 
iti |  uktamarthatrayamupapAdayati \dash \" uktaM cha\" iti |  \" iyaM visR^iShTiH 
vividhA jagatsR^iShTiH kutaH kAraNAt A jAtA iti kaH puruShaH kutaH pramANAt addhA 
veda kashcha iha loke prAvochat |  na ko.api kutashchit |  yato devA asya Ishvarasya 
visarjanena niShpannA arvAchInAH |  sarvathA.aj~nAne tadabhAvaH syAdityata uktaM atha 
anyat yato yasmAt iyaM A babhUva sa kaH prajApatiH bhagavAn addhA veda\" ityarthaH |  
\" na tat prabhAvaM ityatra addhA\" iti draShTavyam |  ata eva vyutkramaH |  
\" pramANam\" pramA |  anyastvartho bhagavataH janmAbhAvaH || 2||

%%% ##endlabel##

%%% ##label=<segment004_pd10>## 

{\Largedvng pra\.dI\. ||} \" aja\" shabdAgatArthatayA anAdishabdaM vyAchaShTe \dash \" ana\"
iti |  sarvasyetyubhayasheShaH |  antarNItaNyarthAdanateH pachAdyach |  \" na vidyate AdiH
kAraNamasyeti anAdiH\" ityanye |  tadasat |  ArthikapunarukteraparihArAdityAha \dash 
\" ajatvena\" iti |  \" itarasya\" kAraNarAhityasya |  \" ajatve heturayamuchyata\" 
iti chet |  maivam |  tajj~nApakavibhaktyAdyabhAvAt |  gatyantarAbhAve hi gamanikaiShA |  
\" cheShTakatvaM prAganuktaM kathamanUdyata\" iti chenna |  prabhAve sarvasyAntarbhAvAt || 3||

%%% ##endlabel##

%%% ##label=<segment005_pd10>##

{\Largedvng pra\.dI\. ||} \" tarhi \" Adim\" ityanena \" buddhiH\" ityAdikaM gatArtham\" ityata 
Aha \dash \" tad\" iti |  sarvAditvam |  \" buddhirupalabdhirj~nAnamityanarthAntaram\" 
iti gautamavachanAt \" buddhirj~nAnam\" iti punaruktirityata
Aha \dash \" kArya\" iti |  \" kuta etad\?\" ityata Aha \dash \" j~nAnam\" iti |  
\" j~nAyate aneneti j~nAnaM shAstram\" ityasat |  AdhyAtmikadharmaprasaN^gAt |
\" damo bAhyendriyopashamaH, shamo.antaHkaraNasya\" iti kashchit |  tadasat |  
ekenaiva shabdena siddhatvAt |  kiM tu \" damaH kriyAsu vinayaH |  shamo 
bAhyAntaHkaraNasamyama\" ityaparaH |  \" tadapyasad\" iti bhAvena Aha 
\dash \" dama\" iti |  \" kuta\?\" ityata Aha \dash \" shama\" iti |  
sukhashabdAgatArthatayA tuShTishabdaM sapramANakaM vyAchaShTe \dash \" tuShTiH\" 
iti || 4\-5||  

%%% ##endlabel##

%%% ##label=<segment006_pd10>##

{\Largedvng pra\.dI\. ||} \" maharShayaH sapta bhR^igvAdaya\" iti shaN^karaH |  tadasat |
\" pUrva\" iti visheShaNena prathamamanvantarasthAnAmeva grahaNasyochitatvAt |  
\" moxadharmasamvAdAchcha\" iti bhAvena Aha \dash \" pUrva\" iti |  \" ito.api 
marIchyAdaya eva\" ityAha \dash \" te hi\" iti |  \" nirupapadena saptarShishabdena\" 
iti sheShaH |  \" pUrva ityasyottaratra sambandhe.apyetatsiddham\" iti bhAvenAneka\-
pramANopanyAsaH |  \" brahmasAvarNyo rudrasAvarNyo daxasAvarNyo dharmasAvarNya iti
bhaviShyantashchatvAro manava\" ityanye |  \" tadasad\" iti bhAvena Aha \dash \" chatvAra\" 
iti |  svAyambhuvasvArochiSharaivatottamAH |  \" prathamAtikrame kAraNAbhAvAd\" iti
bhAvaH |  kiM cha \" yeShAM loka imAH prajAH\" iti visheShaNameShveva sambhavati |
\" netareShu ato.apyevam\" ityAha \dash \" teShAM hi\" iti |  imA vartamAnAH prajA 
apatyAni |  nanu chaturdasha manavaH |  teShu chaturNAM yat pR^ithakkaraNaM tatra kAraNena 
bhAvyam |  asti cha tatparokteShu saJNj~nAsAmyam |  na tu svAyambhuvAdiShu |  \" ataH 
kathametad\" ityata Aha \dash \" vibhAga\" iti |  \" prAdhAnyAdeva\" iti sheShaH |  
saMj~nAsAmyasyAprayojakatvAt |  \" anyathA merusAvarNerapi grahaNaprasaN^gAd\" iti 
bhAvaH |  astvevam |  \" prAdhAnyaM cha paroktAnAmeva\" ityata Aha \dash \" prAdhAnyaM
cha\" iti |  \" svAyambhuvAdInAm\" iti sheShaH |  \" kiM cha shrutau svAyambhuvAdInAmevaM
pR^ithakkAraNAtta evAtra\" ityAha \dash \" gautama\" iti |  \" pR^ithakkAraNe na phalam\" 
iti sheShaH |  \" prAthamikatvAdeva pradhAnyaM bhavati\" ityuktam |  \" tatkatham\?\" 
ityata Aha \dash \" pUrvebhyo hi\" iti |  \" tatsantatau\" ityarthaH |  teShAM 
pUrveShAmuttarAn prati |  \" tatsantatAvajAtAn prati prathamAnAM kathaM prAdhAnyam\?\" 
ityata Aha \dash \" ajAteShu\" iti |  viShayasaptamIyam |  \" jyaiShThyaM prathamAnAM 
pradhAnyam\" ityarthaH |  idamuktaM bhavati |  \" pradhAnaguNabhAvo hi sati sambandhe 
bhavati |  ayugapadbhAviShu chaiteShu prathamAnAmeva pradhAnyamuttareShAM guNatvamuktavidhayA 
sambhavati |  na tvanyathA kathamapi\" iti |  \" prathamAshchedgR^ihyante tadA chaturthastApaso 
gItA.abhipretatayA kuto na vyAkhyAtA\?\" ityata Aha \dash \" tApasasya\" iti |  
anuktiravyAkhyAnam |  \" bhagavati cha \" madbhAvA mAnasA jAtAH\" iti 
visheShaNAsambhavAd\" iti bhAvaH |  \" tApasasya bhagavadavatAratvaM kuta\?\" ityata 
Aha \dash \" tachcha\" iti |  

\ \ \" chaturtha uttamabhrAtA manurnAmnA cha tApasaH |
\ \ harirityAhR^ito yena gajendro mochito grahAt\" ||

\dash ityAdinA |  nanu yadi visheShaNAsambhavAt prathamaprAptAtikrameNa tatsambhavatAM
grahaNaM, tarhi \" mAnasA jAtAH\" iti visheShaNAsambhavAdetAn parityajya 
brahmasAvarNyAdaya eva grAhyAH |  \" teShu tatsambhavAd\" iti bhAskaraH | 
tatrAha \dash \" mAnasatvaM cha\" iti |  \" chaturNAM daxaduhitari kila bhAvo
yugapadAsIdityevaMvidhaM mAnasatvaM na sarveShAm\" iti chenna |  atrArthe
taddhitotpatterasmaraNAt |  nanu brahmaputrAssantu mAnasAH |  na tu tadA te manavaH |
kintu tachCharIraM parityajya priyavratAdiputrA jAtAstadaiva |  \" ato manuShu
mAnasatvamasambhAvyam\" ityata Aha \dash \" anya\" iti |  \" tanmAnasaM sharIraM
aparityajya sthitAnAmapyanyaputratvaM sambhavati\" iti yojanA |  \" dvitIye sharIre 
jAte tatpUrvasharIreNaikyamApadyata\" iti sampradAyavidaH |  \" kimatra pramANam\" ityata Aha \dash \" pramANaM cha\" iti |  manUnAmeva brahmamAnasa\-
putratvavAkyaM priyavratAdiputratvavAkyaM chetyubhayavidhavAkyam |  upachAratvakalpanA
kliShTaiva |  \" kiM cha \" pUrvam\" iti visheShaNaM pUrveNaiva sambadhyate pareNaiva vA 
ubhAbhyAmapi\" iti trayaH paxAH |  \" paxatraye.api chatvAro manava prathamAeva\" iti 
siddhyati |  Adye saptarShINAM prathamatvena tatsAhacharyAt |  \" dvitIyatR^itIyayoH
vachanAdeva\" iti bhAvenAha \dash \" pUrva\" iti |  \" mayi bhAvo yeShAmiti vyAkhyAnaM 
prakR^itAsaN^gataM, kAraNatvasyAtra prakR^itatvAd\" iti bhAvena Aha \dash 
\" matta\" iti |  \" bhAvo\" janma |  \" nanu \" mAnasA jAtA\" ityanena 
bhagavatastatkAraNatvamuchyate\" |  maivam |  tato \" manUn\" iti vachanasya sattvena 
\" brahmaNo mAnasA jAtAH\" iti vyAkhyeyatvAt |  \" tarhi kathaM na vyAhatiH\" ityata Aha 
\dash \" ye ta\" iti |  \" matta eva brahmAntaryAmiNaH\" |  \" brahmA tu dvAramAtram\" 
iti bhAvaH || 6\-7||

%%% ##endlabel##

%%% ##label=<segment007_pd10>##

{\Largedvng pra\.dI\. ||} \" nanu \" etAM vibhUtim\" iti parij~nAtuH phalamuktam |
tatkimarthaM punaruchyata\?\" ityatastAtparyAntaramAha \dash \" santi cha\" 
iti |  \" uktaphale vishvAsajananArtham\" iti sheShaH || 8\-11||

%%% ##endlabel##

%%% ##label=<segment008_pd10>##

{\Largedvng pra\.dI\. ||} \" brahmavibhu\" shabdau aikArthyaparihArAya krameNa sapramANakaM
vyAchaShTe \dash \" brahma\" iti |  \" paraM vastu \" brahma\" iti kasmAduchyate\?\" |
bR^ihati pUrNaM bhavati |  bR^ihmayati pUrayati chAnyAn |  bR^ihate rman-pratyayo.amAgamashcha |
Ishvaro brahmaNo.anyaH |  \" sa kathaM paraM brahmetyuchyata\?\" ityata uktam \dash \" paramam\" 
iti |  vividhamanekarUpatvenAbhavat |  \" mehanAvataH sechakasya bhagavataH prathamaM
rUpaM vibhu prabhu cha\" ityedanUdya vyAkhyAyate |  prAbhavat samartho.abhavaditi prabhuH |
vividhobhavaditi vibhuH |  \" so.akAmayata\" iti vividhabhavane shrutyantaram |
\" viprasambhyoN^vasaJNj~nAyAm\" iti cha smR^itiH || 12\-15||

%%% ##endlabel##

%%% ##label=<segment009_pd10>##

{\Largedvng pra\.dI\. ||} vibhUtayaH aishvaryANi pR^iShTAni |  nAnArUpANi vaxyante |  \" kiM
kena saN^gatam\?\" ityata Aha \dash \" vibhUtaya\" iti |  vividhabhUtayo
nAnAbhUtAni rUpANi || 16\-17||

%%% ##endlabel##

%%% ##label=<segment010_pd10>##

{\Largedvng pra\.dI\. ||} \" arda gatau yAchane cha\" iti vachanAd \" AsurajanAnAM
narakAdigamayitR^itvAt, janaiH yAchyatvAdvA janArdana\" iti shaN^karaH |  
tadaprAmANikaM vyAkhyAnam |  \" idaM tu shrautatvAdupAdeyam\" iti bhAvenAha \dash 
\" na jAyata\" iti |  naJNaH paranipAtaH |  ata eva nalopAbhAvaH |  uttarapade tasya 
smaraNAt |  ardayati gamayati |  \" sa hyAsId\" iti |  bhUtaH |  \" anAditaH sattvavAn\" 
ityarthaH |  \" sa nAsIt na janmavAn |  so.ardayati\" iti janArdanaH || 18\-20||

%%% ##endlabel##

%%% ##label=<segment011_pd10>##

{\Largedvng pra\.dI\. || } \" dvividhaM vibhUtirUpam |  pratyaxaM tirohitaM cha |  atra viShNvAdikaM 
pratyaxam\" iti j~nApayituM tachChabdAn vyAkurvan \" AdityAnAM ahaM viShNuH\" iti 
\" viShNu\" shabdaM sapramANakaM vyAkaroti \dash \" viShNuH\" iti |  sarveti yogyatayA 
sambadhyate |  \" Adi\" padena vaxyamANArthasaN^grahaH |  \" cha\" shabdo 
dhAtvantarasamuchchayArthaH |  \" gachChatyanena\" iti gatiH |  \" bhUtAnAm\" pR^ithivyAdInAM, 
\" prajAnAm\" brahmAdInAm |  \" vI gatiprajanakAntyashanakhAdaneShu\" 
ityato gatyarthAt \" ksnu\" pratyayaH |  dhAtorhrasvashcha |  \" me mayA\" |  
rodasI dyAvApR^ithivyau |  vyAptau vyApte |  \" viShlR^i vyAptau\" ityataH knuH |  kAntiH 
kamanIyatA |  \" vasha kAntau\" ityato nuH |  dhAtorakArasyekAraH shakArasya ShakAraH |  
\" vI gati\" ityato vA kAntikarmaNaH ksnuH |  adhibhUtaM prAgvyAkhyAtam |  
\" visha praveshane\" ityataH knuH |  ShatvaM cha |  tadichChuH adhibhUtasya 
janmAdIchChuH |  kAntirichChA  |  ato vayatervaShTeshcha pUrvavadrUpam |  kramaNAt 
trivikramarUpeNa pAdavixepAt |  pUrvavadvayatergatyarthAt kartari pratyayaH || 21\-25||

%%% ##endlabel##

%%% ##label=<segment012_pd10>##

{\Largedvng pra\.dI\. || } \" siddhAnAM kapilo muniH\" iti \" kapila\" shabdaM vyAchaShTe 
\dash \" sukha\" iti |  \" sukharUpa\" iti \" kaH\" |  \" pAlyate jagadanena\" iti 
\" piH\" |  \" pAraxaNe\" ityataH \" kiH\" |  \" lIyate jagadanena\" iti 
\" laH\" |  \" lI shleShaNa\" ityasmAt \" DaH\" |  \" lA AdAna\" ityato vA 
\" kaH\" |  tataH karmadhArayaH |  \" ka\" shabdasya sukhavAchitve.abhidhAnaM 
prayogaM cha paThati \dash \" prItiH\" iti |  samagrArthe shrutimAha \dash \" R^iShim\" 
iti |  taM bhagavantaM R^iShiM kapilaM cha pashyet |  \" kathaM R^iShiM sarvaj~natvAd\?\" 
ityuchyate |  \" yaH prasUtaM pUrvakalpeShu jAtam |  jAyamAnaM vartamAnaM cha evamAgAmi cha |  
jagat j~nAnaiH bibharti jAnAti\" iti yAvat |  \" kathaM kapila\?\" ityata uktam 
\dash \" sukhAd\" iti |  yachChabdadvayasya \" tam\" ityanenAnvayaH || 26\-30||

%%% ##endlabel##

%%% ##label=<segment013_pd10>##

{\Largedvng pra\.dI\. || } \" rAmaH shastrabhR^itAmaham\" iti \" rAma\" shabdaM vyAkhyAti 
\dash \" Ananda\" iti |  \" AnandarUpatvAt pUrNatvAd\" ityeko.arthaH |
\" ramata\" iti \" raH\" |  \" ramu krIDAyAm\" ityato \" JNamantADDaH\" iti
\" DaH\" |  \" na vidyate mA pramAparichChedo asya\" iti \" amaH\" |  \" loka\" 
ityaparo.arthaH |  ramateH ghaJN |  atra shrutimAha \dash \" Ananda\" iti |  
Adye.arthe vigrahaM darshayati |  \" rashchAsAvamashcha\" ityarthaH || 31\-36||

%%% ##endlabel##

%%% ##label=<segment014_pd10>##

{\Largedvng pra\.dI\. || } \" vR^iShNInAM vAsudevo.asmi\" iti \" vAsudeva\" shabdaM
vyAchikIrShuH \" vAsu\" shabdArthaM tAvadAha  \dash \" AchChAdayati\" iti |  \" vasa
AchChAdana\" ityata uN |  \" vAsayati sarvam\" iti vartate |  \" vasa nivAse\" 
ityato \" NyantAduN\" |  \" vasati cha\" iti kevalAduNeva |  \" tataH kimAyataM
vAsudevashabdasya\?\" ityata Aha \dash \" deva\" iti |  \" tathA hi devashabdArtham\" 
ityatra, tataH karmadhArayaH |  \" vishvaM samastaM bhUtvA prApya\" |  \" bhU
prAptau AtmanepadI\" iti vachanAt sarvabhUtAdhivAsashcheti tatpuruSho bahuvrIhishcha |  
atrApi \" deva\" shabdArtho grAhyaH |

\" munInAmapyahaM vyAsaH\" iti \" vyAsa\" shabdaM vyAchaShTe \dash \" vishiShTa\" 
iti |  \" sarvasmAt vishiShTaH\" iti \" vi\" shabdArthaH |  \" A\" ityanuvAdena
\" samantAt\" iti vyAkhyAnam |  \" sa\" ityasya \" sa eva\" iti |  \" sR^i
gatau sR^iplR^i gatau\" ityato vA De rupametat |  na tu tadaH |  \" vyAsam\" ityA\-
dyanupapatteH |  \" samantAt gataH sarvagata\" ityarthaH |  sa vyAsaH |  \" kutaH\?\"
vIti hetoH |  \" ko.arthaH\?\" |  tamapo artho hi \" vi\" shabdaH |  uttarataH
upariShTAt |  \" yachcha kiJNchit\" iti bhagavataH sarvagatatve pramANam || 37\-38||

%%% ##endlabel##

%%% ##label=<segment015_pd10>##

{\Largedvng pra\.dI\. || } \" na tadasti vinA\" ityatra padAnAM vyavahitatvAdanvayaM Aha \dash 
\" mayA\" iti |  bhagavato anantai rUpaiH |  sarvapadArthavyApitve pramANamAha \dash 
\" vishva\" iti |  vishvaM rUpaM pratimA yasyAsau \" vishvarUpaH\" |  anantAnAM gatiH 
Ashrayo \" anantagatiH\" | anantA bhAgAH avatArA yAsyAsau \" anantabhAgaH\" |  
anantAn padArthAn gato \" anantagaH\" |  \" anantaH\" kAlAdyaparichChinnaH || 39\-40||

%%% ##endlabel##

%%% ##label=<segment016_pd10>##

{\Largedvng pra\.dI\. || } \" eSha tUddeshataH\" ityetachChabdo \" anukrAntaparAmarshI\" iti 
pratItinirAsArthamAha \dash \" yadyad\" iti |  vaxyamANaM buddhisthametachChabdena
parAmR^ishyate |  \" shR^iN^gigrAhikayokterapi laxaNoktervistaratvAd\" iti bhAvaH |
\" vibhUtimadAdikaM mama tejorUpeNAMshena saha bhavati\" ityuktyA viShNvAdInAmapi
bhagavadaMshayuktatvaM pratIyate |  teShAmapyetallaxaNopetatvAt |  tannivR^ittyarthaM Aha 
\dash \" viShNvAdIni\" iti |  \" tarhi kiM viShayametadvAkyam\" ityata Aha 
\dash \" anyAni tu\" iti |  \" kuta etad\?\" ityata Aha \dash \" tathA cha\" iti |  
visheShakAH garuDAnantaviriJNchAH |  vainyaH pR^ithuH |  rAjAnyagrahaNena gR^ihItasyApi 
punaruktiH sAxAdavatAratvavisheShoktibAdhanArtham |  kR^iShNo dharmasUnurapi |  rAmo 
bhArgavo.api |  aMshayuktatvenoktvA kalA ityanena kalA iva kalAH |  na svarUpatvena |  
\" ete svAMshakalA\" ityanena svarUpAMsharUpA eva kalAH |  \" na tu pUrvavadupachAreNa\" 
iti |  \" nanvatraite varAhAdyAH paramapuruShasya aMshA eva |  kR^iShNastvaMshI 
bhagavAn svayamiti pratIyate |  tatkathamuktavyAkhyAnam\?  anyathA tushabdAnupapatteH\" 
ityata Aha \dash \" tu shabda\" iti |  

tatashchAyamarthaH |  ete varAhAdyAH puMsaH svAMshakalAH |  \" ko.arthaH\?\" \" kR^iShNaH 
paramapuruSho bhagavAn svayameva eta\" iti |  \" kuta etad\?\" iti ched
udAhR^itashrutisamvAdAt |  \" arthAntarasya samvAdAbhAvAchcha\" ityAha \dash
\" anyastu\" iti |  \" varAhAdayo aMshAH |  kR^iShNo.aMshI ityevaM rUpaH |  ito.apyayaM 
visheSho na yukta\" ityAha \dash \" aMshatvam\" iti |  tatrApi kR^iShNe.api |  kiM 
chAsmin vyAkhyAne kR^iShNasyaikasyaiva prakR^itatvAt |  \" indrArivyAkulaM lokaM 
mR^iDayanti yuge yuge\" (bhA\.pu\. 1\.3\.28) ityuttaravAkye bahuvachanaM nopapannamityAha 
\dash \" mR^iDayanti\" iti |  \" nanu bahuvachanaM pUrvoktaiH varAhAdibhiH sambadhyate\? 
na kR^iShNena\" iti chenna |  \" kR^iShNastu bhagavAn svayam\" (bhA\.pu\. 1\.3\.28) iti 
vAkyArthena vyavahitatvAt |  vyavahitasyApi punaH sannidhAnAya parAmarshAbhAvAt |  sati 
gatyantare.adhyAhArA.ayogAt |  \" asaMnihitenAnvayabodhasya kvApyadarshanAd\" iti 
bhAvenAha \dash \" na hi\" iti |  \" kriyA\" iti prakR^itApexayoktam |  \" nanu 
sannidherapi yogyatA balavati\" iti chet, satyam |  sannidhimanatikramya 
yogyAnvayastUktaH || 41||

%%% ##endlabel##

%%% ##label=<segment017_pd10>##

{\Largedvng pra\.dI\. || } \" athavA bahunaitena kiM j~nAnena iti pUrvoktavyasta\-
j~nAnAxepAttasya niShphalatvam\" iti pratIti nirAsArthamAha \dash \" kim\" iti | 
\" kim\" ityayamAxepo vaxyamANasarvavyAptarUpaj~nAnasya uktaraviprabhR^itiparichChinna\-
vastusvarUpaj~nAnApexayA prAdhAnyaj~nApanArthameva na tUktavisheShaj~nAnasya niShphalatva\-
j~nApanArtham |  \" niShphalatve taduktivaiyarthyApattiH\" ityarthaH |  \" nanu
vyAptij~nAnenaiva muktisambhavAdvisheShaj~nAnaM vyarthameva kiM na syAt\?\" ityata Aha 
\dash \" aj~nAtvA\" iti |  priyashirastvAdyaprAptirityAdikaM dhyAnApexayoktam |
j~nAnApexayA tu shrutirityavirodhaH |  athavA vishiShTAdhikAriviShayeyaM shrutiH |
\" nanu vyAptaj~nAnayogyAnAM visheShaj~nAnaM niShphalameva |  anyAn prati tu
taduktiriti vyavasthA.astu |  \" tava\" iti visheShaNasAmarthyAd\" ityata
Aha \dash \" tvaM tu\" iti |  \" ato na tava visheShaj~nAnamAtreNAlamiti 
j~nApayitum\" iti sheShaH |  \" visheShaNasyAnyathAsiddhatvAnnoktavyavasthA\-
kalpakatvam\" iti bhAvaH |  \" nanu kiM j~nAtena, na kimapIti shabdAduktasya
naiShphalye pratIte taduktivaiyarthyaprasaN^gAt bAdhakAt niShphalAlpaphalayoH
mahAphalatvAbhAvasAdR^ishyAt gauNyA vR^ittyA uktasyAprAdhAnyapratItAvarthAd
vaxyamANasya prAdhAnyapratItiH\" ityuktam |  \" tatra gauNaprayoge prayojanaM
vAchyam\" iti chenna |  \" rUDhopachAratvAd\" iti bhAvenA.aha \dash \" anya\" 
iti |  \" stutiH\" prashastatAj~nApanam |  \" arthaH\" prayojanam |  \" syAdidaM
vyAkhyAnaM yadi parichChinnaj~nAnAdvyAptij~nAnasya prAdhAnyaM pramitaM syAt |  
tadeva kuta\?\" ityata Aha \dash \" prAdhAnyaM cha\" iti |  \" yo mAm\" iti
vishiShTaphalakathanAt |  \" nyAyasiddho.apyartho vAkyasaMmatyA dR^iDho
bhavati\" ityetaduktam || 42||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrIbhagavadgItAbhAShyasya}
\centerline{TIkAyAM jayatIrthamunivirachitAyAM prameyadIpikAyAM dashamo.adhyAyaH ||}
%%% ##endlabel##

% shrImadhveshakR^iShNArpaNamastu 

%%% ##label=<segment001_pd11>##

{\Largedvng pra\.dI\. ||} etadadhyAyapratipAdyamarthamAha \dash \" yathA\" iti |  dashamAnte, 
\" vishhTabhyAhamidaM kR^itsnamekAMshena sthito jagat\" (10\.42) iti vyAptopAsanaM 
saN^xepeNoktam |  na cha saN^xepoktasya dhyAnaM shakyam, buddhAvanArohAt |  
ato, yathAbhUte vyAptarUpe vistareNa shrute dhyAnaM shakyaM bhavati |  tathAbhUtasya 
rUpasthitirarjunAya pradarshitasyAnuvAdena anenaikAdashAdhyAyena uchyate |  
svarUpagrahaNena vishvarUpasya mAyAdinA tadaiva nirmAya visR^ishhTatvaM nivArayati  |
%%% ##endlabel##

%%% ##label=<segment002_pd11>##

{\Largedvng pra\.dI\. ||} \" manyase yadi ityatra \" prabhu\" shabdo na svAmitvamAtrArthaH, 
kintu tavAtisAmarthyAt tvatsAmarthyenaivAtIndriyasyApi darshanam iti 
bhAvena prayukta\" ityAshayena Aha \dash \" prabhuH\" iti |  Ishvarasya 
niratishaya sAmarthye pramANamAha \dash \" nAsti\" iti |  \" bhUtam\"
samartham |  \" prabhu\" shabdasya samarthArthatve.abhidhAnamAha, \" prabhuH\" 
iti || 1\-4||
%%% ##endlabel##

%%% ##label=<segment003_pd11>##

{\Largedvng pra\.dI\. ||} \" mahAyogeshvaro hariH\" ityatra \" hari\" shabdasya
prakR^itopayuktamarthamAha \dash \" hariH\" iti |  \" geheshhu\", ishhTigR^iheshhu |
\" harateH\", ikAra pratyayaH |  \" shreshhTho\" aprAkR^itaH |  \" aprAkR^itavigrahasya
sAkArasyaivAnantapUjAsthAneshhu svarUpeNaiva yugapat sannidhAne kiM vaktavyaM
mahAyogeshvaratvam\?\" iti || 5\-9||
%%% ##endlabel##

%%% ##label=<segment004_pd11>##

{\Largedvng pra\.dI\. ||} \" sarvAshcharyamayam\" iti kenachit iti kenachit prAchuryArtho
mayaT vyAkhyAtaH |  tadasat |  \" sarvashabdena gatArthatvAd, iti bhAvenAha 
\dash \" sarva\" iti |  mayaTastAdAtmyArthatve pramANamuktameva  || 10\-11||
%%% ##endlabel##

%%% ##label=<segment005_pd11>##

{\Largedvng pra\.dI\. ||} \" divi sUryasahasrasya\" iti vishvarUpasya sahasrasUryopamaprabhatvamuchyate |
tatra \" sahasrashabdo dashashatavAchI\" iti pratItinirAsArthamAha \dash \" sahasra\" iti |
anantasUryopamaprabhatvamapi bhagavato na vAstavam, nirupamatvAt |  \" kiM tarhi\?\"
ityata Aha \dash \" tadapi\" iti |  \" pratyAyanArthaM, buddhipraveshanArthamevochyate |
yathA bhagavato dAsharatheH pAkashAsanopamaparAkramatvam\", ityarthaH |

\" sahasrashabdasya prasiddhArthaparityAgaH kutaH\?\", ityata Aha \dash \" tathA hi\"
iti |  \" tatastataH\", \" sUryAderapi vilaxaNa\" iti sheshhaH |  \" kutaH shrutyA
gItAvAkyasya bAdha\?\" iti chet\?  \" shataM sahasraM ityaparimitanAmAni, iti
gItAvAkyasya sAvakAshatvena daurbalyAt |  shruteH niravakAshatvena prAbalyAt |
itashcha shruteH prAbalyam\" ityAha \dash \" mahAtAtparyAchcha\" iti |
\" samastAgamAnAM mahAprayojanAya yadbhagavati mahAtAtparyaM, shrutestadAnukUlyAt,
gItAvAkyasya tatprAtikUlyAd\", ityarthaH |  \" kathaM gItAvAkyasya tatprAtikUlyam\?\"
iti chet\?  kiM bhagavataH parimitaprabhatvameva vastutaH, uta aparimitaprabhasyApi
atra sahasrasUryopamaprabhatvamuchyate\?  nA.adyaH |  sakalashrutismR^itItihAsapurANavirodhAt |
dvitIye, tvaparimitasya parimANoktyA kiJNchidapi prayojanaM na siddhyati |
\" kuto mahad\?\" ityAha \dash \" na cha\" iti  || 12||
%%% ##endlabel##

%%% ##label=<segment006_pd11>##

{\Largedvng pra\.dI\. ||} \" anekabAhUdaravaktranetram\" ityatra \" aneka\" shabdasya dvayAdau
paryavasAnAd, vivaxitamarthamAha \dash \" aneka\" iti |  \" anekavaktranayanam\" 
(11\.10) ityapi vyAkhyAtam |  \" kuta etad\" ityata Aha \dash \" ananta\" 
iti |  \" sarvata\" ityasyArthaH tAtparyanirNaye.avagantavyaH |  \" ityAdi 
cha\" vaxyati |

\" bAhubhyAm\" pradhAnAbhyAM |  \" patatraiH\" \" patatrasadR^ishairitarabAhubhiH
sandhamati agnyAdibhUtAni sa.nyojayati\" iti pratyekamanvayaH |  
\" saM namati\" ityasyApyayamevArthaH |
%%% ##endlabel##

%%% ##label=<segment007_pd11>##

{\Largedvng pra\.dI\. ||} \" etayormantrayoH prakR^itAnupayogAdayuktamudAharaNam\" ityata 
Aha \dash \" vishvashabdashcha\" iti |  tathA cha \" prathamArthe tasiH\" ityuktaM
bhavati |  spashhTArthAM chAtra shrutimAha \dash \" anantapAdam\" iti |  

\" yadi bhagavAnanantabAhvAdiH, tadA paramamahatparimANaH syAt\?  anyathA 
tadayogAt |  na cha tadyuktam, \" rUpaM mahat te\" (11\.23) iti mahattvamAtrokteH |  
tathA \" bahuvaktranetram\" (11\.23) iti bahutvamAtrokteranantabAhvAditvoktishcha
anupapannA\" ityata Aha \dash \" mahattvAd\" iti |  \" syAdayaM virodho, yadi 
bhagavadrUpasya mahattvamAtraM tadavayavAnAM cha bahuttvamAtramuchyeta |  na chaivam 
\dash avachchhedakAshravaNAt |  mahattvabahuttvoktirastu paramamahattvAtmakatvena
anantAvayavatvena cha saha sambhavati |  paramamahati mahattvasyAnante cha
bahuttvasyAntarbhAvAd\", ityarthaH |

\" avachchhedakAnuktAvapyavAntaramahattvAdigrahaNe ko doshha\?\" ityata Aha \dash 
\" anyathA\" iti |  tatra paramamahattvasyAnantAvayavattvasya chokteriti bhAvaH |

\" pashyAmi tvA sarvato.anantarUpam\", \" tvayA tataM vishvamanantarUpa\" (11\.38)
iti \" ananta\" shabdadvayasya mAhAtmyAtishayasUchanAya, arthabhedamAha \dash \" ekatra 
tu\" iti |  \" aparimANo.aparichchhinna iti anantarUpa\" iti sambandhaH |

\" syAdidaM vyAkhyAnaM yadIdaM dvayaM prAmANikaM syAd\" ityata Aha \dash \" uktaM 
hi\" iti |  \" mahAntam\", mahat |  \" mahato mahAntam\" iti \" anantaM
aparichchhinnaparimANaM rUpamasya\" ityuktArthe pramANam |  \" ekam\" abhinnamapi |
\" anantarUpam\" iti \" anantAnyasaN^khyAni asya rUpANi\" ityarthaH |

\" nanu \" mahato mahAntam\" iti mahattvAt mahattvamevochyate |  na tu anantatvam |
tatashcha \" yadekamavyaktam\" ityavyaktavyApitvavachanAt tatsAmyameva siddhyati\", 
ityata Aha \dash \" avyaktasya\" iti |  \" mahato\" \" mahattve avyaktavyApitve 
cha\", ityapi grAhyam |  \" avyaktasya anantatvaM kuta\?\" ityata Aha \dash \" mahAntaM 
cha\" iti |  \" anantasya\" vishhNoH pratimAbhUtasya \" tasyAntaH\" parimANaM
parichchhedaH kAryataH \" saN^khyAnam\" saN^khyAparichchhedo.api \" na\" \" vidyate\" |

prakArAntareNa, \" ananta\" \" rUpa\" shabdadvayasya arthabhedamAha \dash \" tAni cha\" iti |
ekasya \" anantarUpa\" shabdasya \" anantasaN^khyArUpa\" arthatve sthite sati ekatra
\" anatarUpa\" shabde |  \" tAni cha anantasaN^khyAni rUpANi pratyekamapi 
aparichchhinnaparimANAni ityartho bhavati\", ityarthaH |  atra pramANamAha \dash
\" asaN^khyAtA\" iti |  \" j~nAnakAH\" j~nAnAnandAtmakAH |

\" ayam\" bahiH vyApta \" AkAshaH\" paramAtmA \" yAvAn\" yAvatparimANaH
\" tAvAnevaishho.antarhR^idaye\" sthitaH paramAtmA, ityarthaH |

\" garbhe jaThare jagat yasya, asau\", tathoktaH |  \" avasanno\" avanataH |
garbhajagattvena aparichchhinaparimANatvaM labhyate  |
%%% ##endlabel##

%%% ##label=<segment008_pd11>##

{\Largedvng pra\.dI\. ||} \" kR^ishhNAdInAmapi aparichchhinnaparimANatvaM vadanto vaktavyAH |  
tatra alpaparimANapratItiH yA sA kiM bhrAntiruta pramitiriti\?  Adye 
kriyAdeH dvibhujachaturbhujAdeshcha mithyAtvaM syAt\?  na dvitIyaH |  yugapadekatra
alpAnalpaparimANasamAveshasyAyuktatvAt |  ato.aparichchhinnaparimANoktiH
upachAramAtram\", iti chet\?  kiM idamanekaparimANatvasya ayuktatvaM, kiM anyatra 
adarshanena asambhAvitatvaM, uta nAyamalpAnalpaparimANopeto dravyatvAt\?  \" nAyaM 
paramamahatparimANo.alpaparimANattvAt, paTavad\" ityAdiyuktiviruddhatvaM, 
atha atiprasaN^gadushhTatvam |  kiM vA aprAmANikatvam\?  nA.adya, ityAha \dash 
\" na cha\" iti |  \" aghaTitaghaTanAshaktyupete kiM nAma asambhAvitam\?\" 
iti bhAvaH |  na dvitIyaH |  \" Ishvarasya yuktyagocharatvena tadanavakAshAd\" 
iti bhAvenAha \dash \" achintyA\" iti |

\" eshhA\" brahmavishhayA |  \" apaneyA\" nirAkAryA |

\" atiprasaN^go.api kiM yadi Ishvaro viruddhaparimANadvayopetassyAt, tadA
\" nirduHkho, duHkhI cha syAd\" iti IshvaramadhikR^itya syAd\?  uta
prANAdayo.api tathA syuH\?  tatashcha \" aNushcha\" (bra\.sU\. 2\.4\.14) ityAdikA
tadvishhayavAkyavyavasthA nAN^gIkriyata ityanyadadhikR^itya syAt\?\"

AdyaM dUshhayati \dash \" atiprasaN^gastu\" iti |  \" avisheshhamAshritya hi ayaM atiprasaN^gaH |
na chAsAvasti |  nirdoshhAnantaguNatve hareH shrutInAM mahAtAtparyeNa duHkhAdeH
tadvirodhAt, parimANadvayasya tu tadavirodhAt duHkhAderapramANikatvAt,
parimANadvayasya tu ukta, vaxyamANa, vAkyasiddhatvAd\", iti bhAvaH |

\" viparyayAparyavasAyI chAyaM prasaN^ga\" iti bhAvenAha \dash \" na hi\" iti |  \" yadi
ghaTaH pR^ithubudhnodarAkArassyAt, tarhi padArtho na syAt\?  tathAvidhasya
padArthasya kasyApyadR^ishhTatvAd\", iti prasaN^go yathA na yuktaH |  \" bhavati
cha padArthaH, tasmAt pR^ithubudhnodarAkAro na bhavati\" iti viparyasya
pramANabAdhitatvena aparyavasAnAt |  tathAtvena tasya dharmigrAhakapramANadR^ishhTatvAt |
tathA prakR^ite.api, iti |

etena anumAnAnAM kAlAtyayApadishhTatvaM choktaM bhavati |  \" prANAdikamadhikR^itya
atiprasaN^ga\" iti dvitIyaM nirAkaroti \dash \" keshhuchid\" iti |  \" atrApi 
sambhAvanAhetubhAvAbhAvAbhyAM visheshhAdavisheshho.asiddha\", iti bhAvaH |

chaturthaM nirasyati \dash \" guNA\" iti |  \" shrutA\", \" ashrutA api\" 
\" suviruddhA\" anyatra saha adR^ishhTAH |  \" aviruddhAshcha\" |  \" tathA\" \" guNA\" 
iva \" doshhAH\" \" shrutA\", ashrutAshcha naiva santi, kintu \" aj~naiH\" 
mithyAdR^ishhTibhiH \" hi\" \" tathA\" santi, iti \" pratItAH\" |  \" evaM pare\" 
Ishvare sthitiH |  tato\" anyatra\" tu \" shrutAnAm\" pramANAntarasiddhAnAM 
cha guNAdoshhANAM \" vyavasthA\" avasthAnam |  tachcha \" kramAd\" \dash 
\" uttameshhu guNabAhulyaM doshhAlpatvaM, madhyameshhUbhayasAmyaM, avareshhu 
doshhabAhulyaM guNAlpatvam\" iti |

\" tadevamasambhAvanAdyabhAvAnna bhagavati aparichchhinnaparimANatvokterupacharitatvaM
kalpyaM, arjunenApi tannirAkR^itam\" iti bhAvenAha \dash \" upachAratva\" iti |
\" nAntaM \.\.\. na punastavA.adiM pashyAmi\" iti AdyantAbhAvokterupacharitatvaparihArAya,
\" na madhyam\" ityuktam |

\" madhyanirAkaraNArthameva tat kiM na syAd\?\" ityata Aha \dash \" anyathA\" iti |
\" upachAratvaparihArArthatvAbhAve tad vaiyarthyaM syAd\", iti sheshhaH |  \" kutaH\?\" 
AdyantasApexatvAt, madhyasya tadabhAvoktyaiva tadabhAvasiddheH |  \" vishvaM 
mahadAdikaM rUpaM, svarUpamasya\", iti pratItiM sapramANakaM nivArayati 
\" vishvarUpa\" iti |  \" etachcha abhyAsarUpam\" iti mantavyam || 16||
%%% ##endlabel##

%%% ##label=<segment009_pd11>##

{\Largedvng pra\.dI\. ||} \" nanu \" analArkadyutim\" ityuktatvAt, \" sahasrashabdo.anantavAchI\"
ityAdyuktaM ayuktam\" iti chenna \dash \" etadeva AshaN^kya pratyAyanArthameva etaduktam |  
\" vastutastu aparichchhinnadyutireva bhagavAn\" iti svayameva uktatvAd\", ityAha 
\dash \" anala\" iti |  ityukte jAtAM dyutermitatvashaN^kAm |  etachcha 
savisheshhaNavisheshhaNatvAt, dyutyA sambaddhyate || 17\-18||
%%% ##endlabel##

%%% ##label=<segment010_pd11>##

{\Largedvng pra\.dI\. ||} \" shashisUryanetraM ityuktatvAt kathaM \" vishvarUpa\" shabdasya anyathA
vyAkhyAnam\?\" ityata Aha \dash \" shashi\" iti |  \" ityAdivat\" vyAkhyeyam |
\" janyajanakabhAvena, AshrayAshrayibhAvena vA, abhedoktiH\" ityarthaH | \" kuta etad\?\" 
ityata Aha \dash \" tadaN^gajA\" iti |  \" tadaN^ga\" iti avibhaktiko nirdeshaH, 
sambuddhirvA |  abhede bAdhakaM chA.aha \dash \" chandramA\" iti |  \" chaxoH\" chaxushhaH |

\" nanvatra chandramaso manojAtatvaM tadAshrayatvaM chochyate |  gItAyAM tu netrAshrayatvAdi |
tathA.anyatra \" daMshhTrA.aryamendU\" iti |  tatkuto na virodha\?\" ityata Aha \dash \" bahu\" 
iti || 18\-19||
%%% ##endlabel##

%%% ##label=<segment011_pd11>##

{\Largedvng pra\.dI\. ||} \" dyAvApR^ithivyoridamantaraM hi ityatra \" tvayA\" ityanenaivaikatvasya
siddhatvAt, \" ekena\" iti vyartham\" ityataH pramANapUrvakaM tadabhiprAyaM
Aha \dash \" mAtApitroH\" iti |  bahutve.api sa \" eko\" abhinnaH |  

anena \" dishashcha sarvAH\", \" rUpAntaraiH\" ityuktaM bhavati |  \" tadayuktam,
vishvarUpasya \" drashhTumichchhAmi te rUpam\" ityAdinaikatvAvagateH\"
ityata Aha \dash \" pashya\" iti |  \" aikyApexayA ekavachanam\" iti bhAvaH |
\" mAtApitroH iti shrutiH prakR^itAnupayoginI kathamudAhR^itA dyAvApR^ithivyoH
ityanabhidhAnAd\?\" ityata Aha \dash \" mAtApitarau cha\" iti |

\" mAtA\" \" pR^ithivI\" \" no\" asmAn \" durmatau\" \" mA\" \" dhAt\", 
na dadhyAt |  \" no\" asmAkaM \" madhu\" sukhaheturastu |

\" dR^ishhTvAdbhutam\" ityAdinA vishvarUpadarshanasya bhayahetutvamuchyate |
\" tanna sarveshhAM sarvadA, kintu keshhAJNchit kAraNavisheshhAt kadAchideva\" iti
sapramANakaM tadabhiprAyamAha \dash \" na tu\" iti |  \" abhyase\" abhyAse 
sati, sarveshhAM \" tR^iptiH\" \" Ananda eva\", ityarthaH |  evaM taddarshanasya 
bhayahetutvaniyama abhAvamabhidhAya lokatrayasya darshanAbhAvaM chAha \dash \" na 
tu\" iti |  \" kintu trilokeshhu sthitaiH bhaktaiH\" ityuktaprakAreNa kaishchideva |
\" tadabhiprAyashcha \" lokatraya\" shabda\", iti bhAvaH |  prakArAntareNa
\" lokatrayam\" ityasyAbhiprAyamAha \dash \" adR^ishhTvA.api\" iti |
\" vishvarUpadarshanArthaM yatamAnAnAM lokatrayasthAnAM puMsAM tadadR^ishhTvA.api
chetasi nirUpya sthitAnAM bhaye jAte sati, taddrashhTurarjunasya tathA.ahamiva
etepi dR^ishhTvA bibhyati, iti pratibhAti, ityato \" lokatrayam\" dR^ishhTvA
\" pravyathitam\" ityAha\", ityarthaH |  atra shrutisammatimAha \dash \" dR^ishhTvA\" 
iti |  \" devam\" vishvarUpaM \" dR^ishhTvA\" \" modamAnAH\" \" ta\" ete,
arjunAdayaH taddhyAyinaH \" pashyanti\" |  katham\?  bhUtAnadR^ishhTvA.api 
tannirUpya etad \" bhayAdbibhyato\" bhayachihnavataH, \" tasminneva\" 
vishvarUpe \" manaso gatatvAt\" tan \" nyastachaxurmukhA.nshcha\" 
\" dR^ishhTavat\" dR^ishhTavanta iva \dash ityarthaH  || 20||
%%% ##endlabel##

%%% ##label=<segment012_pd11>##

{\Largedvng pra\.dI\. ||} \" svarUpameva aj~nAtvA, taddhArmAn vA ayaM pR^ichchhati\" iti
anyathApratItinirAsArthamAha \dash \" dharmAntara\" iti |  tarhi \" kiM dharmAntaro 
bhavAn\?\" iti prashnena bhAvyam |  \" ko bhavAn\? iti tu na yujyata\" 
ityata Aha \dash \" yathA\" iti |  anyeshhAM vyavahArAn nAma, pratyaxeNa
rUpAdikaM jAnannapi jAtij~nAnArthaM yathA kashchit kaJNchit \" kastvam\?\" 
ityeva pR^ichchhati |  \" tathA.arjuno bhagavantaM taddharmA.nshcha jAnan api 
dharmAntaraj~nAnArthaM \" ko bhavAn\?\" ityeva pR^ichchhati\", ityarthaH |  
prashnavyAkhyAnasya vartamAnatvAd vartamAnanirdeshaH |

\" ugraM rUpaM dR^ishhTvA, \" rudro vA yamo vA ayam\", iti svarUpa eva sandihAnasya
prashnaH kiM na syAd\?\" ityata Aha \dash \" yadi\" iti |  \" tatsvarUpameva\" 
ityarthaH |  \" bhAsastavogrAH pratapanti vishhNo\" (11\.30) iti |  

\" tarhi dharmavishhayo.ayaM prashno.astu |  tatashcha \" antara\" shabdo na yukta\" ityata 
Aha \dash \" tvam\" iti |  \" yadi bhagavad dharmAn na jAnIyAt, tarhi
\" tvamaxaraM paramam\" (11\.18) ityAdi varNanam na syAt\?  ato, bhagavantaM
taddharmA.nshcha axaratvAdIn j~nAtvA, tadanyadharmaj~nAnArthameva prashna, ityevamuktam\"
ityarthaH  || 21\-31||
%%% ##endlabel##

%%% ##label=<segment013_pd11>##

{\Largedvng pra\.dI\. ||} \" evaM tarhi \" kAlo.asmi\" ityuttaramayuktaM, dharmAnukteH\" 
ityata Aha \dash \" kAla\" iti |  \" dharmavishishhTabhagavadvAchI\" ityarthaH |  
\" kuta etad\?\" ityata Aha \dash \" kala\" iti |  \" yathA kAmadhenuH 
sarvArthAn dadAti, tathA.ayamapi dhAtuH sarvArthavAchI\" ityarthaH |  tathA 
cha asmAd aN, kartari ghaJN vA |  \" jagad\" iti yogyatayA sambaddhyate |

\" bhavatu ayaM bandhanAdidharmavadvAchI |  bhagavadvAchI tu kutaH\?\" \" anyatra
rUDhatvAd\" ityata Aha \dash \" prasiddhashcha\" iti |  \" baddham\" mAM prati
\" vikatthase\", AtmAnaM tu shlAghase |  \" saH\" \" kAlaH\" \" ayam\" |  
katham\?  \" shyAmaH\", \" prajA\" \" harati\" |  \" baddhvA tishhThati, raudrashcha\", 
iti |

\" atra kathaM vishhNuvAchitvanishchaya\?\" ityata Aha \dash \" vishhNunA\" iti |  
\" kAlanAma vigraho yasya, asau\" tathoktaH  |
%%% ##endlabel##

%%% ##label=<segment014_pd11>##

{\Largedvng pra\.dI\. ||} \" pravR^iddha\" iti kAdAchitkI vR^iddhiH pratIyate |  ata Aha \dash 
\" pravR^iddha\" iti |  \" vR^iddhiH\" dhAtvarthaH |  \" sA cha \" pra\" shabdena deshataH, kAlatashcha 
sadAtanI vivaxitA\", iti bhAvaH |  \" anAdiH\" iti nityasyApi 
upalaxaNam |  \" bhUtAdhikAre vihitasya tasya kutaH sArvakAlikatvam\?\" 
\" prayogadarshanAd\", iti bhAvenAha \dash \" R^itaM cha\" iti |  \" iddhAt\", 
\" bhUtamitivad\" ityarthaH |  \" atrApi sArvakAlikatvAnishchaya ityato bhagavato 
dIpteH sattAyAshcha sadAtanatve shrutisadbhAvAd\" ityAha \dash \" pra vishhNuH\" iti |  
\" vishhNuH\" tavaso deshakAlaparichchhinnAt sUryAdestejasaH \" stavIyAn\" 
atishayitatejorUpo bhavati |  ata eva, \" hyasya sthavirasya\" anAdikAlInasya 
\" tveshham\" iti nAma |  \" asAdhAraNyena hi vyapadeshAH bhavanti\", iti arthaH |

\" astvevaM, tathA.api prAgalpassannidAnIM vR^iddhiM gataH ityatrArthaH kiM na syAd\?\"
ityata Aha \dash \" na tu\" iti |  \" tu\" shabdo visheshhaNArthaH |  

vikriyArUpaM varddhanaM \" pravR^iddha\" shabdapravR^ittinimittaM na bhavati |  bhagavati
bhAvavikArANAM pratishhiddhatvAt |  

\" bhagavato vikriyArUpavR^iddhyabhAve.api tadrUpasya bhavatu\" iti tatrAha \dash
\" yasya\" iti |  \" nanu \" na karmaNA varddhate no kanIyAn\" iti
shrutau karmanimittavR^iddhipratishhedhanAt \" vR^iddhimAtramasti\" iti j~nAyate |
anyathA visheshhaNavaiyarthyAt |  tathA cha satpratipaxamuktavAkyam\" ityata
Aha \dash \" na\" iti |  \" na karmaNA\" iti visheshhanishhedhastu vR^iddhilaxaNa
vikriyAkAraNatvena |  \" sambhAvitena karmaNA.api yadA na varddhate, tadA 
svayaM karmaNA vinA na varddhate, iti kimu vaktavyam\? iti vR^iddhilaxaNa
vikriyAkAraNatvamAtranishhedhAya kaimutyapradarshanArthaM ityanyathopapannam\" 
ityarthaH |

\" nanu sarvatra bhagavAneva lokAnAM saMhartA |  tasmAt, \" iha\" iti vyartham\",
ityata Aha \dash \" lokAn\" iti |  \" yugapat bahUn pratyaxata eva\", iti
\" visheshheNa\" |  \" yudhishhThirAdInAM avashishhTatvAt kathaM \" tvaM R^ite\"
ityevoktam\?\" ityata Aha \dash \" bhrAtrAdI.nshcha\" iti |  \" apishabdo
dyotayati\" iti sheshhaH |  \" asmatpratikUleshhvanIkeshhvavasthitA yodhA na
bhavishhyanti, ityukte kA pANDavAdInAM prAptiH\?  yena \" R^ite.api tvAm\"
ityuchyanta\?\" ityata Aha \dash \" pratyanIkatvam\" iti |  \" senAdvayasyApi\" 
iti sheshhaH |  \" kuta evaM vyAkhyAnam\?\" ityata Aha \dash \" sarva\" iti |  
\" senAdvayagatA api\" ityarthaH |  \" pratyanIkeshhu\" iti bahuvachanaM 
katham\?  ityata Aha \dash \" axauhiNI\" iti |  \" bhedena\", bahuttvena || 32||
%%% ##endlabel##

%%% ##label=<segment015_pd11>##

{\Largedvng pra\.dI\. ||} \" yadvA jayema yadi vA no jayeyuH\" (2\.6) ityasya sandehe.api 
pravR^ittiryuktA |  \" paxadvaye.api phalalAbhAd\" iti \" hato vA\" (2\.37) 
ityuttaramuktam |  idAnIM, \" tava parAjayashaN^kA.api nAsti\" ityuchate \dash \" droNaM
cha\" iti |  tatra droNasya dhanurvidyAchAryatvena, bhIshhmasya svachchhandamR^ityutvena 
chA.ashaN^kAvishhayatvAd yuktaM yodhavIrasamudAyAt pR^ithakkR^itya svashabdena 
grahaNam |  \" jayadrathasya, karNasya cha kuta\?\" ityata Aha \dash \" yo.asya\" 
iti |  \" asya\", jayadrathasya, tachchhiraH tasya pAtayituH \" shiro bhetsyati\" 
bhetsyate |  \" tatpituH\", jayadrathapituH |  \" shaktiH\", \" asti karNasya\", 
iti sheshhaH |  \" karNo visheshheNokta\" iti vartate  || 33\-34||
%%% ##endlabel##

%%% ##label=<segment016_pd11>##

{\Largedvng pra\.dI\. ||} \" sthAne ityetad \" yuktam\" ityarthe, avyayaM chAsti |  asti cha 
saptamyantaM padam |  tat kiM atrAbhipretam\?  kathaM cha asyAnvaya\?\" ityata 
Aha \dash \" yad\" iti |  \" sthAne\" \" vishhaye eva\" iti vA, \" bahumAnasthAne tvayi\" 
iti vA, yojanAyAM sAdhyAharatvam, iti bhAvaH |  \" hR^ishhIkesha\" shabdasya
prakR^itopayuktamapUrvarthamAha \dash \" agni\" iti |  atra Adyena \" anAdi\" shabdena 
sUryo gR^ihyate |  dvitIyena bodhanasthApane |  \" agnyAdyaMshubhiH svakeshaiH\" iti 
sheshhaH |  \" jagaddharshhaNAdeH\" iti \" bodhanasthApanAbhyAM jagaddharshhaNAd\" ityarthaH |

\" sUryAdyaMshUnAM kathaM bhagavatkeshatvam\?\" ityata Aha \dash \" keshatvam tu\" iti |
\" tanniyatatvatajjanyatvAdinA tAdAtmyoktirityatra kiM pramANam\?\" ityata Aha \dash
\" pramANaM tu\" iti |  \" ityatra\", etadvyAkhyAnAvasare |  anena vaxyamANaM
vAkyaM vivR^itaM bhavati |  tathA cha, \" agnyAdishhu sthitvA, svakeshaniyataistadaMshubhiH
jagato bodhanasthApanAbhyAM harshhaNAd\" ityuktaM bhavati |  hR^ishhyateH kIpratyayaH |  
\" hR^ishhyo harshhahetavaH keshAH asya\" iti \" hR^ishhIkeshaH\" |

\" nAnena prasiddho.arthaH tyAjyaH\", iti bhAvena tamapyAha \dash \" hR^ishhIkANAm\" 
iti |  \" nanu jagadIshasya visheshhataH indriyeshatvaM katham\?\" ityata Aha \dash 
\" teshhAm\" iti |  \" purushhArthopayuktaj~nAnakriyAshaktiprerakatvena\" iti bhAvaH |  
\" hR^ishhIkashabdasya indriyavAchitvaM kuta\?\" ityata Aha \dash \" na\" iti |  
pUrveNa samuchchitasya asya vyAkhyAnasamarthahetutvAt \" cha\" shabdaH |  
Adye.arthe pramANamAha \dash \" itaro.artha\" iti |  agnishcha jagat bodhayanto 
sthApayantashcha \" pR^ithak\" svAvasare utpadyante udayaM gachchhanti |  sUryakR^itaishcha |  
atrApi pUrvavadbodhanAderhetuhetumadbhAvo j~nAtavyaH |  IshAnatvAdAvapyukto 
hetuH  || 35\-36||
%%% ##endlabel##

%%% ##label=<segment017_pd11>##

{\Largedvng pra\.dI\. ||} \" sarve namasyanti, ityetadyuktaM, iti svayamevoktvA, \" kasmAchcha te
na nameran\" iti viruddhaM kathaM pR^ichchhati\? ityata Axepa evAyam\", iti
j~nApayituM tannivartyAshaN^kApradarshanapUrvakamavatArayati \dash \" katham\" iti | 
\" iti shaN^kAyAm\" iti sheshhaH |  tat tasyA uttaram |  \" mahAtmanaH 
axudrachitta\" ityalpArthapratItinirAsArthamAha \dash \" pUrNashcha\" iti | 
\" AtmA jIva\" iti pratItiM nivArayitumAha \dash \" Atma\" iti |  \" ukto\" 
niruktaH |  \" yad\", yasmAt |  ApnoteH man |  pakArasya cha takAraH |  
AN^pUrvAd dAJNaH, sa eva pratyayaH |  AkAralopaH tattvam |  
AN^pUrvAdado man, tattvaM cha |  \" iha\" dehe |  \" santato bhAvo\" 
nityA sattA |  AN^pUrvAt tanoteH Dman |  \" sadasadAtmakaM vishvaM 
tvameva\" iti sattAdipradatvAdevochyate, na tvanyathA |  \" tathA 
sati, uttaravAkyavirodhAd\" iti bhAvena, tatpaThitvA sapramANakaM 
vyAchashhTe \dash \" tatparam\" iti || 37||
%%% ##endlabel##

%%% ##label=<segment018_pd11>##

{\Largedvng pra\.dI\. ||} \" ekaH paroxa\" (shaM\.bhA\. 11\.42) iti klishhTaM vyAkhyAnaM iti j~nApayituM
tadarthaM, anvayaM cha darshayati \dash \" eka\" iti |  AdyaxaragrahaNena \" e\" shabdaH
ekasya dyotakaH |  \" ka\" shabdaH kArayitR^itvadyotakaH |  antarNItaNyarthAt
karoteH DaH |  \" athA.api\", evaM, asatkArAnarho.api \" asatkR^ito.asi\"  || 38\-42||
%%% ##endlabel##

%%% ##label=<segment019_pd11>##

{\Largedvng pra\.dI\. ||} \" svakaM rUpaM darshayAmAsa\" iti kR^ishhNarUpasya svakatvavisheshhaNAt,
\" vishvarUpaM na svakam\" iti pratItiH syAt\?  ata Aha \dash \" svakam\" 
iti |  \" kR^ishhNaH svakaM rUpaM, na vishvarUpaM, iti bhrAntapratItyanuvAdenochyata\"
ityarthaH |  \" kuta etad\" ityata Aha \dash \" anyathA\" iti |  \" pramANapratItyA\"
ityarthaH |  \" kAni tAni pramANAni\?\" ityata Aha \dash \" pramANAni\" iti |  
dvitIyAnte || 43\-50||
%%% ##endlabel##

%%% ##label=<segment020_pd11>##

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM ekAdasho.adhyAyaH ||}
%%% ##endlabel##


%%% ##label=<segment001_pd12>##

{\Largedvng pra\.dI\. || } etadadhyAyapratipAdyamarthamAha \dash \" avyakta\" iti |
avyaktaM shrIH |  \" tadupAyaM\" bhagavadupAsanopAyam |  tadupAyapradarshanaM cha
bhagavadupAsanAdhikyasamarthanArthaM ityekArthatA |  ShaTkAntarbhAvashcha |  arjunasya
prashnasaN^gatipradarshanenaiva AnantaryalaxaNA.api saN^gatirj~nAyate |

\" nanu bhagavadupAsanamiva avyaktopAsanamapi yadi moxasAdhanatvena pramitaM syAttadA
tatsAdhakAdhikyaviShayaH saMshayaH syAt |  tadeva kutaH\?  tathA cha kathamayaM
saMshayamUlo.arjunasya prashnaH\?  na hi bhinnaphalasAdhanasAdhakAnAM nirdhAraNArthaH
prashno yujyate |  kintu sAdhyanirdhAraNArtha eva |  na cha tathA prakR^ito
\" yAvAnartha\" (2\.46) ityAdinA nirastatvAt\" ityata Aha \dash \" tadupAsanam\"
iti |

\" shriyam\" prati \" vasAnA\" vasantaH tAmAchChAdya sthitA vA upAsInA iti
yAvat |  teShAM \" samithA\" samIhitAni satyAni bhavanti |  \" mitadrau\"
samudre xIrAbdhau |  shrIshabdasya anyatrApi pravR^itteravyaktaviShayAmeva shrutiM
paThati \dash \" anAdi\" iti || \" nichAyya\" sampUjya nishAmya vA |  atrApi
nAvyaktaM shrUyata ityata Aha \dash \" avyaktaM cha\" iti |  cho.avadhAraNe |
\" kuta etat\?\" \" paramAtmano.api tatsambhavAd\" ityata Aha \dash
\" mahata\" iti |

atra hi \" taM mahataH param\" iti parAmarsho dR^ishyate |  sa choktasyaiva
bhavati |  avyaktameva cha \" mahataH paramavyaktam\" iti mahataH paratvena
uktam |  ato.atrApyavyaktagrahaNe \" tam\" ityayaM \" mahataH paramavyaktam\" 
ityuktasya parAmarsha ityupapadyate |  anyathA.anuktaparAmarshaH prasajyate |  
paramAtmA tu na mahataH para ityuktaH |  kintu \" avyaktAtpuruShaH
paraH\" ityevetyarthaH |  shrutidvayArthasaN^grahikAM spaShTAM chAtra shrutiM
udAharati \dash \" upAsya\" iti |

%%% ##endlabel##

%%% ##label=<segment002_pd12>##

{\Largedvng pra\.dI\. || } \" nanvevaM pratIyamAnamapyavyaktopAsanasya moxasAdhanatvaM
upacharitameva |  \" antavattu phalaM teShAm\" (7\.23) ityuktanyAyAt |  ato 
nAsya sandehahetutvam\" ityata Aha \dash \" mahachcha\" iti |  \" tasyAH\" shriyaH |
\" yuktaM brahmAdyupAsanasya moxasAdhanatAyAM upacharitatvakalpanam |  teShAM
jananamaraNAdimattvena asambhavAt |  shriyastu mahAmAhAtmyavattvena vedoktatvAt
asambhavAbhAvAt vAstavameva tadupAsanasya moxasAdhanatvam\" ityarthaH |

\" supeshA\" surUpA |  \" ghR^itapratIkA\" dIptAN^gI |  \" vayunAni\" j~nAnAni
\" vaste\" AchChAdayati |  j~nAnAlaN^kR^itA iti yAvat |  \" suparNA\" suShThu
paramAnandau \" vR^iShaNA\" sechakau, dvirUpo bhagavAneva |  \" yatra\" yasyAM
viShaye |  atra nityayauvanaM j~nAnamayatvaM sarvadevatApUjyatvaM cha pratIyate |
evamuttaratra |

rudrAdyaiH parivR^itA |  \" rAShTrI\" rAj~nI |  \" yaj~niyAnAm\" yaj~nArhANAM
\" vasUnAm\" padArthAnAM devAnAM vA \" saN^gamanI\" saN^gamayitrI |  \" prathamA
chikituShI\" anAditaH sarvatra kR^itanivAsA |  \" purutra\" purusthAneShu | 
\" vyadadhuH kR^itavantaH\" pUjArthaM pratiShThApitavantaH |  \" bhUristhAtrAm\" svato
bhUristhAneShu sthitAm |  bhUristhAneShu devAnAveshayantIm |

yo.annamatti sa mayaivAttItyAdi |  ye \" amantavo\" niraparAdhAste \" mAmupaxayanti\"
matsamIpe vasanti |  \" shrudhi\" shruNu |  \" shrutaH\" prasiddhaH |  \" shraddhivaM\"
shraddheyam |  yaM \" ugram\" rudraM kartuM \" kAmaye taM tamugraM kR^iNomi\" karomi
ityAdi |  sumedhasam |  \" rudrAya\" ityAdi chaturthI dvitIyArthe |  \" brahmadviShe\"
saMhArakAle brAhmaNA.a.adisarvaprANidviSham |  yadvA brahmadviShAM \" sharave\" hiMsakaM
\" hantavA u\" hantumeva |  asya jagataH \" pitaram\" hiraNyagarbhaM mUrdhani
sarvAdhikye |  \" yoniH\" kAraNam |  divA ityAditR^itIyA paJNchamyarthe |  \" enA\"
etasyAH |  \" mahinA\" mahimnA ahaM etAvatI \" sambabhUva\" ityAdinochyate |

%%% ##endlabel##

%%% ##label=<segment003_pd12>##

{\Largedvng pra\.dI\. || } \" bhavatvevaM, tataH kim\?  asandigdhatayA bhagavantameva
upAsInasyArjunasya kathamayaM saMshayaH yenaivaM pR^ichChati\?\" ityata Aha \dash \" iti\"
iti |  yata evaM bhagavadupAsanasyevAvyaktopAsanasyApi vinopachAreNa moxasAdhanatvaM
pratIyata iti tasmAnmArgadvayenaikameva phalaM prApnuvatAM madhye ke shreShThA iti
sAdhakabAdhakapramANAbhAvena shaN^kA saMshayaH kasyachidaviditatattvasya bhavati |
atastadanujighR^ixayA bhagavadupAsakA eva shreShThA iti \" jAnannapi\" arjunaH
pR^ichChatItyarthaH |  athavA \" jAnannapi\" tatra svAviditayuktij~nAnArthaM
saMshayamAhR^itya pR^ichChatItyAha \dash \" sUxma\" iti |

yogyatAvashAdevambhUtaM tvAmevaMprakAreNopAsata ityubhayatra evaMshabdasyAnvaya
ityAshayavAnAha \dash \" evaM\" iti |  dR^iShTaM shrutaM cha rUpaM yasya brahmaNaH
tattathA |  avyaktAxarashabdayorapavyAkhyAnaM nirAkartumarthaM tAvadAha \dash \" avyaktam\"
iti | \" prakR^itiH\" chetanA |  \" triguNam\" triguNAbhimAnitvAt |
\" sadasadAtmakam\" kAryakAraNAbhimAnitvAt |  \" avisheSham\" akAryam |
tataH pradhAnaM prAhuH |  \" visheShavat\" kAryavat |  tataH prakR^itiM prAhuH |
\" tat\" prakR^ityAkhyaM tattvam |  \" parataH paraH\" atyuttamaH |

atra \" avyaktam\" iti visheShyavAchI |  \" axaram\" iti visheShaNavAchI \dash
\" avyaktAsaktachetasAm\" , \" avyaktAhi gatiH\" ityAdivachanAt |  ato
vyutkrameNa vyAkhyAnam |  visheShaNopAdAnaM cha devAntaravailaxaNyapradarshanena
prashnasambhAvanArtham |  etadeva bhAShyakR^itA \" mahachcha\" ityAdinA
prapaJNchitam |

%%% ##endlabel##

%%% ##label=<segment004_pd12>##

{\Largedvng pra\.dI\. || } \" anye tu ye tvAM bhagavantaM vAsudevamupAsate ye chApyaxaramavyaktaM
paraM brahma teShAM ke yogavittamA\? iti vyAchaxate |  tadasad\" ityAha \dash \" parantu\"
iti | \" Anandam\" ityAdeH pUrveNottareNa cha anvayo draShTavyaH |  tathA cha \" ye
tvAM paryupAsate, ye cha tvAm\" ityuktaM syAt\?  \" tathA cha unmattapralApatva
prasaN^ga\" iti bhAvaH |  \" nanu bhagavAn karacharaNAdimadrUpavAn |  paraMbrahma 
tu nedR^isharUpavat |  \" ashabdamasparshamarUpam\" ityAdishruteH |  ataH
kathametad\?\" ityata Aha \dash \" rUpaM cha\" iti |  \" parAbhyupagatasya
brahmaNo.api\" iti sheShaH |

\" astu bhagavAneva paraM brahma |  kintu \" ye tvAmevaM sAkAramupAsate ye 
chAvyaktaM nirAkAraM, teShAM ke yogavittamA\?\" iti prashnArtha\" ityata Aha \dash 
\" upAsanaM cha\" iti |  \" tathaiva\" rUpavattayaiva |  \" syAdayaM prashnArthaH, yadi
rUpavattvArUpavattvAbhyAM bhagavadupAsanaM kAryaM syAt |  na tvetadasti |  kintu
rUpavattayaiva |  anyasya mithyopAsanatvenAnarthahetutvAd\" iti bhAvaH |  \" kuta
etad\?\" ityata Aha \dash \" sahasra\" iti |  \" Arabhya\" ityanena \" brAhmaNo.asya 
mukham\" ityAdeH \" AdityavarNaM tamasaH parastAt\" ityAdeshcha grahaNam |  
\" abhyAsa\" shabdena tatphalaniyamo laxyate |  \" shrutiH sAkAropAsanaM moxasAdhanaM
Aha\" iti sheShaH |

\" nanvatrochyamAna AdityavarNatvAdiH AkAraH atamaskatvAdisAdR^ishyAdupacharita
eva\" ityata Aha \dash \" Aditya\" iti |  \" vR^ithA\" bAdhakena vinA |
upacharyata ityupachAraH |  kechit \" sahasrashIrSha ityAdikaM hiraNyagarbhaviShayam\" 
iti manyante |  atastadvidhUyeshvaraviShayatayA svamataM gR^ihItuM \" Aditya\" 
ityAdyuktam |

upachArAnarhAM chAtra shrutimAha \dash \" tathA cheti\" | \" sthANuH\" rudraH |
\" prAjApatyaH\" prajApaterapatyam |  \" sAdhubhiH\" sAdhakaiH |  \" tArakam\"
saMsArasya |  tAraH OMkAraH |  \" AptarucheH\" vyAptatejasaH |  loma iti
keshavachanam |  lomapAda iti dvandvaH |  na vidyante lomAntapAdAdyavayavAH
yasyAsau \" alomapAdaH\" |  \" taM\" sthANuM \" uvAcha\" prajApatiH |  \" suvarNaH\" 
suvarNavarNaH |

atra \" mumuxubhiH ko dhyeyaH\?\" ityekaH prashnaH |  \" tAravAchyaM tArakaM vastu
kim\?\" iti dvitIyaH |  \" tasya dhyAnaM kathaM syAt\? kiM sAkAratayA uta
nirAkAratvena\?  nAdyaH, alomapAdo hyasAvuchyate |  nadvitIyaH, buddhAvanArohAt,
iti tR^itIyaH |  tatrAdyadvitIyayorarthato na bhedaH \dash tArakasyaiva mumuxudhyeyatvAt\"
ityabhipretya dvayorekamevottaramAha \" yaH tvayA mumuxudhyeyaH tArakaH pR^iShTaH eSha 
viShNuH\" iti |  \" yadyapyasAvalomapAda uchyate tathA.api tasya sAkAratayaiva 
dhyAnaM vadAmi\" iti tR^itIyasya |

yadi brahma sAkArameva taddhyAnaM cha tathaiva kAryam tarhi
\" ashabdamasparshamarUpamavyayam\" ityAdeH kA gatirityata Aha \dash
\" arUpatvAdestu\" iti |  laukikarUpAdyabhAvarUpA |  etena alomapAda ityasya
abhiprAyo.apyukto bhavati |  ito.api na paroktaH prashnArtha ityAha \dash \" puruSha\" 
iti | evaM hi vyAkhyAne dhyeyasyaiva dhyAnaM dvedhetyuktaM syAt |  atra 
tu dhyeyau puruShau dvau pratIyete |  atashcha naivamityarthaH |  prashnasya 
ekadhyeyaviShayatayA kathaJNchidvyAkhyAne.apyuttaraM niravakAshaM ityAshayena Adi 
grahaNaM kR^itam |  kiJNcha sAkAropAsanena vishuddhAshaye nirAkAramupAste 
ityekasyaiva krameNa dhyeyadvayamiti pareShAM siddhAntaH | atra tUpAsakapuruShabhedaH 
pratIyate |  tato.api nAnyo.artha ityAha \dash \" puruSha\" iti |  
uttarApavyAkhyAnanirAkaraNaM tu tAtparyanirNaya ityuktameva vyAkhyAnamiti
sthitam || 1||

%%% ##endlabel##

%%% ##label=<segment005_pd12>##

{\Largedvng pra\.dI\. || } \" evaM tarhi \" mayyAveshya\" ityanenaiva madupAsakA eva uttamA,
iti prashnasya uttaraM jAtam |  kimuttareNa vAkyena\?\" ityata Aha \dash \" bhavantu\"
iti |  Axepagarbho.ayamabhyupagamaH |  \" na yuktaM tvadupAsakAnAmevottamatvam\" iti
bhAvaH |  tadupapAdanAya pR^ichChati \dash \" itareShAm\" iti | \" avyaktopAsakAnAM
kiM phalaM\?  moxo.asti vA, na vA\?  na chedudAhR^itavAkyavirodhaH |  Adye kathaM
tvadupAsakAnAmuttamatvam\?  phalasAmyAd\" iti bhAvaH |

\" nanveShAM visheShaNAnAM brahmaNo.anyatrAsambhavAtkathaM \" itareShAM kiM phalam\"
ityasyottaratvenetadavatAra\" ityato.axarAvyaktatvayoH mAyAyAmupapAditatvAdanyAni
tatropapAdayannanirdeshyatvaM tAvadupapAdayati \dash \" anirdeshyatvaM cha\" iti |
shabdAgocharatvam |  \" dharmasya mama pAdabhaN^ga\" ityanvayaH |  \" nanu
atrApIshvaro.astu anirdeshya\" ityata Aha \dash \" Ishvarastu\" iti |  \" daivaM 
pAdabhaN^gakAraNamAhuH |  tathA cha punaruktiH syAd\?\" iti bhAvaH |  na cha 
\" daiva\" shabdo.adR^iShTavAchI |  tasya \" apare karma\" iti pR^ithaguktatvAt |  
mAyAyA anirdeshyatve spaShTaM cha pramANamAha \dash \" uktaM cha\" iti |  
\" mahAbhUtam\" AkAshavAyurUpam |  \" upabhUtam\" tejo.abhbhUlaxaNam |  
\" tadA\" pralaye |  \" ajaram\" ityAdikaM pralaye.avasthAnasyopapAdakam |  
na cha etadbrahma iti pradarshanAya \" eShA hyeva prakR^itiH\" ityudAhR^itam |

idAnIM \" sarvatragam\" ityAdikaM mAyAyAmupapAdayitumAha \dash \" sarvaga\" iti |
bhAvapradhAno nirdeshaH |  \" svarUpavAchI vA laxaNashabdaH Ashrayo yasya
tat\" tathoktam |  anena brahmaNo vyAvR^ittiH |  \" ajarAt\" \" amarAd\" iti
jaDapradhAnAdeH |  tasya tatprAptyabhAvAt |  \" agrAhyAnmanaso.apyagocharAd
ityanena achintyam\" iti siddhyati |  \" asambhavato\" \" axayAt\" \" axarAt\"
iti dhruvatvasiddhiH |  asati praLaye bhavaM asatyam |  lalAmaM pradhAnam |
dvitIyA bhagavadekAdhInA pravR^ittiH visheSho yasya tattathA |  \" amUrtitaH\"
prAkR^itadeharahitAt |  \" sarvasyAH\" sarvagAyA iti ChAndaso liN^gavyatyayaH |
anAdyavidyAbhimAnitvAt \" shAshvatatamasaH\" |  puruSho.abhUdityanvayaH |

\" idam\" prasiddhaM \" tamo\" mAyAkhyaM praLaye \" sarvataH\" \" prasuptamiva\" 
nirvyApAraM \" AsIt\" |  \" abhUtam\" ajAtam |  \" apraj~nAtam\" 
ityAdinA pratyaxAnumAnAgamavedyatvAbhAva uchyate |  avedyalaxaNatvAt 
\" apratarkyam\" |  anena \" sarvatragamachintyam\" \" dhruvam\" iti 
siddhyati |

\" gItAvAkyena kUTasthatvaM nityatvaM chet, \" dhruvam\" iti punaruktiH |
\" kUTamanR^itaM tiShThAtyasmin\" ityasambhavi\" ityata Aha \dash \" kUTa\"
iti |  \" kUTa\" shabdasyAkAshavAchitve.abhidhAnaM prAk paThitam |  tathA.api
dArDhyAya shrutyudAharaNam |  shrutyanusAreNa strIliN^gam |  \" sA sarvagA\"
ityuktArthe spaShTaM pramANam |  \" nishchalA\" svapadAdabhraShTA |  \" vishvaM
gatamAshritamasyAm\" iti \" vishvagA\" |  \" etAni choktavisheShaNAni tadupAsanasya
moxasAdhanatvAN^gIkArasamarthanArthAni\", iti j~neyam || 2\-4||

%%% ##endlabel##

%%% ##label=<segment006_pd12>##

{\Largedvng pra\.dI\. || } \" nanu \" itareShAM kiM phalam\?\" ityasya prashnasya \" te 
prApnuvanti mAmeva\" ityuttaraM dattam |  tatkimuttareNa\?\" ityata
Aha \dash \" katham\" iti |  \" pUrvavAkye paxagrahaNamAtraM kR^itam |  na tu 
tatrAbhipretasya doShasya parihAraH |  ataH pUrvapaxiNA abhiprAyodghATane
kR^ite tatsamAdhAnamAha\" iti bhavaH |  tarhyubhayeShAM phalasAmye |  yadyapyeShA
shaN^kA pUrvavAkye parihR^itA |  paryAdishabdaprayogAt |  tathA cha vaxyati |
tathA.api sAdhyasyAnuktatvAddhetuvachanaM svarUpakathanaM manyamAnasya
bhavatyeva punaH shaN^kA |  uttarArdhe padAnAM vyavahitatvAdanvayApratItau
tamAha \dash \" avyaktA\" iti |  anena \" duHkham\" ityasya
kriyAvisheShaNatvamuktam |  \" gati\" shabdasya akartari kArake bhAve cha
prayogAdatra vivaxitamarthamAha \dash \" gatiH\" iti |  \" gamyate anena
iti vyutpAdanAd upAyo gatir\" ityarthaH |

\" nanu mArgasyAvyaktatvaM kathaM uchyate\? kutashcha gamyArthatA \" gati\" shabdasya
tyajyata\?\" ityata Aha \dash \" avyakta\" iti |  \" avyaktopAsanaM dvAramupAyo
yasyAsau tathoktaH\" |  avyaktopAsanAnantarabhAvi yadbhagavadupAsanaM
tadevamuchyate |  anena \" avyakta\" shabdaH tadupAsanaM laxayati |  tena cha
taddvArakatvaM laxyate |  gamyArthatAyAM cha \" gati\" shabdasya \" avyaktAkhyaM
gamyam\" ityuktaM syAt\?  na cha tadyuktam |  \" te prApnuvanti mAmeva\"
iti bhagavatprApteruktatvAdityuktaM bhavati |  atra pUrvArdhe.asya mArgasya
adhikatarakleshavattvaM pratij~nAya kathamityatastatprasiddhamityuttarArdhenoktam |

tatprasiddhiM vivR^iNoti \dash \" atishaya\" iti | ShaShThoktaprakAreNa
sarvasamaduddhiH |  \" tataH kim\?\" ityata Aha \dash \" tadR^ite cha\" iti |
\" ayogavyavachCheda evAyamukto, na tu tAvanmAtreNa\", ityAha \dash \" satyapi\" 
iti |  \" tasminnavyaktAparoxye sati viShNuprasAda\" iti vartate |  \" tato.api 
kim\?\" ityata Aha \dash \" narte cha\" iti |  \" tam\" viShNuprasAdam |

\" astvevamavyaktopAsanadvArakabhagavatprAptimArgaprakAraH |  tathA.api
kathamatrAdhikaH kleshaH\?\" ityata Aha \dash \" vinA\" iti |
avyaktopAsanamArgam |  \" ayam\" avyaktopAsanadvArakaH |  \" evaM
tarhi \" kim\" iti pravR^itto yenArjunenAshaN^kita\?\" ityata Aha \dash
\" tathA.api\" iti |  \" evaM tarhi mArgayoH sAmyameva |  anena prayojanena 
kleshasya samAdhAnAd\" ityata Aha \dash \" tatrApi\" iti |  avyaktopAsanadvArake
mArge.api |  dvitIyaM bhagavadupAsane duHkhaM pAxikametat |  \" Unena
vA\" ityuktatvAt |  \" itashchAvyaktopAsanadvArake mArge bhagavadupAsanAt
klesho.adhikatara\" ityAha \dash \" indriya\" iti |  \" nAtiprasAdameti\"
ityataH paraM \" eka\" iti shabdaH |  dvAvapi hetau prakArArtho vA |  

\" kuto.ayaM bhagavato bhAva\?\" ityata Aha \dash \" tadetat\" iti | 
upalaxaNametat |  \" sarvatra samabuddhaya\" ityAdinetyapi draShTavyam |  atra 
\" pari\" ityanenopAsakasyAtishayaH |  \" sam\" ityanenendriyaniyamasyAtishayaH |
\" sarvatra\" ityAdinA sarvetyAdikam | \" tarap\" atisuShTvAchArAdikam |
\" avyaktA gatiH\" ityanena \" tadR^ite cha\" ityAdi vyavadhAnam |
\" mAmeva\" ityavadhAraNena \" tathA.api\" ityAdikaM \" prApnuvanti\" iti 
svAtantryoktyendriyasaMyamAdau devatAsahAyAbhAvaH |  bhagavadupAsane
tvetadabhAvo yathA gItoktaH taduttaratra pradarshayiShyate |

%%% ##endlabel##

%%% ##label=<segment007_pd12>##

{\Largedvng pra\.dI\. || } \" AgamAntarasiddhatvAchchAyaM bhavati bhagavadabhiprAya\"
ityAha \dash \" sAmaveda\" iti |  \" teShAm\" ityAdiShaShThI tR^itIyArthe |
\" viditvA\" sAxAtkR^itya |  \" tato\" vedanAtprasannAt \" tato\"
vAsudevAt |  \" yAvatA\" prayAsena \" tatprasAdo\" avyaktaprasAdaH |
sarvasyApIti dvitIyaH \" tu\" shabdo\" .api\" shabdArthe |  \" Adhikya\" shabdena
nyUnatvamapyupalaxyate \dash nyUnAdhikayoranyatra pratyavAyahetutvAt |
\" nAvyaktAdeH\" iti pAThe madhyetyupaskAraH |

mamopAsanena \" AtmabhAvam\" kaivalyam |  \" paramAtmane\" tamuddishya |
asya vAkyasya kathaM prakR^itopayoga ityata uktaM \" shrIvachanam\" iti |
nitye niyate |  \" brahmaNye\" brahmaNi sAdhau |  \" nivasAmi\" prasannA
bhavAmi |  \" iti cha\" \dash \" shrIvachanam\" iti sambandhaH |

\" pUrvaM shaN^kAhetutvena \" shriyaM vasAnA\" ityAdIni vAkyAnyudAhR^itAni |
teShvidamekaM nAvyaktaviShayam\?\" iti vastusthitimAha \dash \" mahata\" iti |
\" anAdyanantaM mahataH param\" iti vAkyapratipAdyam, iti yAvat |
atrAbhyuchchayayuktiM chAha \dash \" tam\" iti |

\" nanu uktaparAmarshopapatteH iti pUrvapaxe.api yuktiruktA, ityataH
sA.anyathAsiddhA\" ityAha \dash \" mahata\" iti |  \" tathA cha
uktavaxyamANabalAt \" avyaktAt puruShaH paraH\" ityuktasyAyaM 
parAmarsha\" iti bhAvaH |

\" shrutyantareNaivaM vyAkhyAnAchchaitadvAkyaM tatparam\" ityAha \dash 
\" tathA cha\" iti |  purubhiH hUtaH \" puruhUtaH\" |

%%% ##endlabel##

%%% ##label=<segment008_pd12>##

{\Largedvng pra\.dI\. || } \" nanu \" avyaktaM nAma tatvameva nAsti\" iti sUtrakR^itoktam |
tatastadabhimAninyavyaktAkhyA devatA.api nAsti |  tatkathaM tadviShayatayA
vyAkhyAnam\?\" ityata Aha \dash \" na cha\" iti |  

\" tarhi tatkathaM sUtritam\?\" ityata Aha \dash \" sharIra\" iti |  
\" sAN^khyaprasiddhaM pradhAnam iti svatantraM mukhyataH shabdavAchyam\"
ityarthaH |  \" vaidikam\" iti \" bhagavadadhInaM, tatsambandhena 
shabdavAchyam\" ityarthaH |  atra shrutiM chAha \dash \" tathA cha\" iti |  
prAk \" tathApyaparoxIkR^itAvyaktAnAM\" ityAdinaikaM prayojanamuktam |
aparaM cha sapramANakamAha \dash \" suvratAnAm\" iti |  \" buddhvA
ityuktaprakAreNopAsInAya\" iti sheShaH |  \" etatprayojanaM gItAyAM na 
sUchitam\" iti na tatraivoktam || 5||

%%% ##endlabel##

%%% ##label=<segment009_pd12>##

{\Largedvng pra\.dI\. || } \" nanvavyaktopAsakAnAM kleshAtishayo gItAyAM pratIyate |
bhagavadupAsakAnAM tu tadabhAvo na pratIyate |  ataH \" tadetat sarvam\" iti
kathamuktam\?\" ityata Aha \dash \" madupAsakAnAm\" iti |  \" bhaktAnAm\"
ityanena nAnyatrAtyantamAdaramiti sUchayati |  atra \" ananyenaiva yogena\"
ityAdinA, \" vinA.avyaktopAsanam\" ityetat pratIyate |  \" upAsata\" ityevoktyA
atishayopAsanAdyabhAvaH |  \" na chirAt\" ityanena tatrApi ityAdikam | 
\" teShamahaM samuddhartA bhavAmi\" ityanena \" devastu\" ityAdikam |
\" AgAmigItAvAkyamapexya prAk buddhyArohAya taduktam\" iti |

atra shrutyAdisammatiM chAha \dash \" uktaM cha\" iti | \" teShAm\"
ArtAdInAm |  madhye \" gatiH\" sAdhanAdisampAdakaH || 6\-11||

%%% ##endlabel##

%%% ##label=<segment010_pd12>##

{\Largedvng pra\.dI\. || } \" nanu j~nAnamabhyAsasya sAdhanam |  tatkathaM tataH 
shreya\?\" ityata Aha \dash \" aj~nAnena\" iti | \" eva\" iti |
kevalam |  \" j~nAnAddhyAnaM vishiShyata ityasat |  sAdhanasyApi
j~nAnasya sambhavAt, aj~nAnapUrvasya dhyAnasya sambhavAchcha\" ityata
Aha \dash \" j~nAnamAtrAd\" iti |  upapattilabdhamarthaM shrutyA.api
draDhayati \dash \" tathA cha\" iti |  \" tatsahitam\" j~nAnasahitaM
dhyAnam |  \" tato\" j~nAnamAtrAt \" adhikam\" |

\" dhyAnAtkarmaphalatyAgo vishiShyata\" ityetadanyathApratItinirAsAya
vyAkhyAti \dash \" dhyAnAd\" iti |  tyAgasya prashastatvamevAnena
laxyate |  \" na pratItArthe tAtparyam\" ityarthaH |  \" kutaH\?\" ityata 
Aha \dash \" anyathA\" iti |  \" athaitadapyashakto.asi kartuM\"
iti |  \" dhyAnAtpratyavare karmatyAge.apyashaktasya karmaphalatyAgaH 
kathamanyathA dhyAnAdAdhikye satyupadishyeta\" ityarthaH |  

\" karmasa.nnyAsAt\" karmaphalarAgasa.nnyAsAt karmayogo.api vishiShyate |  kimuta 
dhyAnayogaH\?  vaxyamANakarmAdi\"sarvAdhikam\" |  \" parAtman\" paramAtmani 
viShaye |  \" virAgaH\" shobhanAdhyAsAbhAvaH |  

\" nanu \" tayostu\" iti, \" sarvAdhikam\" iti cha dvayorapi vAkyatvAt 
kathaM tadvirodhena \" dhyAnAt\" iti vAkyasya svArthe tAtparyAbhAvaH
vyAkhyAta\?\" ityata Aha \dash \" vAkya\" iti |  \" vAkyatvena sAmye.api
upapattisAhityena prAbalyAd\" ityarthaH |  itaratra \" dhyAnAd\" iti
vAkyasya pratIte.arthe, yuktyantaraM chAha \dash \" dhyAnAdi\" iti |  \" tyAgo 
hi dhyAnaj~nAnanivR^ittakarmAnuShThAnaprAptau kAraNatvena \" parIxya lokAn\" 
ityAdAvuchyate |  na cha phalAtsAdhanaM shreyaH |  ato.apIyaM stutireva\" 
ityarthaH |  anena laxyArtho.api niShkR^iShyokto bhavati |

prakArAntareNa vyAkhyAti \dash \" kevala\" iti |  tyAgarahitAd \" dhyAnAt\" |
\" nanu kuto \" dhyAnAt\" iti kevalasya nirdhAraNam\?  kutashcha \" karmaphalatyAga\" 
iti tatsahitadhyAnalaxaNA\?  tyAgasya vA dhyAnasAhityenopaskAra\"
ityataH pratij~nApUrvakamAha \dash \" dhyAna\" iti | \" tyAgayuktaM dhyAnam\"
\" dhyAnayuktastyAga\" iti dvividhoktyoktaM prakAradvayaM sUchayati ||
anyathA kevalatyAgAN^gIkAre, kathaM cha ityatrApi \" anyathA\" iti 
vartate\?  na kevalamanyathA.anupapattyA.ayamarthaH siddhaH |  \" kiM tarhi
shrutyA.api\?\" ityAha \dash \" tathA cha\" iti |  AdyAmanyathA.anupapattiM
upapAdayati \dash \" na hi\" iti |  \" tatashchAparoxyam\" ityuktashruti
virodhAd iti bhAvaH |  \" uktAN^gIkAre kathametadanupapattyabhAva\?\" ityata Aha \dash
\" bhavati cha\" iti |  \" tyAgAd\" iti sambandhaH |  \" j~nAnamAtravyavadhAnena\"
iti bhAvaH |  dvitIyAnupapattistu \" tayostu\" ityupapAditaiva |

\" nanu \" athaitadapyashakto.asi\" ityanena kevalatyAgo vihitaH |
tatprarochanAya \" shreyo hi\" iti tasya stutirupakrAntA |  na cha 
kevaladhyAnAttatphalatyAgayuktaM dhyAnamadhikamiti vyAkhyAne
kevalatyAgastutirlabhyate, kintu tadyuktasya dhyAnasyaiva |  ataH
pUrvasaN^gatatvAtpUrvameva vyAkhyAnaM yuktam, na tu dvitIyamasaN^gateH\"
ityata Aha \dash \" kevala\" iti |  yathA \" anena bhR^ityena yukto rAjA
ripUNAM jetA, nAnyathA\" ityukte bhR^ityasya stutirlabhyate
tathaivamapyasminnapi vyAkhyAne kevalatyAgastutiryuktA |  dhyAnasya
dhyAnAntarAdhikye tatsAhAyyasya hetutvenoktatvAdityarthaH || 12||

%%% ##endlabel##

%%% ##label=<segment011_pd12>##

{\Largedvng pra\.dI\. || } punaruktidoShamAshaN^kya pariharati \dash \" sarva\" iti |  
\" sarvArambhaparityAgI\", \" shubhAshubhaparityAgI\" ityAdau
sAmAnyavisheShabhAvena |  \" santuShTaH satatam\", \" santuShTo yena
kenachit\" ityAdau vyAkhyAnavyAkhyeyabhAvena |  \" harShAmarShabhayodvegairmukto,
\" yo na hR^iShyati\" ityatra noktaM prakAradvayaM sambhavati\" ityata Aha \dash
\" harShAdibhir\" iti |  \" niShThApratyayenAtItatvapratItyA kAlAntare
harShAdikaM bhavati, ityAshaN^kya kriyAnibandhe vihitena laTA pratipAdayati\"
ityarthaH |  \" tarhIdamevAstu kiM tena\" ityata Aha \dash \" upachAra\" iti |
\" siddhe.arthe vachanamupachAraM tAtparyadyotanena pariharati\" ityarthaH |
\" yo madbhaktaH\" iti bhaktiH punaH punaruchyate |  tatprayojanamAha \dash
\" Adhikya\" iti |  \" adveShTA\" ityAdinokteShu \" sarvadharmeShu bhakter\" iti
sheShaH |  \" adveShTA\" ityAdeH saN^gatyadarshanAttAmAha \dash \" ye tu\" iti | 
\" prapaJNchaH\" tadupalaxitasyAbhidhAnam |

\" axaropAsakAnadhikR^ityaitaduchyata\" ityasat |  sannihitasambandhe sati
vyavahitasambandhagrahaNAyogAt | \" yo madbhaktaH sa me priyaH\"
ityAdivachanAchcha || 13\-19||

%%% ##endlabel##

%%% ##label=<segment012_pd12>##

{\Largedvng pra\.dI\. || } \" ye tu, ityuktameva kimarthamuchyata\?\" ityata Aha \dash
\" piNDIkR^itya\" iti |  \" dharmyAmR^itam\" ityetadapratItArthaM
vyAkhyAtuM \" dharma\" shabdaM tAvadvyAkhyAti \dash \" dharma\" iti |
\" tadviShayaM\" tadupAsanAN^gatvAt |  dharmAdanapetaM dharmyaM dharmashcha
viShNuH |  nAdR^iShTam pravR^ittasyAsambhavAt |  nivR^ittasyaitatsAdhanatvAt |
idAnImamR^itashabdaM vyAkurvan \" dharmyAmR^itam, iti karmadhArayo.ayam\"
ityAha \dash \" dharmyam\" iti |  na mR^itam, \" amR^itam\" |  naJN
viruddhArthe |  \" mR^itashabdashchopalaxaka\" ityarthaH |  \" shraddadhAnA\"
ityetadvyutpAdayati \dash \" shrad\" iti |  \" shrachChabdasyopasaN^khyAnam\"
ityupasargatvenopasaN^khyAyamAnasyApyasya sattvavAchitvamaviruddham \dash
upasargatvasya kAryavisheShArthatvAt  || 20||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya}
\centerline{shrIbhagavadgItAbhAShyasya TIkAyAM jayatIrthamunivirachitAyAM}
\centerline{prameyadIpikAyAM dvAdasho.adhyAyaH ||}

%%% ##endlabel##

%%% ##label=<segment001_pd13>##

{\Largedvng pra\.dI\. ||} pUrvasaN^gatvenAdhyAyapratipAdyaM darshayati \dash \" pUrvokta\" 
iti |  pUrvamAShaShThasamApteH yajj~nAnaM j~nAnasAdhanamuktaM yachcha saptamAdibhiH
ShaDbhirj~neyaM brahmasvarUpamuktaM yadapi \" bhUmiH ApaH\" (7\.04)ityAdinA
xetramuktaM, yachcha \" na tvevAham\" (2\.12) ityAdinA puruShabheda uktaH, 
tatsarvamanenAdhyAyena darshayati bhagavAn |  \" kimartham\?\" piNDIkR^itya
vixiptamekIkR^itya |  gauNo.atra ktvApratyayaH |  \" piNDIkaraNArtham\" 
ityarthaH |  \" piNDIkaraNe mishratvAdapratipattireva\" ityata uktam \dash 
\" vivichya\" iti |  \" prakaraNashuddhyA\" ityarthaH | 

%%% ##endlabel##

%%% ##label=<segment002_pd13>##

{\Largedvng pra\.dI\. ||} \" yo vikArI yasya tat yadvikArI\" (shAM\.bhA\. 13\.4) iti kvachit |
tadasat |  bahuvrIhitAyAminervaiyarthyAt |  kiM tu \" yashchAsau vikArashcha\"
iti yadvikAraH |  \" so.asyAsti\" iti \" yadvikArI\" iti bhAvena Aha \dash 
\" yad\" iti |  atra \" yena vikAreNa\" ityanena karmadhArayaM sUchayati |
\" yuktam\" iti inerartham |  \" yatashcha yat ityetat yasmAchcha
yatkAryamutpadyate\" iti kashchit vyAkhyAtavAn |  tadayuktam |  \" yadvikArI\" 
ityanena gatArthavAt |  sAdhyAhAratvAchcha |  \" vikArAMshcha guNAMshcha\" (13\.20)
ityasyAnyathopapatteH |  aparastu \" yatashcha amAnitvAdibhyo yajj~neyam prApyata\" 
iti |  tadapyasat |  adhyAhArAdeva |  \" amAnitvam\" ityAdeH \" anAdimadityA\-
deshchAnyathAsiddheH\" ityanyathA vyAchaShTe \dash \" yatashcha\" iti |  \" yato yasya
preraNayA\" |  \" yad\" iti iNaH laDAdeshashatrantasya rUpam |  iNo yAteshchAnati\-
bhinnArthatvAt \" yAti\" ityuktam |  sarvasya xetrasya gatyabhAvAt gauNIM
vR^ittimAshritya vivR^iNoti \dash \" pravartata\" iti |  \" sa cha ya\" iti
\" jIvapratij~nA\" iti vyAkhyAnamasat |  tasyAprakR^itatvAt |  \" xetraj~na\-
shabdasyAtadviShayatvAd\" iti bhAvena Aha \dash \" sa cha\" iti |  \" yataH
xetraM pravartate\" iti \" pravartakasya prakR^itatvAd\" ityAshayaH |  nanvevaM
chedetadvaktavyam |  kiM \" yatashcha yat sa cha ya\" ityekaiva pratij~nA\?  uta
dve\?  nAdyaH \" cha\" shabdadvayAnupapatteH |  tatsamAsenetyanenAnvayAt |
\" sa cha ya\" ityasya vaiyarthyAchcha |  na dvitIyaH |  \" arthabhedAbhAvAd\"
ityato dvitIyamaN^gIkR^ityAha \dash \" yatashcha\" iti |  \" yatashcha yat\" 
iti vachanaM \" asmAdevandharmavishiShTAt xetraM pravartata\" iti vaktuM 
pratij~nArUpam |  \" sa cha ya\" iti vachanaM \" pravartakasya svarUpamAtraM 
vaktuM pratij~nArUpaM ityarthabheda\" ityarthaH || 1\-4||

%%% ##endlabel##

%%% ##label=<segment003_pd13>##

{\Largedvng pra\.dI\. ||} \" brahmaNaH sUchakAni vAkyAni\" \" brahmasUtrANi\" |  \" tatashcha
ChandasAM R^iShivAkyAnAM cha tathAtvAt \" R^iShibhiH\" ityAdikaM vR^ithA syAd\?\"
ityato rUDhimAshrityAha \dash \" brahma\" iti || 5\-6|| 

%%% ##endlabel##

%%% ##label=<segment004_pd13>##

{\Largedvng pra\.dI\. ||} \" mahAbhUtAni\" (13\.6) ityanukraMya, \" etat xetraM samAsena
savikAramudAhR^itam\" ityuktam |  tatra \" na j~nAyate kiM xetre ke cha tadvikArA\"
ityata Aha \dash \" ichChAdaya\" iti |  \" pUrvaM xetram\" iti bhAvaH || 7||

%%% ##endlabel##

%%% ##label=<segment005_pd13>##

{\Largedvng pra\.dI\. ||} \" nanu ShaTsvartheShu pratij~nAteShvamAnitvAdikamanantarbhUtaM
kimityuchyata\?\" ityata Aha \dash \" sa cha\" iti |  \" iti\" pratij~nAtaM
arthadvayaM vaktuM \" j~neyaM yattad\" (13\.13) ityAdinA |  \" na yAdR^ishatAdR^ishena 
shravaNena tadanubhavArUDhaM bhavatItyAshayena\" iti sheShaH |  mAnAhaN^kArAbhyAM 
dambhaM pR^ithagdarshayati \dash \" AtmA\" iti |  \" Arjavam\" j~nAnasAdhanaM 
yathA syAt tathA vyAchaShTe \dash \" Arjavam\" iti |  \" etachcha sanmArga\" 
iti j~nAtavyam || 8\-9||

%%% ##endlabel##

%%% ##label=<segment006_pd13>##

{\Largedvng pra\.dI\. ||} \" sakti\", \" abhiShvaN^ga\" shabdayoH arthabhedamAha \dash 
\" saktiH\" iti || 10|| 

%%% ##endlabel##

%%% ##label=<segment007_pd13>##

{\Largedvng pra\.dI\. ||} \" nanu tatvaj~nAnArthadarshanaM nAma j~nAnameva |  tatkathaM
j~nAnasAdhaneShUchyata\?\" ityata Aha \dash \" tattva\" iti |  \" shAstradarshanaM
tatparyAlochanam |  atra shAstrasya ityadhyAhR^itya vyAkhyAnam\", iti 
j~nAtavyam || 12||

%%% ##endlabel##

%%% ##label=<segment008_pd13>##

{\Largedvng pra\.dI\. ||} \" pratij~nAtArthadvayapratipAdanAya \" j~neyaM yattat\" ityAdikaM
vAkyamiti sUchitam |  tatra kena tu kimuchyata\?\" ityata Aha \dash \" param\" 
iti |  \" iti\" nAmoktyA |  \" anyadanAdimadityAdikaM \" yatprabhAvam\" iti
pratij~nAtasya pratipAdakam\" ityarthaH |  \" AdirasyAsti\" ityAdimat |  \" na
Adimat\", \" anAdimat\" iti vyAkhyAne, \" na vidyate AdiH yasya ityanAdiH\" 
iti bahuvrIhitvAshrayaNenaiva \" vivaxitArthasiddheH matupo vaiyarthyam\" iti 
doShaM pashyantaH kechit \" anAdiH\" iti \" matparam\" iti cha padaM vichChidya
\" ahaM vAsudevAkhyA parA shaktiH yasya tat matparam\" iti vyAchaxate |  tadasat |
arthAsambhavAt |  na hi \" brahma\" iti \" vAsudeva\" iti kashchidbhedaH | 
\" na chAvatAreShu parAvaryaM ityuktam\" iti bhAvena yathA matupo na vaiyarthyaM
tathA vyAchaShTe \dash \" Adimad\" iti |  \" AdiH eShAmasti\" iti \" Adimanti\" |
\" na vidyante Adimanti yasya, tad\" \" anAdimat\" |  \" sAmarthyAt tAni 
dehendriyaguNakriyAdIni\", ityarthaH |  athavA pUrvokta eva vigrahaH |  na cha matupo 
vaiyarthyam |  \" vaidikaM liN^gavyatyayaM vibhaktilopaM vA manyamAnasya bahuvrIhirvA 
naJNsamAso vA ayam\", iti saMshayaM syAt\?  tathAcha \" brahma svayaM kAraNaM 
na bhavati\" ityapi shaN^kyeta\?  tannivR^ittyarthaM matubantenA\" .adi\" shabdena 
naJNsamAsasyA.ashrayaNAt |  ye tvevaM prayojanamanabhidhAya \" matupaH prayogaH 
shlokapUraNArtham\" ityuktavantaH tAnnirAchaShTe \dash \" anyathA\" iti |  
\" asmaduktaprayojanadvayAnaN^gIkAraH\" ityarthaH |  \" sArthakena shabdAntareNa 
shlokapUraNasambhavAd\" iti bhAvaH |  \" nanu bahuvrIhimAshritya punaH matupaH prayoge 
doShaH syAt\?\" |  na chaivam |  kiM tu shabdAntaramevaitat |  tatkathamayaM doShaH\?   
anyathA \" yadvikAri\" ityatrApi doShaprasaN^gAt |  maivam |  bahuvrIhiM vivaxitvA
alpena shabdenAbhimatArthapratipAdanasambhave bahuyatnAshrayaNasya doShatvenoktatvAt, 
\" yadvikAri\" ityatra gauravAbhAvAt || 13\-14||

%%% ##endlabel##

%%% ##label=<segment009_pd13>##

{\Largedvng pra\.dI\. ||} \" ahaM parAshaktiH yasya\" iti vyAkhyAne arthAsambhavaM kashchidanyathA
prAha \" brahmaNassarvavisheShapratiShedhenaivAtra jij~nApayiShitatvAchChaktimatvapratipAdanaM
viruddham\" iti |  tadasat |  \" atra visheShavattvasya darshanAd\" iti bhAvena
Aha \dash \" sarve\" iti |  \" guNAn\" tadviShayAn, \" AbhAsayati\" pratyAyati 
\" pratyeti\" iti vA |  bhAsateH pachAdyach |  evaM, \" sarvataH pANipadaM tat\" 
(13\.14), \" sarvabhR^it\" \" guNabhoktR^i cha\" ityAdikamapyudAhAryam |  
\" kathaM tarhi \" sarvendriyavivarjitam\", \" nirguNam\", \" acharam\" 
ityadyuktam\?\" ityata Aha \dash \" indriya\" iti |  \" Adi\" shabdAt 
\" param\" shabda, ityadhyAhAryam |  \" purastAt\" dvitIye |

\" nanu brahmaNi pratipAdite kena sAdhanenedaM buddhyArUDhaM bhaved\?\" ityAkAN^xAyAM
sAdhanaM pashchAdvaktavyam |  \" tatkutaH prathamata uktam\?\" ityata Aha \dash 
\" vikAra\" iti |  \" vikAriShvantarbhAvaM j~nApayituM tadanantaramupoddhAtaprakriyayA
uktam\" iti bhAvaH |  \" uddeshakramAnusAreNa \" yatashcha yat\" iti prathamamanuktvA
\" sa cha yo yatprabhAvashcha\" ityetatkuta uktam\" ityata Aha \dash \" bahutvAd\" 
iti |  sUchIkaTAhanirmANAdau bahutvasya prAthaMyavyabhichArAt hetvantaroktiH |  
\" alaukikasya prabhAvasya buddhyArohe hi sAdhanAnAmatyupayogo na tu tAvan 
laukikasya prerakatvasyAnubhavAroha\" iti j~nApayituM j~nAnasAdhanAnantarameva 
prabhAva uktaH |  \" tatprasaN^gena cha\" iti bhAvaH || 15\-19||

%%% ##endlabel##

%%% ##label=<segment010_pd13>##

{\Largedvng pra\.dI\. ||} \" nanu \" prakR^itiM puruShaM chaiva viddhi\" ityAdikaM apratij~nAtaM 
kimuchyate\?\" |  maivam |  \" yAdR^ik cha\" iti pratij~nAtasya saprakArasya 
xetrasya kathanAt |  \" tatpratij~nAkrameNa prAgeva kuto noktam\?\" ityata Aha 
\dash \" yatashcha\" iti |  \" yatashcha yat\" iti pratij~nAtaM prerakasvarUpaM 
tAvatprabhAvAnantaraM vaktavyaM prAptam |  tatra prerakasya svarUpanirUpaNaM 
preryaj~nAnamapexate |  preryaM cha saprakAraM xetram |  prerakasvarUpaM vaktumanena 
preraNIyaM saprakAraM xetramuchyate |  \" tasya prAgapi vachane gauravaM syAd\?\" 
iti bhAvaH |  tarhi \" prakR^iti\" ityAdi kathamuchyate\?

\" IshvarAtiriktassarvo.api chetanAchetanavargaH xetram\" ityuchyate |  tatra
\" prakR^iti\" shabdena \" mahAbhUtAni\" ityAdinoktAni chaturviMshatitatvAni gR^ihyante |  
\" vikAra\" shabdenechChAdyupalaxitAH xetrAntarbhUtA api guNatrayAdyAssarve 
vikArA vivaxAvisheShavashena pR^ithagupAttAH |  \" puruSha\" shabdena \" jIva\" iti |  
\" yAvat saJNjAyate\" ityAdinA punarvaxyamANatvAtpunaruktidoShaM parihartuM 
\" saN^xipya\" ityuktam |  \" Aha\" saprakArAn nirUpayati |  \" guNAH
sukhaduHkhamohA\" (shAM\.bhA\. 13\.21) iti kashchit |  \" kAryakAraNalaxaNA\" ityanyaH | 
tadubhayaM nirAkartuM vyAchaShTe \dash \" guNA\" iti |  \" nanu sattvarajastamasAmapi
prakR^itivikAratvAt vikArAMshcha guNA.nshcheti pR^ithaguktiH kimartha\?\" ityata Aha 
\dash \" teShAm\" iti |  \" iti j~nApayitum\" iti sheShaH |  \" vikArAH pR^ithaguktA\" 
iti,  \" vikArAshcha guNAshcha pR^ithaguktA\" ityarthaH |  kAryAshcha te akAryAshcha |  
\" tisraH\" trayaH |  \" anena sukhAdyaN^gIkAre vikArebhyaH pR^ithaggrahaNamayuktam\" 
ityapi sUchitam || 20||

%%% ##endlabel##

%%% ##label=<segment011_pd13>##

{\Largedvng pra\.dI\. ||} \" kAraNAnAmapi kAryatvAt pR^ithaguktiH vyartha\" ityato 
rUDhimAshritya kAryakAraNashabdau vyAkhyAti \dash \" kAryam\" iti |  \" bhoktR^itva\" 
ityatra prakR^ityartho bhogaH abhyavahArAdiH sukhAdiviShayo na sambhavati |  ata Aha 
\dash \" bhoga\" iti |  \" svIyatayA sAxAtkAra\" ityarthaH |  \" bhogaH\" prakR^itereva |  
na puruShasya |  \" ataH \" puruShassukhaduHkhAnAM bhoktR^itve hetuH\" iti kathamuktam\?\" 
iti sAN^khyAH |  tatrAha \dash \" sa hi\" iti |  \" na tu prakR^itiH, achaitanyAd\" 
iti sheShaH |  \" nanu \" kAryakAraNakartR^itve hetuH prakR^itiH\" ityuktam |  kartR^itvaM 
cha j~nAnechChAprayatnayogaH |  tatkathaM prakR^iter bhogAsambhava\?\" ityata Aha \dash 
\" prakR^itishcha\" iti |  \" chaH\" \" tu\" arthaH |  \" pariNAmikAraNatvAt kartR^itvaM 
ityupacharyata\" iti bhAvaH |  shlokArthe purANasammatimAha \dash \" kArya\" iti |  
\" kAraNaM viduH\" ityuttarArdhe.anuvartate || 21\-22||

%%% ##endlabel##

%%% ##label=<segment012_pd13>##

{\Largedvng pra\.dI\. || } \" yatashcha yat iti vaktum, ityuktam |  tatkena uchyata\?\" ityata 
Aha \dash \" yatashcha\" iti |  \" iti pratij~nAtam\" iti sheShaH |  \" anumantA 
anuj~nAta\" (shAM\.bhA\.13\.23) iti kashchit |  tadasat |  \" audAsInyaprAptau
\" bhartA\", \" bhoktA\" ityAdivirodhAd\" iti bhAvena vyAchaShTe\dash \" anumantA\" 
iti |  \" anu\" shabdaH punararthe |  \" kriyA.a.avR^ittishcha tadartha\" iti 
j~nApanAya dviruktiH |  \" visheShata\" iti tR^ino.arthaH |  \" nirUpakaH\" 
kartavyasyA.alochakaH || 23||

%%% ##endlabel##

%%% ##label=<segment013_pd13>##

\" ya enaM vetti puruSham\" ityatra \" puruSha\" shabdaM vyAkhyAtumupodghAtamAha \dash
\" puruSha\" iti |  \" sukhaduHkhabhoktR^iliN^gAd\" iti bhAvaH |  \" sukhaduHkhAnAM
bhoktR^itve bhoge hetuH kartA\" iti vyAkhyAnamAshrityedamuktam |  vyAkhyAnAntare tu
bhagavAnevAtra puruShaH, \" puruShaH prakR^itistho hi\" iti jIvaH |  upalaxaNametat |
\" upadraShTeti Ishvara ukta\" ityapi draShTavyam |  \" tataH kim\?\" ityata Aha \dash 
\" puruSham\" iti |  yata evaM ubhAvapi prakR^itau, ato \" ya enaM vetti puruSham\" 
ityatra \" puruSha\" shabdena jIveshvarau dvAvapi gR^ihyete, dvayorapi parAmarshasambhavAt |
\" tarhi dvayoH dvivachanena bhAvyam\?\" ityata uktam\dash \" sahaiva\" iti |  
\" tantreNa\" ityarthaH |  atra kashchit \" ya enaM vetti puruSham\" \" sAxAdahamasmi 
ityevamadhyAhAreNa jIveshvaraikyam\" (shAM\.bhA\.13\.24) vyAkhyAtavAn |
taddUShayati \dash \" anyatra\" iti |  \" jIveshvaraikye sarvavedAnAM prAdhAnyena 
yatpratipAdakatvaM, tadvirodhaH |  katham\?\" ityata Aha \dash \" utkarShe hi\" iti |  
\" sarvAgamAnAM Ishvarasya sarvotkarShe hi mahAtAtparyam\" ityarthaH |  \" tatkutaH\?\" 
\" prAguktayukteH, shruteshcha\" ityAha \dash \" tathA hi\" iti |  \" viShNoH 
mahattvAdevAvAchyatvenokte sarvotkarShe sarvAsAM vedavAchAM, sarvanyAyAnAM, 
nyAyavyutpAdakasya mImAMsAshAstrasya\", iti yAvat |  

mahattatparatvaM \" mahAtAtparyam\" |  \" astUtkarShe mahAtAtparyam | 
tathA.apyutkarShasya sattvaM kutaH\? na hi jainavAkyasya kvachit mahAtAtparye.api
tatsattvamasti\" ityata Aha \dash \" tachchApi\" iti |  na kevalaM tatra tAtparyam |
kiM tu tatsattvamapi chAstyeva |  \" dhiyAM svataH prAmANyAd\" iti herarthaH | \" svataH
prAmANye.api bAdhakAt viShayAsattvaM bhavati |  tadapyatra nAsti\" ityAha \dash \" na 
chAtra\" iti |  \" shaN^kA\" iti |  \" shaN^kAhetuH bAdhakam\" iti yAvat |  \" kathaM 
bAdhakAbhAva\?\" ityata Aha \dash \" ata\" iti |  \" ata\" ityasyoratrAnvayaH |
tatra Ishvarasya sarvotkarShe tu yadviruddhaM mAnaM shaN^kyate, tadapi kimaxajAdau
axajAgamayoranyatarat, athavA yuktiH |  AdyaM nirAkaroti \dash \" na tad\" iti |  
\" kavayo\" nyAyavidaH |  kutaH\?  ataH upajIvyavedavirodhAt |  etena dvitIyo.api
nirastaH |  tathA.api visheShaM vaktumAha \dash \" na cha\" iti |  yuktirapi naiva
mAnaM, yato dR^iShTeH shruteH UnamatiH jAtyaiva durbalaj~nAnotpAdikA |  bhagavadutkarShe
sarvAgamAnAM mahAtAtparyamityatra paThitAyAH shruteH sheSheNa yo.artho labdhaH so.api
prakR^itopayukta eva |  utkarShasya sattvAbhAve jIveshvaraikyasya sadvirodhAbhAvAt |
atastaM svavAkyenApyAha \dash \" ata\" iti |  \" yuktibhiH\" ityupalaxaNam | 
etadapalApaH bhagavadutkarShasyAvidyamAnatvAdikalpanam |  ata ityuktamevArthaM 
vishadayati \dash \" ata\" iti |  \" vedavirodhAd\" ityarthaH |  \" Adi\"
padenAnirvAchyatvaM gR^ihyate |  \" bhagavadutkarShasya\" iti sheShaH |  \" sA.api\" 
iti \" api\" shabdena pratyaxAdessamuchchayaH |  \" iti\" shabdo hetau |  
\" bAdhakAbhAvAd\" ityarthaH |  utkarShasya prakR^itatve.api, \" tachchApi\" iti 
shrautatachChabdavyAkhyAnAya \" mAhAtMyam\" ityuktam |  

\" nanu pratipannasya vidyamAnatvAdikaM bAdhakAbhAvena kalpyam |  svataH prAmANyAt |  
na chotkarShasya sattvaM vedAtpratipannam |  \" utkarShe tatsattve cha tAtparyAN^gIkAre 
vAkyabhedaprasaN^gAd\" ityata Aha \dash \" avAntaraM cha\" iti |  \" cha\" shabdasya
\" tatra sattve cha\" ityanvayaH |  ubhayatra mahAtAtparyAbhAvAnna doShaH |  \" etat 
kuta\?\" ityata Aha \dash \" uktaM cha\" iti |  \" tatraiva\" tasyAmeva shrutau |  
aN^gIkR^itya chedamuktam |  vastutastUtkarShasattve mahadapi tatparatvam |  kutaH\?  
anantasambandhinostayorutkarShasya tatsattvasya chaikatvAt |  \" ananta\" iti 
prakR^itatvAdevoktam |  

etaduktaM bhavati |  \" pramANaM pravartamAnaM vidhirUpaM niShedharUpaM vA, na tUdAsInam |  
tasya cha bAdhAbhAve svata eva sattvAsattvalaxaNau vidhiniShedhau sidhyataH, kiM tatra 
tAtparyAntarakalpanayA\" iti |  \" nanu nirAkArameva brahma shrUyate |  tatkathaM 
tadguNotkarShe sarvashrutInAM mahAtAtparyaM syAd\?\" ityata Aha \dash \" shyAmatvAd\" 
iti |  etachchAnantarAtItAdhyAye prapaJNchitam |  

\" vedavirodhAt yuktyAderAbhAsatvam ityuktam |  tadayuktam |  niyAmakAbhAvAt, 
viparyayasyApi suvachanAd\" ityata Aha \dash \" yuktaM cha\" iti |  \" yuktam\" 
sambhAvitam |  \" aj~nAnasambhavAt\" aj~nAnamUlatvasambhavAt |  aj~nAnaM
upAdhivyabhichArAdiviShayam |  svataH pramANasyApauruSheyatayA puruShaguNAn
apexapramANabhAvasya |  \" yukteraj~nAnamUlatvasambhAvanA nirbIja\" ityata Aha \dash 
\" adarshanaM cha\" iti |  \" sambhavati shaN^kArham\" ityarthaH | 

etaduktaM bhavati |  \" vedasya yuktyAdeshcha parasparavirodhe dvayoH prAmANyAn
upapattAvanyatarasyA.abhAsattve kalpanIye, yuktyAdereva tatkalpyaM sambhavAt |  
na tu vedasyAsambhavAt |  niravakAshena sAvakAshasya bAdhadarshanAd\" iti | 

puruSheShvadarshanamAshaN^kamAnAnAmatiprasaN^gamAshaN^kya niShedhati \dash \" tarhi\" iti |  
viparyayo bhagavadguNotkarShasya |  \" sarvavAchAm\" iti shrutyaivoktatvAditi
parihAre sthite.anyamapyAha \dash \" yata\" iti |  tasyAmeva shrutAvAha vedapuruShaH |
\" etadviruddhAH\" bhagavadguNotkarShaviruddhAH |  \" utkarShe hi\" ityAdinoktaM
upasamharati \dash \" tad\" iti |  sarvavedAnAM yadbhagavadguNotkarShe
mahAtAtparyamuktaM tadviruddhaM \" jIvasAMyam\" jIvasyaikAtMyam || 24||

\" sUtretihAsaviruddhaM cha\" ityAha \dash \" AbhAsa\" iti |  \" bahava iti 
paxe.api kiM sarve samAH utaika shreShThaH |  dvitIye ko.asAvatra puruSheShu shreShThaH; 
kathaM cha shreShThaH taM tathA vaktumarhati\" iti |  \" etat\" etasmin jagati |  
\" kiM tu bahavaH |  teShAM bahUnAM puruShANAM madhye yo yoniH kAraNabhUtaH 
saH shreShThaH |  tathA cha taM puruShaM tathA vyAkhyAsyAmi\" |  \" vishvam\" 
vyAptam |

\" syAdetat |  \" sarvaM jagat svapnavadekAj~nAnakalpitam\" ityeke |  
\" indrajAlavadanekAj~nAnakalpitam\" ityapare |  aprakR^iShTApexashchotkarShaH |
tathA cha apakR^iShTasya vishvasya mithyAtvAdutkarShasya sattvaM kathaM syAt\?  
kathaM cha tatra sarvavedAnAM mahAtAtparyam\?\" ityata Aha \dash \" na cha\" 
iti |  \" bhagavadvachanaM yata\" iti sheShaH |  \" ito.apyevam\" ityAha \dash 
\" na cha\" iti |  \" kalpitatve vishvasya\" |  evaM \" bahujIvakalpitatve.api\" 
iti vAchyam | viparyaye satyatve |  

\" tarhi kathaM vishvasya purANeShu svapnAdisAMyaM uchyata\?\" ityata Aha \dash \" uktaM 
cha\" iti |  ayaM prapaJNchaH svapna evochyate |  chaJNchalatvAdanityatvAt vikAritvAchcha,
na tu svapnaH sAxAnmithyA\" iti yAvat |  \" kutaH etat\?\" \" etasya vichChedo 
bAdho na hi\" ityarthaH |  yadyapi svapnaH satyaH |  tathA.apyaN^gIkAravAdo.ayam |  
mithyArthaprAchuryAdvA |

\" nanu jIvasya brahmaNi \" ahaM brahmAsmi\" (bR^i\.u\. 1\.4\.10) ityahaN^grahopAstiH
tAvat kartavyA |  jIvashcha na sarvotkR^iShTaH |  tatashcha tenaikIbhUtasyeshvarasya kathaM
sarvotkarSha\?\" ityata Aha \dash \" nAyam\" iti |  \" buddhisthasya ayaM iti\" 
parAmarshaH |  \" kuta\" ityata Aha \dash \" na hi\" iti |  \" kiM tarhyuchyata\?\" 
ityata Aha \dash \" jIvasya hi\" iti |  \" syAdayaM doShaH, yadi \" 
ahaM brahmAsmi\" (bR^i\.u\. 1\.4\.10) ityAdineshvaramuddishya tasyAnutkR^iShTa
jIvaikyamuchyeta\? 

na chaivam, kintu jIvamuddishya tasyeshvaraikyam |  anyathA, \" brahma madAtmakaM 
bhavati\" iti nirdeshaprasaN^gAd\" iti |  \" satyametajjIvasyeshvaraikyamuchyata\"
iti |  

\" tathA.api noktadoShaparihAraH |  yadIshvaraH vastutassarvotkR^iShTaH syAt,
tadA kathaM jIvasya tadaikyaM syAt\?  tasyAnutkR^iShTatvenAnubhAvAt |  ato
\" jIvasya brahmaNi shrutasyAhaN^grahopAsanasyAnyathAnupapattyeshvarasya 
sarvotkR^iShTatvaM mithyA\" ityaN^gIkAryam\" ityata Aha \dash \" tad\" iti | 
yajjIvasyeshvareNaikyamuchyate tadapi na nirupAdhikaM nirupacharitam |  kiM
tUpachAreNaivamuchyate |  upachArabIjaM sahetukamAha \dash \" ata\" iti |  yataH
sAxAdaikyaM nArthaH |  ataH \" ahaM brahmAsmi\" (bR^i\.u\. 1\.4\.10) ityAdAvuchyamAnaM
aikyaM pratibimbatvavirodhi pratibimbatvAdanyanna bhavati |  kiM tu pratibimbatvameva,
ityarthaH |

\" nanu sAxAdaikyaM kuto nArthaH\?  kutashchopachAro.api pratibimbatvanimitta\?\"
ityata Aha \dash \" tathA cha\" iti |  \" jIvasyApi viShNoraikyaM yaddR^iShayo 
vadanti tatpratibimbenaiva nimittena hi\" ityarthaH |  \" itashchopachAreNaiva
ahaMgrahopAsanam\" ityAha \dash \" aham\" iti |  \" phalAdhikyam\" mukhyaM 
phalam |  ahaN^grahopAsanasya hi paramaM prayojanamIshvarasArUpyApattireva
shrutyochyate |  yadi cha nirupacharitamaikyamupAsyaM syAttadA tannopapadyeta | 
\" taM yathA yathopAsate tadeva bhavati\" (shata\. brA\. 10\.5\.2\.20) iti shruter,
iti bhAvaH |  \" abhyAshaH\" samIpam |  \" alpenaiva kAlena\" ityarthaH |  

\" ito.apyupachAreNaivAhaN^graha\" ityAha \dash \" tadIya\" iti |  \" bhR^ityairevopAsyata\" 
iti sheShaH |  svataH sAxAdaikyAt |  

\" nanu \" agniH mANavakaH\" ityAdyupachAro bhedaj~nAnasahachArito dR^iShTaH\" |  
na cha prakR^ite tadasti |  \" tatkathamupachAreNAhaN^grahopAsanamityato.atrApi
bhedaj~nAnasAhityamasti\?\" iti sapramANakamAha \dash \" prAtibimbyena\" iti |  

\" nanu bimbatvamaN^gIkR^itaM chedaikyamevApannam\" ityata Aha \dash \" prAtibimbyaM 
cha\" iti |  tadadhInatvaM cha grAhyam |  \" tadIyo.aham\" ityuktatvAt |
\" eva\" shabdastvaikyasya vyavachChedArthaH |  etena \" xetraj~naM chApi mAM 
viddhi\" (13\.3) ityAderapavyAkhyAnamapAstaM bhavati || 24||

%%% ##endlabel##

%%% ##label=<segment014_pd13>##

{\Largedvng pra\.dI\. || } \" anye sAN^khyena yogena\" ityatra \" kApilatantrokta
prakR^itipuruShavivekaj~nAnaM sAN^khyam\" iti vyAkhyAnamasat |  kApilatantrasya,
avaidikasyAtra grahaNAyogAt |  \" tasya bhagavaddarshane pradhAnasAdhanatvAyogAchcha\"
iti bhAvenAnyathA vyAchaShTe \dash \" sAN^khyena\" iti |  \" j~nAnena\" 
paroxaj~nAnena |  \" dhyAnena\" ityatra \" dhyAnAdInAM kevalAnAmeveshvaradarshana
sAdhanatvamuchyata\" ityanyathApratItinirAsArthamAha \dash \" karmiNAm\" iti | 
\" dR^iShTiH prApya\" iti sheShaH |  pAThakramAdarthakramasya prAdhAnyAdvyutkrameNoktiH |
\" kuta etad\?\" ityAha \dash \" tathAcha\" iti |  \" dhyAtvA\" ityetat
\" j~nAnyapi\" ityuttareNApi sambadhyate |  

\" nanu sarvatra sarvasya saMyojane satyeka evAyaM prakAraH syAt\?  tathA cha 
\" kechit\", \" anye\", \" pare\" ityuktamayuktaM syAd\?\" ityata Aha \dash 
\" anya\" iti |  \" dhyAnAdAvuttarottarasAdhane sAxAdashaktAnAmapi 
tattadupAya j~nAnAdipradarshanArthamavasthAbhedamAshritya \" anya\" ityAdyuktam\" 
ityarthaH || 25\-26||

%%% ##endlabel##

%%% ##label=<segment015_pd13>##

{\Largedvng pra\.dI\. || } \" tatxetraM yachcha\" iti \" pratij~nAtasya sarvasyoktatvAt
kimuttareNa\?\" ityata Aha \dash \" punashcha\" iti |  \" uktasya punarvachane ko
hetuH\?\" ityata Aha \dash \" sAMyAd\" iti |  IshvaradharmasyobhayadharmAtprAdhAnyena
sAMyagrahaNam |  tachcha prakR^itipuruShadharmakathanaM \" yAdR^ik\" iti
pratij~nAte.antarbhavati |  IshvaradharmakathanaM cha \" yatprabhAva\" iti || 27\-29||

%%% ##endlabel##

%%% ##label=<segment016_pd13>##

{\Largedvng pra\.dI\. || } \" prakR^ityaiva cha\" ityatra \" yaH prakR^ityaiva cha karmANi 
kriyamANAni pashyati sa AtmAnamakartAraM pashyati\" (shAM\.bhA\. 13\.30) iti 
kashchidanvayaM Aha |  tadasat |  \" tathAshabdavaiyarthyApatteH\" iti bhAvena
anyathA.a.aha \dash \" AtmAnaM cha\" iti |  \" sa pashyati\" parameshvaram || 30||

%%% ##endlabel##

%%% ##label=<segment017_pd13>##

{\Largedvng pra\.dI\. || } \" ekastham\" ityasya \" ekasthAtmakam\" (shAM\.bhA\.13\.31)
iti vyAkhyAnaM sarvapramANaviruddhamiti bhAvenAha \dash \" ekastham\" iti |  
\" tata eva cha vistAram\" ityasya \" svasmAdeva vishvasya vistAram\" 
(shAM\.bhA\.13\.31) iti vyAkhyAnamasad\" iti bhAvenAha \dash \" tata eva\" 
iti |  \" vistAram\" utpattim || 31||

%%% ##endlabel##

%%% ##label=<segment018_pd13>##

{\Largedvng pra\.dI\. || } \" avyaya\" ityanuvAdena \" lepAbhAvamAtraM vidhIyata\" 
ityanyathApratItinirAsArthamAha \dash \" na cha\" iti |  etenAvyayatvamapi
sAdhyamaprAptatvAdityuktaM bhavati |  \" tasya\" viShNoH |  anena jIvavisheShaNametat |
\" tasya prAptisadbhAvena pratiShedhopapatteH\" iti nirastam |  viShNorapi
\" sharIrastho.api\" iti prApteruktatvAt |  anAdinirguNatvayoravyayatve hetutvaM
upapAdayituM vyAptimAha \dash \" sAdi\" iti |  \" yat vyayi tatprAyaH sAdi 
guNAtmakaM cha\" iti yojanA |  prAgabhAve vyabhichAravAraNAya \" prAyaH\" 
ityuktam |  sAdyeva guNAtmakamevetyavadhAraNena yathAsthitayojanA vA |  \" na
karoti\", \" nirguNatvAt\" iti \" Ishvarasya kriyAguNAbhAvaH pratIyata\" ityata 
Aha \dash \" na karoti\" iti |  purastAduktameva smArayati \dash \" na\" iti |  
\" ityAdivadakriyatvAdikaM vyAkhyeyam\" iti sheShaH |  yadyapyavyayatvamapyatra
sAdhyam |  \" tathA.api tallokato j~nAtuM shakyata\" iti lepAbhAvamAtraM \" yathA 
sarvagatam\" ityupapAdyate || 32\-34||

%%% ##endlabel##

%%% ##label=<segment019_pd13>##

{\Largedvng pra\.dI\. || } \" bhUtaprakR^itimoxam\" ityasya \" bhUtAnAM prakR^itiH avidyA, 
tasyAH moxamavasAnalaxaNam\" (shAM\.bhA\.13\.35) iti vyAkhyAnamasat, 
\" bhUta\" shabdavaiyarthyAt |  \" avidyAdhvaMsasyAnuktatvena \" evam\" iti 
parAmarshayogAchcha\" iti bhAvenAha \dash \" bhUtebhya\" iti |  anena 
\" bhUtaprakR^iti\" iti dvandvaH |  tataH \" paJNchamI iti 
yogavibhAgAtpaJNchamItatpuruSha\" ityuktaM bhavati |  \" bhUtebhyaH\" 
pR^ithivyAdibhyaH |  

\" nanu moxo na prAgukta\?\" ityata uktam \dash \" moxasAdhanam\" iti |
\" karaNe dhaJN\" ityarthaH |  \" moxasAdhanamapi noktam\" ityata Aha 
\dash \" amAnitvAdikam\" iti |  \" j~nAnasAdhanamapi paramparayA 
moxasAdhanam\" iti bhAvaH |  \" moxa\" shabdasya nityasApexatvAnna 
asamarthatvam |  yadvA \" bhUtebhyaH prakR^iteshcha\" iti samAsadvayasUchanArthaM 
pR^ithageva vAkyam |  tato \" moxapadavyAkhyAnaM pR^ithageva\" iti || 35||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TikAyAM}
\centerline{jayatIrthamunivirachitAyAM prameyadIpikAyAM trayodasho.adhyAyaH samAptaH ||} 

%%% ##endlabel##

% shrImadhveshakR^iShNArpaNamastu 

%%% ##label=<segment001_pd14>##

{\Largedvng pra\.dI\. ||} uttareShAM paJNchAnAmadhyAyAnAM pratipAdyamAha \dash \" sAdhanam\" 
iti |  \" yoge tvimAM shR^iNu\" (2\.39) iti pratij~nAya AShaShThaparisamApteH 
kAmavarjanAdItikartavyatAsahitaM karmadhyAnalaxaNaM j~nAnasAdhanamuktam | 
\" tatra\" iti \" kartavyatAMshamuttarairadhyAyaiH prapaJNchayi\", ityarthaH |  

\" mama yonirmahadbrahma(14\.3), na tadbhAsayate sUryaH(15\.6) ityAdineshvaramAhAtmyasyApi 
vachanAtkathametad\?\" ityata uktam \dash \" prAdhAnyena\" iti |  \" prAchuryApexayA 
saN^grAhakametad\" ityarthaH |  avAntarapratipAdyabhedAd adhyAyabhedaH |  
tatra \" yAvatsaJNjAyate kiJNchit\" (13\.27) ityuktavivaraNapUrvakaM 
\" kAraNaM guNasaN^go.asya\" (13\.22) ityuktaM guNasambandhaM prapaJNchya 
tadatyayasAdhanamanenAdhyAyenochyate |

\" atra mahadbrahma iti jaDAvidyochyata\" (shAM\.bhA\. 14\.3) iti pratItinirAsArthaM 
Aha \dash \" mahad\" iti |  \" prakR^itiH\" mahAlaxmiH |  

\" nanu \" sattvaM rajastama\" iti jaDAprakR^itiH vaxyate |  tatsannidhAnAdatrApi 
saiva yuktA\" iti chenna |  tatrApi chetanaprakR^ityabhidhAnAt |  \" kathamasyAH 
sattvAdibhedabhinnatvam\?\" ityata Aha \dash \" sA cha\" iti |  \" jaDaprakR^iter
abhimAninI, tatkAryasattvAdiguNAbhimAninI etadrUpatrayavati\", ityarthaH |  

\" nanu bhagavatI \" mAheshvarI, brAhmI, kaumArI, mAhendrI, shrI, bhU, durgA\" iti 
saptadhA bhinnA AgameShUchyate |  tatkathaM tridhA bhinnochyata\?\" ityata Aha \dash 
\" umA\" iti |  AdyAH chatasro bhagavatyA anyAH |  kutaH\? \" jIvAH\" |  
\" kathaM tadrUpatvoktiH\?\" |  tadaMshayutAH tatsannidhAnopetAH |  \" kuta etad\?\" 
ityata Aha \dash \" tathA cha\" iti |  \" mama yoniH\" ityetatpare vyAchaxate 
\" mama svarUpabhUtA yoniH kAraNaM vishvasya\" |  pratIta eva anvaye \" mama mAtA 
ityApatteH\" iti |  tannirAsArthamAha \dash \" mama\" iti |  \" bhAryA\" ityarthaH |
\" mama ityanuvAdenAnyathA pratItAnvayabAdhaH syAd\" iti sUchayati |  
\" pratItAnvayAN^gIkAre mAtA ityapi pratIyeta\? tatra kathaM bhAryA iti 
nishchaya\?\" ityata Aha \dash \" na tu\" iti |  \" iti pratItiH prasajyata\"
iti sheShaH |  \" kuto na\?\" ityata Aha \dash \" vAkya\" iti |  \" tasmin
garbhaM dadhAmyaham\" iti vAkyasheShAdbhAryArthatAnishchayAt |  \" shrutibalAchcha\"
ityAha \dash \" tathA hi\" iti |  \" prakAshayanti\" pravartate |  \" anayaiva
shrutyA.anyadapi labdham\" iti prasaN^gAdAha \dash \" ata\" iti |  \" mR^iShA\", 
\" ayathArthaM pradarshanaM yasya, tat tathA\" |  itashchaivamevetyAha \" tathA\" 
iti |  tatra hyevamuktam \dash 

\ \ \" dagdhvA mAyAmayIM sItAM bhagavAnugradIdhitiH |
\ \ rAmAyAdarshayatsItAM pAvako.asau surapriyaH\" ||

ityAdi |  

\" nanu mahAlaxmIH \" shrI bhU durgA iti bhinnA\" ityuktam |  bhuvashcha
\" gaurbhUtvA.ashrumukhI khinnA\" iti duHkhaM pratIyate |  tatkathaM tad\?\"
ityata Aha \dash \" na cha\" iti |  iyaM bhUtAbhinaninI prasiddhA bhUH bhagavatyA
rUpaM na bhavati |  kintvanyaiva |  \" kuta\?\" ityata Aha \dash \" tathA cha\" 
iti |  mahAlaxmIrUpaM bhUH anyA |  iyaM prasiddhA tasyAH ChAyA pratimA |  

\" nanu rAvaNaharaNAdikaM bhavatu mAyAsitAyAH |  vAlmIkidAsyaM tAvanmatsyapurANe 
sAxAtsItAyA evoktam |  dAsye cha duHkhamavarjanIyam\" ityAshaN^kAM pramANapUrvakaM
apAkaroti \dash \" avApa\" iti |  \" shrutirasti yataH, ata\" iti sheShaH |  
\" mahadbrahma prakR^itiH\" ityuktam |  tatra pramANaM vaktuM vyavahitatvAtpunaH 
pratijAnIte \dash \" mahad\" iti |  \" mahad brahma\" iti bhinne pade |  
tataH \" param\" iti shabdaH adhyAhAryaH |  \" kuta\?\" ityata Aha \dash 
\" mahatI\" iti |  tatraiva matsyapurANe |  arthakrameNa \" mama yoniH mahad 
brahma\" ityatra vyutkrameNa vyAkhyAnam |  \" matsyapurANodAharaNaprasaN^gAd
atropapAdanam\" iti || 1\-4||

%%% ##endlabel##

%%% ##label=<segment002_pd14>##

{\Largedvng pra\.dI\. ||} \" nanu pratij~nAtaM j~nAnaM shlokadvayenoktam |  tatkimuttareNa
granthenAdhyAyAsaN^gatamuchyata\?\" ityata Aha \dash \" bandha\" iti |  \" yo hi
\" baddho.asmi\" iti jAnAti sa eva tannivR^ittisAdhanaM vijij~nAsya j~nAtvA 
anutiShThati |  ato, bandhochChedasAdhanAnuShThAnAya tajj~nApanArthaM jij~nAsAM
utpAdayituM guNatrayakR^itabandhaprakAramAdau tAvaddarshayati, iti na asaN^gatam\", 
ityarthaH || 5\-6||

%%% ##endlabel##

%%% ##label=<segment003_pd14>##

{\Largedvng pra\.dI\. ||} atra rajaH \" tR^iShNAsaN^gasamudbhavam\" ityasya \" tR^iShNAsaN^gAbhyAM 
samudbhavo yasya (shAM\.bhA\. 14\.7), ityasyApavyAkhyAnam\" iti 
bhAvena vigrahapradarshanapUrvakamarthamAha \dash \" tR^iShNA\" iti |  \" samudbhavati 
asmAd\" iti \" samudbhavam\" kAraNam |  anyathA, \" prakR^itisambhavAH\" 
ityuktavirodhAt |  \" samudbhavashabdenAvirbhAvo vivaxita\" iti chet, tathA.api 
guNakAryakathanaprakaraNavirodhAt || 7||

%%% ##endlabel##

%%% ##label=<segment004_pd14>##

{\Largedvng pra\.dI\. ||} \" tamastu aj~nAnajam\" ityasya \" aj~nAnAjjAtam\" 
(shAM\.bhA\. 14\.8) ityapavyAkhyAM pratyAkhyAtumAha \dash \" aj~nAnam\" 
iti |  etachcha \" anyeShvapi dR^ishyate\" (aShTA\. 3\.2\.101) iti 
dR^ishigrahaNasAmarthyAllabhyate |  \" kutaH pratIta evArtho na\?\" ityata Aha \dash 
\" pramAda\" iti |  \" vAkyasheShe.aj~nAnasya tamaHkAryatvavachanAd\" 
ityarthaH || 8\-15||

%%% ##endlabel##

%%% ##label=<segment005_pd14>##

{\Largedvng pra\.dI\. ||} \" duHkhashabdaH kevaladuHkhavAchi\" ityanyathApratItinirAsAyAha 
\dash \" rajasa\" iti |  \" duHkhashabdena uchyata\" iti sheShaH |  \" tatkatham\?\" 
ityata uktam \dash \" alpa\" iti |  \" alpatvAtsukhasyAvivaxita\" iti bhAvaH |  
\" kuta\?\" ityata Aha \dash \" tathA hi\" iti |  \" rajasa\" iti paJNchamI |
\" mAtrayA\" iti sukhavisheShaNam |  \" stokAtmakaM sukhaM duHkhaM cha\" 
ityarthaH |  \" tAn\" rAjasakarmiNaH |  kevaladuHkhArthAN^gIkAre bAdhakaM
chAha \dash \" anyathA\" iti |  \" atikaShTatvAd\", aj~nAnAdapi kaShTatvAt | 
tatphalakasya rajasaH |  \" tathA cha \" madhye tiShThanti rAjasAH\", \" adho 
gachChanti tAmasAH\" ityAdyayuktaM syAd\", iti bhAvaH || 16\-18||

%%% ##endlabel##

%%% ##label=<segment006_pd14>##

{\Largedvng pra\.dI\. ||} \" nAnyaM guNebhyaH kartAram\" iti \" svatantrakartR^itvaM 
guNAnAmeva, nAnyasyetyuchyata\" (shAM\.bhA\. 14\.19) ityapavyAkhyAnanirAsArthamAha \dash
\" pariNAmi\" iti |  \" kuta etad\?\" ityata Aha \dash \" anyathA\" iti |  
guNebhyo.anyasya kartR^itvAbhAve |  

\" moxadharme parameshvarasya kartR^itvamuktaM, tadvirodhashcha\" iti vAkyasheShaH || 19\-21||

%%% ##endlabel##

%%% ##label=<segment007_pd14>##

{\Largedvng pra\.dI\. ||} \" prakAshaM cha pravR^ittiM cha\" ityanena \" guNAtItasya 
sarvathA sattvAdiguNakAryeShu prakAshAdiShu dveShAkAN^xe na sta ityuchyata\" 
(shAM\.bhA\. 17\.22) iti anyathApratItinirAsArthamAha \dash \" prAya\" iti |  

idamuktaM bhavati |  \" sattvAdayo guNAH dvividhAH sthUlAH sUxmAshcha |  tatra sthUlebhyo 
laukikAH prakAshapravR^ittimohAH jAyante |  sUxmebhyashcha parameshvarAdiviShayAH |  
tatrAdyeShu guNAtItasya dveShAkAN^xe prAyo na staH |  na tu sarvathA, prArabdhavashAt 
kadAchit sambhavAt |  dvitIyeShu tvAkAN^xAdikaM vidyata eva\" \dash iti |  

\" kuta etad\?\" ityata Aha \dash \" tathA hi\" iti |  yadyapi \" na dveShTi\" 
ityAdikamuktam |  tathA.api yadi sutamaH sUxmatamaH daivavashAttaM praviShTaM syAt\?  
tadA.asau tajjahyAt dviShyAt |  guNAtItAnAM cha sUxmasattvasadbhAve bhAratavAkyaM cha 
paThati \" na hi\" iti |  yadi devA R^ishayashcha sUxmeNa sattvena hInAH syuH, tadA 
\" sattvasthA\" iti nochyeran\?  kintu tatastadA vaikArikAH smR^itAH prasajyeran\?  
tataH kiM, \" kathaM vaikAriko gachChet puruShottamam\" (mahA\. 12\.336\.74) \" teShAM 
moxo na syAd\" iti yAvat |  asti cha moxo teShAm |  ataH, \" sUxmasattvavantaH 
eva ta\" ityarthaH |  

\" sAttvikaH\" sUxmasattvavAn \dash

\ \ \" sa sUxmasattvasaMyuktaH samyuktastribhiraxaraiH |
\ \ puruShaH puruShaM gachChenniShkriyaH paJNchaviMshakaH\" ||

\dash (mahA\. 12\.336\.75) iti sUxmasattvaprakaraNAt |  

moxArthanishchito moxalaxaNe puruShArthe nishchitaH || 22\-23||

%%% ##endlabel##

%%% ##label=<segment008_pd14>##

{\Largedvng pra\.dI\. ||} \" samaduHkhasukhaH\" ityAdinA \" sarvathA sukhAdau tulyatvabuddhiruchyata\" 
(shAM\.bhA\.17\.24) ityanyathApratItinirAsArthamAha \dash \" tulyatva\" iti |  
\" tulyatvavAchinaH shabdasyArtha\" ityarthaH |  \" prAyaH sarvAn, ityAdyuktarItyA\" 
iti bhAvaH || 24\-25||

%%% ##endlabel##

%%% ##label=<segment009_pd14>##

{\Largedvng pra\.dI\. ||} \" brahmabhUyAya ityasya parabrahmatvAya\" (shAM\.bhA\. 17\.26) iti vyAkhyAnaM 
pramANaviruddhamiti bhAvenAnyathA vyAchaShTe \dash \" brahmavad\" iti |  nAtra \" brahma\"
shabdaM paraM brahma, kintu \" mama yonirmahadbrahma\" iti prakR^itA prakR^itireva |  
\" brahmaNo hi pratiShThA.aham\" (14\.27) ityuttaravAkyAt |  tadbhUyaM cha na tAdAtmyaM, 
kintu tadvat bhagavatpriyatvameva |  \" anyasyAnyabhAvAyogAd\" 
iti bhAvaH |  

\" tatkiM yAvatprakR^iteH bhagavatpriyatvaM tAvat guNAtItasya\?\" ityataH
sapramANamAha \dash \" na tu\" iti |  \" tatkiM \" bhUya\" shabdaH priyatvavAchI,
yenaivaM vyAkhyAta\?\" ityata Aha \dash \" bhUyAya\" iti |  \" bhuvo bhAvaH\" 
iti vachanAd bhAvo bhavanaM \" bhUya\" shabdArthaH |  \" brahmavad\" bhAvo
\" brahmabhUyam\" |  \" vadaH supi\" (ashhTA\. 3\.1\.106) iti subantamAtrasya
upapadasyAnuvR^itteH |  vatyarthasya cha vR^ittAvantarbhAvAt |  mayUravyaMsakAdivat |  
\" vatyarthashcha priyatvamiti taduktam\" iti bhAvaH || 26||

%%% ##endlabel##

%%% ##label=<segment010_pd14>##

{\Largedvng pra\.dI\. ||} \" brahmaNo hi\" ityetat \" parabrahmaNo hi\" (rA\.bhA\. 17\.26) iti 
vyAchaxate |  tadasat |  \" pratiShThA.aham\" iti vachanAt |  \" upachAro.asau\" 
iti chenna |  \" mukhye sambhavati tadupAdAnAyogAd\" iti bhAvenAha \dash \" brahmaNa\" 
iti |  \" mAyA\" iti prakR^itA mahAlaxmIH || 27||

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya} 
\centerline{TikAyAM jayatIrthamunivirachitAyAM prameyadIpikAyAM chaturdasho.adhyAyaH samAptaH ||} 
%%% ##endlabel##

% shrImadhveshakR^iShNArpaNamastu 


%%% ##label=<segment001_pd15>##

{\Largedvng pra\.dI\. || } adhyAyapratipAdyamarthamAha \dash \" saMsAra\" iti |  saMsarati
aneneti \" saMsAraH\", prakR^ityAdikaM xetram |  pUrvAdhyAye saMsAraikadeshAnAM
guNAnAmeva vR^ittaM darshitam |  atra punaH samagraM saMsArasvarUpaM pradarshya
tadatyayechChAmutpAdya tatsAdhanajij~nAsuM prati prAguktaM sAdhanaM prapaJNchayati |
tatprasaN^gadalaukikaM bhagavanmahimAnaM cha darshayatyanenAdhyAyenetyarthaH |
jagadvR^ixasyordhvamUlatvaM ghaTayitumUrdhvashabdhAbhidheyaM tAvadAha \dash \" Urdhva\" iti |  
kutaH\? shrautaprayogAdityAha \dash \" Urdhva\" iti |  \" Adau tAvadahamUrdhvena
viShNunA pavitro niShpApo.asmi tato vAjirUpashcha netA cha\" |  \" vAjinIH\" sUryaH |
tatra vasatIti vAjinI vasuH |  \" tena vAjinI vasunA viShNunA.amR^itaM prArabdhakarma\-
nirmuktashchAsmi\" |  \" sa tejasI sUrye sampannaH\" (ShaTpra\. u\. 5\.5) iti 
shruteH |  tatashcha tenaiva savarchasaM saprabhamanubhUyamAnamiti yAvat |  
\" draviNaM dhanaM sukhaM chAsmi\" ityarthaH |  \" varchasa\" shabdo akArAnto.apyasti |
\" brahmahastibhyAM varchasa\" ityatra yogavibhAgAtsamAsAnto vA |  viShNuprasaN^ga\-
darshanAya shrutisheShodAharaNam |  idAnIM tasya tatra pravR^ittau nimittamAha \dash
\" Urdhva\" iti |  unnato hi Urdhva uchyate |  ato brahmAdilokasthatvAdilaxaNA 
sUxmatvAdiguNayogo vA nA.ashrayaNIyaH |  sarvataH sarvasmAt prapaJNchAt |  sarvaishcha
guNaiH |  \" adhashshAkham\" ityetaddhaTayan adhaH shabdArthaM tAvadAha \dash \" adha\" 
iti |  \" shAkhAH kA\?\" ityata Aha \dash \" shAkhA\" iti |  tAni hi mUlApexayA
apakR^iShTAni |  \" nanu vR^ixamAtrasya sArUpyamabhidadhata kathamashvatthatvamasyochyata\"
ityata Aha \dash \" shvo.api\" iti |  \" supi stha\" iti kaH\? shvasaH sakArasya
takAro dhAtusakArasya lopasya niruktatvAt shvaH sthAtA shvatthaH |  \" shvattho na
bhavati\" ityashvatthaH |  kimuta kAlAntare iti \" api\" shabdaH |  \" nanu 
pAdArthAnAM bahukAlasthAyitvadarshanAtkathametad\?\" ityata Aha \dash \" eka\" 
iti |  \" tiShThati\" iti luDarthe anAdarasUchanAya laT |  athavA \" api\" shabdena
vartamAnAtItayoH samuchchayaH |  tataH kriyAprabandhe laT |  \" tarhi \" avyayam\" 
iti vyAghAta\" ityata Aha \dash \" tathA.api\" iti |  vikAritve.api |  \" etadapi
nAsti, jagatpravAhasya praLaye vyayAd\" ityata Aha \dash \" pUrva\" iti |  
ChandasAM parNatvaM ghaTayati | \" phala\" iti |  \" phalakAritvasAdR^ishyAd\" 
ityarthaH |  tatra phalaM moxAdikam |  \" ChandasAM\" vedAnAM |  \" syAdidaM, 
yadi parNAnAM phalakAraNatvaM syAt |  tadeva kutaH\?\" \" anvayavyatirekAbhyAm\" 
ityata Aha \dash \" na hi\" iti | kiM tu jAta evetyanvayo.api vAchyaH || 1||  
%%% ##endlabel##

%%% ##label=<segment002_pd15>##

{\Largedvng pra\.dI\. || } \" adhashcha\" ityetadghaTayati \dash \" avyakte.api\" iti | 
anena \" tasya shAkhA bhUtAnyadhashcha svApexayA.apakR^iShTe sharIrAdau kArye chordhvaM 
chottame kAraNe.avyakte cha prasR^itAH sUxmarUpeNa santi\" iti vyAkhyAtaM bhavati |  
\" prasR^itA ityanenochyata\" iti sheShaH |  \" adhaH pAtAlAdau UrdhvaM svargAdAu\" 
(rA\.bhA\. 15\.2) iti vyAkhyAne prakR^itaparityAgAprakR^itaprakriye prasajyete |
guNashabdasyAnekArthatvAt \" guNapravR^iddhAH\" ityatra vivaxitamarthamAha \dash 
\" guNaiH\" iti |  arvAchInamUlairhi shAkhAH pravR^iddhA bhavanti |  \" sattvAdayashcha 
arvAchInamUlA\" iti vaxyante |  viShayANAM pravAlatvaM ghaTayati \dash \" pratItimAtra\"
iti |  pratItisamayamAtrasukhahetutvAdityarthaH |  vimardanAsahatvasAmyAditi bhAvaH |
viShayAH pravAlA iti sambandhaH |  \" adhashcha mUlAni\" ityatra \" rAgadveShAdi\-
vAsanAmUlAni\" (shAM\.bhA\. 15\.2) iti vyAkhyAnamasat |  prakramavirodhAditi 
bhAvena Aha \dash \" mUlAni\" iti |  \" Adi\" padena jaDAjaDaprakR^ityoH 
sattvAdInAM cha grahaNam |  teShAmapi \" UrdhvamUlam\" ityatra vivaxitatvAt |
\" nanu bhagavataH kathaM karmAnubandhitvam\?\" ityata Aha \dash \" bhagavAnapi\" 
iti |  atra \" karmAnubandhitvam\" nAma karmAnusAritvam |  \" tachcha 
karmasambandhena phaladAtR^itvAdbhagavato.api yuktam\" ityarthaH |  yadvA karma 
evAnubandhaH charamabhAvikAraNaM karmAnubandhaH |  tadvattvaM karmAnubandhitvam |  
tadapi karmAnubandhena phaladAtR^itvAdbhagavato yujyata iti |  shlokadvayArthe 
shrutisammatiM chAha \dash \" tathA cha\" iti |  asya jagadvR^ixasya pR^ithak 
vR^ixAnantargatam |  sahabhUtaM mUlaM \" samUlam\" |  arvAchInamUlaM 
bhUmyantargatapAdAkhyam |  \" ChandAmsi\" ityasyopapAdanam \dash \" patrebhyo 
hi\" iti |  devAdisharIrANi chopashAkhAH |  \" mAtrAH\" bhUtasUxmANi |  
\" shiphAH\" jaTAH |  muktyamuktishabdAbhyAM moxataditarapuruShArthasAdhane 
j~nAnakarmaNI uchyete |  phalamavAntaram |  moxAmoxashabdAbhyAM tu puruShArthAveva |
\" rasaH\" shreShThaM phalam |  \" guNAH\" viShayAH |  AlolapatrANi pravAlapatrANi 
yasyAsau tathoktaH |  \" na sthIyata\" ityanenAshvatthashabdArthakathanam |  
tatkiM xaNikaH\? na na sthIyate pravAhavyayo nAstItyarthaH |  tasyopapAdanam 
\dash \" na hi\" iti |  dviruktistAtparyArthA || 2||
%%% ##endlabel##

%%% ##label=<segment003_pd15>##

{\Largedvng pra\.dI\. || } \" asya rUpaM nopalabhyata\" (shAM\.bhA\. 16\.3) ityukte pramANabAdhaH |
ata uktaM \dash \" tathA\" iti |  tatsApexamityataH pUrayati \dash \" yathA\" iti | 
vikAritvAdinetyarthaH |  \" jagato deshakAlAbhyAM parichChedasyopalabhyamAnatvAnnAnta\"
ityAdyuktamayuktamityata Aha \dash \" antAdiH\" iti |  \" samhartR^itvAdeH\" 
iti sheShaH |  atra sammatiM Aha \dash \" tvam\" iti |  madhyaM sthiteH kartA |  
tasyAnupalabhyamAnatve pramANamAha \dash \" anAdi\" iti |  Adyantarahitam | 
\" asaN^ga eva shastram\" (shAM\.bhA\. 15\.4, rA\.bhA\. 15\.4) iti vyAkhyAnamasaditi 
bhAvena Aha \dash \" asaN^ga\" iti |  asaN^gaH saN^garAhityam |  tena sahitaM 
j~nAnaM asaN^gashastram |  dadhyodanAdivadvR^ittau sAhityasyAntarbhAvAdaprayoga 
iti bhAvaH |  \" pratItArthaH kuto na\?\" ityato \" j~nAnasyaiva tatra kAraNatvena\-
ukteH\" ityAha \dash \" j~nAna\" iti |  \" Chitvetyasya sabIjamuddhR^itya\"
(shAM\.bhA\.15\.4, rA\.bhA\.15\.4) iti vyAkhyAnamasaditi bhAvena Aha \dash \" Chedashca\" 
iti |  chastvarthaH |  \" vimarsho\" vivekaH |  \" vyAkhyAnAntaraparityAgenaivaM 
vyAkhyAne ko hetuH\?\" ityata Aha \dash \" tatashcha\" iti |  yato vimarsha eva 
prakR^ityAdeH vishvasya chChedaH, na sarvathoddharaNam |  tata eva tasyaikasyaiva
idamabandhakaM bhavatIti yujyate |  anyathA ekena Chede kR^ite sarvamuktiH syAditi 
bhAvaH |  itashchAyameva chCheda ityAha \dash \" tathA hi\" iti |  atra hyashvatthamenaM 
ChitvA \" tataH paraM tat parimArgitavyam\" iti vishvachChedasya 
brahmapratItAvupAyatvamuchyate |  tathA hi vishvasya kAryatvAdinA vimarshe 
sati kAryasya kAraNApexatvAt chetanAnadhiShThitAdupAdAnAdutpattyasambhavAt\-
paratantrANAM mukhyato adhiShThAtR^itvAyogAnmUlasthamupAdAnakAraNAdhiShThAtR^i 
brahma pratIyate na vishvavinAshe |  ato \" yogyatAvashAdvimarsha eva chChedo na 
vinAsha iti gamyata\" ityarthaH |  \" vishvamithyAtvaj~nAnameva chCheda\" iti 
chenna |  asya mithyAj~nAnatvAt |  shrutisamvAdAchchaivamevetyAha \dash \" tachcha\" 
iti |  \" taM vai prapadye yaM vai prapadye\" iti tachChrutAveva |  atastaM 
chChedakameva || 3||
%%% ##endlabel##

%%% ##label=<segment004_pd15>##

{\Largedvng pra\.dI\. || } vAkyArthasyAsamAptatvAt \" tameva chAdyam\" iti 
vyarthamityataH saN^gatiM sUchayannAha \dash \" tadarthaM cha\" iti |  vimarshArthaM
cheti |  vishvavimarshAdbrahmaj~nAnaM bhavatu |  \" sa vimarsha eva kathaM syAd\?\"
ityAkAN^xAM tadarthamityanena sUchayati |  tarhi chichChidiShuM prati tadupAyo vidheyo na 
tu prapadya iti vachanaM saN^gatamityato \" vyatyayo bahulam\" iti vachanamAshrityAha
\dash \" prapadyeta\" iti |  \" kuto vyatyaya\?\" ityataH shrutismR^itisaMvAdAd
ityAha \dash \" tachcha\" iti |  tadvishvaM ChitsuH |  abhyAsalopaH iDabhAvashcha
ChAndasaH |  chichChidiShuH vishvavimarshArthI yastadbrahma vishvasya mUlaM tameva
puruShaM prapadyeta ityarthaH |  prapattyA prasannena nArAyaNena dR^iShTaH pumAn
pratibaddho vishvavimarshaxamo bhavedityarthaH |  \" itashcha puruShavyatyayo.atra
vyAkhyeya\" ityAha \dash \" chChedana\" iti |  \" atastadupAyavidhAnameva 
saN^gatam\" iti sheShaH |  na kevalaM uttamapuruSho.atrAnupayuktaH |  kintvayuktashcha
ityAha \dash \" na cha\" iti |  \" tameva prapadya ityevaM parimArgitavyaM\" 
iti sambandhastvayuktaH |  asya parimArgaNatvAbhAvAt || 4||
%%% ##endlabel##

%%% ##label=<segment005_pd15>##

{\Largedvng pra\.dI\. || } tarhi brahmaj~nAnasAdhanaM vishvavimarshaH |  \" tatra sAdhanaM 
cha tatprapattiriti samastamuktaM, kimuttareNa\?\" ityata Aha \dash 
\" sAdhanAntaram\" iti || 5||
%%% ##endlabel##

%%% ##label=<segment006_pd15>##

{\Largedvng pra\.dI\. || } uttaravAkyAnAM saN^gatyapratItestAM sUchayannAha \dash \" svarUpam\" 
iti |  \" anena kIdR^ishaM tatpadaM yatprAptiH puruShArthaM ityAkAN^xyAmidamuchyata\"
ityuktaM bhavati |  \" svarUpam\" ityanena \" padam\" ityuktasya \" dhAma\" 
iti vaxyamANasya chArtho.apyukto bhavati |  sthAnatejasoH asaN^gatatvAt || 6\-7||
%%% ##endlabel##

%%% ##label=<segment007_pd15>##

{\Largedvng pra\.dI\. || } \" pUrvavAkye jIvasya prakR^itatvAttaduttaramapi tadviShayam\" 
(shAM\.bhA\. 15\.8) iti vyAkhyAnamasat |  IshvarapadarUDhArthaparityAgadoShAdityAshayavAn 
saN^gatiM tAvadAha \dash \" karShati\" iti |  \" sharIrAvAptau mUlakAraNAt, utkramaNe 
sharIrAt sthitau golakAdibhyo viShayAn pratIndriyANi jIvaH karShati\" iti 
pUrvatroktam |  tathA cha tasya niyAmakAntarAnuktyA indriyakarShaNe svAtantryaM 
pratItam |  tadayuktam |  \" pUrvoktavirodhAdityAshaN^kyeshvarasyaiva tatpratipAdayan
tajjIvasya svAtantryaM nivArayati\" ityarthaH |  shlokadvayopAdAnAya \" Adi\" padam |
atra sharIrAvAtpyutkramaNayoruktatvAdIshvarasya tadayogAtkathamidaM tadviShayamityato 
vyAchaShTe \dash \" yadi\" iti |  \" jIva\" iti pUrvavAkyAdanuvartate |  \" yadA\" 
iti shravaNAt \" tadA\" iti labhyate |  etAni indriyANi saMyAti 
sharIram |  lokAntaraM cha |  \" kuto.ayamartha\?\" ityato jIvasya sharIraprAptau 
tAvadIshvarAdhInatve pramANasammatimAha \dash \" yatra\" iti | \" saMyuktaH\" 
prerakatvena saMyuktaH |  yatra yatraiva yonau garbhadhAtA tatra tatraiva vasati jIvaH |
pravR^ittAvapIshvarAdhInatve jIvasya pramANasaMvAdamAha \dash \" bhAva\" iti |  
\" bhAvAbhAvau\" laukike shubhAshubhe |  garIyaH shreyo moxamapi |  \" tathA.api 
tanna karomi, sAdhayituM na svatantro.asmi\" |  kintu \" AshAsu\", dixu, 
\" harmyAsu\" harmyeShu, \" hR^idAsu\" hR^ideShu |  \" tAstAH kriyAH kurvanniva 
pratIyamAno.ahaM yatheshvareNa niyukto.asmi tathA tA vahAmi\" |  hananAdikriyAH 
kR^itvA yaH kashchit paramapuruShavat svAtantryamAtmano manyate so.apyakartaiva 
bhavati |  yataH taddhananAdikartA Ishvara eva karoti |  sharIrotkramaNamapIshvarAdhInaM
ityatra shrutisammatimAha \dash \" tadyathA\" iti |  \" AnaH\" shakaTam |  
susamAhitaM puruSheNa samyagadhiShThitam |  \" utsarjat\" grAmAdikaM utsR^ijat |
\" shArIra\" AtmA jIvaH |  \" prAj~nena\" AtmanA paramAtmanA \" anvArUDha\" 
adhiShThitaH |  \" utsarjat\" sharIraM utsR^ijat |  \" vAk\" ityanena 
utkramaNe paradevatA vAgAdInyAkarShatItyuchyate |  anekeShvAkR^iShyamANeShu satsu 
gandhopAdAne.abhiprAyamAha \dash \" gandhAniva\" iti |  gandhavataH 
puShpAdyavayavAnityarthaH || 8||
%%% ##endlabel##

%%% ##label=<segment008_pd15>##

{\Largedvng pra\.dI\. || } \" nanu shrotraM ityAdinA viShayabhogo.asyochyate |  na
cheshvarasyAsAvasti |  kiM tu jIvasyaiva |  tatkathamidamIshvaraviShayam\?\" ityata
Aha \dash \" bhoga\" iti |  purastAt saptame |  \" astIshvarasya bhogaH |  kiM tu
jIvendriyairnAstItyato jIvaviShayametad\" ityata Aha \dash \" indriya\" iti |  
\" rAjAdyantargataM gAyanti\" ityanena hi tachChrotreNa gAnabhogo labhyate | 
\" viShayabhogAN^gIkAre duShTasyApi bhogaH syAd\" ityata uttaravAkyagataM visheShaNaM
Ashritya Aha \dash \" guNa\" iti |  \" guNameva\" ityarthaH |  \" etadbhuJNjanasya 
visheShaNam\" iti kechit |  tAn pratyAha \dash \" na ha vA\" iti || 9|| 
%%% ##endlabel##

%%% ##label=<segment009_pd15>##

{\Largedvng pra\.dI\. || } \" uktameva kimityuchyata\?\" iti mandAshaN^kAnirAsArthaM
uttarashlokadvayasya saN^gatimAha \dash \" tarhi\" iti |  \" yadi jIvAtirikto dehe
niyAmakaH syAd\" iti sheShaH |  \" uktAnuvAdena vimUDhatvamanupalambhe kAraNaM
na tadabhAva ityuchyata\" iti bhAvaH || 10||
%%% ##endlabel##

%%% ##label=<segment010_pd15>##

{\Largedvng pra\.dI\. || } \" yatanto yoginashcha iti kAraNAntaramuchyata\" (shAM\.bhA\. 15\.11)
iti pratItinirAkaraNArthamAha \dash \" yatanta\" iti |  AtmA jIvashchet sarvadA
akR^ita eva |  \" sharIraM chedasambhava\" ityata Aha \dash \" akR^ita\" iti |  
\" AtmA\" buddhiH |  akR^itatvaM chAshuddhatvam |  \" keshAn karoti\" 
ityAdau shodhane.api karoteH prayogAditi bhAvaH || 11||
%%% ##endlabel##

%%% ##label=<segment011_pd15>##

{\Largedvng pra\.dI\. || } \" nanu tadbhAsayate ityAdinA svarUpaM kathitam |
tatkimuttareNa\?\" ityata Aha \dash \" pUrvoktameva\" iti |  \" adhashcha 
mUlAnyanusantatAni\" iti yatsarvAntaryAmisvarUpaM vij~nAnamuktaM, yachcha 
\" Urdhva\" shabdena sarvottamatvaM tadadhyAyasheSheNa prapaJNchayatItyarthaH || 12||
%%% ##endlabel##

%%% ##label=<segment012_pd15>##

{\Largedvng pra\.dI\. || } \" dhenoH Aveshena bhUtadhAraNe kiM kAraNam\" ityata 
Aha \dash \" gAm\" iti || 13\-14|| 
%%% ##endlabel##

%%% ##label=<segment013_pd15>##

{\Largedvng pra\.dI\. || } \" vedAntakR^it ityupaniShadAM kartA\" (shAM\.bhA\. 15\.15) ityanyathApratIti
nirAsArthamAha \dash \" veda\" iti |  \" vedo\" vedArthaH |  tasya \" anto\" 
nirNayaH |  tadAtmikA |  tAdarthyAt tAchChabdyam |  \" mImAmsA\" brAhmI |  
\" tasyAH kartA\" iti sheShaH |  \" kuta etad\?\" ityata Aha \dash \" tathA 
cha\" iti |  \" yuktisUtrakR^it\" |  vedArthanirNayArthayuktisUchakavAkyakR^it |  
\" sa kAlaka\" iti dvitIyena kaladhAtoH j~nAnAdyarthatayA prasiddhatvAt 
nigadavyAkhyAnametadityAchaShTe || 15||
%%% ##endlabel##

%%% ##label=<segment014_pd15>##

{\Largedvng pra\.dI\. || } \" xarAxarashabdau jaDajIvArthau\" ityapavyAkhyAna
nirAsArthamAha \dash \" xara\" iti |  bhUtagrahaNaM yuktisUchanArtham |  na hi
jaDamAtre \" bhUta\" shabdo rUDhaH |  kiM tu jIveShvapi |  \" puruSha\" shabdasya 
chaitadupalaxaNam |  \" prakR^itiH\" chetanA |  \" axara\" iti vaktavye
\" kUTastha\" iti vachanamapi yuktisUchanArthameva |  na hi jIvAnAM 
kUTasthatvamasti |  sukhAdimattvena vikAritvAt |  \" shrutisammatyA 
chAyamevArtham\" ityAha \dash \" tathA cha\" iti |  \" xara\" ityanuvAdena 
\" prajApati\" ityAdi vyAkhyAnam |  anyaM paramAtmAnam |  
\" xarAntarbhUto.api mAtarishvA vivaxAvisheSheNAxaro.api bhavati\" 
ityuchyate \dash \" jAla\" iti |  \" jAlam\" saMsArabandhaH |  
\" so.asyAsti\" iti \" jAlaH\" |  arsha Adibhyo ach |  tadrahitashcha 
\" ajAlaH\" |  abhimAnAbhAvAt || 16\-20||
%%% ##endlabel##

%%% ##label=<segment015_pd15>##

\centerline{iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya}
\centerline{TikAyAM jayatIrthamunivirachitAyAM prameyadIpikAyAM paJNchadasho.adhyAyaH} 
%%% ##endlabel##

%%% ##label=<segment001_pd16>##

{\Largedvng pra\.dI\. || } adhyAyapratipAdyaM darshayati \dash \" pumartha\" iti | yadyapi 
pUrvayoradhyAyayoH sAdhanapratipAdana eva tAtparyam |  tathA.api tanna
prapaJNchitam |  \" kiM nAma bandhanasvarUpaM sAdhanamanutiShThatA cha tadvirodhinAM
tyAgo.avashyaM karaNIyaH\" |  pUrvAdhyAye cha \" nirmAna\" (15\.5) ityAdinA 
pumarthayorj~nAnamoxayoH sAdhanaM, \" yatanto.apyakR^itAtmAnaH\" (15\.11) ityAdinA 
tadvirodhi cha saN^xepeNoktam |  tadubhayamidAnIM prapaJNchanIyam |  \" surAsuralaxaNaM 
cha tatheti tadanenAdhyAyena darshayati\" ityarthaH |  \" tapo vaxyamANam\" (shAM\.bhA\.16\.1)
iti kashchit |  tadasat |  \" devadvija\" ityAdinoktasyAtra grahaNe shauchAderapi 
tapograhaNena gR^ihItatvAtpunaruktiprasaN^gAt |  ato vaxyamANAntargataM yadatra 
pR^ithaguchyate tadvyatiriktameva |  tachcha pradhAnasyaivopalaxaNatvopapatternopavAsAdIti 
bhAvena sapramANakamAha \dash \" tapa\" iti || 1|| 

%%% ##endlabel##

%%% ##label=<segment002_pd16>##

{\Largedvng pra\.dI\. || } paishunAbhAvo \" apaishunam\" |  paishunaM cha \" parasya\-
aparAdhavachanam\" ityasat |  shiShyAdidoShAnuvAdasya shixArthasyApi tattvaprApte\-
rityAshayenA.aha \dash \" paishunam\" iti |  rAjAdeH tachChrAvaNam |  
\" paropadravanimitta\" iti doSheShUpachAraH |  anena \" paropadravAya\" iti 
sUchayati |  \" vachaH\" kathanam |  \" madAt\" kAraNAt |  \" bhIteH 
adR^iShTiranutpattiH\" iti yAvat |  \" bhIteH bhItikAraNasya tathAtvenAdR^iShTiH\" 
iti vA |  bAlAdInAM bhIteradarshanaM vyAvartayituM \" madAt\" ityuktam |  
anena dhAtvartho.apyanugataH |  etenAsuralaxaNaM darpo.api vyAkhyAtaH |  
alolutvAchApalatvayorbhedaM krameNa sapramANakaM darshayati \dash \" laulyam\" 
iti |  lolutvaparyAyo.ayamityata evamuktam || 2||

%%% ##endlabel##

%%% ##label=<segment003_pd16>##

{\Largedvng pra\.dI\. || } \" akrodha\" ityuktatvAt \" xamA\" iti punaruktirityata
Aha \dash \" xamA tu\" iti |  krodhaM doShamapakAraM cha na karoti \" akrodhadoShakR^it\" |
shatrorapakartuH || 3||

%%% ##endlabel##

%%% ##label=<segment004_pd16>##

{\Largedvng pra\.dI\. || } \" sampadaM abhijAto.asi\" ityatra abhijAta uttamajanmA |  
nAyaM dhAtuH sakarmakaH |  \" tatkathaM dvitIya\?\" ityAshaN^kya \" abhilaxya jAta\" 
(shAM\.bhA\.16\.4) iti kechidvyAchaxate |  tadasat |  arjunasya devatvena devatvamuddishya 
janmAyogAdityAshayavAnAha \dash \" daivIm\" iti |  anenaitadvyAchaShTe |  nAyaM 
\" abhiH\" upasargaH |  yena tasya janIsambandhe dvitIyA.anupapattiH, laxisambandhe 
choktAnupapattiH syAt |  kiM tu pratyarthe laxaNe karmapravachanIyaH |  tathA cha 
karmapravachanIyayukte dvitIyopapadyate |  \"	yathA vR^ixamabhi vR^ixaM pratividyotata 
ityatra vR^ixo vidyotanasya laxaNam\" ityarthaH |  \" evaM devI sampat jAtasya 
tava laxaNam\" ityarthaH sampadyate |  tathA chArjunasya prAptadevatvAvirodha iti |  
ata eva \" sampadaM daivIM abhijAtasya\", \" abhijAtasya pArtha sampadamAsurI\" 
ityetadvihAyedaM vyAkhyAtam |  arjunasya devatvaprasiddheH |  
etatsAhacharyAttatrApyetadarthatvopapatteH || 4\-7||

%%% ##endlabel##

%%% ##label=<segment005_pd16>##

{\Largedvng pra\.dI\. || } na kevalaM jagato mithyAtvAdi vadatAmasuratvaM \" asatyamapratiShThaM
te\" ityanenochyate |  \" kiM tu jagajjanmAdikAraNaM viShNuM ye na manyante teShAM
sarveShAmapi\" iti bhAvena Aha \dash \" jagata\" iti |  \" tadvaiparItyena\" iti |
\" na vidyate satyaM asti\" ityAdi |  \" jagataH satyaM viShNuH\" ityatra 
shrutimAha \dash \" tasya\" iti |  tasya viShNoH satyasya satyamityupaniShadrahasyaM 
nAma |  katham\? \" prANAH mUrtAmUrtaM, jagad\" iti yAvat, \" satyam\" 
ityuchyate |  \" teShAM prANAnAmeSha viShNuH satyam\" ityarthaH |  \" evaM 
chejjagato mukhyaM satyatvaM na bhavet\" |  anyathA nirdhAraNAyogAdityato 
mUrtAmUrtAtmakasya jagataH satyatvaM tAvadanyathA shrutyaiva vyAchaShTe \dash \" dve 
vA va\" iti |  \" rUpe\" pratime |  tatra mUrtaM \" sthitam\" iti \" sat\" 
iti chochyate |  amUrtaM tu \" yat\" iti \" tat\" iti chochyata ityarthaH |  
tathA cha sachcha tyachcha satyamityuktaM bhavati |  idAnIM jagataH satyatvaM
viShNoH shrutyA vyAchaShTe \dash \" tasya\" iti |  \" sAdayati visharaNAdikaM 
prApayati\" iti \" sat\" |  \" yAmayati niyachChati\" iti yam |  \" sachcha 
tat yachcha satyam\" ityarthaH |  pratiShThA Ishvarashcheti prasiddhameva \" aparaspara\-
sambhUtam\" ityasya \" aparaM parasmAt sambhUtam\" (shAM\.bhA\.16\.8, rA\.bhA\.16\.8)
iti vyAkhyAnamasat |  pratiShedhaprakaraNAt |  \" ataH parasparasambhUtaM 
bhagavato.abhimataH syAd\" ityata Aha \dash \" paraspara\" iti |  yadvA.anena 
paravyAkhyAnAsAdhutvamupapAdayati |  \" bhagavatA parasparasambhavasyoktatvAt
tadvachanaM kathamAsuram\?\" iti |  \" IshvarAxepe tAtparyam\" iti chenna |  
punaruktiprasaN^gAt || 8\-9||
%%% ##endlabel##

%%% ##label=<segment006_pd16>##

{\Largedvng pra\.dI\. || } \" kAmamAshritya duShpUram\" iti kAmasya duShpUratvaM
kiM visheShaNam\? \" na\" iti brUmaH |  kiM tarhi\?  \" kAmasya pravR^ittihetutve 
heturayamuchyata\" iti bhAvena Aha \dash \" duShpUro hi\" iti |  \" visheShaNameva 
kiM na syAt\?  kAmasya duShpUratvAvyabhichArAd\" iti bhAvenAha \dash 
\" pAtAla iva\" iti || 10\-17|| 

%%% ##endlabel##

%%% ##label=<segment007_pd16>##

{\Largedvng pra\.dI\. || } \" bhagavaddveShyasyA.atmaparadehAdhikaraNatvaM katham\?\" ityata
Aha \dash \" mAm\" iti |  kuto na\? \" kArayitA yadi syAttarhIdAnImakurvANaM
mAmapi kArayatu\" |  \" kurvANaM cha nivArayatu\" ityarthaH |  \" sadA.adho\"
nityanarakam || 17\-24||

%%% ##endlabel##

iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TikAyAM
shrIjayatIrthamunivirachitAyAM prameyadIpikAyAM Shodasho.adhyAyaH samAptaH || 

% shrImadhveshakR^iShNArpaNamastu 


%%% ##label=<segment001_pd17>##

{\Largedvng pra\.dI\. || } adhyAyArthamAha \dash \" guNa\" iti |  guNanimittAH
shraddhAdInAM bhedAH |  \" nAnyaM guNebhyaH kartAram\" (14\.19) ityuktatvAt
\" prapaJNchayati\" ityuktam |  \" sAttvikAnAM pumarthasAdhanatvAdanuShTheyatvam |  
anyeShAM tadviruddhatvAt tyAjyatvaM cha j~nApayitum\" iti sheShaH |  \" shAstravidhiM
utsR^ijya\" ityasya \" vedavidhAnamaprAmANyabuddhyA parityajya\" ityarthapratItiM 
nivArayituM Aha \dash \" shAstra\" iti |  \" aj~nAnamevAtrotsargaH, na tvaprAmANyabuddhyA 
tyAga\" ityarthaH |  \" nanu prAptaparityAga utsargaH |  evaM cha pratItArthameva 
yuktaH |  na tu j~nAtvA\" iti |  tatrAha \dash \" veda\" iti |  arthaj~nAnaparyanto.ayaM
vidhiH |  ayaM cha sarvAn dvijanmanaH prAptaH, tairaj~nAnibhirutsR^iShTashcha |  ato 
\" aj~nAtvA\" iti yuktaM ityarthaH |  atra shrutisaMmatiM chAha \dash \" ya\" 
iti |  na chArthamAdhigachChanti |  sahAnUnayA vedatadarthAdhigatiyogyayA buddhyA 
vartamAnAn |  \" sAnUnabuddhayo.api ye vedaM na paThanta\" iti yojyam |  
\" aprAmANyabuddhyA parityajya ityevArthaH kiM na syAd\?\" ityata Aha \dash 
\" anyathA\" iti |  yadyatra vedavirodhinAM bauddhAdInAM niShThA pR^ichChyeta 
tadA \" te tAmasAH\" ityevottaramuchyeta |  \" tadIyatAmasatvasyAvikalpitatvAd\" 
iti bhAvaH |  \" na kevalaM vaktavyAnuktireva doShaH |  kiM tu tadviruddhoktishcha 
syAd\?\" iti bhAvenA.aha \dash \" na tu\" iti |  \" trividhA bhavati shraddhA\" 
ityAdinA \" shraddhAM vibhajyottaraM nochyeta\" ityarthaH |  \" evamuttara\-
vachane.api kiM syAd\?\" iti chet, vedApramANyavAdinAmapi pAxikaM sAttvikatvaM 
syAt |  tathA cha vaxyAmaH |  \" tadapi syAd\" iti chenna |  
\" sAttvikatvavedavirodhitvayoH sahAnavasthAnAd\" ityAha \dash \" yadi\" iti |  
\" sahAnavasthAnamapi kuto nishreyam\?\" iti chet \" sAttvikA hi dharmaM
Acharanti |  \" sattvAt dharmo bhavet puMsAm\" iti vachanAt |  tathA 
cha \" vedavirodhino dharmiNashcha\" ityuktaM bhavati |  evaM cha \" vedavirodhI 
dharma\" ityAdyApadyate |  tachchAnupapannam\" ityAha \dash \" na hi\" 
iti |  \" kuto na\?\" ityata Aha \dash \" veda\" iti || 1||

%%% ##endlabel##

%%% ##label=<segment002_pd17>##

{\Largedvng pra\.dI\. || } \" nanu teShAM niShThA kA\?\" iti pR^iShTe sAttvikatvAdikaM
vaktavyam |  \" trividhA ityAdikaM kimarthamuchyata\?\" ityAha \dash \" ata\" 
iti |  yata evaM arjunena vedavidhimajAnatAM niShThA pR^iShTA |  aj~nAnaM cha 
na bhedakaM, trayANAmapi sambhavAt |  na chAj~nAnasya prabhedAH santi |  ataH 
\" shraddhayAnvitAH\" iti tadvisheShaNatvenoktAM shraddhAM sAttvikatvAdinA 
vibhajya tadAshrayeNa teShAM svArUpamAha ityarthaH || 2||  

%%% ##endlabel##

%%% ##label=<segment003_pd17>##

{\Largedvng pra\.dI\. || } \" sAttvikatvAdibhedena shraddhA trividhA ityuktA |  
punaH \" sattvAnurUpA sarvasya shraddhA bhavati\" iti vachanaM kathaM na 
vyAhatam\?\" ityata Aha \dash \" sattva\" iti |  \" chittam\" 
chaitanyam |  jIva iti yAvat |  \" nanu shraddhAsvarUpameva nirUpitam |  
na tu tadAshritya jIvasvarUpaM, ato nAsaN^gatamuttaram\" ityato yena taduchyate 
tatpaThitvA vyAchaShTe \dash \" ya\" iti |  \" ityAdi j~nAtavyam\" iti 
sheShaH |  rAjasashraddho \" rAjasaH\" |  tAmasashraddhaH \" tAmasa\" 
ityarthaH || 3||

%%% ##endlabel##

%%% ##label=<segment004_pd17>##

{\Largedvng pra\.dI\. || } \" tAM shR^iNu iti pratij~nAtaM nochyate |  \" yajante 
sAttvikA\" ityAdikamaprastutaM chochyata\" ityata Aha \dash \" ka\" iti |  
\" ityAdi jij~nAsAyAm\" iti sheShaH |  \" vibhajya shraddhAsvarUpaM pratij~nAtaM 
shraddhAtraividhyaM evochyate |  ato nAsaN^gatiH\" iti bhAvaH |  etena 
\" sAttvikAH\" ityAdeH \" sAttvikashraddhAH\" ityAdirarthaM ukto bhavati || 4\-5||

%%% ##endlabel##

%%% ##label=<segment005_pd17>##
{\Largedvng pra\.dI\. || } \" nanu nirvikArasya bhagavataH kathaM \" mAM chaivAntaH
sharIrasthaM karshayantaH\" iti karshanamuchyata\?\" ityata Aha \dash \" bhagavad\" 
iti |  \" prAtipadikAt dhAtvarthe bahulam\" iti vachanAt dR^iShTirapi 
\" Nerartha\" iti bhAvaH |  \" mAM chaiva jIvarUpeNAntaH sharIrastham\" iti 
vyAkhyAnaM tu samyagvyAkhyAnenaiva parAstam |  jIvarUpatvadarshanasyaiva kR^ishIkaraNatvAt |  
\" madanushAsanAkaraNameva matkarshanam\" (shAM\.bhA\. 17\.6) iti vyAkhyAna
nirAsArthaM \" eva\" ityuktam |  ashAbdatvAt |  uktavyAkhyAne shrutisaMmatiM 
chA.aha  \dash \" ya\" iti |  naivaM mahattvaviruddham |  \" draShTA\" iti 
tR^innantam |  \" karshakaH tasyochyata\" iti sheShaH |  karmadhArayatva
shaN^kAnirAsArthamAha \dash \" Asura\" iti |  \" nishchayaH\" shraddhA |  
\" karmadhArayapaxe hi sAmAnAdhikaraNyaM gauNam\" iti kalpyam |  matvarthIya\-
pratyayo vA |  \" tathA cha gauravam\" iti bhAvaH |  \" nanu prakaraNAt 
tAmasanishchayan iti vaktavyam |  AsuranishchayAn iti kathamuktam\?\" ityata 
Aha \dash \" devAstu\" iti |  \" sAttvikA devAH devaparyAyavAchyAH proktAH |  
rAjasA tAmasAshcha daityA daityaparyAyavAchyAH proktA\" ityarthaH || 6\-7||
%%% ##endlabel##

%%% ##label=<segment006_pd17>##

{\Largedvng pra\.dI\. || } \" prItivivarddhanAH\", \" hR^idyAH\" ityetayorarthabhedaM
Aha \dash \" prItiH\" iti |  \" Anantarika\" iti |  Than-pratyayAntam |  
\" sevAvyavahitakAla\" ityarthaH |  \" priyaM tatkAlasaukhyadam\" iti vachanAt |
darshane.anubhave sati pashchAdapi yanmanohAritvaM tat hR^idyatvam |  \" hR^idyaM 
pashchAt manohAri iti vachanAd\" ityarthaH |  \" AhArANAM xaNikAnAmabhAvAt 
kathaM \" sthirA\" iti visheShaNaM\?\" ityata Aha \dash \" sthirAshcha\" iti |  
chastvarthaH prasiddhaM sthairyaM vyAvartayati |  tadaiva achirakAla eva |  
\" pakvAH nirvR^ittapAkAH chirakAlaM dehe guNapradA\" ityarthaH |  
asambhavaparihArAya tAnudAharati \dash \" tathA hi\" iti || 8\-15|| 

%%% ##endlabel##

%%% ##label=<segment007_pd17>##
{\Largedvng pra\.dI\. || } \" nanvaN^gasauShTavaM \" saumyatvam\" |  tatkathaM mAnasaM tapa 
uchyata\?\" ityata Aha \dash \" saumyatvam\" iti |  \" maunaM vAN^niyamanam\"
(rA\.bhA\. 17\.16) ityanyathApratItinirAsArthamAha \dash \" maunam\" iti |  \" kuta 
etad\?\" ityata Aha \dash \" bAlyam\" iti |  yuktibalopetatvaM \" bAlyam\" |
Agamaj~natvaM \" pANDityam\" |  atha \" muniH mananashIlo bhavati\" ityarthaH |  
\" etena hIdam\" ityuktamarthaM \" yadanena\" iti hetutvenopAdatte |  yasmAdevaM 
munistasmAttaM munirityAchaxate |  \" mana j~nAne\" ityataH ikArapratyayaH |  
upadhAyA ukArashcha |  muneH bhAvashcha \" maunam\" |  tachcha mananashIlatvAkhyaM
AgamArthasya yuktibhiranusandhAnam |  uktArthAnaN^gIkAre bAdhakamAha \dash \" katham\"
iti |  \" maunam\" iti sheShaH |  \" vAN^niyama eva na maunam |  kintvatra
tatkAraNamanoniyamo laxyata\" (shAM\.bhA\. 17\.16) iti kashchit |  tadasat |
\" Atma vinigrahaH\" iti punaruktidoShAt |  kathaJNchit tatparihAre.api 
mukhyArthasambhave laxaNAshrayaNasyaiva doShatvAt || 16\-22||
%%% ##endlabel##

%%% ##label=<segment008_pd17>##
{\Largedvng pra\.dI\. || } \" OM ityAdikaM prakR^itAsaN^gataM kathamuchyata\?\" ityata Aha 
\dash \" punashcha\" iti |  \" karma\" iti yaj~na uchyate |  \" Adi\" padena
tapodAne |  \" iti kartavyatA\" itthambhAvaH |  \" vidhAnArtham\" pratipAdanArtham |
\" aphalAkAN^xibhiH\" ityAdinoktatvAt \" punashcha\" ityuktam |  
\" yaj~natapodAnAnAM sAttvikatvAdihetavo asAdhAraNAH dharmAH prAguktAH |  
sAdhAraNAMstu vaktuM purAkalpAdirUpamarthavAdamAha\" ityarthaH |  \" brahma\"
shabdasya hiraNyagarbhAdyarthatAM nirdeshashabdasya cha bhAvArthatAM vArayituM 
vyAkhyAti \dash \" parasya\" iti | \" nirdishyate.anena\" iti \" nirdesho\" 
nAma |  \" kuta etad\?\" ityato \" hi\" ityuktam |  bhAvArthatve \" OM 
tat sat\" ityetaiH sAmAnAdhikaraNyAnupapatteH nAmArthatvamevAN^gIkAram |  
\" OMAdikaM cha parabrahmanAmatvena prasiddham\" ityarthaH |  tAmeva prasiddhiM 
darshayati \dash \" otam\" iti |  \" otam\" praviShTaM AshritaM yatra 
parameshvare yaH svayaM cha jagati otaH praviShTaH |  pUrNo.anupachArataH 
mukhyayA vR^ittyA |  atra \" otaM jagat yatra\" ityAdinA \" OM\"
shabdasya nimittadvayena bhagavati vR^ittirdarshitA |  \" avateH Tilopashcha\" iti 
vachanAt |  \" sarvaiH\" ityanena sachChabdasya |  \" sAdhubhAve cha\" iti vaxyamANatvAt |  
tachChabdasya tu na kenApi |  \" ataH OM tat sat ityetamityayuktam\" ityata Aha \dash 
\" dvitIya\" iti |  \" vedokta\" iti dvitIyapAdaH tachChabdArthavyAkhyAnaparaH |  
\" tat\" iti nityaparoxatvamuchyate |  na cheshvarasvarUpamanumAtuM shakyam |  
\" ato vedaikavedyatvAt \" tat\" ityuchyata\" iti bhAvaH |  sadOMshabdayoH 
parabrahmanAmatve shrutyantaraM chAha \dash \" sadeva\" iti |  \" tena iti 
nirdeshaparAmarsha\" (shAM\.bhA\. 17\.23) iti kashchit |  tadasaditi bhAvena 
Aha \dash \" tena\" iti |  \" kuta etat\?\" nirdeshasya brAhmaNAdividhAnAyogAt |  
\" nirdeshastutyarthamidamuchyata\" iti chet \" na |  bhUtoktisambhavena 
tadayogAt |  brahmaNA.api brAhmaNAdividhAnAnupapattiH prayojanAbhAvAd\" ityata 
Aha \dash \" AtmA\" iti |  \" AtmapUjayA prANinAM sukhArthaM brAhmaNAdayo 
vihitA\" iti sambandhaH |  \" brAhmaNAdivat vedAnAmapi vidhAnaM nirmANameva\" 
(shAM\.bhA\. 18\.23) iti pratItinirAsArthamAha \dash \" veda\" iti |  \" vyaJNjanameva 
vidhAnaM, na nirmANam\" ityarthaH |  \" sakR^ichChrutasya vihitashabdasya 
dvidhA arthakalpanaM kuta\?\" iti chet, vedApauruSheyatvasya pramitatvAt |  
\" kiM tatpramANam\?\" ityata Aha \dash \" mA tu\" iti |  \" parameshvarasya 
vedavyaJNjanaM nAdhyApakavat |  kiM tu svAtantryamapyasti\" iti j~nApayituM 
vidhigrahaNaM kR^itam |  vedo hi vidhyAtmA asti |  \" vidhiH\", \" preraNam\",
\" niyogaH\" iti chAnarthAntaram |  na cha niyoktAramantareNa niyogaH sambhavati |
na cha shabdAdInAM niyoktR^itvaM sambhavati lokavirodhAt |  na chochchAraka eva 
niyoktA \" mAM upAsIta\" ityAdAvavyavasthApAtAt |  tasmAt svatantreNa vaktrA 
bhAvyaM na chaivaM pauruSheyatvApattiH |  anAdisiddhenaiva shabdArthasambandhena 
tasya niyoktR^itvAbhyupagamAditi || 23\-24||
%%% ##endlabel##

%%% ##label=<segment009_pd17>##
{\Largedvng pra\.dI\. || } \" tadityanabhisandhAya\" iti vAkyaM \" brahmaNIva yaj~nAdAvapi 
tachChabdapravR^ittiM pratipAdayati\" iti j~nApayituM yojayati \dash \" tad\" 
iti |  vedoktaM svargAdikam || 25||
%%% ##endlabel##

%%% ##label=<segment010_pd17>##
{\Largedvng pra\.dI\. || } \" sadbhAve sattAyAm\" (shAM\.bhA\. 17\.26) iti pratItinirAsArthamAha 
\dash \" sadbhAva\" iti |  prajananaM prAgasataH sattA.apAdanam |  \" yadyapi \" sadbhAva\"
shabdaH sattAmAtravAchI tathA.apyatra brahmaNo jagajjanakatvasya vivaxitatvAt 
sattAvisheShaprajananapara iti j~nAyata\" iti pratipAdayituM \" sUchitam\" 
ityuktam |  \" nanvanena yaj~nAdInAM kA itikartavyatA pratipAditA bhavati\?\" 
ityata Aha \dash \" OM\" iti |  uktoN^kArArthaj~nAnapUrvakamanabhisandhAya phalaM 
brahmAbhisandhAya cha brahmaj~nAnabhaktipUrvakaM tadviShayatvena niShThayA vedoktaprakAreNa 
brAhmaNaiH sahA ityapi grAhyam |  \" Adi\" padena japAdigrahaNam |  ShaShThI 
tR^itIyArthe |  \" nAmasAmyAt\" nAmasAmyena avagatAt tatpratimAtvAt |  
\" ghaTAdInAmapi brahmapratimAtvasAmyAt ko visheSho yaj~nAdeH\?\" ityata 
uktam \dash \" atiprIteH\" iti |  brahmaNaH yaj~nAdiShu niShpAditaM pratiShThApitam |
\" ata evaM kriyamANe yaj~nAdikaM sAttvikaM, anyadrAjasaM tAmasaM vA ityevaM itikartavyatA 
pratipAdita\" iti vAkyasheShaH |  atra hi \" OM tat sat\" ityanena \" brahmaNo 
yannAmatrayaM tadyaj~nAderapi vAchakam\" iti pratipAditam |  tena yaj~nAdeH 
brahmapratimAtvaM sUchitam |  \" brAhmaNA\" ityAdinA OMkAraM brahmaNi yaj~nAdau 
cha vyutpAdya taduchcharaNAchAra uktaH |  \" tenArthasmaraNapUrvakam OMkAramuchchArya 
vedoktaprakAreNa brAhmaNaiH saha yaj~nAdikaM kAryam\" iti sUchitam |  \" tat\" 
ityanena tachChabdo yaj~nAdau brahmaNi cha vyutpAditaH |  \" tena phalamanabhisandhAya 
brahmAbhisandhAya cha\" iti labdham |  \" sadbhAve\" ityanena sachChabdo brahmaNi 
vyAkhyAtaH |  \" tena brahmaj~nAnapUrvakam\" iti labhyate || 

\" yaj~ne tapasi karma chaiva\" ityanena yaj~nAdiShu sachChabdo vyAkhyAtaH |
\" tena brahmaviShayatvena niShThayA cha\" iti labdham || 

\" ashraddhayA\" ityanena \" brahmabhaktirapi\" iti |  atra shrutisammatiM Aha 
\dash \" tathA cha\" iti |  OM yaj~nAdyAH vedAdyotatvAt |  niShphalaM 
phaloddesharahitatvAt |  tadarthaM brahmaviShayam |  evaM tachChabdAnAM brahmashabdAnAM, 
yaj~nAdiShu sannidheravagatatadrUpatvAt tatpratimAtvAt |  tasyoktaprakAreNa 
yaj~nAdInAmanuShThAtuH || 26\-28||
%%% ##endlabel##

%%% ##label=<segment011_pd17>##
iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TIkAyAM 
shrIjayatIrthamunivirachitAyAM prameyadIpikAyAM saptadasho.adhyAyaH samAptaH || 

%%% ##endlabel##

% shrImadhveshakR^iShNArpaNamastu 

%%% ##label=<segment001_pd18>##

{\Largedvng pra\.dI\. || } adhyAyapratipAdyamAha \dash \" pUrvoktam\" iti |  
\" sAdhanam\" j~nAnasAdhanam |  \" uktasyoktirvyartha\" ityAshaN^kAnirAsAya 
\" saN^xipyopasaMharati\" ityuktam |  \" anuktaM traiguNyaM cha vakti\" ityapi 
grAhyam || 1||

%%% ##endlabel##

%%% ##label=<segment002_pd18>##

{\Largedvng pra\.dI\. || } \" kAmyAnAM karmANAm\" ityetaM shlokaM kechit 
\" kAmyAnAM karmaNAM ashvamedhAdInAM svarUpeNa tyAgaH saMnyAsaH |  nityanaimittikAdi 
sarvakarmaphalatyAgaH tyAgaH\" (shAM\.bhA\. 18\.2) iti |  \" tadasad\" iti bhAvenA.aha 
\dash \" phala\" iti |  vaikalpikakAmyAnAM svargAdiphalAnichChayA visheShaNatyAgena 
\" tyAgaH\", niyatakAmyAnAM svarUpAkAraNena tyAgaH \" sannyAsaH\" |  
\" kAmyakarmaNAmeva phalatyAgastu tyAgaH, karaNAkaraNe tu na vivaxite\" ityarthaH |  
\" kuta etad\?\" ityata Aha \dash \" tathA hi\" iti |  \" akarmaNA\" akaraNena |  
janakAshvapatyAdibhiH mumuxibhiH ashvamedhAdInAmanuddiShTaphalAnAmanuShThAnAnna 
kAmyAnAM svarUpaparityAga eva |  nityanaimittikaphalasyAntaHkaraNashuddheH 
sarvApexitatvena tattyAgo na yuktaH || 2||

%%% ##endlabel##

%%% ##label=<segment003_pd18>##

{\Largedvng pra\.dI\. || } \" tyAjyaM doShavat ityanena heyaH kApilAnAM paxaH 
upanyastaH\" (shAM\.bhA\. 18\.3) iti kechit |  \" tadasad\" iti bhAvenA.aha 
\dash \" manIShiNa\" iti |  \" pUrvapaxaH\" pUrvopanyastaH paxaH |  \" nanu 
yaj~nadAnatapaH karma na tyAjyaM, kAryameva taditi bhagavanmataviruddho.asau kathaM 
grAhya\?\" ityata Aha \dash \" phalatyAgenaiva\" iti |  phalatyAgAbhiprAyeNa 
yaj~nAdeH tyAgo vivaxitaH tatpaxe na svarUpataH |  kutaH\? \" manIShiNa\" iti 
visheShaNAdeva |  ato na bhagavanmataviruddho.asau |  \" karmatyAgashabdaH kathaM 
phalatyAgenArthenArthavAn\?\" ityata Aha \dash \" yastu\" iti |  \" nanvevaM 
sati pUrvottarArdhopanyastayoH paxayoravirodha Apadyata\" iti chet, \" satyaM\", 
ityAha \dash \" ata\" iti |  ato manIShipaxatvAt eko.aviruddhaH |  ayaM 
pUrvottarArdhopanyastaH |  \" kintvApAtapratItimapexya sandehabIjatvena 
vipratipattiriyamudbhAvitA\" iti bhAvaH || 3||

%%% ##endlabel##

%%% ##label=<segment004_pd18>##

{\Largedvng pra\.dI\. || } na kevalaM \" manIShiNa\" iti visheShaNasAmarthyAdevamuchyate |
\" kiM tu bhagavatA.api tadavirodhaprakArasya vyutpAdyamAnatvAd\" iti 
bhAvenottaravAkyatAtparyamAha \dash \" tad\" iti || 4|| 

%%% ##endlabel##

%%% ##label=<segment005_pd18>##

\" nanu paramahaMsAnAM yaj~nadAnayorabhAvAtkathamuchyate na tyAjyaM kAryameva 
tat\?\" iti tatrA.aha \dash \" yaj~na\" iti |  \" nanu jyotiShTomAdikameva 
yaj~naH, dhanadAnAdikameva dAnaM gR^ihItvA pAramahaMsyameva kuto na nirAkriyata\?\" 
ityata Aha \dash \" anyathA\" iti |  \" yatiH\" haMsAdiH |  \" AsthAtum\" 
prAptum |  \" uttamAshramam\" pAramahaMsyam |  \" nanveteShAM madhye 
ityevaM vyAkhyAne.api kathaM paramahaMsAnAM yaj~nAdisambhava\?\" ityata 
Aha \dash \" j~nAna\" iti |  bahuvrIhitrayagarbhaH karmadhArayo.ayam |  
vidyA.abhayaviShayaM dAnaM yeShAM te tathoktAste paramahaMsAH |  \" nanu pAramahaMsye 
hi pravR^ittaH priyavrato hiraNyagarbheNa nivArita iti purANeShUchyate |  tatkathaM 
pAramahaMsyAkartavyatA\?\" ityata Aha \dash \" ata\" iti |  uktavAkyavirodhAdeva |  
\" vAkyatvAvisheShAt purANavAkyenaiva smR^iterbAdhaH kiM na syAd\?\" ityata 
Aha \dash \" anyathA\" iti |  evamayojane |  \" itareShAM\" brahmachArI
ityAdInAm |  \" gatyantarAbhAvAdaprAmANyameva prasajyata\" iti sheShaH |  
evaM paramahaMsAnAmapi yaj~nAdikartavyatAsampAdanenedamapi parAstaM yat 
kenachiduktam \" aj~nAn karmaNi adhikAriNo.adhikR^itya etatprakaraNaM
pravR^ittaM na paramahaMsaparivrAjakAn\" iti || 5\-10||

%%% ##endlabel##

%%% ##label=<segment006_pd18>##

{\Largedvng pra\.dI\. || } \" nanu \" iti me pArtha\" (18\.6) iti bhagavatA svasiddhAnto 
niShTaN^kitaH |  ato \" na hi dehabhR^itA\" iti kimuchyata\?\" ityata 
Aha \dash \" anya\" iti |  sarvakarmaparityAgalaxaNaH |  \" tyAgArthaH\" 
tyAgashabdArthaH |  \" pUrvapaxabIjanirAsArthaM\" iti sheShaH || 11|

%%% ##endlabel##

%%% ##label=<segment007_pd18>##

{\Largedvng pra\.dI\. || } \" karmaphalAbhAvo nAma saMsAranivR^ittireva |  sA 
kathaM tyAgaphalatvenochyata\?\" ityata Aha \dash \" tyAgam\" iti |  
upapAditametat \" tyAgAchChAntiH\" (12\.12) ityatra || 12||

%%% ##endlabel##

%%% ##label=<segment008_pd18>##

{\Largedvng pra\.dI\. || } \" paJNcha\" ityAdeH prakR^itena saN^gatyapratItestAmAha 
\dash \" punaH\" iti |  \" na kevalaM kAmyAnAM karmaNAM nyAsaH saMnyAsaH kiM tu 
kartR^itvAbhimAnatyAgashcha ityevaM prAguktaM saMnyAsaM punaH prapaJNchayitumAtmano
akartR^itve kriyA.aniShpattiprasaN^gAt aN^gIkArye kartR^itve kathaM 
tadabhimAnatyAgo yukta\?\" ityAshaN^kAparihArArthaM \" AtmavyatiriktAnyeva 
karmakAraNAnyAha\" ityarthaH |  \" sAN^khya\" shabdaH kApilatantre rUDhaH |  
\" kR^itaM karma, tasya anto nivR^ittiryatra uchyate\" (shAM\.bhA\. 18\.13) 
ityupaniShatsu kR^itAntashabdaM kashchidvyAkhyAtavAn |  tadubhayaM nivartayitumAha 
\dash \" sAN^khya\" iti |  j~nAnArthaH siddhAntaH \" j~nAnasiddhAntaH\" |
\" siddhAnta\" iti shAstraM laxyate |  kApilatantrasya ninditatvAt |  
upaniShatsvapi karmatyAgApratipAdanAt || 13||

%%% ##endlabel##

%%% ##label=<segment009_pd18>##

{\Largedvng pra\.dI\. || } \" adhiShThAnAdi karaNa evAntarbhUtam\" (mA\.bhA\. 18\.18) iti 
vaxyati |  tatpratibodhanAyAdhiShThAnaM nirdishati \dash \" adhiShThAnam\" iti |  
\" Adi\" padena bhUmyAdi |  \" kartA jIva\" (rA\.bhA\. 18\.13) iti vyAkhyAnamasaditi 
bhAvenAha \dash \" kartA\" iti |  \" sharIravAN^manobhiH kriyamANAnAM 
karmaNAM kartA kathaM viShNuH\" ityata Aha \dash \" sa hi\" iti | 
\" uktam\" upapAditam |  \" tathA.api jIvo.atra kartA kiM na syAd\?\"
ityata Aha \dash \" jIvasya cha\" iti |  aparAdhInatvAbhiprAyeNedaM 
nirAkaraNam |  \" parAdhInaM kartR^itvamaN^gIkR^ityAnyatra jIvo vyAkhyAta\" 
ityavirodhaH |  bhAvasAdhanatApratItinirAsArthamAha \dash \" karaNam\" iti |  
\" Adi\" padena struvAdi |  bhAvasAdhanArthasya sAdhyatvAt |  cheShTAgrahaNena 
cha gR^ihItatvAchcha |  \" vAyavIyAH prANApAnAdyAH cheShTA\" (shAM\.bhA\. 18\.13) 
ityasat |  dravyAbhidhAne cheShTAtvAnupapatteH |  \" prANanAdyabhidhAne sAdhyatvAt 
kArakatvAnupapatteH\" ityAshayavAnA.aha \dash \" cheShTA\" iti |  \" kriyANAM
sAdhakatvAtkathaM kArakatvam\?\" ityata Aha \dash \" hastAd\" iti |  
sAvAntaravyApAraM hi kAraNaM kArakamuchyate |  tatrAdhiShThAnAdipadairvyApAriNo 
nirdishyante |  \" kriyA\" shabdena tvavAntarA vyApArAH |  \" kArakAshritAbhiH
avAntarakriyAbhiH pradhAnakriyAjananaM cha prasiddhameva\" ityarthaH |  \" nanvatra 
kArakAbhidhAnaprasaN^ge adhiShThAnAdyevoktam |  karmasampradAnApAdAnAni kuto 
noktAni adhiShThAnAdInAM sarvakriyAnugamAt\?\" \" karmAdInAM tadabhAvAd\" 
iti brUmaH |  tathA cha vaxyati \dash \" sharIravAN^manobhiH yat\" iti |  
evaM tarhi cheShTA.api na vaktavyA |  \" dhyAnAdijanane karaNasya manasaH 
cheShTAbhAvenAnanugamAd\" ityata Aha \dash \" dhyAnAderapi\" iti |  \" Adi\" padena 
smaraNaM gR^ihyate |  \" j~nAta\" evArthe dhyAnaM bhavati |  \" j~nAnaM 
chA.atmendriyasannikR^iShTenaiva manasA jAyate |  sannikarShashcha mAnasacheShTAjanyaH |  
ato dhyAnAderapi manassambandhinI cheShTA kAraNaM bhavati\" iti bhAvaH |  \" nanu 
niyatapUrvakshaNe sat kAraN |  na cha dhyAnAdipUrvakshaNe manasi kriyA.asti |
chirA.atItatvAt |  manonaishchalasAdhyatvAt dhyAnAdeH |  na cha sannikarSha\-
j~nAnadvArA karaNam |  tasyApi chirAtItatvAd\" ityata Aha \dash \" pUrvatani\" 
iti |  \" pUrvatanI\" chirAtItA.api mAnasI kriyA sannikarShadvArA dhyAnAdihetu\-
saMskArakAraNatvena bhavati dhyAnAdeH kAraNam |  \" saMskArasya sthAyitvAd\" 
ityarthaH |  \" daivamantaryAmivyApAra\" (rA\.bhA\. 18\.13) iti kashchit |
tadasat |  \" kartA\" ityanenaivoktatvAt |  \" chaxurAdyanugrAhakAH
sUryAdaya\" (shAM\.bhA\. 18\.13) ityaparaH |  tadapyasat |  \" karaNAdi\-
shabdaireva gR^ihItatvAd\" iti bhAvena Aha \dash \" daivamadR^iShTam\" 
iti |  uktamarthaM shrutisaMmatyA.api samarthayati \dash \" tathA cha\" iti |
\" dehaH\" upalaxaNam |  \" hetuH\" kAraNam |  \" karma hetu\" 
iti kvachit pAThaH |  tatra ChAndaso liN^gavyatyayaH |  na chaivaM jIvasya 
karmakAraNeShvanantarbhAve vyAkhyAyamAne \" tatraivaM sati\" ityuttaravAkye, 
\" kevalam\" iti na yujyate |  \" ekAkinamAtmAnaM karaNatvena manyamAnasya 
nindayA.asya sasahAyasya kAraNatvapratIteH\" ityata Aha \dash \" kevalam\" 
iti |  nAtra \" kevala\" shabda ekAkivachanaH |  kiM tu niShkriyAtvavAchI |
\" taduktishcha nindopapAdanArtha\" iti bhAvaH |  \" kevalashabdasya 
niShkriyArthatvaM kuta\?\" ityata Aha \dash \" enam\" iti |  \" tatraiva\"
AyAsyashrutAvevoktam || 14\-16||

%%% ##endlabel##

%%% ##label=<segment010_pd18>##

{\Largedvng pra\.dI\. || } \" avashyaM chaitadevaM, yAvatottarashloke svAtmAnamakAraNaM
jAnatastutiH kriyate |  anyathA sahAyasya kAraNatvaM jAnataH stutiH kriyeta\" iti 
bhAvena Aha \dash \" tad\" iti |  svAtmano niShkriyatvaj~nAnam |  \" nanu 
nirahaN^kArasyApIndrAdeH vR^itravadhAdineShat bandho dR^ishyate |  tatkathametad\?\" 
ityata Aha \" yastu\" iti |  iyaM cha kalpanA vakturAptatvAdinA yujyate || 17||

%%% ##endlabel##

%%% ##label=<segment011_pd18>##
{\Largedvng pra\.dI\. || } \" yadi na jIvasya kAraNatvaM kathaM tarhi tajj~nAnAderuttaravAkye 
karmaNAM mUlakAraNatvaM uchyate j~nAnAditrayaM karmaNAM pravartakaM iti\?\" 
ityAshaN^kya tasyArthAntaraM vivaxuH, tannivartyAmAshaN^kAmAha \" evaM tarhi\" 
iti |  \" yadi jIvo na karmaNAM kAraNam\" ityarthaH |  \" vidhiH\" shrautaH 
smArtashcha |  \" na pravarteta tatashcha tadvaiyarthyaprasaN^ga\" iti sheShaH |
\" evaM tarhi\" ityuktasyaiva vivaraNam |  \" akartR^itvAd\" iti |  
\" jIvasya ghaTavad\" iti sheShaH |  \" nanu j~nAnAdirupeNa karmachodanAyAH 
traividhyamayuktamanupayuktaM cha kathamuchyate\? niyoktuH preraNaM hi vidhiH |  
na cha tajj~nAnAditrayarUpam |  na chAnenoktashaN^kAnivR^ittiH\" ityata 
Aha \dash \" trividhA\" iti |  spaShTapratItyartho.anuvAdaH |  \" ityatra\" 
iti sheShaH |  \" etad\" j~nAnAdikam |  \" karmavidhiH pravartate jIvaM 
prati\" iti sheShaH |  \" iti\" shabdo hetau |  \" trividhA\" ityuchyate 
karmachodanA |  \" nimittanaimittikabhAvenAbhedopachAra\" ityarthaH |  
\" karmakaraNAnAmuktatvAt kimidaM punaruchyata\?\" ityata Aha \dash \" kAraNAni\" 
iti |  \" tarhi \" karmasaN^graha\" iti kathaM\?, \" kAraNasaN^graha\" 
iti vaktavyatvAd\" ityata Aha \dash \" karma\" iti |  \" karma\" shabdena 
tatkAraNAni laxyanta ityarthaH |  \" yadi paJNchAnAM kAraNAnAmayaM saN^grahastarhi 
kasya kutrAntarbhAva\?\" ityata Aha \dash \" AdhiShThAnAdi\" iti |  
\" Adi\" padena daivapadoktamadR^iShTaM gR^ihyate |  \" kAMsyapAtryA pAtryA 
bhuN^kte devena devena kR^itamanyathA\" ityAdivat sAdhakatamatvena vivaxitatvAt |
\" vivaxAtaH kArakANi bhavanti\" iti vachanAt |  na chA.adipadena cheShTAyAH 
saN^grahaH |  tatra kArakAntarbhAvasyaivauchityAt |  \" karma\" iti pR^ithag\-
grahaNAchcha |  na cha \" karma\" adR^iShTam |  \" karma cheShTA\" ityanyatra 
vyAkhyAtatvAt |  \" karturIpsitatamaM karma\" (shAM\.bhA\. 18\.18) iti kechit |
tadasat |  paJNchasu kAraNeShu tasyAgR^ihItatvAt |  shlokArthe shrutisammatiM 
chAha \dash \" tathA hi\" iti |  \" karma\" ityAvartanIyam |  tatraikaM 
vyastam |  paraM samastam |  \" nanu \" j~nAnaM j~neyam\" ityanena 
kathamuktashaN^kAnirAsa\?\" ityata Aha \dash \" akartR^itve.api\" iti |  
aparAdhInakartR^itvAbhAve.api jIvasya na taM prati vidhivaiyarthyam |  kutaH \? 
\" iti hetoH\" ityanvayaH |  vidhishabdena tajj~nAnamupalaxyate |  \" ichChA\" 
ityanena prayatno.api |  uktakaraNaiH adhiShThAnAdibhiH |  anena \" j~nAnaM\"
vidhiviShayaM, \" j~neyaM\" cha ichChAprayatnalaxaNaM adhiShThAnAdilaxaNaM 
puruShArthalaxaNaM cha, \" parij~nAtA\" sarvaj~na Ishvarashcha sarvaprerako 
jIve sannihito.asti |  ataH \" taM prati karmachodanA\" ityarthaH sUchito bhavati |  

etaduktaM bhavati |  \" nAparAdhInakartR^itvaM vidhiviShayatve prayojakam |  yena 
jIvaM prati karmavidhivaiyarthyaM syAt |  tathA satIshvarasyApi vidhiviShayatvApAtAt |
kiM tu yasya svasambandhitayA vidhij~nAnaM karmatatphalaM choddishyechChA tadanuguNashcha
prayatnaH adhiShThAnAdisannidhAnaM, karmasambandhaH phalabhAktvaM chAsti taM prati
karmavidhayaH pravartante\" |  \" asti chedaM samastaM parameshvaraprasAdAyattaM jIva
iti kathaM na taM prati karmavidhayaH syuH\?\" iti |  etatsaN^grahavAkyamuttara\-
vAkyairvivriyate |  \" nanvIshvarashchet prerako jIvasharIre.abhyupagataH tadA 
tatprasAdAdevechChAprayatnayorutpAdAt kiM vidhij~nAnamaN^gIkriyata\?\" ityata Aha 
\dash \" Ishvara\" iti |  \" ichChati prayatate cha\" iti sheShaH |  anena 
vidhidvAreshvaraprasAdAdichChotpattyetyetadvivR^itaM bhavati |  \" uktakAraNaiH karma 
bhavatItyuktam |  tenAdhiShThAnAdInAM svavyApAre svAtantryaM prAptam\" |  
tannirAsArthamAha \dash \" yadi cha\" iti |  IshvareNaiva karmAdhiShThAnAdIni 
nimittamAtrANi kR^itvA kAritaM bhavati |  atra \" Nicham\" prayuJNjAnasya 
svAtantryamiti vaxyamANo.abhiprAyaH |  \" karmadvArA puruShArtho bhavati\" iti 
puruShArthasAdhane karmaNAM prAdhAnyaM prAptam |  ata Aha \dash \" phalaM cha\" iti |  
IshvareNaiveti vartate |  \" yadvA\", \" yadi cha\" ityAdinA vAkyadvayena 
vidhiviShayatAsiddhaye karmaphalasambandhasya kAkatAlIyatA nirAkriyate |  idaM cha 
neshvaramuktajaDeShu vidhyaviShayeShvasti, kiM tu saMsAriShveveti bhavati prayojakam |  
evamekaM gItoktaM kAraNamuktvA bhAShyakAraH kAraNAntaraM chAha \dash \" vastuta\" iti |  
vastutaH paramArthataH |  AbhimAnikamahaN^kArakAritaM bhrAntipratItam |  \" tasya 
jIvasyaiva\" ityavadhAraNena \" asya jIvaM prati vidhipravR^ittau prayojakatvaM 
samarthayate parameshvara kR^itAsu kriyAsu svasya svAtantryaM manyamAnasyAparAdhIno 
vidhibandhalaxaNo daNDa\" iti bhAvaH |  prakArAntaramAha \dash \" svAtantryaM cha\" 
iti |  \" tasya\" iti vartate |  \" syAdidaM vidhipravR^ittivaiyarthyaM yadi 
jIvasya kriyAsvAtantryalaxaNaM kartR^itvaM sarvathA na syAt |  na chaivam |  
IshvarAyattasya tasyAN^gIkArAt |  aparAdhInApexayA tadabhAvokteH |  na chaivaM 
jaDataulyam\" ityAha \dash \" jaDamapexya\" iti |  \" adhikam\" iti 
sheShaH |  jaDaM hi tadA parakR^itena nodanAdinA kriyAvadbhavati |  na 
tvAgantukakAraNamantareNa svechChayA |  jIvastvanAdisiddhayA parameshvaraprasAdAyattayA 
sattAtulyayA kriyAshaktyA karteti yuktastaM prati karmavidhiriti |

\" nanvetat sarvaM kutaH pramANAt pratipattavyam\" ityata Aha \" sarvaM cha\" iti | 
anubhavenoktapramANaishcha \" vidhij~nAne satIchChotpattiH\" ityAdikamanubhavasiddham |
\" IshvaraprasAdAt\" ityAdikaM tu \" yathA niyukto.asmi\" ityAdyudAhR^itAgama\-
siddham |  \" pR^ithak\" punaH  || 18||

%%% ##endlabel##

%%% ##label=<segment012_pd18>##

{\Largedvng pra\.dI\. || } \" j~nAnaM karma\" ityAdeH prakR^itopayogApratIteH taM 
darshayannAha \dash \" punaH\" iti |  moxasAdhanaprapaJNchAt prAgapi guNabhedAnAM
uktatvAt \" punaH\" ityuktam |  \" guNasaN^khyAnashabdena kApilaM shAstraM
uchyata\" iti bhAvenA.aha \dash \" guNa\" iti |  tachcha vaidikamabhipretam || 19||

%%% ##endlabel##

%%% ##label=<segment013_pd18>##

{\Largedvng pra\.dI\. || } \" ekaM bhAvaM\" iti sAmAnyenoktam |  \" ko.asau eko 
bhAvaH\?\" ityAkAN^xAyAmAha \dash \" ekam\" iti || 20\-27 ||

%%% ##endlabel##

%%% ##label=<segment014_pd18>##
{\Largedvng pra\.dI\. || } \" dIrghasUtritvaM kathaM tAmasatvahetuH\?\" ityataH sapramANakaM 
vyAchaShTe \dash \" para\" iti |  \" dIrghakAlakR^itaM\" chirAtItakAlakR^itam |  
\" anuchitam\" vachanAyogyam |  paropadravahetutvAt doShAt mAtsaryAdeH || 28\-30||

%%% ##endlabel##

%%% ##label=<segment015_pd18>##
{\Largedvng pra\.dI\. || } \" yayA dharmamadharmaM cha iti rAjasyAH buddheH 
dharmAdiviShayAyA ayathArthaj~nAnahetutvamuchyate\" (shAM\.bhA\. 18\.31) ityanyathA\-
pratItinirAsArthamAha \dash \" yathArthatva\" iti |  \" ayathAvat prajAnAti\" 
ityasya \" yathArthaj~nAnajanananiyamAbhAve tAtparyamityarthaH pratIta evArthaH 
kiM na syAd\?\" ityata Aha \dash \" anyathA\" iti |  \" rAjasyAH\" iti 
ShaShThyantamanuvartate |  \" tAmasyAH\" iti paJNchamI |  \" bhedAbhAvAt\" 
bhedAbhAvaprasaN^gAt || 31\-48||

%%% ##endlabel##

%%% ##label=<segment016_pd18>##
{\Largedvng pra\.dI\. || } \" naiShkarmyasiddhiM moxam\" (shAM\.bhA\. 18\.49) iti kechit |
tadasat |  \" tadanantaraM mAM vishata iti vAkyasheShavirodhAd\" iti 
bhAvenAnyathA vyAchaShTe \dash \" naiShkarmyam\" iti |  naiShkarmyArthA 
siddhiH \" naiShkarmyasiddhiH\" |  \" sA cha yogasya\" ityarthaH || 49||

%%% ##endlabel##

%%% ##label=<segment017_pd18>##

{\Largedvng pra\.dI\. || } \" siddhiM prAptaH iti yogasiddhiprAptyanantaraM 
brahmaprAptAvupAyakathanaM pratij~nAyata\" (shAM\.bhA\. 18\.50) ityanyathA
pratItinirAsArthaM vyAchaShTe \dash \" yathA\" iti |  \" brahmA.apnoti\" 
ityanuvAdamAtram |  tathA tamupAyam |  \" pratIta evArthaH kiM na syAd\?\" 
iti chenna |  siddheH j~nAnaniShThA.atmakatvenAbhidhAnAt |  \" j~nAnasya cha 
brahmaprAptAvanapexatvAd\" iti bhAvena \" niShThA\" ityetadvyAchaShTe 
\dash \" yA\" iti || 50\-52||

%%% ##endlabel##

%%% ##label=<segment018_pd18>##
{\Largedvng pra\.dI\. || } \" brahmabhUyAya brahmatvAya\" iti pratItinirAsArthaM 
vyAchaShTe \dash \" brahma\" iti | \" ityartha\" iti sheShaH |  bhAvo na 
janmAdItyAshayena vivR^iNoti \dash \" brahmaNi\" iti |  iyamapi na muktiH |  
\" brahmabhUta iti punarbhaktyAdilAbhashravaNAd\" iti bhAvenA.aha \dash 
\" sarvadA\" iti || 53\-55||

%%% ##endlabel##

%%% ##label=<segment019_pd18>##
{\Largedvng pra\.dI\. || } uttaragranthasya saN^gatiM sUchayat tAtparyamAha \dash 
\" punaH\" iti |  upasaMharati |  \" shAstram\" iti sheShaH || 56\-60||

%%% ##endlabel##

%%% ##label=<segment020_pd18>##
{\Largedvng pra\.dI\. || } \" IshvarassarvabhUtAnAM hR^iddeshe.arjuna tiShThati\" |
\" tameva sharaNaM gachCha\", \" tatprasAdAt\" ityAdirUpAtparoxavachanAt 
kR^iShNasyAnIshvaratvaM pratIyate |  tannirAkartumAha \dash \" paroxa\" iti |  
\" nishchitArthatvAbhiprAyeNAnyathA siddham\" iti sheShaH || 61\-65||

%%% ##endlabel##

%%% ##label=<segment021_pd18>##
{\Largedvng pra\.dI\. || } \" sarvadharmAn parityajya iti varNAshramavihitAnAmapi 
sarvadharmANAM parityAgo vidhIyata\" (shAM\.bhA\.18\.66) ityanyathApratItinirAsArthamAha 
\dash \" dharma\" iti |  \" pratIta evArthaH kiM na syAd\?\" ityata Aha \dash 
\" katham\" iti |  \" asmin shAstre kriyata\" iti sheShaH |  \" ashAbdo
ayamartha\" iti chenna dharmashabdasya svakAryaphalopalaxaNatvAt |  \" evameva 
bhagavatA vyAkhyAtatvAchcha\" ityAha \dash \" yastu\" iti || 66\-78||

%%% ##endlabel##

%%% ##label=<segment022_pd18>##

{\Largedvng pra\.dI\. || } idAnIM samApitabhAShyo bhagavAnAchAryo bhAShyanirmANasya 
phalaM bhagavatprItimevA.ashAste \dash \" pUrNa\" iti |  etat \" gItAm\" 
ityanena \" nirUpaNam\" ityanena cha sambadhyate |  \" tena\" iti shravaNAt 
\" yad\" iti labhyate |

\ \ \ karatalakalitAmalakamiva prabhuNA yenedamavagataM vishvam |
\ \ \ sa jayati janakasutAyAH kAntaH shrIraghunandano devaH || 

\ \ \ namAmi vyAsadAsasya pUrNabuddheH padAmbuje |
\ \ \ natAmarashiroratnarAjinIrAjite sadA ||

\ \ \ axobhyatIrthaguruNA shukavachChixitasya me |
\ \ \ vachobhiramR^itaprAyaiH prIyantAM satataM budhAH ||

iti shrImadAnandatIrthabhagavatpAdAchAryavirachitasya shrImadgItAbhAShyasya TikAyAM
jayatIrthamunivirachitAyAM prameyadIpikAyAM aShTAdasho.adhyAyaH samAptaH || 

%%% ##endlabel##

% shrImadhveshakR^iShNArpaNamastu 
